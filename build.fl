; Native front build stages that are supported by the current v11 C backend.
(load "build-transforms.fl")
(load "island-compiler.fl")
(load "island-emitter.fl")
(load "agents-compiler.fl")
(defn scan-pages [dir]
  (scan-entries dir (sort (dir-list dir)) 0 []))
(defn scan-entries [dir entries i result]
  (if (>= i (length entries)) result
    (let [name (get entries i)
          path (str dir "/" name)]
      (if (dir-exists? path)
        (scan-entries dir entries (+ i 1) (concat result (scan-pages path)))
        (scan-entries dir entries (+ i 1)
          (if (and (str-ends-with name ".flx")
                   (not (str-starts-with name "_")))
            (append result path) result))))))
(defn scan-all-flx [dir]
  (scan-all-entries dir (sort (dir-list dir)) 0 []))
(defn scan-all-entries [dir entries i result]
  (if (>= i (length entries)) result
    (let [name (get entries i)
          path (str dir "/" name)]
      (if (dir-exists? path)
        (scan-all-entries dir entries (+ i 1) (concat result (scan-all-flx path)))
        (scan-all-entries dir entries (+ i 1)
          (if (str-ends-with name ".flx") (append result path) result))))))
(defn route-name [file]
  (let [relative (str-slice file 6 (- (length file) 4))
        path (str "/" relative)
        without-index (if (str-ends-with path "/index")
                        (str-slice path 0 (- (length path) 6)) path)
        root (if (= without-index "") "/" without-index)]
    (str-replace (str-replace root "[" ":") "]" "")))
(defn function-name [file]
  (let [relative (str-slice file 6 (- (length file) 4))]
    (str "page_"
      (str-replace
        (str-replace
          (str-replace
            (str-replace relative "[" "") "]" "")
          "/" "_")
        "-" "_"))))
(defn route-record [file]
  {"route" (route-name file)
   "file" (last (str-split file "/"))
   "fn" (function-name file)
   "source" file})
(defn route-records [files i result]
  (if (>= i (length files)) result
    (route-records files (+ i 1) (append result (route-record (get files i))))))
(defn select-routes [routes i dynamic result]
  (if (>= i (length routes)) result
    (let [record (get routes i)
          is-dynamic (>= (str-index-of (get record "route") ":") 0)]
      (select-routes routes (+ i 1) dynamic
        (if (= is-dynamic dynamic) (append result record) result)))))
(defn remove-source [record]
  {"route" (get record "route")
   "file" (get record "file")
   "fn" (get record "fn")})
(defn public-routes [routes i result]
  (if (>= i (length routes)) result
    (public-routes routes (+ i 1)
      (append result (remove-source (get routes i))))))
(defn helper-rank [name]
  (if (str-starts-with name "_layout") 0
  (if (str-starts-with name "_db") 1
  (if (str-starts-with name "_auth") 2
  (if (str-starts-with name "_error") 3
  (if (str-starts-with name "_charts") 4 5))))))
(defn helper-files [entries i result]
  (if (>= i (length entries)) result
    (let [name (get entries i)]
      (helper-files entries (+ i 1)
        (if (and (str-starts-with name "_") (str-ends-with name ".flx"))
          (append result name) result)))))
(defn helpers-at-rank [helpers rank i result]
  (if (>= i (length helpers)) result
    (let [name (get helpers i)]
      (helpers-at-rank helpers rank (+ i 1)
        (if (= (helper-rank name) rank) (append result name) result)))))
(defn order-helpers [helpers rank result]
  (if (> rank 5) result
    (order-helpers helpers (+ rank 1)
      (concat result (helpers-at-rank helpers rank 0 [])))))
(defn route-lines [routes i result]
  (if (>= i (length routes)) result
    (let [record (get routes i)
          route (get record "route")
          fn-name (get record "fn")
          source (get record "source")
          get-line (str "(server-get \"" route "\" \"" fn-name "\")")
          post? (>= (str-index-of (file-read source)
                       "(defn render_post [req]") 0)
          next (append result get-line)]
      (route-lines routes (+ i 1)
        (if post?
          (append next (str "(server-post \"" route "\" \"" fn-name "_post\")"))
          next)))))
(defn write-stripped-pages [files i]
  (if (>= i (length files)) true
    (let [file (get files i)
          dest (str "tests/build-actual/stripped/" file)
          stripped (remove-style-blocks (file-read file) 0 "")]
      (do (file-write dest stripped)
          (write-stripped-pages files (+ i 1))))))
(defn binding-lines [bindings i result]
  (if (>= i (length bindings)) result
    (let [binding (get bindings i)
          name (get binding "name")
          cls (get binding "cls")
          snake (str-replace name "-" "_")
          next (str result "(define " snake " \"" cls "\")\n")]
      (binding-lines bindings (+ i 1)
        (if (= name snake) next
          (str next "(define " name " \"" cls "\")\n"))))))
(defn app-css [routes i css]
  (if (>= i (length routes)) css
    (let [file (get (get routes i) "source")
          paired (str (str-slice file 0 (- (length file) 4)) ".css")
          extra (if (file-exists paired)
                  (str-trim (str-replace (file-read paired) "\n" " ")) "")]
      (app-css routes (+ i 1)
        (if (= extra "") css (str css " " extra))))))
(defn escape-css [s]
  (str-replace (str-replace s "\\" "\\\\") "\"" "\\\""))
(defn helper-body [file css seen]
  (let [name (last (str-split file "/"))
        raw (str-trim (file-read file))
        source (if (= name "_layout.flx")
                 (replace-global-css raw (escape-css css)) raw)
        stripped (str-trim (remove-style-blocks source 0 ""))
        resolved (resolve-loads stripped "pages" seen 0 "")]
    [(str "; ── " name " ──\n" (get resolved 0) "\n\n") (get resolved 1)]))
(defn helper-bodies [helpers i css seen result]
  (if (>= i (length helpers)) [result seen]
    (let [entry (helper-body (str "pages/" (get helpers i)) css seen)]
      (helper-bodies helpers (+ i 1) css (get entry 1)
        (str result (get entry 0))))))
(defn page-critical-css [file]
  (let [css-path (str "tests/style-actual/"
                  (str-slice file 0 (- (length file) 4)) ".css")]
    (if (file-exists css-path) (file-read css-path) "")))
(defn page-body [record seen bindings helpers]
  (let [file (get record "source")
        fn-name (get record "fn")
        route (get record "route")
        raw (str-trim (file-read file))
        critical (page-critical-css file)
        first-pass (server-fn-to-defn raw)
        with-link (if (= critical "") first-pass
                    (replace-first first-pass
                      "\"<link rel='stylesheet' href='/public/app.css'>\""
                      (json-stringify (str "<style>" critical "</style>"))))
        stripped (str-trim (remove-style-blocks with-link 0 ""))
        resolved (resolve-loads stripped (dirname-of file) seen 0 "")
        with-layout (if (= critical "") (get resolved 0)
                      (inject-layout-css (get resolved 0) critical))
        clean (str-trim (remove-defstores with-layout 0 ""))
        islands (island-extract clean 0 [])
        island? (> (length islands) 0)
        island-src (island-transform clean islands bindings helpers file)
        renamed (rename-render
                  (rename-render island-src "render" (str fn-name "__inner"))
                  "render_post" (str fn-name "_post__inner"))
        post? (>= (str-index-of (file-read file) "(defn render_post [req]") 0)
        section (str renamed "\n" (wrapper fn-name route false) "\n"
                  (if post? (str (wrapper (str fn-name "_post") route true) "\n") ""))]
    [(str "; ── " file " ──\n" section "\n")
     (str section "\n") (get resolved 1) island? clean islands]))
(defn page-bodies [routes i seen result island-list bindings helpers]
  (if (>= i (length routes)) [result island-list]
    (let [record (get routes i)
          entry (page-body record seen bindings helpers)
          file (get record "source")]
      (do (file-write (str "tests/build-actual/sections/" file) (get entry 1))
          (file-write (str "tests/build-actual/pre-island/" file) (get entry 4))
          (if (get entry 3)
            (do
              (file-write (str "tests/build-actual/island-ast/" file ".json")
                (str (json-stringify (island-asts (get entry 5) 0 [])) "\n"))
              (file-write (str "tests/build-actual/island-scripts/" file ".txt")
                (str (str-join (island-compile-all (get entry 5) 0 []) "\n") "\n"))) nil)
          (page-bodies routes (+ i 1) (get entry 2)
            (str result (get entry 0))
            (if (get entry 3) (append island-list file) island-list)
            bindings helpers)))))

(let [files (scan-pages "pages")
      records (route-records files 0 [])
      routes (concat (select-routes records 0 false [])
                     (select-routes records 0 true []))
      helpers (order-helpers (helper-files (sort (dir-list "pages")) 0 []) 0 [])
      port (or (env-get "PORT") "40850")
      registration (concat (route-lines routes 0 [])
        ["(server-get \"/*\" \"not_found_handler\")" ""
         (str "(println \"FL-Front v0.1 — http://localhost:" port "\")")
         (str "(server-start " port ")")])
      bindings (json-parse (file-read "tests/style-actual/bindings.json"))
      css (app-css routes 0 (str-trim
            (str-replace (file-read "public/app.css") "\n" " ")))
      global-css (str (file-read "templates/base.css") "\n" css)
      helper-pair (helper-bodies helpers 0 global-css {} "")
      pages-pair (page-bodies routes 0 (get helper-pair 1) "" [] bindings helpers)
      binding-text (if (= (length bindings) 0) ""
        (str "; ── CSS 스타일 클래스 바인딩 ──\n"
             (binding-lines bindings 0 "") "\n"))
      app (str "; _app.fl — 자동 생성. 직접 수정 금지.\n"
               "; 생성: <native>\n\n"
               (file-read "templates/injected-helpers.fl") "\n\n"
               binding-text
               "; ── 레이아웃·헬퍼 함수 ──\n"
               (get helper-pair 0) (get pages-pair 0)
               (str-join registration "\n"))]
  (do
    (write-stripped-pages (scan-all-flx "pages") 0)
    (file-write "tests/build-actual/routes.json"
      (str (json-stringify (public-routes routes 0 [])) "\n"))
    (file-write "tests/build-actual/helpers.json"
      (str (json-stringify helpers) "\n"))
    (file-write "tests/build-actual/route-registration.fl"
      (str-join registration "\n"))
    (file-write "tests/build-actual/_app.fl" app)
    (file-write "tests/build-actual/AGENTS.md"
      (agents-generate routes helpers))
    (file-write "tests/build-actual/island-pages.txt"
      (str (str-join (get pages-pair 1) "\n") "\n"))
    (println (str "BUILD_FL_ROUTES=" (length routes)))
    (println (str "BUILD_FL_HELPERS=" (length helpers)))
    (println (str "BUILD_FL_ISLAND_PAGES=" (length (get pages-pair 1))))))
