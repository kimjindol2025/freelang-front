; FL-Front 메인 서버
; 실행 전 빌드 필수: node fl-front-build.js

(define PORT 40860)

; subs.skl.kr → subscriptions.skl.kr 리다이렉트
(defn subdomain-redirect [req]
  (let [host (get (get req "headers") "host")]
    (if (= host "subs.skl.kr")
      (server-redirect "https://subscriptions.skl.kr/")
      nil)))

(server-static "public/uploads/market" "/uploads/market")
(server-static "public/fx2-wasm" "/fx2-wasm")

; 개발 모드 HMR 브리지 — 브라우저는 앱 origin(:40860)만 사용한다.
(defn dev-hmr-state [req]
  (if (= (fl-env-get "FL_DEV") "1")
    (let [raw (try (file-read ".hmr-event.json")
                   (catch $e "{\"version\":0,\"type\":\"\"}"))
          state (json-parse raw)
          since (str-to-num (or (server-req-query req "since") "0"))
          version (or (get state "version") 0)
          kind (if (> version since) (or (get state "type") "") "")]
      (server-json {"version" version "type" kind}))
    (server_status 404 "")))

(server-get "/~hmr-state" "dev-hmr-state")

; 빌드 결과물 로드 (라우트 등록 + server-get 포함)
(load "_app.fl")

(server_use "/*" "subdomain-redirect")

; 내부 코딩 서버 계약 — 브라우저 HMR/metrics와 release smoke가
; loopback 한도(기본 100/60s)에 서로 걸리지 않도록 제한을 명시한다.
; 외부 공개·상용 배포 계약에는 이 값을 재사용하지 않는다.
(server-rate-limit 1000 60000)

; 서버 시작
(println (str "FL-Front v0.1 — http://localhost:" PORT))
(server-start PORT)
