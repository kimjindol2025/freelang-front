{
  "$": "airc-spec",
  "version": "1.0.0",
  "project": "freelang-front",
  "date": "2026-05-29",
  "cmd": "python3 -c \"import json; d=json.load(open('SPEC.airc')); print('what:', d['identity']['what']); print('hot:', d['hot'])\"",
  "identity": {
    "what": "FreeLang v11 fx 기반 풀스택 프론트엔드 언어 — npm install 0개로 Next.js 스택 전체 대체",
    "why": "React+Next.js+Tailwind+Zustand+TanStack 조합의 복잡성을 단일 언어로 통합",
    "for": "FreeLang v11 fx 사용자. 콘텐츠 중심 앱, 관리자 대시보드, SaaS 프론트엔드",
    "not": "SPA, 3D, 게임, 인터랙션이 많은 앱"
  },
  "hot": "task-011",
  "constitution": {
    "1": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2": "identity는 잠긴다. 변경은 사용자 협의 필수",
    "3": "hot이 가리키는 task가 지금 당장 해야 할 일이다",
    "4": "오류·실수도 nodes에 기록한다",
    "5": "노드는 삭제하지 않는다. void 처리만 허용",
    "6": "why 없는 lock·decision 등록 불가"
  },
  "types": {
    "task": "t + v + entry + check + verified + next",
    "decision": "t + v + why + lock",
    "error": "t + v + cause + fix + repeat_risk"
  },
  "phases": {
    "P1": "SSR + 파일 라우터 (3~4주) ★★☆",
    "P2": "CSS DSL + 빌드 파이프라인 (2~3주) ★★☆",
    "P3": "아일랜드 컴파일러 (6~8주) ★★★★★",
    "P4": "query/form/atom 내장 (2~3주) ★★★☆",
    "P5": "SVG 차트 + HMR (2~3주) ★★★☆"
  },
  "nodes": {
    "task-001": {
      "t": "task",
      "v": "P1-A: pages/ 라우터 스캐너 구현 — .flx → 라우트 맵",
      "entry": [
        "router.fl",
        "server.fl"
      ],
      "check": [
        "pages/index.flx → GET / 응답",
        "pages/about.flx → GET /about 응답",
        "pages/api/hello.flx → GET /api/hello JSON"
      ],
      "verified": true,
      "next": [
        "task-002"
      ]
    },
    "task-002": {
      "t": "task",
      "v": "P1-B: 동적 라우트 — pages/users/[id].flx → /users/:id",
      "entry": [
        "router.fl (str-replace-regex 패턴)"
      ],
      "check": [
        "GET /users/42 → req.params.id = '42'"
      ],
      "verified": true,
      "next": [
        "task-003"
      ]
    },
    "task-003": {
      "t": "task",
      "v": "P1-C: fl-dev-server — 파일 감시 + 자동 restart",
      "entry": [
        "dev-server.fl"
      ],
      "check": [
        ".flx 저장 → 1초 내 서버 재시작"
      ],
      "verified": true,
      "next": [
        "task-004"
      ]
    },
    "task-004": {
      "t": "task",
      "v": "P2-A: (style ...) DSL → scoped .css 생성",
      "entry": [
        "style-compiler.fl"
      ],
      "check": [
        "10개 속성 지원",
        "hash suffix",
        ".css 파일 출력"
      ],
      "verified": true,
      "next": [
        "task-005"
      ]
    },
    "task-005": {
      "t": "task",
      "v": "P3-A: (island ...) 파서 + 기본 JS emit",
      "entry": [
        "island-compiler.fl"
      ],
      "check": [
        "카운터 island 브라우저 동작",
        "JS < 2KB"
      ],
      "verified": true,
      "next": []
    },
    "dec-001": {
      "t": "decision",
      "v": "아일랜드 아키텍처 채택 — 전체 Hydration 금지",
      "why": "Virtual DOM 구현 6개월+. 아일랜드로 충분",
      "lock": true
    },
    "dec-002": {
      "t": "decision",
      "v": "CSS 빌드타임 정적 생성 — 런타임 CSS-in-JS 금지",
      "why": "의존성 없음. SSR Critical CSS 자동화",
      "lock": true
    },
    "dec-003": {
      "t": "decision",
      "v": "확장자 .flx — 기존 .fl과 구분",
      "why": "빌드 파이프라인이 .flx만 라우트로 스캔",
      "lock": true
    },
    "target-demo": {
      "t": "decision",
      "v": "target_demo 달성 — /dashboard 동작 (2026-05-29)",
      "why": "server-fn + CSS DSL + SVG chart + scoped class 모두 동작. MVP 기준 충족",
      "lock": true
    },
    "task-010": {
      "t": "task",
      "v": "P2-C: 반응형 CSS — :sm- :md- :lg- breakpoint prefix 지원",
      "entry": [
        "style-compiler.js (breakpoint prefix 파싱 + @media 블록 생성)"
      ],
      "check": [
        "(style card :p '24px' :sm-p '12px') → .card { padding:24px } @media(max-width:640px){.card{padding:12px}}",
        "3단계 breakpoint: sm(640px) md(768px) lg(1024px)",
        "pages/styled.flx 반응형 예제 추가",
        "GET /styled HTML 내 @media 규칙 포함 확인"
      ],
      "verified": true,
      "next": []
    },
    "task-009": {
      "t": "task",
      "v": "P3-B: To-do Island — atom 배열 상태 + 목록 렌더링 + 항목 삭제",
      "entry": [
        "pages/todo.flx",
        "island-compiler.js (push/get/assoc/map/filter/reduce/get-in 추가)",
        "FL_ISLAND_RT 확장 (배열·맵 조작 런타임)"
      ],
      "check": [
        "GET /todo → SSR 렌더 (island placeholder 포함)",
        "항목 추가 — 입력 후 추가 버튼 → 목록에 반영",
        "항목 완료 토글 — 클릭 시 취소선",
        "항목 삭제 — 삭제 버튼",
        "JS 번들 크기 < 5KB (배열/맵 조작 함수 포함)"
      ],
      "verified": true,
      "next": []
    },
    "task-008": {
      "t": "task",
      "v": "P1-D: 레이아웃 시스템 — pages/_layout.flx 공통 헬퍼 + 페이지 boilerplate 제거",
      "entry": [
        "pages/_layout.flx (layout 헬퍼 함수 정의)",
        "fl-front-build.js (_layout.flx를 라우트 제외 + 맨 앞 삽입)"
      ],
      "check": [
        "_layout.flx 내 layout 함수가 _app.fl 맨 앞에 삽입됨",
        "pages/index.flx — layout 사용으로 100줄 이하로 단축",
        "GET / 정상 렌더 (타이틀·nav·footer 포함)",
        "GET /about 정상 렌더",
        "기존 dashboard·counter·contact 페이지 회귀 없음"
      ],
      "verified": true,
      "next": []
    },
    "task-007": {
      "t": "task",
      "v": "P4-A: 서버 폼 처리 — POST form-field 파싱 + server-side 처리 + redirect",
      "entry": [
        "pages/contact.flx (GET 폼 렌더 + POST 처리)",
        "fl-front-build.js (server-post 라우트 등록 지원)"
      ],
      "check": [
        "GET /contact → 폼 HTML 렌더",
        "POST /contact → form-field 파싱 후 /contact/thanks redirect",
        "GET /contact/thanks → 성공 메시지 렌더",
        "빈 필드 submit → 에러 메시지 재렌더 (JS 없이)"
      ],
      "verified": true,
      "next": []
    },
    "task-006": {
      "t": "task",
      "v": "P2-B: Critical CSS 인라인 — 페이지별 <style> 인라인 + <link> 제거",
      "entry": [
        "style-compiler.js (compilePageCSS 추가)",
        "fl-front-build.js (<link> → <style> 교체 로직)"
      ],
      "check": [
        "/dashboard HEAD 내 <style> 블록 포함 (stat_card__5598 외 3개 규칙)",
        "/styled HEAD 내 <style> 블록 포함 (card__6486 외 3개 규칙)",
        "페이지 간 CSS 격리 — stat_card__5598 /styled에 미포함, card__6486 /dashboard에 미포함",
        "<link rel='stylesheet'> 완전 제거"
      ],
      "verified": true,
      "next": [
        "task-007"
      ]
    },
    "task-011": {
      "t": "task",
      "v": "P5-A: SVG 차트 DSL — (chart-bar) / (chart-line) 순수 SSR SVG 생성",
      "entry": [
        "pages/_charts.flx (chart-bar, chart-line 헬퍼 함수)",
        "pages/dashboard.flx (차트 통합)"
      ],
      "check": [
        "(chart-bar [{:label 'A' :value 40} ...] {}) → <svg>...</svg> 문자열",
        "(chart-line [{:x 0 :y 10} ...] {}) → <svg>...</svg> 문자열",
        "GET /dashboard — SVG 차트 2개 이상 포함",
        "npm install 0개 유지",
        "JS 없이 SSR SVG 렌더링"
      ],
      "verified": true,
      "next": []
    }
  },
  "lock": [
    {
      "rule": "npm install 금지",
      "why": "의존성 0 원칙"
    },
    {
      "rule": "Virtual DOM 전체 구현 금지",
      "why": "dec-001"
    },
    {
      "rule": ".flx 내 순수 JS 금지",
      "why": "언어 단일성"
    },
    {
      "rule": "CSS 런타임 생성 금지",
      "why": "dec-002"
    }
  ],
  "graveyard": [
    {
      "idea": "Virtual DOM clone",
      "why": "6개월+. 아일랜드로 대체",
      "final": true
    },
    {
      "idea": "WASM 타깃",
      "why": "cgc-bin으로 충분. 별도 프로젝트",
      "final": true
    },
    {
      "idea": "TypeScript 통합",
      "why": "FL 타입 시스템과 충돌",
      "final": true
    }
  ],
  "handoff": {
    "step1": "cmd 실행 → identity·hot 확인",
    "step2": "graveyard 확인",
    "step3": "hot = task-001 실행",
    "step4": "오류 시 error 노드 기록",
    "step5": "identity 변경 필요 시 사용자 협의"
  }
}