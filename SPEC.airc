    "dec-009-circuit-breaker": {
      "t": "decision",
      "v": "서킷 브레이커 — _layout.flx 모니터링 전송에 장애 격리 장치 탑재",
      "why": "모니터링 장애 → 앱 응답 지연 → 모니터링 호출 폭증 → 앱 전체 장애 경로 차단. 장애 방지 장치는 성능 최적화보다 먼저.",
      "spec": {
        "timeout_ms": 500,
        "fail_threshold": 3,
        "reset_after_ms": 30000,
        "states": ["closed", "open", "half-open"]
      },
      "lock": true
    },
    "dec-010-batch-metrics": {
      "t": "decision",
      "v": "배치 전송 — 메트릭 즉시 POST 금지, 로컬 큐 5초 또는 10개 단위 묶음 전송",
      "why": "페이지 로드마다 5-6개 fetch 즉시 발사 → 모니터링 트래픽 = 서비스 트래픽. sendBeacon 병행.",
      "spec": {
        "batch_interval_ms": 5000,
        "batch_max_size": 10,
        "use_beacon_on_unload": true
      },
      "lock": true
    },
    "dec-011-percentile-slo": {
      "t": "decision",
      "v": "백분위수 도입 — SLO 기준을 평균이 아닌 p95/p99로 전환",
      "why": "산술 평균은 이상치에 왜곡됨. '95%의 사용자가 500ms 이내' 같은 실용적 SLO 기준 필요.",
      "spec": {
        "percentiles": [50, 95, 99],
        "slo_baseline": "p95 < 500ms",
        "alert_threshold": "p99 > 2000ms"
      },
      "lock": true
    },
    "dec-012-metrics-retention": {
      "t": "decision",
      "v": "TTL + Roll-up — 24시간 초과 raw 데이터는 분 단위 집계 후 폐기",
      "why": "인메모리 atom 선형 증가 → OOM 위험. MAX_PERF_RECORDS=500은 임시 방편.",
      "spec": {
        "raw_ttl_hours": 24,
        "rollup_unit": "minute",
        "rollup_fields": ["avg", "min", "max", "count"],
        "max_rollup_records": 1440
      },
      "lock": true
    },
    "task-009-circuit-breaker": {
      "t": "task",
      "v": "P0: 서킷 브레이커 — _layout.flx 모니터링 전송 장애 격리",
      "entry": ["pages/_layout.flx"],
      "check": [
        "타임아웃 500ms — fetch가 500ms 넘으면 중단",
        "3회 연속 실패 → circuit OPEN (전송 중단 30초)",
        "30초 후 half-open → 1회 시도 → 성공 시 CLOSED 복구",
        "circuit OPEN 중 /api/metrics POST 발사 안 됨 확인",
        "서킷 브레이커 상태 console.log로 추적 가능"
      ],
      "verified": true,
      "verified_at": "2026-06-01",
      "next": ["task-010-batch-metrics"]
    },
    "task-016": {
      "t": "task",
      "v": "파일 업로드 — multipart/form-data 파싱 + public/ 저장",
      "entry": [
        "pages/upload.flx (업로드 폼 + 처리)",
        "fl-front-build.js (multipart 파싱 지원)"
      ],
      "check": [
        "GET /upload → 파일 선택 폼",
        "POST /upload → public/uploads/ 저장 + 미리보기",
        "파일 크기 제한 2MB"
      ],
      "verified": true,
      "next": []
    }
  },
