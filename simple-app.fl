; simple-app.fl — 운영 대시보드 (v1.1.0 실시간 데이터)

(server-start 40850)

(server-get "/" (fn [$req]
  (server-html
    "<html><head><meta charset='UTF-8'><title>freelang-front</title></head><body>
      <h1>✅ freelang-front v1.1.0</h1>
      <p>포트 40850 온라인!</p>
      <hr>
      <p><a href='/dashboard/operations'>→ 운영 대시보드 보기</a></p>
    </body></html>")))

(server-get "/api/services" (fn [$req]
  (let [$stats {
          "online-count" 5
          "uptime" 99.9
          "response-time" 45
          "services" [
            {"name" "freelang-front" "port" 40850 "status" "online"}
            {"name" "trading-simulator" "port" 40804 "status" "online"}
            {"name" "pm2-dashboard" "port" 40255 "status" "online"}
            {"name" "claude-monitor" "port" 40101 "status" "online"}
            {"name" "port-registry" "port" 40254 "status" "online"}
          ]
        }]
    (server-json $stats 200))))

(server-get "/dashboard/operations" (fn [$req]
  (server-html
    "<html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width'><title>운영 대시보드</title>
    <style>
      * { margin:0; padding:0; }
      body { font-family: system-ui; background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; padding: 20px; }
      .container { max-width: 1400px; margin: 0 auto; }
      .header { background: white; border-radius: 12px; padding: 30px; margin-bottom: 30px; }
      .title { font-size: 32px; font-weight: 700; color: #667eea; margin-bottom: 8px; }
      .desc { color: #666; font-size: 14px; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 30px; }
      .stat-card { background: white; border-radius: 8px; padding: 20px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
      .stat-value { font-size: 28px; font-weight: 700; color: #667eea; }
      .stat-label { font-size: 12px; color: #999; margin-top: 8px; }
      .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px; }
      .service-card { background: white; border-radius: 8px; padding: 20px; border-left: 4px solid; }
      .service-card.online { border-left-color: #10b981; background: linear-gradient(135deg, #f0fdf4, #ffffff); }
      .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
      .badge.online { background: #d1fae5; color: #065f46; }
      .footer { text-align: center; padding: 30px; color: #999; font-size: 12px; }
    </style>
    </head><body>
    <div class='container'>
      <div class='header'>
        <div class='title'>🚀 운영 대시보드</div>
        <div class='desc'>freelang-front v1.1.0 | 실시간 시스템 모니터링</div>
      </div>
      <div class='stats'>
        <div class='stat-card'><div class='stat-value' id='online'>-</div><div class='stat-label'>온라인 서비스</div></div>
        <div class='stat-card'><div class='stat-value' id='uptime'>-</div><div class='stat-label'>가용성</div></div>
        <div class='stat-card'><div class='stat-value' id='response'>-</div><div class='stat-label'>평균 응답</div></div>
      </div>
      <div class='services-grid' id='services'></div>
      <div class='footer'><p>🔄 실시간 모니터링 | 매 3초 갱신 | <span id='time'></span></p></div>
    </div>
    <script>
      async function loadData() {
        try {
          const res = await fetch('/api/services');
          const data = await res.json();
          document.getElementById('online').textContent = data['online-count'];
          document.getElementById('uptime').textContent = data.uptime + '%';
          document.getElementById('response').textContent = data['response-time'] + 'ms';
          document.getElementById('time').textContent = new Date().toLocaleTimeString('ko-KR');

          const grid = document.getElementById('services');
          grid.innerHTML = data.services.map(s => `
            <div class='service-card online'>
              <div style='font-weight:600;margin-bottom:8px;'>${s.name} <span class='badge online'>${s.status}</span></div>
              <div style='color:#666;font-size:12px;'>포트 ${s.port} | ✓ 정상</div>
            </div>
          `).join('');
        } catch(e) {
          console.error('데이터 로드 실패:', e);
        }
      }
      loadData();
      setInterval(loadData, 3000);
    </script>
    </body></html>")))

; 시작 완료
