; simple-app.fl — 운영 대시보드 (v1.1.0 간단버전)

(server-start 40850)

(server-get "/" (fn [$req]
  (server-html
    "<html><head><meta charset='UTF-8'><title>freelang-front</title></head><body>
      <h1>✅ freelang-front v1.1.0</h1>
      <p>포트 40850 온라인!</p>
    </body></html>")))

(server-get "/dashboard/operations" (fn [$req]
  (server-html
    "<html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width'><title>운영 대시보드</title>
    <style>
      * { margin:0; padding:0; }
      body { font-family: system-ui; background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; padding: 20px; }
      .container { max-width: 1400px; margin: 0 auto; }
      .header { background: white; border-radius: 12px; padding: 30px; margin-bottom: 30px; }
      .title { font-size: 32px; font-weight: 700; color: #667eea; margin-bottom: 8px; }
      .desc { color: #666; font-size: 14px; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 30px; }
      .stat-card { background: white; border-radius: 8px; padding: 20px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
      .stat-value { font-size: 28px; font-weight: 700; color: #667eea; }
      .stat-label { font-size: 12px; color: #999; margin-top: 8px; }
      .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px; }
      .service-card { background: white; border-radius: 8px; padding: 20px; border-left: 4px solid; }
      .service-card.online { border-left-color: #10b981; background: linear-gradient(135deg, #f0fdf4, #ffffff); }
      .service-card.offline { border-left-color: #ef4444; background: linear-gradient(135deg, #fef2f2, #ffffff); }
      .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
      .badge.online { background: #d1fae5; color: #065f46; }
      .badge.offline { background: #fee2e2; color: #7f1d1d; }
      .footer { text-align: center; padding: 30px; color: #999; font-size: 12px; }
    </style>
    </head><body>
    <div class='container'>
      <div class='header'>
        <div class='title'>🚀 운영 대시보드</div>
        <div class='desc'>freelang-front v1.1.0 | 실시간 시스템 모니터링</div>
      </div>
      <div class='stats'>
        <div class='stat-card'><div class='stat-value'>5</div><div class='stat-label'>온라인 서비스</div></div>
        <div class='stat-card'><div class='stat-value'>99.9%</div><div class='stat-label'>가용성</div></div>
        <div class='stat-card'><div class='stat-value'>45ms</div><div class='stat-label'>평균 응답</div></div>
      </div>
      <div class='services-grid'>
        <div class='service-card online'>
          <div style='font-weight:600;margin-bottom:8px;'>freelang-front <span class='badge online'>online</span></div>
          <div style='color:#666;font-size:12px;'>포트 40850 | ✓ 정상</div>
        </div>
        <div class='service-card online'>
          <div style='font-weight:600;margin-bottom:8px;'>trading-simulator <span class='badge online'>online</span></div>
          <div style='color:#666;font-size:12px;'>포트 40804 | ✓ 정상</div>
        </div>
        <div class='service-card online'>
          <div style='font-weight:600;margin-bottom:8px;'>pm2-dashboard <span class='badge online'>online</span></div>
          <div style='color:#666;font-size:12px;'>포트 40255 | ✓ 정상</div>
        </div>
        <div class='service-card online'>
          <div style='font-weight:600;margin-bottom:8px;'>claude-monitor <span class='badge online'>online</span></div>
          <div style='color:#666;font-size:12px;'>포트 40101 | ✓ 정상</div>
        </div>
        <div class='service-card online'>
          <div style='font-weight:600;margin-bottom:8px;'>port-registry <span class='badge online'>online</span></div>
          <div style='color:#666;font-size:12px;'>포트 40254 | ✓ 정상</div>
        </div>
      </div>
      <div class='footer'><p>🔄 실시간 모니터링 | freelang-front v1.1.0 프로덕션</p></div>
    </div>
    </body></html>")))

; 시작 완료
