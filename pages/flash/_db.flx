; pages/flash/_db.flx — 플래시카드/SRS DB
(ns flash)

(define FLASH-DB {:type "sqlite" :path "data/flash.db"})

(defn init []
  (do
    (db-exec FLASH-DB
      "CREATE TABLE IF NOT EXISTS decks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        description TEXT DEFAULT '',
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])
    (db-exec FLASH-DB
      "CREATE TABLE IF NOT EXISTS cards (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        deck_id INTEGER NOT NULL,
        front TEXT NOT NULL,
        back TEXT NOT NULL,
        interval_days INTEGER DEFAULT 1,
        ease REAL DEFAULT 2.5,
        next_at TEXT DEFAULT (date('now')),
        reps INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])))

(defn all-decks []
  (db-query FLASH-DB
    "SELECT d.*, COUNT(c.id) as card_count,
            SUM(CASE WHEN c.next_at <= date('now') THEN 1 ELSE 0 END) as due_count
     FROM decks d LEFT JOIN cards c ON c.deck_id=d.id GROUP BY d.id ORDER BY d.name ASC" []))

(defn deck-by-id [id]
  (db-one FLASH-DB "SELECT * FROM decks WHERE id=?" [(str-to-num id)]))

(defn cards-by-deck [deck-id]
  (db-query FLASH-DB "SELECT * FROM cards WHERE deck_id=? ORDER BY id ASC" [(str-to-num deck-id)]))

(defn due-cards [deck-id]
  (db-query FLASH-DB
    "SELECT * FROM cards WHERE deck_id=? AND next_at <= date('now') ORDER BY next_at ASC"
    [(str-to-num deck-id)]))

(defn add-deck [name description]
  (db-exec FLASH-DB "INSERT INTO decks (name,description) VALUES (?,?)" [name description]))

(defn add-card [deck-id front back]
  (db-exec FLASH-DB
    "INSERT INTO cards (deck_id,front,back) VALUES (?,?,?)"
    [(str-to-num deck-id) front back]))

(defn update-card-srs [id interval ease reps next-at]
  (db-exec FLASH-DB
    "UPDATE cards SET interval_days=?,ease=?,reps=?,next_at=? WHERE id=?"
    [(str-to-num interval) ease (str-to-num reps) next-at (str-to-num id)]))

(defn delete-deck [id]
  (do
    (db-exec FLASH-DB "DELETE FROM cards WHERE deck_id=?" [(str-to-num id)])
    (db-exec FLASH-DB "DELETE FROM decks WHERE id=?" [(str-to-num id)])))

(defn card-by-id [id]
  (db-one FLASH-DB "SELECT * FROM cards WHERE id=?" [(str-to-num id)]))

(defn delete-card [id]
  (db-exec FLASH-DB "DELETE FROM cards WHERE id=?" [(str-to-num id)]))

; SM-2 알고리즘: quality 0-5
(defn sm2-next [interval ease reps quality]
  (let [new-ease (let [e (+ ease (* 0.1 (- quality 5)))]
                   (if (< e 1.3) 1.3 e))
        new-interval (cond
          (< quality 3) 1
          (= reps 0) 1
          (= reps 1) 6
          true (floor (* interval ease)))
        new-reps (if (>= quality 3) (+ reps 1) 0)
        next-at (str-trim (shell (str "date -d '+" new-interval " days' '+%Y-%m-%d'")))]
    {:interval new-interval :ease new-ease :reps new-reps :next-at next-at}))
