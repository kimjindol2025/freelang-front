; pages/contacts/[id].flx — 연락처 상세/편집
; GET  /contacts/:id
; POST /contacts/:id

(load "pages/contacts/_db.flx")
(contacts-init)

(defn render [req]
  (let [id (server-req-param req "id")
        c  (contacts-by-id id)]
    (if (= c nil)
      (server-redirect "/contacts")
      (layout-html "연락처 편집"
        (h "div" {:style "max-width:560px;margin:0 auto;padding:32px 24px"}
          (str
            (h "div" {:style "display:flex;align-items:center;gap:16px;margin-bottom:28px"}
              (str
                (h "a" {:href "/contacts" :style "color:#6366f1;text-decoration:none;font-size:.9rem"} "← 목록")
                (h "h1" {:style "font-size:1.4rem;font-weight:800;margin:0"} "연락처 편집")))
            (h "div" {:style "background:white;border-radius:16px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.08)"}
              (str
                (h "div" {:style "text-align:center;margin-bottom:24px"}
                  (h "div" {:style "width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:1.6rem;margin:0 auto 8px"}
                    (str-slice (get c "name") 0 1)))
                (h "form" {:method "POST" :style "display:flex;flex-direction:column;gap:14px"}
                  (str
                    (h "div" {}
                      (str
                        (h "label" {:style "font-size:.8rem;color:#6b7280;display:block;margin-bottom:4px"} "이름 *")
                        (h! "input" {:type "text" :name "name" :value (get c "name") :required "true"
                                     :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem"})))
                    (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:12px"}
                      (str
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.8rem;color:#6b7280;display:block;margin-bottom:4px"} "전화번호")
                            (h! "input" {:type "tel" :name "phone" :value (get c "phone")
                                         :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem"})))
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.8rem;color:#6b7280;display:block;margin-bottom:4px"} "이메일")
                            (h! "input" {:type "email" :name "email" :value (get c "email")
                                         :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem"})))))
                    (h "div" {}
                      (str
                        (h "label" {:style "font-size:.8rem;color:#6b7280;display:block;margin-bottom:4px"} "그룹")
                        (h "select" {:name "group_name"
                                     :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem"}
                          (arr-join
                            (map
                              (fn [g]
                                (if (= g (get c "group_name"))
                                  (str "<option value='" g "' selected>" g "</option>")
                                  (str "<option value='" g "'>" g "</option>")))
                              ["일반" "가족" "친구" "직장" "비즈니스"])
                            ""))))
                    (h "div" {}
                      (str
                        (h "label" {:style "font-size:.8rem;color:#6b7280;display:block;margin-bottom:4px"} "메모")
                        (h "textarea" {:name "memo" :rows "3"
                                       :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem;resize:none"}
                          (get c "memo"))))
                    (h "div" {:style "display:flex;gap:8px;margin-top:4px"}
                      (str
                        (h "button" {:type "submit"
                                     :style "flex:1;background:#6366f1;color:white;border:none;border-radius:8px;padding:12px;font-weight:700;cursor:pointer"}
                          "저장")
                        (h "a" {:href "/contacts"
                                :style "padding:12px 20px;border:1px solid #d1d5db;border-radius:8px;text-decoration:none;color:#374151;text-align:center"}
                          "취소")))))))))
        req))))

(defn render_post [req]
  (let [id         (server-req-param req "id")
        c          (contacts-by-id id)]
    (if (= c nil)
      (server-redirect "/contacts")
      (let [name  (form-get req "name")
            phone (form-get req "phone")
            email (form-get req "email")
            memo  (form-get req "memo")
            group (form-get req "group_name")]
        (if (= (str-trim name) "")
          (server-redirect (str "/contacts/" id "?error=이름을 입력하세요"))
          (do
            (contacts-update id name phone email memo group)
            (server-redirect "/contacts")))))))
