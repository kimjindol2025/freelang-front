; pages/examples/14-toast.flx
; 예제 14 — 토스트 알림: atom 배열에 추가하고 닫기 버튼으로 제거
; 배우는 것: atom 배열, push, filter, 동적 리스트 렌더

(island Toast []
  (let [toasts (atom [])
        seq    (atom 0)
        add    (fn [kind text]
                 (reset! seq (+ @seq 1))
                 (swap! toasts (fn [xs] (push xs {"id" @seq "kind" kind "text" text}))))]
    (h "div" {}
      (str
        (h "div" {:style "display:flex;gap:8px;margin-bottom:20px"}
          (str
            (h "button" {:style "background:#10b981;color:white;border:none;border-radius:8px;padding:8px 14px;cursor:pointer"
                         :on-click (fn [] (add "success" "저장되었습니다 ✓"))} "성공")
            (h "button" {:style "background:#ef4444;color:white;border:none;border-radius:8px;padding:8px 14px;cursor:pointer"
                         :on-click (fn [] (add "error" "오류가 발생했습니다 ✕"))} "오류")))
        (h "div" {:style "display:flex;flex-direction:column;gap:8px"}
          (map
            (fn [t]
              (h "div" {:style (str "display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-radius:8px;color:white;"
                                    (if (= (get t "kind") "success") "background:#10b981" "background:#ef4444"))}
                (str
                  (h "span" {} (get t "text"))
                  (h "button" {:style "background:none;border:none;color:white;cursor:pointer;font-size:1.1rem;margin-left:12px"
                               :on-click (fn []
                                 (swap! toasts (fn [xs] (filter (fn [x] (not= (get x "id") (get t "id"))) xs))))} "×"))))
            @toasts))))))

(defn render [req]
  (layout-html "14 · 토스트"
    (str
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "토스트 알림")
          (h "p" {:style "color:#6b7280;margin:0 0 24px"} "버튼으로 atom 배열에 알림을 추가하고, × 로 제거합니다.")
          "ISLAND_PLACEHOLDER"
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      "ISLAND_SCRIPTS")
    req))
