; 예제 33 — UI 컴포넌트 계약
; 목적: _ui.flx의 공통 컴포넌트를 한 화면에서 조합하고 SSR 결과를 검증한다.

(defn render [req]
  (let [rows [["ui-btn" "atoms" "PASS"]
              ["ui-input" "forms" "PASS"]
              ["ui-card" "layout" "PASS"]
              ["ui-alert" "feedback" "PASS"]
              ["ui-table" "data" "PASS"]]]
    (layout-html "33 · UI 컴포넌트 계약"
      (h "main" {:style "max-width:960px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.8rem;margin:0 0 8px"} "UI 컴포넌트 계약")
          (h "p" {:style "color:var(--c-muted);margin:0 0 24px"}
            "AI가 조합할 수 있는 FreeLang Front 공통 컴포넌트입니다.")
          (ui-alert "info" "이 페이지는 SSR 컴포넌트 조합을 검증합니다.")
          (h "div" {:style "display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px"}
            (str
              (ui-card "Atoms" (str (ui-btn "primary" "실행") " " (ui-badge "안정" "green")))
              (ui-card "Forms" (ui-input "component-name" "컴포넌트 이름" "text" "ui-card"))
              (ui-card "Progress" (str (ui-progress 8 10) (h "p" {:style "margin:8px 0 0"} "8 / 10 단계")))))
          (ui-card "Component matrix"
            (ui-table ["component" "group" "status"] rows))))
      req)))
