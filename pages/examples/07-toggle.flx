; pages/examples/07-toggle.flx
; 예제 07 — 토글: 보이기/숨기기를 atom 불리언으로 전환
; 배우는 것: atom 불리언, when, 조건부 렌더

(island Toggle []
  (let [open (atom false)]
    (h "div" {}
      (str
        (h "button" {:style "background:#6366f1;color:white;border:none;border-radius:8px;padding:10px 18px;cursor:pointer"
                     :on-click (fn [] (swap! open (fn [v] (not v))))}
          (if @open "▲ 접기" "▼ 펼치기"))
        (if @open
          (h "div" {:style "margin-top:14px;background:#f9fafb;border-radius:8px;padding:16px;color:#374151;line-height:1.7"}
            "숨겨져 있던 내용입니다. 버튼을 다시 누르면 사라집니다. 상태는 atom 하나로 관리됩니다.")
          "")))))

(defn render [req]
  (layout-html "07 · 토글"
    (str
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "토글")
          (h "p" {:style "color:#6b7280;margin:0 0 24px"} "불리언 atom 으로 보이기/숨기기를 전환합니다.")
          "ISLAND_PLACEHOLDER"
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      "ISLAND_SCRIPTS")
    req))
