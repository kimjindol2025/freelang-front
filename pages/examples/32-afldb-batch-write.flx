; @contract
; route: /examples/32-afldb-batch-write
; purpose: afl-db-batch-write-demo
; type: page
; pattern: API_MUTATION
; routes:
;   read: GET /api/afldb
;   write: POST /examples/32-afldb-batch-write
; state:
;   source: server
;   mutable: true
; requires:
;   auth: none
; checks:
;   syntax: PASS
;   route: PASS
;   schema: PASS
;   smoke: PASS
; last_verified:
;   commit: f0e4a02
; @endcontract

; pages/examples/32-afldb-batch-write.flx
; 예제 32 — afl-db 배치 쓰기: item + index 를 1회 batch-put 으로 기록
; 배우는 것: afldb-batch-put, afldb-batch-get, 실제 데이터 경로, POST 후 redirect

(define batch_demo_ns "examples-batch-write")

(defn batch-demo-index-key []
  (str "fl:" batch_demo_ns ":index"))

(defn batch-demo-item-key [id]
  (str "fl:" batch_demo_ns ":item:" id))

(defn batch-demo-ids []
  (afldb-index-get (batch-demo-index-key)))

(defn batch-demo-rows []
  (let [ids (batch-demo-ids)
        keys (map (fn [id] (batch-demo-item-key id)) ids)
        rows (afldb-batch-get keys)]
    (if (= rows nil)
      []
      (filter (fn [row] (not (= row nil))) rows))))

(defn batch-demo-add [title body]
  (let [id (str (now-ms))
        updated (now-ms)
        item {"id" id "title" title "body" body "updated" updated}
        index-key (batch-demo-index-key)
        item-key (batch-demo-item-key id)
        ids (afldb-index-get index-key)
        sid (str id)
        exists (filter (fn [x] (= (str x) sid)) ids)
        next-ids (if (> (length exists) 0) ids (push ids sid))]
    (afldb-batch-put [{"key" item-key "value" item}
                      {"key" index-key "value" next-ids}])
    item))

(defn batch-demo-card [row]
  (let [id (get row "id")
        title (get row "title")
        body (get row "body")
        updated (get row "updated")]
    (h "div" {:style "background:white;border:1px solid #e5e7eb;border-radius:14px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.06)"}
      (str
        (h "div" {:style "display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px"}
          (str
            (h "div" {:style "font-weight:800;font-size:1rem;line-height:1.35"} title)
            (h "span" {:style "display:inline-block;margin-top:6px;font-size:.72rem;font-weight:700;color:#6366f1;background:#eef2ff;border-radius:999px;padding:3px 8px"}
              (str "id " id))))
        (h "p" {:style "margin:0;color:#4b5563;line-height:1.7;white-space:pre-wrap"} body)
        (h "p" {:style "margin:12px 0 0;color:#9ca3af;font-size:.75rem"} (str "updated " updated)))))

(defn render [req]
  (let [rows (batch-demo-rows)
        count (length rows)]
    (layout-html "32 · afl-db 배치 쓰기"
      (h "div" {:style "max-width:980px;margin:0 auto;padding:40px 24px"}
        (str
          (h "div" {:style "display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;align-items:flex-end;margin-bottom:24px"}
            (str
              (h "div" {}
                (str
                  (h "p" {:style "margin:0 0 8px;color:#6366f1;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase"} "example 32")
                  (h "h1" {:style "font-size:2rem;line-height:1.1;margin:0 0 8px"} "afl-db 배치 쓰기")
                  (h "p" {:style "margin:0;color:#6b7280;line-height:1.7;max-width:680px"}
                    "item 1개와 index 1개를 한 번의 batch-put으로 같이 기록합니다. 실제 데이터는 afl-db에 저장되고, 목록은 batch-get으로 다시 읽습니다.")))
              (h "div" {:style "display:flex;gap:10px;flex-wrap:wrap"}
                (str
                  (h "a" {:href "/api/afldb" :data-spa "1"
                          :style "display:inline-block;padding:10px 14px;border-radius:10px;background:#6366f1;color:white;text-decoration:none;font-weight:700"}
                    "afl-db JSON")
                  (h "a" {:href "/examples" :data-spa "1"
                          :style "display:inline-block;padding:10px 14px;border-radius:10px;border:1px solid #d1d5db;color:#374151;text-decoration:none;font-weight:700"}
                    "예제 갤러리")))))

          (h "div" {:style "display:grid;grid-template-columns:1.15fr .85fr;gap:18px;align-items:start"}
            (str
              (h "section" {:style "background:white;border:1px solid #e5e7eb;border-radius:18px;padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.06)"}
                (str
                  (h "div" {:style "display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px"}
                    (str
                      (h "div" {}
                        (str
                          (h "h2" {:style "margin:0 0 6px;font-size:1.15rem"} "새 항목 추가")
                          (h "p" {:style "margin:0;color:#6b7280;font-size:.9rem"} "POST 후 redirect로 재전송을 막습니다.")))
                      (h "span" {:style "display:inline-block;padding:6px 10px;border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.72rem;font-weight:800"} "batch-put")))
                  (h "form" {:method "post" :action "/examples/32-afldb-batch-write" :style "display:grid;gap:12px"}
                    (str
                      (h "input" {:name "title" :placeholder "제목"
                                  :style "padding:12px 14px;border:1px solid #d1d5db;border-radius:10px;font-size:1rem"})
                      (h "textarea" {:name "body" :placeholder "본문"
                                     :rows "5"
                                     :style "padding:12px 14px;border:1px solid #d1d5db;border-radius:10px;font-size:1rem;resize:vertical;line-height:1.6"})
                      (h "button" {:type "submit"
                                   :style "padding:12px 16px;border:none;border-radius:10px;background:#111827;color:white;font-weight:800;cursor:pointer"}
                        "배치 저장")))
                  (h "div" {:style "margin-top:18px;padding-top:16px;border-top:1px solid #e5e7eb;color:#6b7280;font-size:.9rem;line-height:1.7"}
                    "저장 흐름: index 읽기 1회 + item/index 동시 batch-put 1회. 목록은 batch-get으로 다시 읽습니다.")))

              (h "aside" {:style "display:grid;gap:14px"}
                (str
                  (h "div" {:style "background:#0f172a;color:#e2e8f0;border-radius:18px;padding:20px;box-shadow:0 12px 24px rgba(15,23,42,.18)"}
                    (str
                      (h "div" {:style "font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#93c5fd;margin-bottom:10px"} "현재 상태")
                      (h "div" {:style "font-size:2rem;font-weight:900;line-height:1"} (str count))
                      (h "p" {:style "margin:10px 0 0;color:#94a3b8;line-height:1.7"}
                        "이 페이지는 가짜 데이터를 보여주지 않고, 실시간 afl-db 값을 그대로 읽습니다.")))
                  (h "div" {:style "background:white;border:1px solid #e5e7eb;border-radius:18px;padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.06)"}
                    (str
                      (h "h2" {:style "margin:0 0 10px;font-size:1.05rem"} "읽기 경로")
                      (h "ul" {:style "margin:0;padding-left:18px;color:#6b7280;line-height:1.8"}
                        (str
                          (h "li" {} "index: `afldb-index-get`")
                          (h "li" {} "item: `afldb-batch-get`")
                          (h "li" {} "write: `afldb-batch-put`"))))))))

          (h "section" {:style "margin-top:26px"}
            (str
              (h "div" {:style "display:flex;justify-content:space-between;gap:12px;align-items:baseline;margin-bottom:14px"}
                (str
                  (h "h2" {:style "margin:0;font-size:1.2rem"} "저장된 항목")
                  (h "p" {:style "margin:0;color:#6b7280;font-size:.9rem"} (str "총 " count "개"))))
              (if (= count 0)
                (h "div" {:style "background:#f9fafb;border:1px dashed #d1d5db;border-radius:16px;padding:32px;text-align:center;color:#6b7280"}
                  "아직 항목이 없습니다. 위 폼으로 하나 추가해 보세요.")
                (h "div" {:style "display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px"}
                  (arr-join (map batch-demo-card rows) "")))))
          (h "div" {:style "margin-top:24px;color:#9ca3af;font-size:.8rem;line-height:1.6"}
            "정본: FRONT-LANG.md · 문서 기준: ROADMAP P3/P4와 실제 데이터 흐름을 유지합니다."))))
      req)))

(defn render_post [req]
  (let [payload (form-data req)
        title (str-trim (str (get payload "title")))
        body (str-trim (str (get payload "body")))]
    (if (or (= title "") (= body ""))
      (server-redirect "/examples/32-afldb-batch-write?error=1")
      (do
        (batch-demo-add title body)
        (server-redirect "/examples/32-afldb-batch-write?created=1")))))
)