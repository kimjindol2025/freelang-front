; pages/examples/20-password-strength.flx
; 예제 20 — 비밀번호 강도: 길이·구성 규칙을 비교/interop 로 평가
; 배우는 것: length, 비교, 문자열 interop (.match), 조건 분기

(island Password []
  (let [pw     (atom "")
        len    (length @pw)
        hasNum (not= (.match @pw "[0-9]") nil)
        hasUp  (not= (.match @pw "[A-Z]") nil)
        score  (+ (if (>= len 8) 1 0) (if hasNum 1 0) (if hasUp 1 0))
        label  (if (= len 0) "비밀번호를 입력하세요"
                 (if (<= score 1) "약함"
                   (if (= score 2) "보통" "강함")))
        color  (if (<= score 1) "#ef4444" (if (= score 2) "#f59e0b" "#10b981"))]
    (h "div" {}
      (str
        (h "input" {:type "password" :value @pw :placeholder "비밀번호 입력"
                    :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:1rem;margin-bottom:12px"
                    :on-input (fn [e] (reset! pw (.-value (.-target e))))})
        (h "div" {:style "display:flex;gap:4px;margin-bottom:8px"}
          (map
            (fn [n]
              (h "div" {:style (str "flex:1;height:6px;border-radius:99px;background:" (if (>= score n) color "#e5e7eb"))} ""))
            [1 2 3]))
        (h "p" {:style (str "font-size:.9rem;font-weight:600;margin:0;color:" (if (= len 0) "#9ca3af" color))} label)))))

(defn render [req]
  (layout-html "20 · 비밀번호 강도"
    (str
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "비밀번호 강도")
          (h "p" {:style "color:#6b7280;margin:0 0 24px"} "길이·숫자·대문자 규칙을 점수화하여 강도를 실시간 표시합니다.")
          "ISLAND_PLACEHOLDER"
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      "ISLAND_SCRIPTS")
    req))
