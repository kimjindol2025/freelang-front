; FL-Front 데모 페이지 (class 기반 — CSP nonce 자동 적용)

(defn render [req]
  (let [fruits   ["🍎 사과" "🍌 바나나" "🍒 체리" "🍓 딸기" "🥝 키위"]
        scores   [{"label" "1월" "value" 65}
                  {"label" "2월" "value" 80}
                  {"label" "3월" "value" 55}
                  {"label" "4월" "value" 90}
                  {"label" "5월" "value" 72}]

        fruit-rows (map-indexed
                     (fn [i item]
                       (str
                         "<div class='fruit-row'>"
                         "<span class='fruit-idx'>" i "</span>"
                         "<span>" item "</span>"
                         "</div>"))
                     fruits)

        bar-rows (map (fn [d]
                        (let [pct   (round (* 100 (/ (get d "value") 100)))
                              color (if (>= (get d "value") 80) "bar-green"
                                      (if (>= (get d "value") 60) "bar-blue" "bar-amber"))]
                          (str
                            "<div class='bar-row'>"
                            "<div class='bar-label'>"
                            "<span>" (get d "label") "</span>"
                            "<span class='" color "'>" (get d "value") "점</span>"
                            "</div>"
                            "<div class='bar-track'>"
                            "<div class='bar-fill " color "' style='width:" pct "%'></div>"
                            "</div>"
                            "</div>")))
                      scores)

        long-text "FreeLang v11은 AI가 쓰기 위해 설계된 언어입니다. 함수형 패러다임 + 서버 내장."
        preview   (str (str-slice long-text 0 30) "...")

        total     (reduce + 0 (map (fn [d] (get d "value")) scores))
        avg       (round (/ total (length scores)))]

    (server_html
      (str
        "<!DOCTYPE html><html lang='ko'><head>"
        "<meta charset='utf-8'>"
        "<meta name='viewport' content='width=device-width,initial-scale=1'>"
        "<title>FL-Front 데모</title>"
        "<style>"
        "*{box-sizing:border-box;margin:0;padding:0}"
        "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f9fafb;color:#111}"

        ".hero{background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 100%);padding:50px 40px;text-align:center;color:white}"
        ".hero-badge{font-size:.82rem;background:rgba(255,255,255,.18);display:inline-block;padding:4px 14px;border-radius:99px;margin-bottom:16px}"
        ".hero h1{font-size:2rem;font-weight:800;margin-bottom:8px}"
        ".hero p{opacity:.85;font-size:1rem}"

        ".main{max-width:960px;margin:0 auto;padding:36px 20px}"

        ".stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}"
        ".stat-card{background:white;border-radius:12px;padding:24px;box-shadow:0 1px 3px rgba(0,0,0,.08)}"
        ".stat-num{font-size:2rem;font-weight:800}"
        ".stat-num.purple{color:#6366f1}"
        ".stat-num.violet{color:#8b5cf6}"
        ".stat-num.pink{color:#ec4899}"
        ".stat-label{color:#9ca3af;font-size:.82rem;margin-top:4px}"

        ".two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}"
        ".card{background:white;border-radius:12px;padding:24px;box-shadow:0 1px 3px rgba(0,0,0,.08)}"
        ".card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}"
        ".card-header h3{font-size:1rem;font-weight:700}"

        ".tag{display:inline-block;padding:3px 10px;border-radius:99px;font-size:.72rem;font-weight:700}"
        ".tag.purple{background:#ede9fe;color:#7c3aed}"
        ".tag.green{background:#dcfce7;color:#16a34a}"
        ".tag.amber{background:#fef3c7;color:#d97706}"

        ".fruit-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f3f4f6}"
        ".fruit-row:last-child{border-bottom:none}"
        ".fruit-idx{width:28px;height:28px;background:#ede9fe;color:#7c3aed;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;flex-shrink:0}"

        ".bar-row{margin-bottom:14px}"
        ".bar-label{display:flex;justify-content:space-between;margin-bottom:5px;font-size:.88rem}"
        ".bar-track{height:10px;background:#f3f4f6;border-radius:99px;overflow:hidden}"
        ".bar-fill{height:100%;border-radius:99px;transition:width .4s ease}"
        ".bar-green,.bar-green{color:#16a34a} .bar-fill.bar-green{background:#16a34a}"
        ".bar-blue{color:#6366f1}  .bar-fill.bar-blue{background:#6366f1}"
        ".bar-amber{color:#f59e0b} .bar-fill.bar-amber{background:#f59e0b}"

        ".slice-box{background:#f9fafb;border-radius:8px;padding:14px 16px;font-size:.9rem;margin-bottom:10px}"
        ".slice-result{background:#ede9fe;border-radius:8px;padding:14px 16px;font-size:.9rem;color:#6d28d9}"
        ".slice-hint{margin-top:10px;font-size:.78rem;color:#9ca3af}"

        ".footer{text-align:center;margin-top:32px;color:#9ca3af;font-size:.85rem}"
        ".footer a{color:#6366f1}"
        "</style></head><body>"

        ; 히어로
        "<div class='hero'>"
        "<div class='hero-badge'>FL-Front · FreeLang v11</div>"
        "<h1>주입 헬퍼 데모</h1>"
        "<p>round · str-slice · map-indexed 실제 작동 확인</p>"
        "</div>"

        "<div class='main'>"

        ; 통계 카드
        "<div class='stat-grid'>"
        "<div class='stat-card'><div class='stat-num purple'>" avg "점</div><div class='stat-label'>평균 점수 (round)</div></div>"
        "<div class='stat-card'><div class='stat-num violet'>" (length fruits) "개</div><div class='stat-label'>과일 (map-indexed)</div></div>"
        "<div class='stat-card'><div class='stat-num pink'>30자</div><div class='stat-label'>미리보기 (str-slice)</div></div>"
        "</div>"

        ; 2열
        "<div class='two-col'>"

        ; 과일 목록
        "<div class='card'>"
        "<div class='card-header'><h3>🍎 과일 목록</h3><span class='tag purple'>map-indexed</span></div>"
        (arr-join fruit-rows "")
        "</div>"

        ; 점수 바
        "<div class='card'>"
        "<div class='card-header'><h3>📊 월별 점수</h3><span class='tag green'>round</span></div>"
        (arr-join bar-rows "")
        "</div>"

        "</div>"

        ; str-slice
        "<div class='card'>"
        "<div class='card-header'><h3>✂️ str-slice 미리보기</h3><span class='tag amber'>str-slice</span></div>"
        "<div class='slice-box'>원본: <strong>" long-text "</strong></div>"
        "<div class='slice-result'>str-slice(0, 30): <strong>" preview "</strong></div>"
        "<div class='slice-hint'>(str-slice text 0 30) → 앞 30자 추출</div>"
        "</div>"

        "<div class='footer'>FL-Front · <a href='/test-helpers'>헬퍼 검증</a> · <a href='/'>홈</a></div>"
        "</div>"
        "</body></html>"))))
