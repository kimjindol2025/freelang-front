; FL-Front 모던 CSS 데모
; Scroll Animations + View Transitions + Anchor Positioning

(defn render [req]
  (let [fruits  ["🍎 사과" "🍌 바나나" "🍒 체리" "🍓 딸기" "🥝 키위" "🍊 오렌지"]
        scores  [{"label" "1월" "value" 65}
                 {"label" "2월" "value" 80}
                 {"label" "3월" "value" 55}
                 {"label" "4월" "value" 90}
                 {"label" "5월" "value" 72}]

        fruit-rows (map-indexed
                     (fn [i item]
                       (str "<div class='fruit-row'>"
                            "<span class='fruit-idx'>" i "</span>"
                            "<span>" item "</span>"
                            "</div>"))
                     fruits)

        bar-rows (map (fn [d]
                        (let [pct   (round (* 100 (/ (get d "value") 100)))
                              color (if (>= (get d "value") 80) "bar-green"
                                      (if (>= (get d "value") 60) "bar-blue" "bar-amber"))]
                          (str "<div class='bar-row'>"
                               "<div class='bar-label'>"
                               "<span>" (get d "label") "</span>"
                               "<span class='" color "'>" (get d "value") "점</span>"
                               "</div>"
                               "<div class='bar-track'>"
                               "<div class='bar-fill " color "' style='width:" pct "%'></div>"
                               "</div></div>")))
                      scores)

        long-text "FreeLang v11은 AI가 쓰기 위해 설계된 언어입니다. 함수형 패러다임과 서버 내장."
        preview   (str (str-slice long-text 0 30) "...")]

    (server_html
      (str
        "<!DOCTYPE html><html lang='ko'><head>"
        "<meta charset='utf-8'>"
        "<meta name='viewport' content='width=device-width,initial-scale=1'>"
        "<title>모던 CSS 데모</title>"
        "<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f4f6fb;color:#1a1d23;min-height:100dvh}

/* ── 히어로 ── */
.hero{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;padding:60px 24px;text-align:center;view-transition-name:hero}
.hero h1{font-size:2.2rem;font-weight:800;margin-bottom:10px;text-wrap:balance}
.hero p{opacity:.85;font-size:1rem;text-wrap:pretty}
.hero-badge{display:inline-block;background:rgba(255,255,255,.18);padding:4px 14px;border-radius:99px;font-size:.82rem;margin-bottom:16px}

/* ── 메인 ── */
.page{max-width:960px;margin:0 auto;padding:48px 20px}
.section-title{font-size:1.2rem;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.section-label{background:#ede9fe;color:#7c3aed;padding:3px 10px;border-radius:99px;font-size:.72rem;font-weight:700}

/* ── Scroll Animations ── */
@keyframes fade-in-up{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fade-in-left{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:translateX(0)}}
@keyframes scale-in{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
.s-fade{animation:fade-in-up linear both;animation-timeline:view();animation-range:entry 0% entry 35%}
.s-left{animation:fade-in-left linear both;animation-timeline:view();animation-range:entry 0% entry 35%}
.s-scale{animation:scale-in linear both;animation-timeline:view();animation-range:entry 0% entry 28%}

/* ── View Transitions ── */
@view-transition{navigation:auto}
::view-transition-old(root){animation:.25s ease both vt-out}
::view-transition-new(root){animation:.3s ease both vt-in}
@keyframes vt-out{to{opacity:0;transform:scale(.97) translateY(-8px)}}
@keyframes vt-in{from{opacity:0;transform:scale(.97) translateY(8px)}}

/* ── Anchor Positioning ── */
.tooltip-wrap{position:relative;display:inline-block}
.tooltip-btn{
  anchor-name:--tip;
  background:#6366f1;color:white;border:none;padding:8px 18px;
  border-radius:8px;font:inherit;font-weight:600;cursor:pointer;
  transition:background .15s;
}
.tooltip-btn:hover{background:#4f46e5}
.tooltip{
  position:absolute;
  position-anchor:--tip;
  top:anchor(bottom);
  left:anchor(center);
  translate:-50% 10px;
  background:#1e2433;color:#e2e8f0;
  font-size:.78rem;padding:8px 14px;border-radius:8px;
  white-space:nowrap;pointer-events:none;
  opacity:0;transform:translateY(-4px);
  transition:opacity .18s,transform .2s cubic-bezier(0,0,.2,1);
  box-shadow:0 4px 20px rgba(0,0,0,.3);z-index:99;
}
.tooltip-wrap:has(.tooltip-btn:hover) .tooltip{opacity:1;transform:translateY(0)}

/* ── 카드/컴포넌트 ── */
.card{background:white;border-radius:12px;padding:24px;box-shadow:0 1px 4px rgba(0,0,0,.08);border:1px solid #e8ecf0;margin-bottom:16px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
.fruit-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f3f4f6}
.fruit-row:last-child{border-bottom:none}
.fruit-idx{width:26px;height:26px;background:#ede9fe;color:#7c3aed;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:700;flex-shrink:0}
.bar-row{margin-bottom:14px}
.bar-label{display:flex;justify-content:space-between;margin-bottom:5px;font-size:.88rem}
.bar-track{height:10px;background:#f3f4f6;border-radius:99px;overflow:hidden}
.bar-fill{height:100%;border-radius:99px;transition:width .5s cubic-bezier(0,0,.2,1)}
.bar-green{color:#16a34a} .bar-fill.bar-green{background:#16a34a}
.bar-blue{color:#6366f1}  .bar-fill.bar-blue{background:#6366f1}
.bar-amber{color:#f59e0b} .bar-fill.bar-amber{background:#f59e0b}
.nav-link{display:inline-block;padding:8px 18px;border-radius:8px;background:#f3f4f6;color:#374151;text-decoration:none;font-weight:600;margin-right:8px;transition:all .2s}
.nav-link:hover{background:#ede9fe;color:#7c3aed}
.footer{text-align:center;margin-top:48px;color:#9ca3af;font-size:.85rem}
.footer a{color:#6366f1}
</style></head><body>"

        ; ── 히어로 ──
        "<div class='hero'>"
        "<div class='hero-badge'>FL-Front · 모던 CSS 3종</div>"
        "<h1>Scroll · Transition · Anchor</h1>"
        "<p>스크롤 애니메이션 · 페이지 전환 · 앵커 포지셔닝</p>"
        "</div>"

        "<div class='page'>"

        ; ── 1. Scroll Animations ──
        "<div class='section-title s-fade'>🌀 Scroll-driven Animations <span class='section-label'>animation-timeline: view()</span></div>"
        "<div class='two-col'>"
        "<div class='card s-left'>"
        "<div style='font-weight:700;margin-bottom:14px'>🍎 과일 목록</div>"
        (arr-join fruit-rows "")
        "</div>"
        "<div class='card s-fade'>"
        "<div style='font-weight:700;margin-bottom:14px'>📊 월별 점수</div>"
        (arr-join bar-rows "")
        "</div>"
        "</div>"

        ; ── 2. View Transitions ──
        "<div class='section-title s-fade'>🎬 View Transitions <span class='section-label'>startViewTransition()</span></div>"
        "<div class='card s-scale'>"
        "<p style='margin-bottom:16px;color:#6b7280'>페이지 이동 시 자연스러운 전환 효과. 아래 링크를 클릭하면 슬라이드 인/아웃 애니메이션이 적용됩니다.</p>"
        "<a class='nav-link' href='/test-helpers' data-spa='1'>🧪 헬퍼 검증 페이지로 이동</a>"
        "<a class='nav-link' href='/' data-spa='1'>🏠 홈으로 이동</a>"
        "<p style='margin-top:14px;font-size:.82rem;color:#9ca3af'>Chrome 111+ 지원 · SPA 라우터에 startViewTransition() 적용됨</p>"
        "</div>"

        ; ── 3. Anchor Positioning ──
        "<div class='section-title s-fade'>📌 Anchor Positioning <span class='section-label'>position-anchor</span></div>"
        "<div class='card s-scale'>"
        "<p style='margin-bottom:20px;color:#6b7280'>버튼 위에 마우스를 올리면 버튼 기준으로 정확히 위치한 툴팁이 나타납니다. JS 없음.</p>"
        "<div style='display:flex;gap:16px;flex-wrap:wrap'>"
        "<div class='tooltip-wrap'>"
        "<button class='tooltip-btn'>저장하기</button>"
        "<div class='tooltip'>💾 Ctrl+S로도 저장할 수 있어요</div>"
        "</div>"
        "<div class='tooltip-wrap'>"
        "<button class='tooltip-btn' style='background:#16a34a'>발행하기</button>"
        "<div class='tooltip'>🚀 전체 공개로 발행됩니다</div>"
        "</div>"
        "<div class='tooltip-wrap'>"
        "<button class='tooltip-btn' style='background:#dc2626'>삭제하기</button>"
        "<div class='tooltip'>⚠️ 삭제 후 복구가 불가능합니다</div>"
        "</div>"
        "</div>"
        "<p style='margin-top:14px;font-size:.82rem;color:#9ca3af'>Chrome 125+ 지원 · :has(.tooltip-btn:hover) 로 CSS만으로 제어</p>"
        "</div>"

        ; ── str-slice 데모 ──
        "<div class='section-title s-left'>✂️ str-slice + round + map-indexed <span class='section-label'>헬퍼 검증</span></div>"
        "<div class='card s-fade'>"
        "<div style='background:#f9fafb;border-radius:8px;padding:14px;margin-bottom:10px'>원본: <strong>" long-text "</strong></div>"
        "<div style='background:#ede9fe;border-radius:8px;padding:14px;color:#6d28d9'>str-slice(0,30): <strong>" preview "</strong></div>"
        "</div>"

        "<div class='footer'>FL-Front · <a href='/test-helpers'>헬퍼 검증</a> · <a href='/'>홈</a></div>"
        "</div>"

        "</body></html>"))))
