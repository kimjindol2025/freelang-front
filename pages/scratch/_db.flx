; pages/scratch/_db.flx — Scratch 도메인 (저장은 _afldb-coll)
; ns: scratch

(define scratch_ns "scratch")

(defn scratch-all []
  (front-collection-all scratch_ns))

(defn scratch-get [id]
  (front-collection-get scratch_ns id))

(defn scratch-add [title body]
  (front-collection-create scratch_ns {"title" title "body" body}))

(defn scratch-update [id title body]
  (front-collection-update scratch_ns id {"title" title "body" body}))

(defn scratch-delete [id]
  (front-collection-delete scratch_ns id))

(defn scratch-history [id]
  (front-collection-history scratch_ns id))

; 하위 호환 — events 등에서 쓰던 이름
(define scratch_index_key (front-collection-index-key scratch_ns))

(defn scratch-item-key [id]
  (front-collection-item-key scratch_ns id))
