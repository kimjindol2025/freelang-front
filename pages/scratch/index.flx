; pages/scratch/index.flx — afl-db 스크래치 메모 (A)

(island ScratchApp []
  (let [items (atom nil)
        title (atom "")
        body  (atom "")
        err   (atom "")
        hist  (atom nil)
        hist-id (atom "")

        reload (fn [res]
                 (reset! items (get res "items"))
                 (reset! err "")
                 (reset! title "")
                 (reset! body ""))

        load (fn []
               (fetch! "/scratch/api"
                 (fn [res] (reset! items (get res "items")))))

        add (fn []
              (if (and (= (str-trim @title) "") (= (str-trim @body) ""))
                (reset! err "제목 또는 내용을 입력하세요")
                (fetch-post! "/scratch/api"
                  {"action" "add" "title" @title "body" @body}
                  reload)))

        del (fn [id]
              (fetch-post! "/scratch/api"
                {"action" "delete" "id" id}
                reload))

        show-hist (fn [id]
                    (reset! hist-id id)
                    (fetch-post! "/scratch/api"
                      {"action" "history" "id" id}
                      (fn [res] (reset! hist (get res "events")))))]

    (fetch! "/scratch/api" (fn [res] (reset! items (get res "items"))))
    (h "div" {:class "afldb-app"}
      (str
        (h "div" {:class "afldb-form"}
          (str
            (h "input" {:class "afldb-input" :placeholder "제목"
                        :value @title
                        :on-input (fn [e] (reset! title (.-value (.-target e))))})
            (h "textarea" {:class "afldb-area" :placeholder "내용"
                           :value @body
                           :on-input (fn [e] (reset! body (.-value (.-target e))))})
            (h "button" {:class "afldb-btn" :on-click (fn [] (add))} "저장")
            (if (= @err "") "" (h "p" {:class "afldb-err"} @err))))
        (if (= @items nil)
          (h "p" {:class "afldb-muted"} "불러오는 중…")
          (if (= (length @items) 0)
            (h "p" {:class "afldb-muted"} "아직 메모가 없습니다. afl-db에 첫 스크래치를 남겨보세요.")
            (h "div" {:class "afldb-list"}
              (map
                (fn [it]
                  (h "div" {:class "afldb-item"}
                    (str
                      (h "div" {:class "afldb-item-top"}
                        (str
                          (h "strong" {} (or (get it "title") "untitled"))
                          (h "span" {:class "afldb-muted"} (str (get it "id")))))
                      (h "p" {} (or (get it "body") ""))
                      (h "div" {:class "afldb-actions"}
                        (str
                          (h "button" {:class "afldb-link" :on-click (fn [] (show-hist (get it "id")))} "history")
                          (h "button" {:class "afldb-danger" :on-click (fn [] (del (get it "id")))} "삭제"))))))
                @items))))
        (if (= @hist nil)
          ""
          (h "div" {:class "afldb-hist"}
            (str
              (h "h3" {} (str "history · " @hist-id))
              (h "pre" {:class "afldb-pre"} (json-stringify @hist))
              (h "button" {:class "afldb-link" :on-click (fn [] (reset! hist nil))} "닫기"))))))))

(defn render [req]
  (layout-html "Scratch · afl-db"
    (str
      """
<style>
.afldb-wrap{max-width:720px;margin:0 auto;padding:36px 20px 80px}
.afldb-wrap h1{font-size:1.7rem;margin:0 0 6px}
.afldb-lead{color:#64748b;margin:0 0 22px;line-height:1.5}
.afldb-app{display:flex;flex-direction:column;gap:18px}
.afldb-form{display:flex;flex-direction:column;gap:10px;padding:16px;border:1px solid #e2e8f0;border-radius:12px;background:#f8fafc}
.afldb-input,.afldb-area{width:100%;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px;font:inherit}
.afldb-area{min-height:96px;resize:vertical}
.afldb-btn{align-self:flex-start;background:#0f766e;color:#fff;border:none;border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600}
.afldb-list{display:flex;flex-direction:column;gap:10px}
.afldb-item{padding:14px 16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}
.afldb-item-top{display:flex;justify-content:space-between;gap:12px;margin-bottom:6px}
.afldb-actions{display:flex;gap:10px;margin-top:10px}
.afldb-link,.afldb-danger{background:none;border:none;cursor:pointer;padding:0;font:inherit}
.afldb-link{color:#0f766e}
.afldb-danger{color:#dc2626}
.afldb-muted{color:#94a3b8;font-size:.85rem}
.afldb-err{color:#dc2626;margin:0}
.afldb-hist{padding:14px;border-radius:12px;background:#0f172a;color:#e2e8f0}
.afldb-pre{white-space:pre-wrap;word-break:break-word;font-size:.8rem}
.afldb-nav{display:flex;gap:14px;margin-top:28px;flex-wrap:wrap}
.afldb-nav a{color:#0f766e;text-decoration:none}
</style>
<div class="afldb-wrap">
  <h1>Scratch</h1>
  <p class="afldb-lead">afl-db append-only KV에 남기는 스크래치 메모. 저장·삭제·키 history까지.</p>
  ISLAND_PLACEHOLDER
  <div class="afldb-nav">
    <a href="/events" data-spa="1">이벤트 뷰어 →</a>
    <a href="/notes-afldb" data-spa="1">Notes (afl-db) →</a>
    <a href="/check" data-spa="1">/check</a>
    <a href="/" data-spa="1">홈</a>
  </div>
</div>
"""
      "ISLAND_SCRIPTS")
    req))
