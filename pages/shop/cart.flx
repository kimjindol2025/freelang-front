; pages/shop/cart.flx — 장바구니 (Island 상태 관리)
; GET /shop/cart

(defn SHOP_API [] "http://localhost:40081")

(island ShopCart []
  (let [user-id (atom 1)
        items   (atom [])
        loading (atom false)
        msg     (atom "")]

    (defn load-cart []
      (reset! loading true)
      (fetch! (str (SHOP_API) "/api/cart/" (deref user-id))
        (fn [res]
          (reset! loading false)
          (when (get res "ok")
            (reset! items (?? (get (get res "data") "items") []))))))

    (defn remove-item [id]
      (fetch-delete! (str (SHOP_API) "/api/cart/" id)
        (fn [_] (load-cart))))

    (defn place-order []
      (fetch-post! (str (SHOP_API) "/api/orders")
        {:user_id (deref user-id)}
        (fn [res]
          (if (get res "ok")
            (do
              (reset! msg (str "✅ 주문 완료! 주문번호: " (get (get res "data") "order_id")))
              (reset! items []))
            (reset! msg (str "❌ " (get res "error")))))))

    (load-cart)

    (h "div" {"style" "max-width:680px;margin:0 auto"}
      (h "div" {"style" "display:flex;align-items:center;gap:8px;margin-bottom:20px"}
        (h "label" {"style" "font-size:.875rem;color:#6b7280"} "회원 ID:")
        (h "input"
          {"type" "number" "value" (str (deref user-id))
           "style" "width:80px;padding:6px 10px;border:1px solid #e5e7eb;border-radius:6px;font-size:.875rem"
           "on-change" (fn [e]
             (let [v (str-to-num (get-in e ["target" "value"]))]
               (when (not (nil? v))
                 (reset! user-id v)
                 (load-cart))))})
        (h "button"
          {"style" "background:#6366f1;color:#fff;border:none;border-radius:6px;padding:6px 14px;font-size:.875rem;cursor:pointer"
           "on-click" (fn [] (load-cart))}
          "조회"))

      (if (deref loading)
        (h "p" {"style" "color:#9ca3af;padding:40px;text-align:center"} "로딩 중...")
        (if (empty? (deref items))
          (h "div" {"style" "text-align:center;padding:60px;color:#9ca3af"}
            (h "p" {"style" "font-size:3rem;margin-bottom:12px"} "🛒")
            (h "p" {} "장바구니가 비어 있습니다"))
          (h "div" {}
            (str-join
              (map (fn [item]
                (h "div"
                  {"style" "display:flex;align-items:center;gap:14px;padding:16px;background:#fff;border-radius:10px;margin-bottom:10px;box-shadow:0 1px 3px rgba(0,0,0,.06)"}
                  (h "div" {"style" "font-size:2rem;width:48px;text-align:center"}
                    (cond
                      (= (get item "category") "전자제품") "📱"
                      (= (get item "category") "의류")     "👕"
                      (= (get item "category") "식품")     "🍱"
                      true                                 "🛍"))
                  (h "div" {"style" "flex:1"}
                    (h "p" {"style" "font-weight:600;color:#111827;font-size:.9rem"} (get item "name"))
                    (h "p" {"style" "color:#6b7280;font-size:.8rem;margin-top:2px"}
                      (str "₩" (get item "price") " × " (get item "qty") "개")))
                  (h "p" {"style" "font-weight:700;color:#111827;font-size:.95rem;min-width:80px;text-align:right"}
                    (str "₩" (get item "subtotal")))
                  (h "button"
                    {"style" "background:none;border:1px solid #fca5a5;color:#ef4444;border-radius:6px;padding:4px 10px;font-size:.8rem;cursor:pointer"
                     "on-click" (fn [] (remove-item (get item "id")))}
                    "삭제")))
              (deref items)))
            (h "div"
              {"style" "background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:16px 20px;margin-top:16px;display:flex;justify-content:space-between;align-items:center"}
              (h "div" {}
                (h "p" {"style" "color:#6b7280;font-size:.85rem"} (str (length (deref items)) "종 상품"))
                (h "p" {"style" "font-size:1.2rem;font-weight:700;color:#111827"}
                  (str "합계: ₩"
                       (reduce (fn [acc r] (+ acc (get r "subtotal"))) 0 (deref items)))))
              (h "button"
                {"style" "background:#10b981;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-weight:700;font-size:.95rem;cursor:pointer"
                 "on-click" (fn [] (place-order))}
                "주문하기")))))

      (when (not (or (nil? (deref msg)) (= (deref msg) "")))
        (h "div"
          {"style" "margin-top:16px;padding:14px 18px;border-radius:8px;background:#f0fdf4;border:1px solid #bbf7d0;font-weight:600;font-size:.9rem;color:#166534"}
          (deref msg))))))

(defn render [req]
  (layout-html "🛒 장바구니"
    (str
      """
<style>
body{background:#f9fafb}
.wrap{max-width:760px;margin:0 auto;padding:32px 20px}
.top-nav{margin-bottom:24px}
.top-nav a{font-size:.875rem;color:#6b7280;text-decoration:none;margin-right:16px}
.top-nav a:hover{color:#6366f1}
h1{font-size:1.5rem;font-weight:800;color:#111827;margin-bottom:24px}
</style>
"""
      (h "div" {"class" "wrap"}
        (h "div" {"class" "top-nav"}
          (h "a" {"href" "/shop"} "← 쇼핑 계속하기")
          (h "a" {"href" "/shop/orders"} "📦 주문내역"))
        (h "h1" {} "🛒 장바구니")
        "ISLAND_PLACEHOLDER"
        "ISLAND_SCRIPTS"))
    req))
