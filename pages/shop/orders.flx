; pages/shop/orders.flx — 주문 내역
; GET /shop/orders

(load "pages/shop/_shared.flx")

(defn status-badge [s]
  (let [styles {"paid"    "background:#dcfce7;color:#166534"
                "pending" "background:#fef9c3;color:#854d0e"
                "cancel"  "background:#fee2e2;color:#991b1b"}
        labels {"paid" "결제완료" "pending" "대기중" "cancel" "취소"}]
    (h "span"
      {"style" (str "font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:99px;" (?? (get styles s) "background:#f3f4f6;color:#6b7280"))}
      (?? (get labels s) s))))

(island OrderList []
  (let [user-id (atom 1)
        orders  (atom [])
        detail  (atom nil)
        loading (atom false)]

    (defn load-orders []
      (reset! loading true)
      (reset! detail nil)
      (fetch! (str (shop-api-base) "/api/orders/user/" (deref user-id))
        (fn [res]
          (reset! loading false)
          (when (get res "ok")
            (reset! orders (?? (get (get res "data") "orders") []))))))

    (defn load-detail [oid]
      (fetch! (str (shop-api-base) "/api/orders/" oid)
        (fn [res]
          (when (get res "ok")
            (reset! detail (get res "data"))))))

    (load-orders)

    (h "div" {}
      (h "div" {"style" "display:flex;align-items:center;gap:8px;margin-bottom:20px"}
        (h "label" {"style" "font-size:.875rem;color:#6b7280"} "회원 ID:")
        (h "input"
          {"type" "number" "value" (str (deref user-id))
           "style" "width:80px;padding:6px 10px;border:1px solid #e5e7eb;border-radius:6px;font-size:.875rem"
           "on-change" (fn [e]
             (let [v (str-to-num (get-in e ["target" "value"]))]
               (when (not (nil? v))
                 (reset! user-id v)
                 (load-orders))))})
        (h "button"
          {"style" "background:#6366f1;color:#fff;border:none;border-radius:6px;padding:6px 14px;font-size:.875rem;cursor:pointer"
           "on-click" (fn [] (load-orders))}
          "조회"))

      (if (deref loading)
        (h "p" {"style" "color:#9ca3af;padding:40px;text-align:center"} "로딩 중...")
        (if (empty? (deref orders))
          (h "div" {"style" "text-align:center;padding:60px;color:#9ca3af"}
            (h "p" {"style" "font-size:3rem;margin-bottom:12px"} "📦")
            (h "p" {} "주문 내역이 없습니다"))
          (h "div" {}
            (str-join
              (map (fn [o]
                (h "div"
                  {"style" "background:#fff;border-radius:10px;margin-bottom:10px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.06)"}
                  (h "div"
                    {"style" "display:flex;align-items:center;justify-content:space-between;padding:14px 18px;cursor:pointer"
                     "on-click" (fn [] (load-detail (get o "id")))}
                    (h "div" {}
                      (h "p" {"style" "font-size:.8rem;color:#9ca3af;margin-bottom:3px"}
                        (get o "created_at"))
                      (h "p" {"style" "font-weight:600;color:#111827"}
                        (str "주문 #" (get o "id"))))
                    (h "div" {"style" "display:flex;align-items:center;gap:12px"}
                      (status-badge (get o "status"))
                      (h "p" {"style" "font-weight:700;color:#111827"}
                        (str "₩" (get o "total")))
                      (h "span" {"style" "color:#9ca3af;font-size:.8rem"} "상세보기 ›")))))
              (deref orders)))

            (when (not (nil? (deref detail)))
              (h "div"
                {"style" "background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin-top:16px"}
                (h "div" {"style" "display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"}
                  (h "h3" {"style" "font-size:1rem;font-weight:700;color:#111827"}
                    (str "주문 #" (get (deref detail) "id") " 상세"))
                  (h "button"
                    {"style" "background:none;border:none;color:#9ca3af;cursor:pointer;font-size:1.2rem"
                     "on-click" (fn [] (reset! detail nil))}
                    "✕"))
                (str-join
                  (map (fn [item]
                    (h "div"
                      {"style" "display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #e5e7eb"}
                      (h "div" {}
                        (h "p" {"style" "font-weight:600;color:#111827;font-size:.88rem"} (get item "name"))
                        (h "p" {"style" "color:#6b7280;font-size:.8rem;margin-top:2px"}
                          (str "₩" (get item "unit_price") " × " (get item "qty") "개")))
                      (h "p" {"style" "font-weight:700;color:#111827"}
                        (str "₩" (get item "subtotal")))))
                  (?? (get (deref detail) "items") [])))
                (h "div"
                  {"style" "display:flex;justify-content:flex-end;margin-top:12px;padding-top:12px;border-top:2px solid #e5e7eb"}
                  (h "p" {"style" "font-size:1.1rem;font-weight:700;color:#111827"}
                    (str "합계: ₩" (get (deref detail) "total"))))))
            ))))))

(defn render [req]
  (layout-html "📦 주문내역"
    (str
      """
<style>
body{background:#f9fafb}
.wrap{max-width:760px;margin:0 auto;padding:32px 20px}
.top-nav{margin-bottom:24px}
.top-nav a{font-size:.875rem;color:#6b7280;text-decoration:none;margin-right:16px}
.top-nav a:hover{color:#6366f1}
h1{font-size:1.5rem;font-weight:800;color:#111827;margin-bottom:24px}
</style>
"""
      (h "div" {"class" "wrap"}
        (h "div" {"class" "top-nav"}
          (h "a" {"href" "/shop"} "← 쇼핑 계속하기")
          (h "a" {"href" "/shop/cart"} "🛒 장바구니"))
        (h "h1" {} "📦 주문 내역")
        "ISLAND_PLACEHOLDER"
        "ISLAND_SCRIPTS"))
    req))
