; pages/_styles.flx — SKL 다크 테마 CSS 헬퍼
; 인라인 style 문자열 반복 제거

; ── 색상 토큰 ────────────────────────────────────────────────
(define $bg     "#0d1829")
(define $panel  "#0f1d33")
(define $bdr    "#1e3050")
(define $muted  "#64748b")
(define $sub    "#94a3b8")
(define $text   "#e2e8f0")
(define $accent "#6366f1")
(define $ok     "#10b981")
(define $warn   "#f59e0b")
(define $danger "#ef4444")

; ── style 조합 함수 ──────────────────────────────────────────
(defn s [& parts]
  "여러 style 조각을 ;로 합치기
   (s (row 8) (p 12) (rounded 8))
   → 'display:flex;align-items:center;gap:8px;padding:12px;border-radius:8px'"
  (str-join (filter (fn [x] (not (= x ""))) parts) ";"))

; ── 레이아웃 ─────────────────────────────────────────────────
(defn row [gap]
  (str "display:flex;align-items:center;gap:" gap "px"))

(defn col [gap]
  (str "display:flex;flex-direction:column;gap:" gap "px"))

(defn between []
  "display:flex;align-items:center;justify-content:space-between")

(defn center []
  "display:flex;align-items:center;justify-content:center")

(defn full []
  "width:100%;height:100%")

(defn flex1 []
  "flex:1;min-width:0")

; ── 간격 ─────────────────────────────────────────────────────
(defn p [v]  (str "padding:" v "px"))
(defn px [v] (str "padding-left:" v "px;padding-right:" v "px"))
(defn py [v] (str "padding-top:" v "px;padding-bottom:" v "px"))
(defn mg [v] (str "margin:" v "px"))

; ── 크기 ─────────────────────────────────────────────────────
(defn w [v]   (str "width:" v))
(defn ht [v]  (str "height:" v))
(defn wh [v]  (str "width:" v ";height:" v))
(defn mxw [v] (str "max-width:" v))

; ── 테두리 ───────────────────────────────────────────────────
(defn rounded [r]
  (str "border-radius:" r "px"))

(defn border []
  (str "border:1px solid " $bdr))

(defn border-b []
  (str "border-bottom:1px solid " $bdr))

(defn border-r []
  (str "border-right:1px solid " $bdr))

; ── 배경/색상 ────────────────────────────────────────────────
(defn bg [c]  (str "background:" c))
(defn fg [c]  (str "color:" c))
(defn bg-panel []  (bg $panel))
(defn bg-page []   (bg $bg))

; ── 텍스트 ───────────────────────────────────────────────────
(defn fs [v]  (str "font-size:" v "px"))
(defn fw [v]  (str "font-weight:" v))
(defn truncate [] "overflow:hidden;text-overflow:ellipsis;white-space:nowrap")
(defn upper []   "text-transform:uppercase;letter-spacing:1px")
(defn mono []    "font-family:monospace")

; ── 커서/상호작용 ────────────────────────────────────────────
(defn pointer [] "cursor:pointer")
(defn none []    "display:none")
(defn abs []     "position:absolute")
(defn fixed []   "position:fixed")
(defn rel []     "position:relative")
(defn inset []   "top:0;left:0;right:0;bottom:0")
(defn ovh []     "overflow:hidden")
(defn ova []     "overflow-y:auto")

; ── 공통 컴포넌트 ────────────────────────────────────────────
(defn $card []
  (s (bg-panel) (border) (rounded 12) (p 16)))

(defn $card-hover []
  (s ($card) (pointer) "transition:border-color .15s"))

(defn $input []
  (s (w "100%") "padding:10px 12px" (bg-page) (border)
     (fg $text) (rounded 8) "font-size:13px;outline:none"))

(defn $textarea []
  (s ($input) "resize:vertical;min-height:120px;line-height:1.7"))

(defn $btn-primary []
  (s "padding:9px 18px" (bg $accent) (fg "white")
     "border:none" (rounded 8) (pointer) "font-size:13px;font-weight:600"))

(defn $btn-ghost []
  (s "padding:9px 18px;background:transparent"
     (str "border:1px solid " $bdr) (fg $muted)
     (rounded 8) (pointer) "font-size:13px"))

(defn $btn-danger []
  (s "padding:9px 18px;background:transparent"
     (str "border:1px solid " $danger) (fg $danger)
     (rounded 8) (pointer) "font-size:13px"))

(defn $btn-icon []
  (s "background:transparent;border:none" (fg $muted) (pointer) "font-size:14px;padding:2px 6px"))

(defn $badge [color]
  (s "padding:2px 8px" (rounded 4) "font-size:11px" (fg color)
     (str "background:" color "1a")))

(defn $sidebar []
  (s "width:220px" (bg-panel) (border-r)
     "display:flex;flex-direction:column;flex-shrink:0"))

(defn $topbar []
  (s (between) "padding:12px 20px" (border-b) (bg-panel)))

(defn $nav-item [active?]
  (s "display:flex;align-items:center;gap:10px;padding:9px 12px"
     (rounded 6) (pointer) "font-size:13px;margin-bottom:2px;border:none;width:100%;text-align:left"
     (if active?
       (str "background:" $panel ";color:" $text)
       (str "background:transparent;color:" $sub))))

(defn $modal-bg []
  (s (fixed) (inset) "background:rgba(0,0,0,0.7);z-index:100"
     (center) "padding:16px"))

(defn $modal []
  (s (bg-panel) (border) (rounded 14)
     "padding:24px;max-width:480px;width:100%"))

(defn $empty-state []
  (s (center) "flex-direction:column;padding:60px 20px" (fg $muted)))

(defn $scroll []
  "::-webkit-scrollbar{width:6px}::-webkit-scrollbar-thumb{background:#1e3050;border-radius:3px}")
