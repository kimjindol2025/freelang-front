; pages/notes.flx — 개선된 메모장 (h() + style DSL 완전 적용)
; GET  /notes        → 목록 (검색 포함)
; POST /notes        → 추가 / 수정 / 삭제 / 핀 (action 필드로 구분)

; ── 스타일 정의 ──
(style note-card
  :radius "12px"
  :shadow "sm"
  :display "flex"
  :flex-dir "column"
  :position "relative"
  :transition "transform .15s, box-shadow .15s"
  :hover-shadow "md"
  :hover-transform "translateY(-2px)")

(style note-input-box
  :bg "white"
  :radius "12px"
  :p "20px"
  :mb "28px"
  :shadow "sm")

(style note-grid
  :display "grid"
  :cols "auto-fill"
  :gap "16px")

(style note-action-bar
  :display "flex"
  :justify "space-between"
  :items "center"
  :p "8px 12px 12px"
  :border-top "1px solid rgba(0,0,0,.06)"
  :mt "4px")

(style search-bar
  :bg "white"
  :radius "8px"
  :border "1px solid #e5e7eb"
  :p "10px 16px 10px 40px"
  :size ".95rem"
  :width "100%"
  :transition "border .15s"
  :hover-border-color "#c4b5fd"
  :focus-border-color "#6366f1"
  :focus-outline "none")

(style add-btn
  :bg "#6366f1"
  :color "white"
  :border "none"
  :radius "8px"
  :p "8px 20px"
  :size ".9rem"
  :cursor "pointer"
  :weight "600"
  :transition "background .15s"
  :hover-bg "#4f46e5")

(style pin-badge
  :position "absolute"
  :bg "#6366f1"
  :color "white"
  :size ".65rem"
  :p "2px 8px"
  :radius "10px"
  :weight "700")

(style note-header
  :display "flex"
  :justify "space-between"
  :items "flex-start"
  :mb "20px")

(style note-count
  :m "0"
  :color "#6b7280"
  :size ".9rem")

(style note-title
  :m "0 0 4px"
  :size "1.6rem")

(style note-content-area
  :p "20px 20px 8px"
  :flex "1")

(style note-view
  :size ".95rem"
  :lh "1.65"
  :ws "pre-wrap"
  :cursor "pointer"
  :min-h "48px")

(style note-meta
  :size ".72rem"
  :color "#9ca3af")

(style form-toolbar
  :display "flex"
  :items "center"
  :justify "space-between"
  :mt "12px"
  :pt "12px"
  :border-top "1px solid #f3f4f6")

(style color-row
  :display "flex"
  :items "center"
  :gap "6px")

(style note-empty
  :align "center"
  :p "64px"
  :color "#9ca3af")

(style note-actions
  :display "flex"
  :gap "4px")

(style icon-btn
  :bg "none"
  :border "none"
  :cursor "pointer"
  :size "1rem"
  :p "4px")

(style del-btn
  :bg "none"
  :border "none"
  :cursor "pointer"
  :size "1rem"
  :p "4px"
  :color "#ef4444")

(style search-wrap
  :position "relative"
  :mb "20px")

(style search-icon
  :position "absolute"
  :color "#9ca3af"
  :pointer "none")

(style pin-form
  :m "0")

(style textarea-input
  :width "100%"
  :border "none"
  :outline "none"
  :size ".95rem"
  :overflow "hidden")

; ── DB 마이그레이션 ──
(db-exec DB "CREATE TABLE IF NOT EXISTS notes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  content TEXT NOT NULL,
  color TEXT DEFAULT '#fff9c4',
  pinned INTEGER DEFAULT 0,
  created_at TEXT DEFAULT (datetime('now','localtime')),
  updated_at TEXT DEFAULT (datetime('now','localtime'))
)" [])
(try (db-exec DB "ALTER TABLE notes ADD COLUMN pinned INTEGER DEFAULT 0" []) (catch $e nil))
(try (db-exec DB "ALTER TABLE notes ADD COLUMN updated_at TEXT DEFAULT (datetime('now','localtime'))" []) (catch $e nil))

; ── DB 헬퍼 ──
(defn notes-fetch [q]
  (if (= q "")
    (db-query DB "SELECT * FROM notes ORDER BY pinned DESC, id DESC" [])
    (db-query DB "SELECT * FROM notes WHERE content LIKE ? ORDER BY pinned DESC, id DESC" [(str "%" q "%")])))

(defn notes-add [content color]
  (db-exec DB "INSERT INTO notes (content, color) VALUES (?, ?)" [content color]))

(defn notes-del [id]
  (db-exec DB "DELETE FROM notes WHERE id = ?" [id]))

(defn notes-update [id content]
  (db-exec DB "UPDATE notes SET content=?, updated_at=datetime('now','localtime') WHERE id=?" [content id]))

(defn notes-pin [id pinned]
  (db-exec DB "UPDATE notes SET pinned=? WHERE id=?" [pinned id]))

; ── 색상 팔레트 ──
(define NOTE-COLORS ["#fff9c4" "#c8e6c9" "#bbdefb" "#f8bbd0" "#e1bee7" "#ffe0b2" "#ffffff"])

(defn color-btn [c]
  (str "<button type='button'"
       " onclick=\"document.getElementById('color-inp').value='" c "';"
       "document.querySelectorAll('.cbtn').forEach(b=>b.style.outline='none');"
       "this.style.outline='3px solid #6366f1'\""
       " class='cbtn'"
       " style='width:26px;height:26px;border-radius:50%;background:" c
       ";border:1px solid #d1d5db;cursor:pointer'></button>"))

; ── 메모 카드 ──
(defn note-card [note]
  (let [id     (str (get note "id"))
        text   (get note "content")
        color  (get note "color")
        pinned (get note "pinned")
        at     (get note "updated_at")
        is-pin (= pinned 1)]
    (str
      (h "div" {:id (str "card-" id)
                :class note-card
                :style (str "background:" color (if is-pin ";border:2px solid #6366f1" ""))}
        (str
          ; 핀 배지
          (if is-pin
            (h "div" {:class pin-badge :style "top:-8px;left:12px"} "📌 고정")
            "")

          ; 내용 영역
          (h "div" {:class note-content-area}
            (str
              (h "div" {:id (str "view-" id)
                        :class note-view
                        :onclick (str "startEdit('" id "')")
                        :title "클릭하여 수정"} text)
              (h "textarea" {:id (str "edit-" id)
                             :style "display:none;width:100%;border:none;background:transparent;font-size:.95rem;line-height:1.65;resize:none;outline:none;font-family:inherit;min-height:80px"
                             :onblur (str "saveEdit('" id "')")
                             :onkeydown (str "if(event.key==='Escape')cancelEdit('" id "')")} "")))

          ; 액션 바
          (h "div" {:class note-action-bar}
            (str
              (h "span" {:class note-meta} at)
              (h "div" {:class note-actions}
                (str
                  (h "form" {:method "POST" :action "/notes" :class pin-form}
                    (str
                      (h! "input" {:type "hidden" :name "action" :value "pin"})
                      (h! "input" {:type "hidden" :name "id" :value id})
                      (h! "input" {:type "hidden" :name "pinned" :value (if is-pin "0" "1")})
                      (h "button" {:type "submit"
                                   :class icon-btn
                                   :style (str "opacity:" (if is-pin "1" ".4"))
                                   :title (if is-pin "핀 해제" "핀 고정")} "📌")))
                  (h "form" {:method "POST" :action "/notes" :class pin-form}
                    (str
                      (h! "input" {:type "hidden" :name "action" :value "del"})
                      (h! "input" {:type "hidden" :name "id" :value id})
                      (h "button" {:type "submit" :class del-btn :title "삭제"} "🗑"))))))))))))

; ── 인라인 편집 스크립트 ──
(define EDIT-SCRIPT
  "<script>
function startEdit(id){var v=document.getElementById('view-'+id),e=document.getElementById('edit-'+id);e.value=v.textContent;v.style.display='none';e.style.display='block';e.focus();e.style.height='auto';e.style.height=e.scrollHeight+'px';}
function cancelEdit(id){document.getElementById('view-'+id).style.display='block';document.getElementById('edit-'+id).style.display='none';}
async function saveEdit(id){var e=document.getElementById('edit-'+id),v=document.getElementById('view-'+id),c=e.value.trim();if(!c||c===v.textContent.trim()){cancelEdit(id);return;}await fetch('/notes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'edit',id:id,content:c})});v.textContent=c;v.style.display='block';e.style.display='none';}
document.getElementById('search-inp')?.addEventListener('input',function(){var q=this.value.toLowerCase();document.querySelectorAll('[id^=card-]').forEach(function(c){c.style.display=c.textContent.toLowerCase().includes(q)?'':'none';});});
</script>")

; ── GET 핸들러 ──
(defn render [req]
  (let [q-raw (server-req-query req "q")
        q     (if (nil? q-raw) "" (str q-raw))
        notes (notes-fetch q)
        count (length notes)
        pin-c (length (filter (fn [n] (= (get n "pinned") 1)) notes))
        cards (if (= count 0)
                (h "div" {:class note-empty}
                  (str (h "div" {:style "font-size:3rem;margin-bottom:16px"} "📝")
                       (h "p" {:style "margin:0"} "메모가 없습니다")))
                (arr-join (map note-card notes) ""))]
    (layout-html "Notes"
      (str
        ; 헤더
        (h "div" {:class note-header}
          (h "div" {}
            (str (h "h2" {:class note-title} "📝 Notes")
                 (h "p" {:style "margin:0 0 8px;font-size:.85rem"}
                   (h "a" {:href "/notes-afldb" :data-spa "1" :style "color:#6366f1"} "afl-db 버전 →"))
                 (h "p" {:class note-count}
                   (str (str count) "개 메모"
                        (if (> pin-c 0) (str " · 📌 " (str pin-c) "개 고정") ""))))))

        ; 검색바
        (h "div" {:class search-wrap}
          (str
            (h! "input" {:id "search-inp" :class search-bar :type "text"
                         :placeholder "메모 검색..." :value q})
            (h "span" {:class search-icon :style "left:14px;top:50%;transform:translateY(-50%)"} "🔍")))

        ; 입력 폼
        (h "form" {:method "POST" :action "/notes" :class note-input-box}
          (str
            (h! "input" {:type "hidden" :name "action" :value "add"})
            (h "textarea" {:name "content" :rows "2"
                           :placeholder "새 메모... (Ctrl+Enter 추가)"
                           :maxlength "1000"
                           :style "width:100%;border:none;outline:none;font-size:.95rem;resize:none;font-family:inherit;line-height:1.6;box-sizing:border-box"
                           :onkeydown "if(event.ctrlKey&&event.key==='Enter')this.closest('form').submit()"
                           :required "true"} "")
            (h "div" {:class form-toolbar}
              (str
                (h "div" {:class color-row}
                  (str (arr-join (map color-btn NOTE-COLORS) "")
                       (h! "input" {:type "hidden" :name "color" :id "color-inp" :value "#fff9c4"})))
                (h "button" {:type "submit" :class add-btn} "추가")))))

        ; 메모 그리드
        (h "div" {:class note-grid :style "grid-template-columns:repeat(auto-fill,minmax(260px,1fr))"}
          cards)

        EDIT-SCRIPT)
      req)))

; ── POST 핸들러 ──
(defn render_post [req]
  (let [parsed  (get req "body")
        action  (get parsed "action")
        id      (str (get parsed "id"))
        content (str (get parsed "content"))
        color   (str (get parsed "color"))
        pinned  (str (get parsed "pinned"))]
    (if (= action "del")
      (do (notes-del id) (server-redirect "/notes"))
    (if (= action "pin")
      (do (notes-pin id (if (= pinned "1") 1 0)) (server-redirect "/notes"))
    (if (= action "edit")
      (do
        (if (not (= content "")) (notes-update id content) nil)
        (server-json {:ok true}))
    (do
      (if (not (= content ""))
        (notes-add content (if (= color "") "#fff9c4" color))
        nil)
      (server-redirect "/notes")))))))
