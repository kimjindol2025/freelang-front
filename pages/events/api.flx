; pages/events/api.flx — 등록 컬렉션 + 임의 키 history
; 알려진 키는 afldb_coll_namespaces 레지스트리에서만 옴 (앱 _db load 불필요)

(defn events-known-keys []
  (let [cols (front-collection-known)
        scratch (first (filter (fn [c] (= (get c "ns") "scratch")) cols))
        notes (first (filter (fn [c] (= (get c "ns") "notes")) cols))]
    {"collections" cols
     "scratch_index" (if (= scratch nil) "" (get scratch "index"))
     "notes_index" (if (= notes nil) "" (get notes "index"))
     "scratch_items" (if (= scratch nil) [] (get scratch "items"))
     "notes_items" (if (= notes nil) [] (get notes "items"))}))

(defn render [req]
  (let [st (afldb-status)
        known (events-known-keys)]
    (server-json {"ok" (get st "ok")
                  "status" st
                  "known" known})))

(defn render_post [req]
  (let [body (get req "body")
        action (str (or (get body "action") ""))]
    (cond
      (= action "history")
      (let [key (str-trim (str (or (get body "key") "")))]
        (if (= key "")
          (server-json {"ok" false "error" "key 필요"})
          (server-json {"ok" true
                        "key" key
                        "events" (afldb-history key)})))

      (= action "known")
      (server-json {"ok" true "known" (events-known-keys) "status" (afldb-status)})

      true
      (server-json {"ok" false "error" "unknown action — history|known"}))))
