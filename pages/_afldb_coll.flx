; pages/_afldb-coll.flx — afl-db 인덱스 컬렉션 공통 패턴
; 키 계약 (고정):
;   fl:<ns>:index      → [id...]
;   fl:<ns>:item:<id>  → {id, ..., updated}
;
; 다음 앱은 scratch/notes 처럼 CRUD를 다시 쓰지 말고 이 모듈만 호출한다.
; 도메인 필드(title/body, content/pinned …)만 앱 _db 에서 채운다.

(define afldb_coll_namespaces ["scratch" "notes" "todo" "bookmarks" "clips"])
(define front_collection_adapter (or (env_get "FL_FRONT_COLLECTION_ADAPTER") "afj-db95"))
(define front_collection_memory (atom {}))

; memory는 production backend가 아니라 동일 언어 계약을 검증하는 test provider다.
(defn front-collection-memory? []
  (= front_collection_adapter "memory"))

(defn front-collection-memory-items [ns]
  (or (get (deref front_collection_memory) ns) []))

(defn front-collection-memory-save [ns items]
  (swap! front_collection_memory (fn [store] (assoc store ns items)))
  items)

(defn afldb-coll-index-key [ns]
  (str "fl:" ns ":index"))

(defn afldb-coll-item-key [ns id]
  (str "fl:" ns ":item:" id))

(defn afldb-coll-ids [ns]
  (afldb-index-get (afldb-coll-index-key ns)))

(defn afldb-coll-item-keys [ns]
  (map (fn [id] (afldb-coll-item-key ns id)) (afldb-coll-ids ns)))

(defn afldb-coll-all [ns]
  (let [vals (afldb-load-values (afldb-coll-item-keys ns))]
    (filter (fn [v] (not (= v nil))) vals)))

(defn afldb-coll-get [ns id]
  (afldb-get (afldb-coll-item-key ns id) nil))

; create: item put + index put 를 kv-batch-put 1회로 합침 (index get 1회는 유지).
; HTTP: 이전 put+get+put = 3 → get+batch-put = 2
(defn afldb-coll-create [ns item]
  (let [id (str (now-ms))
        full (obj-merge item {"id" id "updated" (now-ms)})
        index-key (afldb-coll-index-key ns)
        item-key (afldb-coll-item-key ns id)
        ids (afldb-index-get index-key)
        sid (str id)
        exists (filter (fn [x] (= (str x) sid)) ids)
        next-ids (if (> (length exists) 0)
                   ids
                   (push ids sid))]
    (afldb-batch-put [{"key" item-key "value" full}
                      {"key" index-key "value" next-ids}])
    full))

(defn afldb-coll-update [ns id patch]
  (let [prev (afldb-coll-get ns id)]
    (if (= prev nil)
      nil
      (let [full (obj-merge prev (obj-merge patch {"id" id "updated" (now-ms)}))]
        (afldb-put (afldb-coll-item-key ns id) full)
        full))))

(defn afldb-coll-delete [ns id]
  (afldb-index-remove-id (afldb-coll-index-key ns) id)
  (afldb-delete (afldb-coll-item-key ns id))
  true)

(defn afldb-coll-history [ns id]
  (afldb-history (afldb-coll-item-key ns id)))

; Events / 점검용 — 등록된 ns 목록의 index·item 키
(defn afldb-coll-known []
  (map
    (fn [ns]
      {"ns" ns
       "index" (afldb-coll-index-key ns)
       "items" (afldb-coll-item-keys ns)})
    afldb_coll_namespaces))

; FreeLang Front 언어 표면 — 페이지는 front-collection-*만 사용한다.
; 실제 AFJ-DB95 collection 호출은 이 adapter 구현 파일에 격리한다.
(defn front-collection-index-key [ns]
  (afldb-coll-index-key ns))

(defn front-collection-item-key [ns id]
  (afldb-coll-item-key ns id))

(defn front-collection-all [ns]
  (if (front-collection-memory?)
    (front-collection-memory-items ns)
    (afldb-coll-all ns)))

(defn front-collection-get [ns id]
  (if (front-collection-memory?)
    (first (filter (fn [item] (= (str (get item "id")) (str id)))
                   (front-collection-memory-items ns)))
    (afldb-coll-get ns id)))

(defn front-collection-create [ns item]
  (if (front-collection-memory?)
    (let [id (str (now-ms))
          full (obj-merge item {"id" id "updated" (now-ms)})
          current (front-collection-memory-items ns)]
      (front-collection-memory-save ns (push current full))
      full)
    (afldb-coll-create ns item)))

(defn front-collection-update [ns id patch]
  (if (front-collection-memory?)
    (let [current (front-collection-memory-items ns)
          prev (first (filter (fn [item] (= (str (get item "id")) (str id))) current))]
      (if (= prev nil)
        nil
        (let [full (obj-merge prev (obj-merge patch {"id" id "updated" (now-ms)}))
              next (map (fn [item]
                          (if (= (str (get item "id")) (str id)) full item)) current)]
          (front-collection-memory-save ns next)
          full)))
    (afldb-coll-update ns id patch)))

(defn front-collection-delete [ns id]
  (if (front-collection-memory?)
    (let [current (front-collection-memory-items ns)
          next (filter (fn [item] (not (= (str (get item "id")) (str id)))) current)]
      (front-collection-memory-save ns next)
      true)
    (afldb-coll-delete ns id)))

(defn front-collection-history [ns id]
  (if (front-collection-memory?)
    []
    (afldb-coll-history ns id)))

(defn front-collection-known []
  (afldb-coll-known))
