; pages/prompts/index.flx — 프롬프트 보관함

(load "pages/prompts/_db.flx")
(prompts-init)

(island PromptsApp []
  (let [data       (atom nil)
        show-form  (atom false)
        title-in   (atom "")
        body-in    (atom "")
        tag-in     (atom "")
        tag-filter (atom "all")
        expand-id  (atom nil)
        err        (atom "")
        copied     (atom "")
        loaded     (atom false)

        apply-res (fn [res]
                    (reset! data res)
                    (reset! show-form false)
                    (reset! title-in "")
                    (reset! body-in "")
                    (reset! tag-in "")
                    (reset! err "")
                    (reset! expand-id nil))

        reload (fn [res]
                 (if (= (get res "ok") false)
                   (reset! err (or (get res "error") "실패"))
                   (apply-res res)))

        add-item (fn []
                   (if (or (= (str-trim @title-in) "") (= (str-trim @body-in) ""))
                     (reset! err "제목과 본문을 입력하세요")
                     (fetch-post! "/prompts/api"
                       {"action" "add" "title" @title-in "body" @body-in "tag" @tag-in}
                       reload)))

        del-item (fn [id]
                   (fetch-post! "/prompts/api" {"action" "delete" "id" id} reload))

        copy-body (fn [text id]
                    (do
                      (.writeText (.-clipboard (.-navigator window)) (or text ""))
                      (reset! copied (str id))))

        tag-known? (fn [acc t]
                     (> (length (filter (fn [x] (= x t)) acc)) 0))

        tags (fn []
               (reduce
                 (fn [acc row]
                   (let [t (str-trim (or (get row "tag") ""))]
                     (if (or (= t "") (tag-known? acc t))
                       acc
                       (concat acc [t]))))
                 []
                 (or (get @data "items") [])))

        visible (fn []
                  (let [f @tag-filter
                        items (or (get @data "items") [])]
                    (if (= f "all")
                      items
                      (filter (fn [row] (= (or (get row "tag") "") f)) items))))

        row-view (fn [row]
                   (let [id      (get row "id")
                         is-open (= @expand-id id)]
                     (h "div" {:class "pr-row"}
                       (str
                         (h "button" {:class "pr-main"
                                      :on-click (fn [] (reset! expand-id (if is-open nil id)))}
                           (str
                             (h "div" {:class "pr-text"}
                               (str
                                 (h "div" {:class "pr-title"} (get row "title"))
                                 (h "div" {:class "pr-meta"}
                                   (str (if (= (or (get row "tag") "") "") "untagged" (get row "tag"))
                                        (if (= @copied (str id)) " · 복사됨" "")))))
                             (h "span" {:class "pr-chev"} (if is-open "▾" "▸"))))
                         (if is-open
                           (h "div" {:class "pr-panel"}
                             (str
                               (h "pre" {:class "pr-body"} (get row "body"))
                               (h "div" {:class "pr-actions"}
                                 (str
                                   (h "button" {:class "pr-btn pr-accent"
                                                :on-click (fn [] (copy-body (get row "body") id))}
                                     "복사")
                                   (h "button" {:class "pr-btn pr-ghost"
                                                :on-click (fn [] (del-item id))}
                                     "삭제")))))
                           "")))))]

    (when (not @loaded)
      (reset! loaded true)
      (fetch! "/prompts/api" (fn [res] (reset! data res))))

    (if (= @data nil)
      (h "div" {:class "pr-loading"} "불러오는 중…")

      (h "div" {:class "pr-app"}
        (str
          (h "header" {:class "pr-head"}
            (str
              (h "div" {}
                (str
                  (h "h1" {} "Prompts")
                  (h "p" {:class "pr-lead"} "자주 쓰는 프롬프트를 모아 두고 복사")))
              (h "button" {:class "pr-btn pr-accent"
                           :on-click (fn [] (reset! show-form true))}
                "+ 추가")))

          (h "div" {:class "pr-filters"}
            (str
              (h "button" {:class (if (= @tag-filter "all") "pr-chip pr-chip-on" "pr-chip")
                           :on-click (fn [] (reset! tag-filter "all"))} "전체")
              (arr-join
                (map
                  (fn [t]
                    (h "button" {:class (if (= @tag-filter t) "pr-chip pr-chip-on" "pr-chip")
                                 :on-click (fn [] (reset! tag-filter t))}
                      t))
                  (tags))
                "")))

          (if @show-form
            (h "div" {:class "pr-form"}
              (str
                (h! "input" {:class "pr-input" :placeholder "제목"
                             :value @title-in
                             :on-input (fn [e] (reset! title-in (.-value (.-target e))))})
                (h "textarea" {:class "pr-area" :placeholder "프롬프트 본문"
                               :value @body-in
                               :on-input (fn [e] (reset! body-in (.-value (.-target e))))} "")
                (h! "input" {:class "pr-input" :placeholder "태그 (예: writing)"
                             :value @tag-in
                             :on-input (fn [e] (reset! tag-in (.-value (.-target e))))})
                (h "div" {:class "pr-form-actions"}
                  (str
                    (h "button" {:class "pr-btn pr-ghost"
                                 :on-click (fn [] (reset! show-form false))} "취소")
                    (h "button" {:class "pr-btn pr-accent" :on-click add-item} "저장")))))
            "")

          (if (= @err "") "" (h "p" {:class "pr-err"} @err))

          (if (= (length (visible)) 0)
            (h "p" {:class "pr-empty"} "프롬프트가 없습니다.")
            (h "div" {:class "pr-list"}
              (arr-join (map row-view (visible)) ""))))))))

(defn render [req]
  (layout-html "Prompts"
    (str
      """
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  .pr-wrap{max-width:520px;margin:0 auto;padding:22px 16px 80px;
    font-family:'IBM Plex Sans',system-ui,sans-serif;color:#e8e6e1;
    background:linear-gradient(165deg,#1a2332 0%,#121820 50%,#0e141c 100%);
    min-height:100dvh;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  .pr-loading,.pr-empty{color:#8a93a3;text-align:center;padding:40px 12px}
  .pr-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px}
  .pr-head h1{margin:0;font-size:1.5rem;font-weight:700;letter-spacing:-.02em}
  .pr-lead{margin:6px 0 0;color:#8a93a3;font-size:.8rem}
  .pr-filters{display:flex;gap:8px;overflow-x:auto;margin-bottom:14px;-webkit-overflow-scrolling:touch}
  .pr-chip{flex:0 0 auto;min-height:40px;padding:0 14px;border-radius:999px;border:1px solid #2c3648;
    background:#182030;color:#8a93a3;font:inherit;font-size:.8rem;font-weight:600;cursor:pointer}
  .pr-chip-on{background:#3d8bfd;border-color:#3d8bfd;color:#fff}
  .pr-form{background:#182030;border:1px solid #2c3648;border-radius:14px;padding:14px;margin-bottom:14px;
    display:flex;flex-direction:column;gap:8px}
  .pr-form-actions{display:flex;justify-content:flex-end;gap:8px}
  .pr-input,.pr-area{width:100%;box-sizing:border-box;background:#0e141c;color:#e8e6e1;
    border:1px solid #2c3648;border-radius:12px;padding:12px 14px;font:inherit;font-size:16px}
  .pr-area{min-height:120px;resize:vertical;font-family:'IBM Plex Mono',monospace;font-size:14px;line-height:1.5}
  .pr-btn{border:none;border-radius:12px;min-height:46px;padding:12px 16px;font:inherit;font-weight:700;cursor:pointer}
  .pr-accent{background:#3d8bfd;color:#fff}
  .pr-accent:active{transform:scale(.98)}
  .pr-ghost{background:transparent;color:#8a93a3}
  .pr-err{color:#ff8f8f;font-size:.8rem}
  .pr-row{border-bottom:1px solid #243044}
  .pr-main{width:100%;display:flex;align-items:center;gap:10px;min-height:56px;padding:14px 2px;
    background:transparent;border:none;color:inherit;font:inherit;text-align:left;cursor:pointer}
  .pr-text{flex:1;min-width:0}
  .pr-title{font-weight:700;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pr-meta{color:#8a93a3;font-size:.72rem;margin-top:3px}
  .pr-chev{color:#8a93a3}
  .pr-panel{padding:0 2px 14px 4px}
  .pr-body{margin:0 0 10px;padding:12px;border-radius:12px;background:#0e141c;border:1px solid #2c3648;
    white-space:pre-wrap;font-family:'IBM Plex Mono',monospace;font-size:.8rem;line-height:1.55;color:#d5d2cb}
  .pr-actions{display:flex;gap:8px;justify-content:flex-end}
</style>
<div class="pr-wrap">
"""
      "ISLAND_PLACEHOLDER"
      "</div>"
      "ISLAND_SCRIPTS")
    req))
