; pages/dashboard/alerts.flx — 실시간 알림 대시보드
; API 조회·표현·주기 갱신을 FreeLang Island으로 처리한다.

(island AlertsDashboard []
  (let [alerts   (atom [])
        loaded   (atom false)
        started  (atom false)
        reload   (fn [res]
                   (reset! alerts (or (get res "alerts") []))
                   (reset! loaded true))
        refresh  (fn [] (fetch! "/api/alerts?limit=20" reload))
        alert-card
          (fn [alert]
            (h "article"
              {:style "padding:15px;margin-bottom:10px;border-left:4px solid;border-radius:4px;background:#f8fafc"}
              (str
                (h "div" {:style "display:flex;justify-content:space-between;gap:12px"}
                  (str
                    (h "strong" {:style "text-transform:uppercase;font-size:12px"}
                      (or (get alert "severity") "info"))
                    (h "span" {:style "font-size:12px;color:#666"}
                      (or (get alert "timestamp") ""))))
                (h "div" {:style "margin-top:8px;font-weight:600"}
                  (or (get alert "message") "알림"))
                (h "div" {:style "margin-top:8px;font-size:12px;color:#666"}
                  (str (or (get alert "metric") "") " · "
                       (or (get alert "value") "") " / "
                       (or (get alert "threshold") ""))))))]
    (when (not @started)
      (reset! started true)
      (refresh)
      (every! 10000 refresh))
    (if (not @loaded)
      (h "div" {:style "padding:40px;text-align:center;color:#999"} "알림 로드 중…")
      (h "main" {:style "max-width:1000px;margin:0 auto;padding:20px"}
        (str
          (h "h1" {:style "font-size:28px;margin:0 0 20px;color:#333"} "🔔 실시간 알림")
          (if (= (length @alerts) 0)
            (h "div" {:style "padding:40px;text-align:center;color:#999;background:white;border-radius:8px"} "알림 없음")
            (h "section" {:style "background:white;border-radius:8px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.1)"}
              (arr-join (map alert-card @alerts) ""))))))))

(defn render [$req]
  (layout-html "실시간 알림"
    (str
      (h "main" {:style "max-width:1000px;margin:0 auto;padding:20px"}
        (str
          (h "h1" {:style "font-size:28px;margin:0 0 20px;color:#333"} "🔔 실시간 알림")
          "ISLAND_PLACEHOLDER"))
      "ISLAND_SCRIPTS")
    $req))
