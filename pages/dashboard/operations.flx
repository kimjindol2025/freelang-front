; pages/dashboard/operations.flx — 통합 운영 대시보드 (v1.1.0)

(defn render [$req]
  (let [$html "<html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>운영 대시보드</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#0f172a;color:#e2e8f0;padding:20px}.container{max-width:1400px;margin:0 auto}.header{margin-bottom:30px}.title{font-size:28px;font-weight:700;margin-bottom:10px}.desc{color:#cbd5e1;font-size:13px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:15px;margin-bottom:30px}.card{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid #334155;border-radius:8px;padding:20px}.service-card{padding:20px;border-radius:8px;border-left:4px solid}.service-card.online{border-left-color:#10b981;background:#064e3b}.service-card.offline{border-left-color:#ef4444;background:#7f1d1d}.service-name{font-weight:600;font-size:14px;margin-bottom:8px}.service-port{color:#cbd5e1;font-size:12px;margin-bottom:8px}.metrics{display:flex;gap:20px;margin-top:10px;padding-top:10px;border-top:1px solid #475569}.metric{flex:1}.metric-label{font-size:11px;color:#94a3b8;margin-bottom:4px}.metric-value{font-size:16px;font-weight:700}.status-dot{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:8px}.status-dot.online{background:#10b981}.status-dot.offline{background:#ef4444}.status-dot.warning{background:#f59e0b}.table{width:100%;border-collapse:collapse}.table th{background:#1e293b;padding:12px;text-align:left;font-weight:600;font-size:12px;color:#cbd5e1;border-bottom:1px solid #334155}.table td{padding:12px;border-bottom:1px solid #334155;font-size:13px}.table tr:hover{background:#1a222f}.badge{display:inline-block;padding:4px 8px;border-radius:4px;font-size:11px;font-weight:600}.badge.ok{background:#10b981;color:#ecfdf5}.badge.warn{background:#f59e0b;color:#fef3c7}.badge.error{background:#ef4444;color:#fee2e2}.footer{margin-top:40px;padding-top:20px;border-top:1px solid #334155;font-size:12px;color:#94a3b8;text-align:center}</style></head><body><div class=\"container\"><div class=\"header\"><div class=\"title\">🚀 freelang-front 운영 대시보드</div><div class=\"desc\">v1.0.0 프로덕션 | 전체 시스템 모니터링</div></div><div class=\"grid\" id=\"services\"></div><div class=\"card\"><h2 style=\"margin-bottom:15px\">📊 서비스 현황</h2><table class=\"table\"><thead><tr><th>서비스</th><th>포트</th><th>상태</th><th>CPU</th><th>메모리</th><th>응답</th></tr></thead><tbody id=\"tbody\"></tbody></table></div><div class=\"footer\"><p>실시간 모니터링 | 매 5초 갱신 | freelang-front v1.1.0</p></div></div><script>const Ops={services:{\"freelang-front\":{port:40850,url:\"http://localhost:40850\"},\"trading-simulator\":{port:40804,url:\"http://localhost:40804\"},\"pm2-dashboard\":{port:40255,url:\"http://localhost:40255\"},\"claude-monitor\":{port:40101,url:\"http://localhost:40101\"},\"port-registry\":{port:40254,url:\"http://localhost:40254\"}},async load(){const cards=document.getElementById(\"services\");const tbody=document.getElementById(\"tbody\");let html=\"\";let rows=\"\";for(const[name,svc] of Object.entries(this.services)){const r=await this.check(svc.url);const status=r?\"online\":\"offline\";html+=`<div class=\"service-card ${status}\"><div class=\"service-name\"><span class=\"status-dot ${status}\"></span>${name}</div><div class=\"service-port\">포트 ${svc.port}</div><div class=\"metrics\"><div class=\"metric\"><div class=\"metric-label\">상태</div><div class=\"metric-value\">${status==\"online\"?\"✓\":\"✗\"}</div></div><div class=\"metric\"><div class=\"metric-label\">응답</div><div class=\"metric-value\">${r?\"정상\":\"오류\"}</div></div></div></div>`;rows+=`<tr><td>${name}</td><td>${svc.port}</td><td><span class=\"badge ${status==\"online\"?\"ok\":\"error\"}\">${status}</span></td><td>-</td><td>-</td><td>${r?\"<100ms\":\"오류\"}</td></tr>`}cards.innerHTML=html;tbody.innerHTML=rows},async check(url){try{const r=await fetch(url,{method:\"HEAD\",mode:\"no-cors\"});return true}catch{return false}}};setInterval(()=>Ops.load(),5000);Ops.load()</script></body></html>"]
    (server_html $html)))
