; pages/dashboard/operations.flx — 운영 대시보드
; 서비스 상태를 서버에서 확인하고 FreeLang SSR로 렌더링한다.

(define SERVICES
  [{"name" "freelang-front" "port" 40850}
   {"name" "trading-sim" "port" 40804}
   {"name" "pm2-board" "port" 40255}
   {"name" "claude-mon" "port" 40101}
   {"name" "port-reg" "port" 40254}])

(defn probe-service [service]
  (let [port (get service "port")
        url  (str "http://localhost:" port)]
    (try
      (do (front-http-get url)
          (assoc service "online" true))
      (catch $e
        (assoc service "online" false)))))

(defn service-card [service]
  (let [online (get service "online")
        tone   (if online "#10b981" "#ef4444")]
    (h "article" {:style (str "background:white;border-radius:8px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.1);border-left:4px solid " tone)}
      (str
        (h "div" {:style "display:flex;justify-content:space-between;align-items:center"}
          (str
            (h "strong" {:style "font-size:14px"} (get service "name"))
            (h "span" {:style (str "padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;background:" (if online "#d1fae5" "#fee2e2") ";color:" (if online "#065f46" "#7f1d1d"))}
              (if online "online" "offline"))))
        (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:12px;color:#666;margin-top:12px;padding-top:10px;border-top:1px solid #eee"}
          (str
            (h "span" {} (str "포트 " (get service "port")))
            (h "span" {:style "text-align:right"} (if online "✓ 정상" "✗ 오류"))))))))

(defn render [$req]
  (let [services (map probe-service SERVICES)
        online   (length (filter (fn [service] (get service "online")) services))]
    (layout-html "운영 대시보드"
      (str
        (h "main" {:style "max-width:1400px;margin:0 auto;padding:20px"}
          (str
            (h "header" {:style "background:white;border-radius:12px;padding:30px;margin-bottom:30px;box-shadow:0 8px 32px rgba(0,0,0,.1)"}
              (str
                (h "h1" {:style "margin:0 0 8px;font-size:32px"} "🚀 운영 대시보드")
                (h "p" {:style "margin:0;color:#666;font-size:14px"} "FreeLang SSR 서비스 상태")))
            (h "section" {:style "display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px;margin-bottom:30px"}
              (h "article" {:style "background:white;border-radius:8px;padding:20px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.1)"}
                (str
                  (h "strong" {:style "display:block;font-size:28px;color:#667eea"} (str online))
                  (h "span" {:style "font-size:12px;color:#999"} "온라인 서비스"))))
            (h "section" {:style "display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:15px"}
              (arr-join (map service-card services) "")))
        ))
      $req)))
