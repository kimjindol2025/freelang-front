; pages/dashboard/charts.flx — 성능 그래프
; 외부 chart library 대신 FreeLang SVG chart-line helper를 사용한다.

(load "performance-monitor.fl")

(defn chart-points [records metric]
  (map-indexed
    (fn [index record]
      {"label" (str (+ index 1))
       "value" (str-to-num (or (get record "value") 0))})
    (filter (fn [record] (= (get record "metric") metric)) records)))

(defn chart-card [title points]
  (h "section" {:style "background:white;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.1);margin-bottom:20px;padding:20px"}
    (str
      (h "h2" {:style "font-size:16px;font-weight:600;margin:0 0 15px;color:#333"} title)
      (if (= (length points) 0)
        (h "p" {:style "padding:40px;text-align:center;color:#999"} "데이터 없음")
        (chart-line points 720 260)))))

(defn render [$req]
  (let [stats   (get-performance-stats)
        records (or (get stats "recent") [])]
    (layout-html "성능 그래프"
      (str
        (h "main" {:style "max-width:1200px;margin:0 auto;padding:20px"}
          (str
            (h "h1" {:style "font-size:24px;margin:0 0 20px"} "📈 성능 메트릭 그래프")
            (h "p" {:style "color:#666;margin:0 0 20px"} "FreeLang SVG chart-line · 최근 기록")
            (chart-card "페이지 로드 시간" (chart-points records "page-load"))
            (chart-card "API 호출 시간" (chart-points records "api-call"))
            (chart-card "메모리 사용량 추이" (chart-points records "memory")))))
      $req)))
