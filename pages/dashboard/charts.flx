; pages/dashboard/charts.flx — 성능 그래프 (v0.6.0)

(defn render [$req]
  (let [$html "<html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>성능 그래프</title><script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js\"></script><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f5f5f5;padding:20px}h1{font-size:24px;margin-bottom:20px}.container{max-width:1200px;margin:0 auto}.card{background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);margin-bottom:20px;padding:20px}.chart-container{position:relative;height:300px;margin-bottom:30px}.chart-title{font-size:16px;font-weight:600;margin-bottom:15px;color:#333}canvas{max-height:300px}</style></head><body><div class=\"container\"><h1>📈 성능 메트릭 그래프 (v0.6.0)</h1><div class=\"card\"><div class=\"chart-title\">페이지 로드 시간 (최근 20개)</div><div class=\"chart-container\"><canvas id=\"pageLoadChart\"></canvas></div></div><div class=\"card\"><div class=\"chart-title\">API 호출 시간 (최근 20개)</div><div class=\"chart-container\"><canvas id=\"apiCallChart\"></canvas></div></div><div class=\"card\"><div class=\"chart-title\">메모리 사용량 추이</div><div class=\"chart-container\"><canvas id=\"memoryChart\"></canvas></div></div></div><script>const Charts={pageLoadChart:null,apiCallChart:null,memoryChart:null,init(){this.loadData()},loadData(){fetch('/api/metrics').then(r=>r.json()).then(d=>{const records=d['recent']||[];this.renderCharts(records)})},renderCharts(records){const pageLoads=records.filter(r=>r.metric==='page-load').slice(0,20);const apiCalls=records.filter(r=>r.metric==='api-call').slice(0,20);const memory=records.filter(r=>r.metric==='memory').slice(0,20);this.createChart('pageLoadChart','Page Load',pageLoads,'#667eea');this.createChart('apiCallChart','API Call',apiCalls,'#764ba2');this.createChart('memoryChart','Memory',memory,'#48bb78')},createChart(canvasId,label,data,color){const canvas=document.getElementById(canvasId);if(!canvas)return;const ctx=canvas.getContext('2d');const labels=data.map((r,i)=>i+1);const values=data.map(r=>parseFloat(r.value));if(this[canvasId])this[canvasId].destroy();this[canvasId]=new Chart(ctx,{type:'line',data:{labels,datasets:[{label,data:values,borderColor:color,backgroundColor:color+'20',tension:0.4,fill:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:true}},scales:{y:{beginAtZero:true}}}})}};Charts.init()</script></body></html>"]
    (server_html $html)))
