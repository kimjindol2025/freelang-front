; pages/dashboard/index.flx — 성능 메트릭 대시보드
; 조회·필터·표현·주기 갱신을 FreeLang Island으로 처리한다.

(island DashboardMetrics []
  (let [data      (atom nil)
        metric    (atom "")
        hours     (atom "24")
        started   (atom false)
        apply-data (fn [res]
                     (reset! data res))
        refresh   (fn []
                    (fetch! "/api/metrics" apply-data))
        filter-data
          (fn []
            (fetch! (str "/api/metrics/filter?metric=" @metric "&hours=" @hours)
              apply-data))
        metric-row
          (fn [row]
            (h "tr" {}
              (str
                (h "td" {:style "padding:12px;border-bottom:1px solid #eee"}
                  (or (get row "metric") "-"))
                (h "td" {:style "padding:12px;border-bottom:1px solid #eee"}
                  (str (or (get row "value") "-") " " (or (get row "unit") "")))
                (h "td" {:style "padding:12px;border-bottom:1px solid #eee"}
                  (or (get row "page") "-"))
                (h "td" {:style "padding:12px;border-bottom:1px solid #eee;font-size:12px;color:#666"}
                  (or (get row "timestamp") "")))))]
    (when (not @started)
      (reset! started true)
      (refresh)
      (every! 5000 refresh))
    (if (nil? @data)
      (h "div" {:style "padding:60px;text-align:center;color:#999"} "메트릭 로드 중…")
      (let [recent (or (get @data "recent") [])]
        (h "main" {:style "max-width:1200px;margin:0 auto;padding:20px"}
          (str
            (h "header" {:style "color:white;margin-bottom:24px"}
              (str
                (h "h1" {:style "font-size:32px;margin:0 0 8px"} "📊 성능 대시보드")
                (h "p" {:style "margin:0;opacity:.85"} "FreeLang Front 실시간 모니터링")))
            (h "section" {:style "display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px;margin-bottom:24px"}
              (str
                (h "article" {:style "background:white;border-radius:10px;padding:20px;text-align:center"}
                  (str
                    (h "strong" {:style "display:block;font-size:28px;color:#667eea"}
                      (str (or (get @data "total-records") 0)))
                    (h "span" {:style "font-size:12px;color:#666"} "총 기록")))
                (h "article" {:style "background:white;border-radius:10px;padding:20px;text-align:center"}
                  (str
                    (h "strong" {:style "display:block;font-size:28px;color:#667eea"}
                      (str (round (or (get (get @data "page-loads") "average") 0))))
                    (h "span" {:style "font-size:12px;color:#666"} "페이지 로드 평균")))
                (h "article" {:style "background:white;border-radius:10px;padding:20px;text-align:center"}
                  (str
                    (h "strong" {:style "display:block;font-size:28px;color:#667eea"}
                      (str (round (or (get (get @data "api-calls") "average") 0))))
                    (h "span" {:style "font-size:12px;color:#666"} "API 평균")))))
            (h "section" {:style "background:white;border-radius:10px;padding:20px;margin-bottom:24px"}
              (str
                (h "div" {:style "display:flex;gap:12px;align-items:end;flex-wrap:wrap"}
                  (str
                    (h "label" {:style "display:grid;gap:4px;font-size:12px;color:#666"} "메트릭"
                      (h "select" {:value @metric
                                   :on-change (fn [event]
                                                (reset! metric (get-in event ["target" "value"])))}
                        (str
                          (h "option" {:value ""} "모든 메트릭")
                          (h "option" {:value "page-load"} "페이지 로드")
                          (h "option" {:value "api-call"} "API 호출")
                          (h "option" {:value "memory"} "메모리"))))
                    (h "label" {:style "display:grid;gap:4px;font-size:12px;color:#666"} "시간"
                      (h "select" {:value @hours
                                   :on-change (fn [event]
                                                (reset! hours (get-in event ["target" "value"])))}
                        (str
                          (h "option" {:value "1"} "1시간")
                          (h "option" {:value "24"} "24시간")
                          (h "option" {:value "168"} "7일"))))
                    (h "button" {:style "padding:9px 14px;border:0;border-radius:6px;background:#667eea;color:white;cursor:pointer"
                                 :on-click filter-data} "필터 적용")
                    (h "a" {:href "/api/metrics/export?format=csv"
                            :style "padding:9px 14px;border-radius:6px;background:#48bb78;color:white;text-decoration:none"} "CSV")
                    (h "a" {:href "/api/metrics/export?format=json"
                            :style "padding:9px 14px;border-radius:6px;background:#48bb78;color:white;text-decoration:none"} "JSON"))))
            (h "section" {:style "background:white;border-radius:10px;padding:20px;overflow:auto"}
              (str
                (h "h2" {:style "margin:0 0 16px;font-size:18px"} "최근 성능 데이터")
                (if (= (length recent) 0)
                  (h "p" {:style "padding:40px;text-align:center;color:#999"} "데이터 없음")
                  (h "table" {:style "width:100%;border-collapse:collapse"}
                    (str
                      (h "thead" {}
                        (h "tr" {:style "background:#f9f9f9;text-align:left"}
                          (str
                            (h "th" {:style "padding:12px"} "메트릭")
                            (h "th" {:style "padding:12px"} "값")
                            (h "th" {:style "padding:12px"} "페이지")
                            (h "th" {:style "padding:12px"} "시간"))))
                      (h "tbody" {} (arr-join (map metric-row recent) ""))))))))))))))

(defn render [$req]
  (layout-html "성능 대시보드"
    (str
      (h "main" {:style "max-width:1200px;margin:0 auto;padding:20px"}
        "ISLAND_PLACEHOLDER")
      "ISLAND_SCRIPTS")
    $req))
