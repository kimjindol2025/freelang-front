; pages/dashboard/custom-metrics.flx — 커스텀 메트릭 대시보드 (v0.8.0)

(defn render [$req]
  (let [$html "<html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>커스텀 메트릭</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f5f5f5;padding:20px}h1{font-size:28px;margin-bottom:20px}.container{max-width:1200px;margin:0 auto}.card{background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);padding:20px;margin-bottom:20px}.form{display:grid;gap:12px;margin-bottom:20px}.form-group{display:flex;flex-direction:column}.label{font-weight:600;margin-bottom:4px;font-size:13px}.input{padding:10px;border:1px solid #ddd;border-radius:4px;font-size:14px}.btn{padding:10px 16px;border:none;border-radius:4px;background:#667eea;color:white;cursor:pointer;font-weight:600}.btn:hover{background:#5568d3}.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px}.metric-card{background:linear-gradient(135deg,#667eea,#764ba2);color:white;padding:20px;border-radius:8px}.metric-name{font-size:16px;font-weight:600;margin-bottom:8px}.metric-value{font-size:32px;font-weight:700;margin-bottom:8px}.metric-unit{font-size:13px;opacity:0.8}.metric-threshold{padding:8px;background:rgba(255,255,255,0.2);border-radius:4px;font-size:12px;margin-top:8px}.empty{text-align:center;color:#999;padding:40px}.error{background:#fee;color:#c33;padding:12px;border-radius:4px;margin-bottom:12px}</style></head><body><div class=\"container\"><h1>📊 커스텀 메트릭</h1><div class=\"card\"><h2>새 메트릭 추가</h2><div class=\"form\"><div class=\"form-group\"><label class=\"label\">메트릭명</label><input class=\"input\" id=\"metricName\" placeholder=\"예: 로그인_시간\"/></div><div class=\"form-group\"><label class=\"label\">설명</label><input class=\"input\" id=\"metricDesc\" placeholder=\"메트릭 설명\"/></div><div class=\"form-group\"><label class=\"label\">단위</label><input class=\"input\" id=\"metricUnit\" placeholder=\"예: ms, %, count\"/></div><div class=\"form-group\"><label class=\"label\">임계값 (선택)</label><input class=\"input\" id=\"metricThreshold\" type=\"number\" placeholder=\"알림 임계값\"/></div><button class=\"btn\" onclick=\"createMetric()\">메트릭 생성</button><div id=\"error\" class=\"error\" style=\"display:none\"></div></div></div><div class=\"card\"><h2>활성 메트릭</h2><div class=\"metrics-grid\" id=\"metricsContainer\"><div class=\"empty\">메트릭 로드 중...</div></div></div></div><script>const CustomMetrics={metrics:{},init(){this.loadMetrics()},loadMetrics(){fetch('/api/custom-metrics').then(r=>r.json()).then(d=>{this.metrics=d.metrics||{};this.render()}).catch(e=>{showError('메트릭 로드 실패: '+e)})},render(){const container=document.getElementById('metricsContainer');if(!this.metrics.length){container.innerHTML='<div class=\"empty\">등록된 메트릭이 없습니다</div>';return}container.innerHTML=this.metrics.map(m=>'<div class=\"metric-card\"><div class=\"metric-name\">'+m.name+'</div><div class=\"metric-unit\">'+m.unit+'</div><div class=\"metric-threshold\">임계값: '+(m.threshold||'-')+'</div></div>').join('')}};function createMetric(){const name=document.getElementById('metricName').value;const desc=document.getElementById('metricDesc').value;const unit=document.getElementById('metricUnit').value;const threshold=document.getElementById('metricThreshold').value;if(!name||!unit){showError('메트릭명과 단위는 필수입니다');return}fetch('/api/custom-metrics',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,description:desc,unit,threshold:threshold?parseFloat(threshold):null})}).then(r=>r.json()).then(d=>{showError('');document.getElementById('metricName').value='';document.getElementById('metricDesc').value='';document.getElementById('metricUnit').value='';document.getElementById('metricThreshold').value='';CustomMetrics.loadMetrics()}).catch(e=>showError('생성 실패: '+e))}function showError(msg){const err=document.getElementById('error');if(msg){err.textContent=msg;err.style.display='block'}else{err.style.display='none'}}CustomMetrics.init()</script></body></html>"]
    (server_html $html)))
