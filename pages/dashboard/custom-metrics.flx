; pages/dashboard/custom-metrics.flx — 커스텀 메트릭 대시보드
; 목록·생성 모두 FreeLang SSR/POST 계약으로 처리한다. 브라우저 script 없음.

(load "performance-monitor.fl")

(defn metric-card [metric]
  (h "article" {:style "background:linear-gradient(135deg,#667eea,#764ba2);color:white;padding:20px;border-radius:12px"}
    (str
      (h "h3" {:style "font-size:16px;margin:0 0 8px"} (get metric "name"))
      (h "p" {:style "font-size:13px;opacity:.85;margin:0 0 14px"} (or (get metric "description") "설명 없음"))
      (h "p" {:style "font-size:13px;margin:0"} (str "단위: " (get metric "unit")))
      (h "p" {:style "font-size:12px;margin:8px 0 0;padding:8px;background:rgba(255,255,255,.2);border-radius:6px"}
        (str "임계값: " (or (get metric "threshold") "-"))))))

(defn metric-form []
  (h "section" {:style "background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);padding:20px;margin-bottom:20px"}
    (str
      (h "h2" {:style "margin:0 0 16px;font-size:20px"} "새 메트릭 추가")
      (h "form" {:method "POST" :action "/dashboard/custom-metrics" :style "display:grid;gap:12px;max-width:560px"}
        (str
          (h "label" {:style "display:grid;gap:4px;font-size:13px;font-weight:600"} "메트릭명"
            (h "input" {:name "name" :required "true" :placeholder "예: 로그인_시간" :style "padding:10px;border:1px solid #ddd;border-radius:4px"} ""))
          (h "label" {:style "display:grid;gap:4px;font-size:13px;font-weight:600"} "설명"
            (h "input" {:name "description" :placeholder "메트릭 설명" :style "padding:10px;border:1px solid #ddd;border-radius:4px"} ""))
          (h "label" {:style "display:grid;gap:4px;font-size:13px;font-weight:600"} "단위"
            (h "input" {:name "unit" :required "true" :placeholder "예: ms, %, count" :style "padding:10px;border:1px solid #ddd;border-radius:4px"} ""))
          (h "label" {:style "display:grid;gap:4px;font-size:13px;font-weight:600"} "임계값 (선택)"
            (h "input" {:name "threshold" :type "number" :placeholder "알림 임계값" :style "padding:10px;border:1px solid #ddd;border-radius:4px"} ""))
          (h "button" {:type "submit" :style "padding:10px 16px;border:0;border-radius:4px;background:#667eea;color:white;cursor:pointer;font-weight:600;width:max-content"} "메트릭 생성"))))))

(defn metric-list [metrics]
  (h "section" {:style "background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);padding:20px"}
    (str
      (h "h2" {:style "margin:0 0 16px;font-size:20px"} "활성 메트릭")
      (if (= (length metrics) 0)
        (h "p" {:style "text-align:center;color:#999;padding:40px"} "등록된 메트릭이 없습니다")
        (h "div" {:style "display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px"}
          (arr-join (map metric-card metrics) ""))))))

(defn render-content [metrics]
  (h "main" {:style "max-width:1200px;margin:0 auto;padding:20px"}
    (str
      (h "h1" {:style "font-size:28px;margin:0 0 20px"} "📊 커스텀 메트릭")
      (metric-form)
      (metric-list metrics))))

(defn render [$req]
  (let [metrics (obj-values (get-custom-metrics))]
    (layout-html "커스텀 메트릭" (render-content metrics) $req)))

(defn render_post [$req]
  (let [body (get $req "body")
        name (get body "name")
        unit (get body "unit")
        description (or (get body "description") "")
        threshold-raw (get body "threshold")
        threshold (if (= (str threshold-raw) "") nil (str-to-num threshold-raw))]
    (if (and (not (= (str name) "")) (not (= (str unit) "")))
      (do (create-custom-metric name description unit threshold)
          (server-redirect "/dashboard/custom-metrics"))
      (server-redirect "/dashboard/custom-metrics"))))
