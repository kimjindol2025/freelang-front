; pages/dashboard/sla.flx — SLO/SLA 대시보드
; 데이터 조회·표현을 모두 FreeLang SSR로 처리한다. 브라우저 polling script 없음.

(load "performance-monitor.fl")

(defn sla-row [metric]
  (let [ok (get metric "compliant")]
    (h "tr" {}
      (str
        (h "td" {:style "padding:12px;border-bottom:1px solid #eee"} (get metric "metric"))
        (h "td" {:style "padding:12px;border-bottom:1px solid #eee;text-align:right"} (str (get metric "total-requests")))
        (h "td" {:style "padding:12px;border-bottom:1px solid #eee;text-align:right"} (str (get metric "passed-requests")))
        (h "td" {:style "padding:12px;border-bottom:1px solid #eee;text-align:right"} (str (get metric "success-percentage") "%"))
        (h "td" {:style "padding:12px;border-bottom:1px solid #eee;text-align:right"} (str (get metric "slo-target") "%"))
        (h "td" {:style (str "padding:12px;border-bottom:1px solid #eee;color:" (if ok "#15803d" "#b91c1c") ";font-weight:700")}
          (if ok "✓ 준수" "✗ 미준수"))))))

(defn render [$req]
  (let [status  (get-sla-status)
        metrics (get status "metrics")
        ok      (get status "all-compliant")]
    (layout-html "SLO/SLA"
      (str
        (h "main" {:style "max-width:1200px;margin:0 auto;padding:20px"}
          (str
            (h "h1" {:style "font-size:28px;margin:0 0 20px"} "SLO/SLA")
            (h "section" {:style (str "padding:20px;border-radius:8px;margin-bottom:20px;background:" (if ok "#d4edda" "#f8d7da") ";color:" (if ok "#155724" "#721c24"))}
              (str
                (h "div" {:style "font-size:13px"} (if ok "전체 SLO 준수" "SLO 미준수 항목 있음"))
                (h "strong" {:style "font-size:36px;display:block;margin-top:6px"}
                  (str (get status "compliance-rate") "%"))))
            (h "section" {:style "background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);padding:20px;overflow:auto"}
              (h "table" {:style "width:100%;border-collapse:collapse"}
                (str
                  (h "thead" {}
                    (h "tr" {:style "background:#f9f9f9;text-align:left"}
                      (str
                        (h "th" {:style "padding:12px"} "메트릭")
                        (h "th" {:style "padding:12px;text-align:right"} "총")
                        (h "th" {:style "padding:12px;text-align:right"} "성공")
                        (h "th" {:style "padding:12px;text-align:right"} "율")
                        (h "th" {:style "padding:12px;text-align:right"} "목표")
                        (h "th" {:style "padding:12px"} "상태"))))
                  (h "tbody" {} (arr-join (map sla-row metrics) ""))))))))
      $req)))
