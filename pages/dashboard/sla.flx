; pages/dashboard/sla.flx — SLO/SLA 대시보드 (v0.9.0)

(defn render [$req]
  (let [$html "<html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>SLO/SLA</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f5f5f5;padding:20px}h1{font-size:28px}.container{max-width:1200px;margin:0 auto}.card{background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);padding:20px;margin:20px 0}.status-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.status-card{padding:20px;border-radius:8px;text-align:center}.status-card.pass{background:#d4edda;color:#155724}.status-card.fail{background:#f8d7da;color:#721c24}.status-value{font-size:36px;font-weight:700}.metrics-table{width:100%;border-collapse:collapse}th,td{padding:12px;text-align:left;border-bottom:1px solid #eee}th{background:#f9f9f9;font-weight:600}.badge{padding:4px 8px;border-radius:4px;font-size:11px}.badge.ok{background:#d4edda;color:#155724}.badge.warn{background:#fff3cd;color:#856404}</style></head><body><div class=\"container\"><h1>SLO/SLA</h1><div class=\"status-grid\" id=\"s\"></div><div class=\"card\"><table class=\"metrics-table\"><thead><tr><th>메트릭</th><th>총</th><th>성공</th><th>율</th><th>목표</th><th>상태</th></tr></thead><tbody id=\"m\"></tbody></table></div></div><script>const D={load(){fetch('/api/sla/status').then(r=>r.json()).then(d=>this.render(d))},render(d){const c=document.getElementById('s');const g=d['all-compliant']?'pass':'fail';c.innerHTML='<div class=\"status-card '+g+'\"><div class=\"status-value\">'+d['compliance-rate']+'%</div></div>';const m=document.getElementById('m');m.innerHTML=(d.metrics||[]).map(x=>'<tr><td>'+x.metric+'</td><td>'+x['total-requests']+'</td><td>'+x['passed-requests']+'</td><td>'+x['success-percentage']+'%</td><td>'+x['slo-target']+'%</td><td>'+(x.compliant?'✓':'✗')+'</td></tr>').join('')}};D.load();setInterval(()=>D.load(),10000)</script></body></html>"]
    (server_html $html)))
