; FreeLang 공식 홈페이지
; /freelang

(defn render [req]
  (server_html (str
    "<!DOCTYPE html><html lang='ko'><head>"
    "<meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>FreeLang — AI가 쓰고 인간이 읽는 언어</title>"
    "<style>"
    "* { margin: 0; padding: 0; box-sizing: border-box; }"
    ":root { "
    "  --bg: #080810; --surface: #0f0f1e; --accent: #7c3aed; --cyan: #06b6d4; "
    "  --text: #e0e0ff; --text-muted: #a0a0bf; --radius: 12px; "
    "}"
    "html { background: var(--bg); color: var(--text); font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; line-height: 1.6; }"
    "body { background: var(--bg); overflow-x: hidden; }"
    "nav { position: fixed; top: 0; left: 0; right: 0; height: 64px; background: rgba(8,8,16,.8); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: space-between; padding: 0 40px; z-index: 1000; border-bottom: 1px solid rgba(255,255,255,.05); }"
    ".nav-brand { font-size: 1.4rem; font-weight: 700; background: linear-gradient(135deg, #7c3aed, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-decoration: none; cursor: pointer; }"
    ".nav-links { display: flex; gap: 30px; }"
    ".nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.95rem; transition: color 0.3s; }"
    ".nav-link:hover { color: var(--accent); }"
    "main { margin-top: 64px; }"
    ".section { padding: 80px 40px; max-width: 1200px; margin: 0 auto; }"
    ".section.hero { min-height: calc(100vh - 64px); display: flex; flex-direction: column; justify-content: center; padding: 120px 40px; position: relative; overflow: hidden; }"
    ".hero-orb { position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(124,58,237,.2), transparent); border-radius: 50%; top: 10%; right: 10%; animation: float 6s ease-in-out infinite; }"
    "@keyframes float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-30px, 30px); } }"
    ".hero-content { position: relative; z-index: 1; max-width: 700px; }"
    "h1 { font-size: clamp(3rem, 8vw, 6rem); font-weight: 800; line-height: 1.1; margin-bottom: 20px; background: linear-gradient(135deg, #7c3aed, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }"
    ".hero-subtitle { font-size: 1.3rem; color: var(--text-muted); margin-bottom: 40px; line-height: 1.6; }"
    ".btn-group { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 40px; }"
    ".btn { padding: 12px 32px; border-radius: 8px; border: none; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.3s; text-decoration: none; display: inline-block; }"
    ".btn-primary { background: var(--accent); color: white; }"
    ".btn-primary:hover { background: #a78bfa; transform: translate(0, -4px); }"
    ".btn-secondary { background: transparent; border: 2px solid var(--accent); color: var(--accent); }"
    ".btn-secondary:hover { background: rgba(124,58,237,.1); transform: translate(0, -4px); }"
    ".stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; margin-top: 80px; }"
    ".stat { background: rgba(255,255,255,.02); border: 1px solid rgba(124,58,237,.2); padding: 30px; border-radius: var(--radius); text-align: center; }"
    ".stat-value { font-size: 2.5rem; font-weight: 700; color: var(--accent); margin-bottom: 10px; }"
    ".stat-label { font-size: 0.95rem; color: var(--text-muted); }"
    "h2 { font-size: 2.5rem; font-weight: 700; margin-bottom: 50px; text-align: center; background: linear-gradient(135deg, #7c3aed, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }"
    ".grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; }"
    ".feature-card { background: rgba(255,255,255,.02); border: 1px solid rgba(124,58,237,.2); padding: 40px; border-radius: var(--radius); transition: all 0.3s; }"
    ".feature-card:hover { background: rgba(255,255,255,.05); border-color: rgba(124,58,237,.5); transform: translate(0, -4px); }"
    ".feature-icon { font-size: 2.5rem; margin-bottom: 15px; }"
    ".feature-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; }"
    ".feature-desc { color: var(--text-muted); font-size: 0.95rem; }"
    ".comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 40px; }"
    ".comparison-box { background: rgba(255,255,255,.02); border: 1px solid rgba(124,58,237,.2); padding: 30px; border-radius: var(--radius); }"
    ".comparison-box h3 { font-size: 1.2rem; margin-bottom: 20px; color: var(--accent); }"
    ".comparison-item { display: flex; gap: 10px; margin-bottom: 15px; font-size: 0.95rem; }"
    ".eco-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 40px; }"
    ".eco-box { background: rgba(255,255,255,.02); border: 1px solid rgba(124,58,237,.2); padding: 25px; border-radius: var(--radius); text-align: center; }"
    ".eco-title { font-weight: 700; margin-bottom: 10px; color: var(--accent); }"
    ".eco-desc { font-size: 0.9rem; color: var(--text-muted); }"
    "footer { background: rgba(0,0,0,.3); border-top: 1px solid rgba(124,58,237,.2); padding: 40px; text-align: center; color: var(--text-muted); }"
    ".cta-footer { text-align: center; margin-bottom: 40px; }"
    "@media (max-width: 768px) { "
    "  nav { padding: 0 20px; } .section { padding: 40px 20px; } "
    "  .section.hero { padding: 80px 20px; } h1 { font-size: clamp(2rem, 6vw, 4rem); } "
    "  .comparison { grid-template-columns: 1fr; } "
    "}"
    "</style>"
    "</head><body>"
    "<nav>"
    "  <div class='nav-brand'>⚡ FreeLang</div>"
    "  <div class='nav-links'>"
    "    <a href='#features' class='nav-link'>특징</a>"
    "    <a href='#ecosystem' class='nav-link'>생태계</a>"
    "    <a href='https://gogs.dclub.kr/kim/freelang-v11' target='_blank' class='nav-link'>Gogs</a>"
    "  </div>"
    "</nav>"
    "<main>"
    "<section class='section hero'>"
    "  <div class='hero-orb'></div>"
    "  <div class='hero-content'>"
    "    <h1>AI가 쓰고,<br/>인간이 읽는 언어</h1>"
    "    <p class='hero-subtitle'>"
    "      npm install 0개. 자가호스팅 가능. 73개 프로덕션 서버에서 운영 중.<br/>"
    "      AI-Native 풀스택 언어로 마이크로서비스를 빠르고 안전하게 구축하세요."
    "    </p>"
    "    <div class='btn-group'>"
    "      <a href='https://gogs.dclub.kr/kim/freelang-v11' class='btn btn-primary'>문서 보기</a>"
    "      <a href='https://gogs.dclub.kr/kim/akl-crm' class='btn btn-secondary'>예제 보기</a>"
    "    </div>"
    "    <div class='stats'>"
    "      <div class='stat'><div class='stat-value'>73</div><div class='stat-label'>프로덕션 서버</div></div>"
    "      <div class='stat'><div class='stat-value'>76</div><div class='stat-label'>마이크로서비스</div></div>"
    "      <div class='stat'><div class='stat-value'>0</div><div class='stat-label'>npm 패키지</div></div>"
    "      <div class='stat'><div class='stat-value'>9.5/10</div><div class='stat-label'>완성도</div></div>"
    "    </div>"
    "  </div>"
    "</section>"
    "<section id='features' class='section'>"
    "  <h2>⚡ 핵심 특징</h2>"
    "  <div class='grid-3'>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>🤖</div>"
    "      <div class='feature-title'>AI-Native</div>"
    "      <div class='feature-desc'>구조·문법 모두 AI 최적화. 파라미터 추적, 타입 추론, 자동 검증이 언어에 내장됨.</div>"
    "    </div>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>🛠️</div>"
    "      <div class='feature-title'>자가호스팅</div>"
    "      <div class='feature-desc'>FreeLang으로 FreeLang을 컴파일. L4 고정점 달성으로 TypeScript 완전 제거.</div>"
    "    </div>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>🌐</div>"
    "      <div class='feature-title'>풀스택</div>"
    "      <div class='feature-desc'>백엔드(v11)와 프론트(FL-Front) 하나의 생태계. 언어 통일로 학습곡선 단축.</div>"
    "    </div>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>🔒</div>"
    "      <div class='feature-title'>보안 내장</div>"
    "      <div class='feature-desc'>CSRF/XSS 함수 내장. HTML/JS 자동 이스케이프. 세션 쿠키 안전 설정.</div>"
    "    </div>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>📦</div>"
    "      <div class='feature-title'>마이크로서비스</div>"
    "      <div class='feature-desc'>서비스당 한 파일(server.fl). PM2로 관리. 무중단 배포 기본.</div>"
    "    </div>"
    "    <div class='feature-card'>"
    "      <div class='feature-icon'>⚙️</div>"
    "      <div class='feature-title'>빠른 시작</div>"
    "      <div class='feature-desc'>포트 자동할당. 폴더 생성 후 한 줄 명령어로 배포. 30분 안에 서비스 런칭.</div>"
    "    </div>"
    "  </div>"
    "</section>"
    "<section class='section'>"
    "  <h2>📊 스택 비교</h2>"
    "  <div class='comparison'>"
    "    <div class='comparison-box'>"
    "      <h3>일반적인 풀스택</h3>"
    "      <div class='comparison-item'>✗ 언어 3개 (JS + TS + Python/Go)</div>"
    "      <div class='comparison-item'>✗ 학습곡선 높음</div>"
    "      <div class='comparison-item'>✗ npm 100+ 패키지</div>"
    "      <div class='comparison-item'>✗ 빌드 단계 복잡</div>"
    "      <div class='comparison-item'>✗ 배포 파이프라인 관리</div>"
    "    </div>"
    "    <div class='comparison-box'>"
    "      <h3>FreeLang 풀스택</h3>"
    "      <div class='comparison-item'>✓ 언어 1개 (FL)</div>"
    "      <div class='comparison-item'>✓ 최소 학습곡선</div>"
    "      <div class='comparison-item'>✓ 의존성 0개</div>"
    "      <div class='comparison-item'>✓ 빌드 자동화</div>"
    "      <div class='comparison-item'>✓ PM2 한 줄</div>"
    "    </div>"
    "  </div>"
    "</section>"
    "<section id='ecosystem' class='section'>"
    "  <h2>🌿 생태계</h2>"
    "  <div class='eco-grid'>"
    "    <div class='eco-box'>"
    "      <div class='eco-title'>BackEnd</div>"
    "      <div class='eco-desc'>FreeLang v11<br/>server_start<br/>db-query<br/>Route API</div>"
    "    </div>"
    "    <div class='eco-box'>"
    "      <div class='eco-title'>↔️ 통합</div>"
    "      <div class='eco-desc'>단일 언어<br/>AI 관리<br/>자동 배포<br/>무중단 전환</div>"
    "    </div>"
    "    <div class='eco-box'>"
    "      <div class='eco-title'>FrontEnd</div>"
    "      <div class='eco-desc'>FreeLang Front<br/>pages/*.flx<br/>SSR + Island<br/>h() Builder</div>"
    "    </div>"
    "  </div>"
    "</section>"
    "<section class='section cta-footer'>"
    "  <h2>지금 시작하세요</h2>"
    "  <p style='color:var(--text-muted); font-size:1.1rem; margin-bottom:30px;'>"
    "    Gogs에서 문서와 예제를 확인하고, 30분 안에 첫 서비스를 배포하세요."
    "  </p>"
    "  <div class='btn-group' style='justify-content:center;'>"
    "    <a href='https://gogs.dclub.kr/kim/freelang-v11' class='btn btn-primary'>📖 언어 레퍼런스</a>"
    "    <a href='https://gogs.dclub.kr/kim/akl-payment' class='btn btn-secondary'>💰 결제 앱 예제</a>"
    "  </div>"
    "</section>"
    "</main>"
    "<footer>"
    "  <p>&copy; 2026 FreeLang Project. Made with AI, for AI.</p>"
    "</footer>"
    "</body></html>")))
