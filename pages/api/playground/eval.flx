; pages/api/playground/eval.flx — FL 코드 실행 API
; POST /api/playground/eval  { "code": "(+ 1 2)" }

(defn render [req]
  (server-json {:ok false :error "POST 메서드를 사용하세요"} 405))

(defn playground-authorized? [req]
  (let [token (fl-env-get "FL_PLAYGROUND_TOKEN")
        provided (server-req-header req "x-fl-playground-token")]
    (and (= (fl-env-get "FL_DEV") "1")
         (or (and (not (nil? token)) (not (= token "")) (= token provided))
             (auth-check req)))))

(defn render_post [req]
  (if (not (playground-authorized? req))
    (server-json {:ok false :error "개발 모드와 인증이 필요합니다"} 403)
    (let [body (get req "body")
          code (get body "code")]
      (if (nil-or-empty? code)
        (server-json {:ok false :error "코드가 없습니다"} 400)
        (if (> (length code) 4000)
          (server-json {:ok false :error "코드는 4000자 이하만 실행할 수 있습니다"} 413)
          (let [tmp (str "/tmp/pg-" (uuid) ".fl")
                runtime (or (fl-env-get "FL_RUNTIME_BOOTSTRAP") "runtime/bootstrap.js")]
            (file-write tmp (str "(println " code ")"))
            (let [out (shell-exec-stdout (str "timeout 5 node " runtime " run " tmp " 2>&1"))]
              (file-delete tmp)
              (if (nil? out)
                (server-json {:ok false :error "실행 실패 또는 타임아웃 (5초)"} 408)
                (if (str-includes out "실행 오류")
                  (server-json {:ok false :error (str-trim out)} 422)
                  (server-json {:ok true :result (str-trim out)}))))))))))
