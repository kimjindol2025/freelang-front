; pages/api/logs/recent — 최근 로그 JSON (폴링용)
; GET /api/logs/recent  또는  /api/logs/stream

(define LOG-LEVELS ["info" "info" "info" "warn" "error" "debug"])
(define LOG-MSGS {
  "info"  ["요청 처리 완료" "DB 쿼리 실행" "캐시 히트" "응답 전송" "세션 갱신"]
  "warn"  ["응답 지연 감지" "메모리 사용량 높음" "재시도 발생" "인증 만료 임박"]
  "error" ["DB 연결 실패" "타임아웃 발생" "인증 오류" "파일 없음"]
  "debug" ["변수 상태 확인" "함수 진입" "조건 분기" "캐시 미스"]
})

(defn rand-log []
  (let [t   (mod (now-ms) 1000000)
        lv  (nth LOG-LEVELS (mod t (length LOG-LEVELS)))
        msgs (get LOG-MSGS lv)
        msg (nth msgs (mod (quot t 7) (length msgs)))]
    {:time (format-date (now-ms) "HH:mm:ss")
     :level lv
     :msg msg}))

(defn render [req]
  (let [logs (map (fn [_] (rand-log)) (range 0 5))]
    (server-json {:ok true :logs logs})))
