; pages/api-alerts.flx — 실시간 알림 API (v0.7.0)

(load "performance-monitor.fl")

(defn render [$req]
  (let [$path (get $req "path")]
    (cond
      (str-includes $path "/api/alerts/stream")
      (handle-alerts-stream $req)

      (str-includes $path "/api/alerts")
      (handle-get-alerts $req)

      true
      (server-json {"error" "Not Found"} 404))))

; ── GET /api/alerts (알림 목록) ──
(defn handle-get-alerts [$req]
  (try
    (let [$query (get $req "query")
          $limit (str-to-num (or (get $query "limit") "50"))]
      (let [$result (get-alerts $limit)]
        (server-json $result 200)))

    (catch $e
      (log-error (str "Error handling GET /api/alerts: " $e))
      (server-json {"error" "Failed to retrieve alerts"} 500))))

; ── GET /api/alerts/stream (SSE 미지원 → 폴링 안내) ──
(defn handle-alerts-stream [$req]
  (server-json {
    "error" "SSE streaming not supported"
    "hint" "Use GET /api/alerts with polling instead"
    "poll_interval_ms" 3000
  } 501))
