; @contract
; route: /api/afldb
; purpose: afl-db-read-write-api
; type: api
; pattern: API_MUTATION
; routes:
;   read: GET /api/afldb
;   write: POST /api/afldb
; state:
;   source: server
;   mutable: true
; requires:
;   auth: none
; checks:
;   syntax: PASS
;   route: PASS
;   schema: PASS
;   smoke: PASS
; last_verified:
;   commit: d7f7ec1
; @endcontract

; /api/afldb — freelang-front ↔ afl-db 연결 API
; GET  → 상태
; POST → {"action":"put"|"get"|"probe"|"batch-get"|"history", ...}

(defn render [req]
  (server-json (afldb-status)))

(defn render_post [req]
  (let [payload (form-data req)
        action  (str (get payload "action"))]
    (cond
      (= action "put")
      (let [key (str (get payload "key"))
            val (get payload "value")
            res (afldb-put key val)]
        (server-json {"ok" true "action" "put" "key" key "result" res}))

      (= action "get")
      (let [key (str (get payload "key"))
            val (afldb-get key nil)]
        (server-json {"ok" true "action" "get" "key" key "value" val}))

      (= action "batch-get")
      (let [keys (get payload "keys")
            items (afldb-batch-get keys)]
        (server-json {"ok" true "action" "batch-get" "items" items}))

      (= action "history")
      (let [key (str (get payload "key"))
            events (afldb-history key)]
        (server-json {"ok" true "action" "history" "key" key "events" events}))

      (= action "probe")
      (let [key (str "freelang-front:probe:" (now-ms))
            put-res (afldb-put key {"hello" "afldb" "from" "freelang-front"})
            got (afldb-get key nil)
            batch (afldb-batch-get [key])]
        (server-json {"ok" true
                      "action" "probe"
                      "key" key
                      "put" put-res
                      "value" got
                      "batch" batch
                      "roundtrip" (= (get got "hello") "afldb")}))

      true
      (server-json {"ok" false "error" "unknown action — put|get|probe|batch-get|history"}))))
