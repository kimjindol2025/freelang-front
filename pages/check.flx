; @contract
; route: /check
; purpose: readiness-dashboard
; type: page
; pattern: UI_PAGE
; routes:
;   read: GET /api/afldb
;   read: GET /roadmap
; state:
;   source: server
;   mutable: false
; requires:
;   auth: none
; checks:
;   syntax: PASS
;   route: PASS
;   schema: PASS
;   smoke: PASS
; last_verified:
;   commit: f0e4a02
; @endcontract

; /check — FreeLang Front 사용 가능 점검 / 홍보 페이지
; afl-db 연결 + 최근 빌드 diagnostics 요약

(defn check-build-diag []
  (let [raw (file-read ".build-state.json")
        st  (if (or (= raw nil) (= raw ""))
              nil
              (json_parse raw))]
    (if (= st nil)
      {"ok" false "errors" "-" "warnings" "-" "schema" "-" "codes" "-"}
      {"ok" (= (get st "ok") true)
       "errors" (str (get (get st "summary") "errors"))
       "warnings" (str (get (get st "summary") "warnings"))
       "codes" (str (get (get st "summary") "diagnosticCodeCount"))
       "schema" (if (= (get st "schema") nil) "-" (get st "schema"))})))

(defn render [req]
  (let [db     (afldb-status)
        ver    (afldb-verify)
        diag   (check-build-diag)
        db-ok  (and (= (get db "ok") true)
                    (or (= (get ver "ok") true)
                        (= (str (get ver "ok")) "true")))
        badge  (if db-ok "사용 가능" "연결 실패")
        badge-cls (if db-ok "ok" "warn")
        records (if db-ok (str (get db "records")) "-")
        keys    (if db-ok (str (get db "keys")) "-")
        base    (if (= (get db "base") nil) "http://127.0.0.1:40610" (get db "base"))
        diag-badge (if (= (get diag "ok") true) "빌드 OK" "진단 없음")
        diag-cls (if (= (get diag "ok") true) "ok" "warn")
        err-n (get diag "errors")
        warn-n (get diag "warnings")
        code-n (get diag "codes")]
    (layout-html "FreeLang Front 사용 가능 점검"
      (str
        """
<style>
:root{
  --bg:#09090f;--panel:#12131c;--panel2:#171925;--line:rgba(139,92,246,.18);
  --ink:#eef2ff;--muted:#98a2b3;--violet:#8b5cf6;--indigo:#6366f1;--cyan:#22d3ee;
  --ok:#22c55e;--warn:#f59e0b;
}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#09090f,#0d1020 40%,#09090f);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
a{text-decoration:none}
.wrap{max-width:1120px;margin:0 auto;padding:36px 22px 80px}
.hero{
  position:relative;overflow:hidden;margin-bottom:18px;padding:44px 34px;border-radius:24px;
  border:1px solid var(--line);background:
    radial-gradient(circle at top right, rgba(34,211,238,.12), transparent 28%),
    radial-gradient(circle at left center, rgba(139,92,246,.18), transparent 30%),
    linear-gradient(135deg,#131726,#0f1220 55%,#12182c);
  box-shadow:0 30px 80px rgba(0,0,0,.45);
}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;
  border:1px solid rgba(139,92,246,.3);background:rgba(139,92,246,.12);
  color:#d8ccff;font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase
}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(34,197,94,.14)}
.hero h1{margin:20px 0 14px;font-size:clamp(2rem,4vw,3.7rem);line-height:1.05;letter-spacing:-.04em}
.hero p{margin:0;max-width:680px;color:var(--muted);font-size:1.02rem;line-height:1.8}
.hero p strong{color:var(--ink)}
.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.btn{
  display:inline-block;padding:12px 18px;border-radius:12px;font-size:.92rem;font-weight:800;
  transition:transform .18s ease,opacity .18s ease
}
.btn:hover{transform:translateY(-2px)}
.btn-fill{background:linear-gradient(135deg,var(--violet),var(--indigo));color:white}
.btn-line{border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}
.card{
  background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.02));
  border:1px solid var(--line);border-radius:18px;padding:22px 20px;box-shadow:0 12px 34px rgba(0,0,0,.18)
}
.label{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#c4b5fd;font-weight:800;margin-bottom:10px}
.value{font-size:1.9rem;font-weight:900;letter-spacing:-.04em}
.sub{margin-top:8px;color:var(--muted);font-size:.84rem;line-height:1.6}
.section{margin-top:34px}
.section h2{margin:0 0 14px;font-size:1.25rem;letter-spacing:-.03em}
.section p.lead{margin:0 0 16px;color:var(--muted);line-height:1.7}
.checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.check{
  background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px;
}
.check-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}
.check-title{font-size:1rem;font-weight:800}
.badge{
  display:inline-block;padding:6px 10px;border-radius:999px;font-size:.72rem;font-weight:900;letter-spacing:.05em
}
.ok{background:rgba(34,197,94,.14);color:#86efac;border:1px solid rgba(34,197,94,.22)}
.warn{background:rgba(245,158,11,.14);color:#fcd34d;border:1px solid rgba(245,158,11,.22)}
.fixed{background:rgba(34,211,238,.12);color:#67e8f9;border:1px solid rgba(34,211,238,.18)}
.check p{margin:0;color:var(--muted);font-size:.88rem;line-height:1.7}
.demo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.demo{
  display:block;background:var(--panel2);border:1px solid var(--line);border-radius:18px;
  padding:20px;color:inherit
}
.demo-k{font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#c4b5fd;margin-bottom:8px}
.demo-t{font-size:1.05rem;font-weight:800;margin-bottom:8px}
.demo-d{color:var(--muted);font-size:.86rem;line-height:1.65}
.foot{
  margin-top:34px;padding:22px;border-radius:18px;border:1px solid rgba(34,211,238,.16);
  background:linear-gradient(135deg,rgba(34,211,238,.07),rgba(139,92,246,.06))
}
.foot strong{display:block;margin-bottom:8px;font-size:1rem}
.foot p{margin:0;color:var(--muted);line-height:1.75}
@media(max-width:860px){
  .grid,.demo-grid{grid-template-columns:1fr}
  .checks{grid-template-columns:1fr}
  .hero{padding:34px 24px}
}
</style>
"""
        (str
          """
<div class="wrap">
  <section class="hero">
    <div class="eyebrow"><span class="dot"></span>FreeLang Front Readiness</div>
    <h1>지금 바로 써볼 수 있는지<br>한 화면에서 점검합니다</h1>
    <p>
      이 페이지는 <strong>프리랭 프론트가 실제로 앱을 만들고 운영할 수 있는지</strong>를
      afl-db 연결과 최근 빌드 진단 기준으로 보여주는 점검 페이지입니다. 언어는 한국어 고정입니다.
    </p>
    <div class="hero-actions">
      <a href="/api/afldb" class="btn btn-fill">afl-db 상태 JSON →</a>
      <a href="/dashboard" class="btn btn-line">운영 대시보드</a>
      <a href="/roadmap" class="btn btn-line">로드맵 허브</a>
