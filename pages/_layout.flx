; pages/_layout.flx — 공통 레이아웃 헬퍼 (h() SSR 적용)

(style layout_nav :bg "#6366f1" :p "0 24px" :display "flex" :items "center" :gap "4px")
(style layout_wrap :max-w "960px" :mx "auto" :p "32px 24px")
(style layout_foot :align "center" :p "32px" :color "#9ca3af" :size ".8rem"
  :border-top "1px solid #e5e7eb" :mt "48px")
(style nav-brand :color "white" :weight "700" :size "1.1rem" :mr "16px" :decoration "none")
(style nav-link-base :color "white" :decoration "none" :p "12px 16px" :display "block")
(style global-style :bg "#f9fafb" :color "#111")

; DEV CSP — inline style + HMR connect 허용
(define DEV-CSP "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob:; connect-src 'self' http://localhost:40851 ws://localhost:40851; font-src 'self' data:")

; nav 링크 — 현재 경로 강조 + SPA 라우팅
(defn nav-link [href label current]
  (if (= href current)
    (h "a" {:href href :class nav-link-base :data-spa "1" :style "background:rgba(255,255,255,.2)"} label)
    (h "a" {:href href :class nav-link-base :data-spa "1" :style "opacity:.8"} label)))

; 공통 글로벌 CSS
(define GLOBAL-CSS
  "<style>*{box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;margin:0;background:#f9fafb;color:#111}</style>")

; HMR 클라이언트 스크립트
(define HMR-SCRIPT
  "<script>(function(){var es=new EventSource('http://'+location.hostname+':40851/~hmr');es.onmessage=function(e){if(e.data==='reload')location.reload();};es.onerror=function(){setTimeout(function(){es.close();},5000);};})()</script>")

; SPA 클라이언트 라우터 — Island 없는 페이지에도 동작
(define SPA-ROUTER
  "<script>(function(){
function spa(href){
  fetch(href,{headers:{'X-SPA':'1'}})
    .then(function(r){return r.text();})
    .then(function(html){
      var doc=new DOMParser().parseFromString(html,'text/html');
      var nw=doc.querySelector('[class*=\"layout_wrap\"]');
      var cw=document.querySelector('[class*=\"layout_wrap\"]');
      if(nw&&cw)cw.innerHTML=nw.innerHTML;
      doc.querySelectorAll('script:not([src])').forEach(function(s){
        if(s.textContent.indexOf('_fl.')>-1){try{eval(s.textContent);}catch(e){}}
      });
      if(window._fl)window._fl.dispatch('route',href);
      history.pushState({href:href},'',href);
      window.scrollTo(0,0);
    })
    .catch(function(){location.href=href;});
}
document.addEventListener('click',function(e){
  var a=e.target.closest('[data-spa]');
  if(!a)return;
  e.preventDefault();
  spa(a.getAttribute('href'));
});
window.addEventListener('popstate',function(e){
  var href=e.state&&e.state.href?e.state.href:location.pathname;
  spa(href);
});
})()</script>")

; ── SEO meta 태그 생성 ──
; 사용: (seo-tags {:title "제목" :desc "설명" :image "/og.png" :type "article"})
(defn seo-tags [m]
  (let [title  (if (= (get m "title") nil) "" (str (get m "title")))
        desc   (if (= (get m "desc") nil) "" (str (get m "desc")))
        image  (get m "image")
        type   (if (= (get m "type") nil) "website" (str (get m "type")))
        url    (if (= (get m "url") nil) "" (str (get m "url")))]
    (str
      (h! "meta" {:name "description" :content desc})
      (h! "meta" {:property "og:title" :content title})
      (h! "meta" {:property "og:description" :content desc})
      (h! "meta" {:property "og:type" :content type})
      (if (= image nil) "" (h! "meta" {:property "og:image" :content (str image)}))
      (if (= url "") "" (h! "meta" {:property "og:url" :content url}))
      (h! "meta" {:name "twitter:card" :content "summary_large_image"})
      (h! "meta" {:name "twitter:title" :content title})
      (h! "meta" {:name "twitter:description" :content desc})
      (if (= image nil) "" (h! "meta" {:name "twitter:image" :content (str image)})))))

; 공통 레이아웃 → HTML 문자열 (meta-str: seo-tags 결과 또는 nil)
(defn layout-core [title content req meta-str]
  (let [path (server-req-path req)]
    (str
      "<!DOCTYPE html>"
      (h "html" {:lang "ko"}
        (str
          (h "head" {}
            (str
              (h! "meta" {:charset "utf-8"})
              (h! "meta" {:name "viewport" :content "width=device-width,initial-scale=1"})
              (h "title" {} (str title " — FreeLang Front"))
              (if (= meta-str nil) "" meta-str)
              GLOBAL-CSS))
          (h "body" {}
            (str
              (h "nav" {:class layout_nav}
                (str
                  (h "a" {:href "/" :class nav-brand} "FL Front")
                  (nav-link "/" "홈" path)
                  (nav-link "/dashboard" "대시보드" path)
                  (nav-link "/counter" "카운터" path)
                  (nav-link "/contact" "문의" path)
                  (nav-link "/styled" "스타일" path)
                  (nav-link "/todo" "To-do" path)
                  (nav-link "/notes" "Notes" path)
                  (nav-link "/about" "About" path)
                  (h "a" {:href "/logout" :class nav-link-base :style "opacity:.8;margin-left:auto"} "로그아웃")))
              (h "div" {:class layout_wrap} content)
              (h "footer" {:class layout_foot} "FreeLang Front v0.1 · npm install 0개 · SSR · Island")
              SPA-ROUTER
              HMR-SCRIPT)))))))

; layout — 기존 호환 유지
(defn layout [title content req]
  (layout-core title content req nil))

; layout-html — server-html + DEV CSP
(defn layout-html [title content req]
  (server_header
    (server-html (layout title content req))
    "Content-Security-Policy" DEV-CSP))

; layout-html-seo — SEO meta 포함 버전
; 사용: (layout-html-seo "제목" content req {:title "..." :desc "..." :image "/og.png"})
(defn layout-html-seo [title content req seo-opts]
  (server_header
    (server-html (layout-core title content req (seo-tags seo-opts)))
    "Content-Security-Policy" DEV-CSP))
