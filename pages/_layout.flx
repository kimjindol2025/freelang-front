; pages/_layout.flx — 공통 레이아웃 헬퍼
; 라우트로 등록되지 않음 (빌드 스크립트가 _ 접두사 제외)
; 사용: (layout "페이지 제목" "body HTML 내용")

(style layout_nav :bg "#6366f1" :p "0")
(style layout_wrap :width "100%" :display "grid")

; nav link 현재 페이지 강조 여부 반환
(defn nav-link [href label current]
  (if (= href current)
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;background:rgba(255,255,255,.2)'>" label "</a>")
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;opacity:.8'>" label "</a>")))

; 공통 레이아웃 — title, content, 현재 path
(defn layout [title content req]
  (let [path (server-req-path req)]
    (str
      "<!DOCTYPE html><html lang='ko'><head>"
      "<meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>" title " — FreeLang Front</title>"
      "<style>"
      "*{box-sizing:border-box}"
      "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;margin:0;background:#f9fafb;color:#111}"
      ".lnav{background:#6366f1;padding:0 24px;display:flex;align-items:center;gap:4px}"
      ".lnav-brand{color:white;font-weight:700;font-size:1.1rem;margin-right:16px;text-decoration:none}"
      ".lwrap{max-width:960px;margin:0 auto;padding:32px 24px}"
      ".lfoot{text-align:center;padding:32px;color:#9ca3af;font-size:.8rem;border-top:1px solid #e5e7eb;margin-top:48px}"
      "</style>"
      "</head><body>"
      "<nav class='lnav'>"
      "<a href='/' class='lnav-brand'>FL Front</a>"
      (nav-link "/" "홈" path)
      (nav-link "/dashboard" "대시보드" path)
      (nav-link "/counter" "카운터" path)
      (nav-link "/contact" "문의" path)
      (nav-link "/styled" "스타일" path)
      (nav-link "/todo" "To-do" path)
      "<a href='/logout' style='color:white;text-decoration:none;padding:12px 16px;display:inline-block;opacity:.8;margin-left:auto'>로그아웃</a>"
      "</nav>"
      "<div class='lwrap'>"
      content
      "</div>"
      "<footer class='lfoot'>FreeLang Front v0.1 · npm install 0개 · SSR · Island</footer>"
      "</body></html>")))
