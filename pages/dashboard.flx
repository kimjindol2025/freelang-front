; server-fn — DB에서 통계 조회
(server-fn fetch-stats []
  (db-fetch-stats))

(style stat_card :bg "white" :p "24px" :radius "12px" :shadow "sm")
(style grid      :display "grid" :cols 3 :gap "16px")
(style chart_box :bg "white" :p "24px" :radius "12px" :shadow "sm")

; 숫자 포맷 (백만 단위)
(defn fmt-num [n]
  (let [s   (str n)
        len (length s)]
    (if (> len 6)
      (str (str-slice s 0 (- len 6)) "백" (str-slice s (- len 6) (- len 4)) "만")
      s)))

(defn render [req]
  (auth-required req (fn [user]
  (let [stats   (fetch-stats)
        users   (get stats :users)
        revenue (get stats :revenue)
        orders  (get stats :orders)
        monthly (get stats :monthly)
        weekly  (get stats :weekly)
        bar     (chart-bar monthly 480 200)
        line    (chart-line weekly 480 200)]
    (layout-html "Dashboard" (str
        "<h2 style='margin:0 0 4px'>📊 FreeLang Front Dashboard</h2>"
        "<p style='color:#6b7280;margin:0 0 24px'>npm install 0개 · SSR · CSS DSL · Island · SVG Chart</p>"

        ; 통계 카드 3개
        "<div class='" grid "' style='margin-bottom:24px'>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>" users "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 사용자</div>"
        "</div>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>₩" (fmt-num revenue) "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 매출</div>"
        "</div>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>" orders "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 주문</div>"
        "</div>"
        "</div>"

        ; 차트 2개 — 나란히
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>"
        "<div class='" chart_box "'>"
        "<h3 style='margin:0 0 12px;font-size:.95rem;color:#374151'>📊 월별 매출 막대 차트</h3>"
        bar
        "</div>"
        "<div class='" chart_box "'>"
        "<h3 style='margin:0 0 12px;font-size:.95rem;color:#374151'>📈 주간 방문 선 차트</h3>"
        line
        "</div>"
        "</div>") req)))))
