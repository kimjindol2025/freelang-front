; pages/app/_db.flx — 노트앱 SQLite 헬퍼
; fl-front에서 (load "pages/app/_db.flx") 로 사용

(define APP-DB {:type "sqlite" :path "data/notes-app.db"})

(defn app-notes-init []
  (db-exec APP-DB
    "CREATE TABLE IF NOT EXISTS notes (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      content TEXT NOT NULL,
      pinned INTEGER DEFAULT 0,
      created_at TEXT DEFAULT (datetime('now','localtime'))
    )" []))

(defn app-notes-all []
  (db-query APP-DB
    "SELECT * FROM notes ORDER BY pinned DESC, id DESC" []))

(defn app-note-add [content]
  (db-exec APP-DB
    "INSERT INTO notes (content) VALUES (?)" [(str-trim content)]))

(defn app-note-delete [id]
  (db-exec APP-DB
    "DELETE FROM notes WHERE id = ?" [(str-to-num id)]))

(defn app-note-pin-toggle [id]
  (db-exec APP-DB
    "UPDATE notes SET pinned = CASE WHEN pinned=1 THEN 0 ELSE 1 END WHERE id = ?"
    [(str-to-num id)]))
