; pages/app/index.flx — 노트앱
; SSR 초기 목록 + Island 폼·삭제·핀
; GET /app

(load "pages/app/_db.flx")

(app-notes-init)

; ── Island: 노트 UI 전체 ───────────────────────────────────
(island NoteApp []
  (let [notes  (atom nil)
        draft  (atom "")
        err    (atom "")
        loading (atom false)

        refresh (fn [data]
                  (reset! notes (get data "notes"))
                  (reset! loading false))

        add (fn []
              (let [text (str-trim @draft)]
                (if (= text "")
                  (reset! err "내용을 입력하세요")
                  (do
                    (reset! err "")
                    (reset! loading true)
                    (fetch-post! "/app/api" {"action" "add" "content" text}
                      (fn [res]
                        (when (get res "ok")
                          (reset! draft "")
                          (refresh res))))))))

        del (fn [id]
              (fetch-post! "/app/api" {"action" "delete" "id" id}
                (fn [res] (when (get res "ok") (refresh res)))))

        pin (fn [id]
              (fetch-post! "/app/api" {"action" "pin" "id" id}
                (fn [res] (when (get res "ok") (refresh res)))))]

    ; 최초 로드
    (fetch! "/app/api-init"
      (fn [res] (reset! notes (get res "notes"))))

    (h "div" {:style "max-width:640px;margin:0 auto;padding:24px"}

      ; 폼
      (h "div" {:style "background:white;border-radius:12px;padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.08);margin-bottom:24px"}
        (str
          (h "textarea" {:rows "3" :placeholder "새 노트를 입력하세요…"
                         :value @draft
                         :style "width:100%;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:.95rem;resize:none;font-family:inherit"
                         :on-input (fn [e] (reset! draft (.-value (.-target e))))
                         :on-keydown (fn [e]
                           (when (and (.-ctrlKey e) (= (.-key e) "Enter"))
                             (add)))})
          (h "div" {:style "display:flex;justify-content:space-between;align-items:center;margin-top:10px"}
            (str
              (h "span" {:style "color:#ef4444;font-size:.85rem"} (if (= @err "") "" @err))
              (h "button" {:style (str "background:#6366f1;color:white;border:none;border-radius:8px;padding:8px 20px;cursor:pointer;font-weight:600;" (if @loading "opacity:.6" ""))
                           :on-click (fn [] (add))}
                (if @loading "저장 중…" "추가 (Ctrl+Enter)"))))))

      ; 목록
      (if (= @notes nil)
        (h "div" {:style "text-align:center;padding:40px;color:#9ca3af"} "로딩 중…")
        (if (= (length @notes) 0)
          (h "div" {:style "text-align:center;padding:40px;color:#9ca3af"} "노트가 없습니다")
          (h "div" {:style "display:flex;flex-direction:column;gap:12px"}
            (map
              (fn [note]
                (h "div" {:style (str "background:white;border-radius:12px;padding:16px 20px;box-shadow:0 1px 4px rgba(0,0,0,.08);border-left:3px solid " (if (= (get note "pinned") 1) "#6366f1" "transparent"))}
                  (str
                    (h "div" {:style "display:flex;justify-content:space-between;align-items:flex-start;gap:12px"}
                      (str
                        (h "p" {:style "margin:0;flex:1;line-height:1.6;white-space:pre-wrap;word-break:break-word"}
                          (get note "content"))
                        (h "div" {:style "display:flex;gap:6px;flex-shrink:0"}
                          (str
                            (h "button" {:title "핀" :style "background:none;border:none;cursor:pointer;font-size:1rem;padding:2px"
                                         :on-click (fn [] (pin (str (get note "id"))))}
                              (if (= (get note "pinned") 1) "📌" "📍"))
                            (h "button" {:title "삭제" :style "background:none;border:none;cursor:pointer;font-size:1rem;padding:2px;color:#ef4444"
                                         :on-click (fn [] (del (str (get note "id"))))}
                              "×")))))
                    (h "div" {:style "font-size:.75rem;color:#9ca3af;margin-top:8px"}
                      (get note "created_at")))))
              @notes)))))))

; ── GET /app/api-init — Island 초기 로드용 ──────────────────
; (별도 api.flx 없이 같은 파일에서 처리 가능하나
;  fl-front는 파일 = 라우트이므로 api.flx 사용)

; ── SSR 렌더 ─────────────────────────────────────────────────
(defn render [req]
  (let [notes (app-notes-all)]
    (layout-html "노트앱"
      (str
        (h "div" {:style "background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;padding:32px 24px;text-align:center;margin-bottom:0"}
          (str
            (h "h1" {:style "font-size:1.8rem;font-weight:800;margin:0 0 6px"} "📝 노트앱")
            (h "p" {:style "opacity:.85;margin:0;font-size:.9rem"}
              (str "FreeLang Island + SSR + SQLite · " (length notes) "개 노트"))))
        "ISLAND_PLACEHOLDER"
        "ISLAND_SCRIPTS")
      req)))
