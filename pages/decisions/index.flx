; pages/decisions/index.flx — 결정 일지
; 선택지 탭 선택 · 날짜 필터 · 모바일 터치 타깃

(load "pages/decisions/_db.flx")
(decisions-init)

(island DecisionsApp []
  (let [data       (atom nil)
        show-form  (atom false)
        title-in   (atom "")
        context-in (atom "")
        options-in (atom "")
        err        (atom "")
        expand-id  (atom nil)
        chosen-in  (atom "")
        outcome-in (atom "")
        day-filter (atom "all")

        apply-res (fn [res]
                    (reset! data res)
                    (reset! show-form false)
                    (reset! title-in "")
                    (reset! context-in "")
                    (reset! options-in "")
                    (reset! err "")
                    (reset! expand-id nil)
                    (reset! chosen-in "")
                    (reset! outcome-in ""))

        reload (fn [res]
                 (if (= (get res "ok") false)
                   (reset! err (or (get res "error") "요청 실패"))
                   (apply-res res)))

        add-item (fn []
                   (if (= (str-trim @title-in) "")
                     (reset! err "제목을 입력하세요")
                     (fetch-post! "/decisions/api"
                       {"action" "add"
                        "title" @title-in
                        "context" @context-in
                        "options" @options-in}
                       reload)))

        del-item (fn [id]
                   (fetch-post! "/decisions/api" {"action" "delete" "id" id} reload))

        decide-item (fn [id]
                      (if (= (str-trim @chosen-in) "")
                        (reset! err "선택한 안을 탭하거나 입력하세요")
                        (fetch-post! "/decisions/api"
                          {"action" "decide" "id" id "chosen" @chosen-in}
                          reload)))

        review-item (fn [id]
                      (if (= (str-trim @outcome-in) "")
                        (reset! err "결과를 짧게 남겨 주세요")
                        (fetch-post! "/decisions/api"
                          {"action" "review" "id" id "outcome" @outcome-in}
                          reload)))

        reopen-item (fn [id]
                      (fetch-post! "/decisions/api" {"action" "reopen" "id" id} reload))

        status-label (fn [st]
                       (cond
                         (= st "open") "미결"
                         (= st "decided") "결정됨"
                         (= st "reviewed") "회고"
                         true st))

        status-color (fn [st]
                       (cond
                         (= st "open") "#FF5B35"
                         (= st "decided") "#5B8CFF"
                         (= st "reviewed") "#3DCF8E"
                         true "#8B8B96"))

        created-day (fn [row]
                      (str-slice (or (get row "created_at") "") 0 10))

        in-filter? (fn [row]
                     (let [day (created-day row)
                           f   @day-filter]
                       (cond
                         (= f "all") true
                         (= f "today") (= day (get @data "today"))
                         (= f "week") (>= day (get @data "week_start"))
                         (= f "month") (>= day (get @data "month_start"))
                         true true)))

        visible-items (fn []
                        (filter in-filter? (or (get @data "items") [])))

        option-list (fn [text]
                      (let [raw (or text "")]
                        (if (= (str-trim raw) "")
                          []
                          (filter
                            (fn [line] (not (= (str-trim line) "")))
                            (str-split raw "\n")))))

        opt-chip (fn [opt]
                   (let [t   (str-trim opt)
                         sel (= @chosen-in t)]
                     (h "button"
                       {:class (if sel "dec-chip dec-chip-on" "dec-chip")
                        :on-click (fn []
                                    (reset! chosen-in t)
                                    (reset! err ""))}
                       t)))

        row-view (fn [row]
                   (let [id      (get row "id")
                         st      (get row "status")
                         is-open (= @expand-id id)
                         opts    (option-list (get row "options"))]
                     (h "div" {:class "dec-row"}
                       (str
                         (h "button" {:class "dec-row-main"
                                      :on-click (fn []
                                                  (reset! err "")
                                                  (reset! chosen-in (or (get row "chosen") ""))
                                                  (reset! outcome-in (or (get row "outcome") ""))
                                                  (reset! expand-id (if is-open nil id)))}
                           (str
                             (h "div" {:class "dec-dot"
                                       :style (str "background:" (status-color st))} "")
                             (h "div" {:class "dec-row-text"}
                               (str
                                 (h "div" {:class "dec-title"} (get row "title"))
                                 (h "div" {:class "dec-meta"}
                                   (str (status-label st)
                                        " · "
                                        (created-day row)
                                        (if (= (or (get row "chosen") "") "")
                                          ""
                                          (str " · " (get row "chosen")))))))
                             (h "div" {:class "dec-chev"} (if is-open "▾" "▸"))))
                         (if is-open
                           (h "div" {:class "dec-panel"}
                             (str
                               (if (= (or (get row "context") "") "")
                                 ""
                                 (h "p" {:class "dec-block"}
                                   (str (h "span" {:class "dec-k"} "맥락")
                                        (get row "context"))))
                               (if (= (length opts) 0)
                                 (if (= (or (get row "options") "") "")
                                   ""
                                   (h "p" {:class "dec-block"}
                                     (str (h "span" {:class "dec-k"} "선택지")
                                          (get row "options"))))
                                 (h "div" {:class "dec-opts"}
                                   (str
                                     (h "span" {:class "dec-k"} "선택지 — 탭해서 고르기")
                                     (h "div" {:class "dec-chips"}
                                       (arr-join (map opt-chip opts) "")))))
                               (if (= st "open")
                                 (h "div" {:class "dec-actions"}
                                   (str
                                     (h! "input" {:class "dec-input"
                                                  :placeholder "직접 입력도 가능"
                                                  :value @chosen-in
                                                  :on-input (fn [e]
                                                              (reset! chosen-in
                                                                (.-value (.-target e))))})
                                     (h "button" {:class "dec-btn dec-btn-accent"
                                                  :on-click (fn [] (decide-item id))}
                                       "결정하기")))
                                 "")
                               (if (= st "decided")
                                 (h "div" {:class "dec-actions"}
                                   (str
                                     (h! "input" {:class "dec-input" :placeholder "나중에 본 결과"
                                                  :value @outcome-in
                                                  :on-input (fn [e]
                                                              (reset! outcome-in
                                                                (.-value (.-target e))))})
                                     (h "button" {:class "dec-btn dec-btn-accent"
                                                  :on-click (fn [] (review-item id))}
                                       "회고 저장")))
                                 "")
                               (if (= st "reviewed")
                                 (h "p" {:class "dec-block"}
                                   (str (h "span" {:class "dec-k"} "결과")
                                        (get row "outcome")))
                                 "")
                               (h "div" {:class "dec-foot"}
                                 (str
                                   (if (= st "open")
                                     ""
                                     (h "button" {:class "dec-btn-ghost"
                                                  :on-click (fn [] (reopen-item id))}
                                       "다시 열기"))
                                   (h "button" {:class "dec-btn-ghost dec-danger"
                                                :on-click (fn [] (del-item id))}
                                     "삭제")))))
                           "")))))]

    (fetch! "/decisions/api" (fn [res] (reset! data res)))

    (if (= @data nil)
      (h "div" {:class "dec-loading"} "불러오는 중…")

      (h "div" {:class "dec-app"}
        (str
          (h "header" {:class "dec-head"}
            (str
              (h "div" {}
                (str
                  (h "h1" {} "Decisions")
                  (h "p" {:class "dec-lead"} "탭으로 고르고, 나중에 결과를 남긴다")))
              (h "button" {:class "dec-btn dec-btn-accent"
                           :on-click (fn []
                                       (reset! show-form true)
                                       (reset! err ""))}
                "+ 새 결정")))

          (h "div" {:class "dec-stats"}
            (str
              (h "div" {:class "dec-stat"}
                (str (h "div" {:class "dec-stat-n"} (str (get @data "open_count")))
                     (h "div" {:class "dec-stat-l"} "미결")))
              (h "div" {:class "dec-stat"}
                (str (h "div" {:class "dec-stat-n"} (str (get @data "decided_count")))
                     (h "div" {:class "dec-stat-l"} "결정됨")))
              (h "div" {:class "dec-stat"}
                (str (h "div" {:class "dec-stat-n"} (str (get @data "reviewed_count")))
                     (h "div" {:class "dec-stat-l"} "회고")))))

          (h "div" {:class "dec-filters"}
            (str
              (h "button" {:class (if (= @day-filter "all") "dec-fchip dec-fchip-on" "dec-fchip")
                           :on-click (fn [] (reset! day-filter "all"))} "전체")
              (h "button" {:class (if (= @day-filter "today") "dec-fchip dec-fchip-on" "dec-fchip")
                           :on-click (fn [] (reset! day-filter "today"))} "오늘")
              (h "button" {:class (if (= @day-filter "week") "dec-fchip dec-fchip-on" "dec-fchip")
                           :on-click (fn [] (reset! day-filter "week"))} "7일")
              (h "button" {:class (if (= @day-filter "month") "dec-fchip dec-fchip-on" "dec-fchip")
                           :on-click (fn [] (reset! day-filter "month"))} "이번 달")))

          (if @show-form
            (h "div" {:class "dec-form"}
              (str
                (h! "input" {:class "dec-input" :placeholder "무엇을 결정하나?"
                             :value @title-in
                             :on-input (fn [e] (reset! title-in (.-value (.-target e))))})
                (h "textarea" {:class "dec-area" :placeholder "맥락 (선택)"
                               :value @context-in
                               :on-input (fn [e] (reset! context-in (.-value (.-target e))))} "")
                (h "textarea" {:class "dec-area" :placeholder "선택지 — 한 줄에 하나"
                               :value @options-in
                               :on-input (fn [e] (reset! options-in (.-value (.-target e))))} "")
                (h "div" {:class "dec-form-actions"}
                  (str
                    (h "button" {:class "dec-btn-ghost"
                                 :on-click (fn [] (reset! show-form false))}
                      "취소")
                    (h "button" {:class "dec-btn dec-btn-accent"
                                 :on-click add-item}
                      "추가")))))
            "")

          (if (= @err "")
            ""
            (h "p" {:class "dec-err"} @err))

          (if (= (length (visible-items)) 0)
            (h "p" {:class "dec-empty"}
              (if (= (length (get @data "items")) 0)
                "아직 기록이 없습니다. 첫 결정을 남겨 보세요."
                "이 기간에 해당하는 결정이 없습니다."))
            (h "div" {:class "dec-list"}
              (arr-join (map row-view (visible-items)) ""))))))))

(defn render [req]
  (layout-html "Decisions"
    (str
      """
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  .dec-wrap{max-width:440px;margin:0 auto;padding:20px 16px 88px;
    font-family:'Manrope',system-ui,sans-serif;color:#F2F2F5;
    background:radial-gradient(120% 80% at 10% -10%,#2a1f1c 0%,#16161C 45%,#121218 100%);
    min-height:100dvh;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  .dec-loading{text-align:center;padding:64px 20px;color:#8B8B96}
  .dec-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:18px}
  .dec-head h1{margin:0;font-size:1.55rem;font-weight:800;letter-spacing:-.02em}
  .dec-lead{margin:6px 0 0;font-size:.78rem;color:#8B8B96;line-height:1.45}
  .dec-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
  .dec-stat{background:#1C1C24;border:1px solid #2A2A33;border-radius:14px;padding:14px 10px;text-align:center}
  .dec-stat-n{font-size:1.25rem;font-weight:800}
  .dec-stat-l{font-size:.68rem;color:#8B8B96;margin-top:2px;font-weight:600}
  .dec-filters{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;
    -webkit-overflow-scrolling:touch;scrollbar-width:none}
  .dec-filters::-webkit-scrollbar{display:none}
  .dec-fchip{flex:0 0 auto;min-height:40px;padding:0 14px;border-radius:999px;border:1px solid #2A2A33;
    background:#1C1C24;color:#8B8B96;font:inherit;font-size:.8rem;font-weight:700;cursor:pointer}
  .dec-fchip-on{background:#FF5B35;border-color:#FF5B35;color:#fff}
  .dec-form{background:#1C1C24;border:1px solid #2A2A33;border-radius:16px;padding:14px;margin-bottom:14px;
    display:flex;flex-direction:column;gap:8px}
  .dec-form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:4px}
  .dec-input,.dec-area{width:100%;box-sizing:border-box;background:#121218;color:#F2F2F5;
    border:1px solid #2A2A33;border-radius:12px;padding:12px 14px;font:inherit;font-size:16px}
  .dec-area{min-height:80px;resize:vertical}
  .dec-input:focus,.dec-area:focus{outline:none;border-color:#FF5B35}
  .dec-btn{border:none;border-radius:12px;min-height:46px;padding:12px 16px;font:inherit;font-weight:700;cursor:pointer}
  .dec-btn-accent{background:#FF5B35;color:#fff}
  .dec-btn-accent:active{filter:brightness(.95);transform:scale(.98)}
  .dec-btn-ghost{background:transparent;border:none;color:#8B8B96;font:inherit;font-weight:600;
    cursor:pointer;min-height:44px;padding:10px 12px}
  .dec-danger{color:#ff7b7b}
  .dec-err{color:#ff7b7b;font-size:.8rem;margin:0 0 12px}
  .dec-empty{color:#8B8B96;font-size:.85rem;padding:28px 8px;text-align:center;line-height:1.5}
  .dec-list{display:flex;flex-direction:column}
  .dec-row{border-bottom:1px solid #24242C}
  .dec-row-main{width:100%;display:flex;align-items:center;gap:12px;min-height:56px;padding:14px 2px;
    background:transparent;border:none;color:inherit;font:inherit;text-align:left;cursor:pointer}
  .dec-row-main:active{opacity:.85}
  .dec-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
  .dec-row-text{flex:1;min-width:0}
  .dec-title{font-size:.95rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dec-meta{font-size:.72rem;color:#8B8B96;margin-top:3px}
  .dec-chev{color:#8B8B96;font-size:.85rem;flex-shrink:0}
  .dec-panel{padding:0 2px 16px 22px;display:flex;flex-direction:column;gap:12px;
    animation:decIn .22s ease}
  @keyframes decIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .dec-block{margin:0;font-size:.8rem;color:#C8C8D0;line-height:1.5;white-space:pre-wrap}
  .dec-k{display:block;font-size:.68rem;font-weight:800;color:#8B8B96;margin-bottom:6px;letter-spacing:.04em}
  .dec-opts{display:flex;flex-direction:column;gap:8px}
  .dec-chips{display:flex;flex-direction:column;gap:8px}
  .dec-chip{width:100%;min-height:48px;text-align:left;padding:12px 14px;border-radius:12px;
    border:1px solid #2A2A33;background:#121218;color:#F2F2F5;font:inherit;font-size:.9rem;
    font-weight:600;cursor:pointer}
  .dec-chip:active{transform:scale(.99)}
  .dec-chip-on{border-color:#FF5B35;background:rgba(255,91,53,.14);color:#fff;
    box-shadow:inset 0 0 0 1px #FF5B35}
  .dec-actions{display:flex;flex-direction:column;gap:8px}
  .dec-foot{display:flex;justify-content:flex-end;gap:4px}
  @media (min-width:480px){
    .dec-chips{flex-direction:row;flex-wrap:wrap}
    .dec-chip{width:auto;flex:1 1 calc(50% - 4px)}
  }
</style>
<div class="dec-wrap">
"""
      DecisionsApp
      "</div>")
    req))
