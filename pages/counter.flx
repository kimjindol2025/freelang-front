(island Counter []
  (let [n (atom 0)]
    (h "button" {:on-click (fn [] (swap! n inc))} (str @n))))

(defn render [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>Counter Island — FreeLang Front</title>"
    "<style>body{font-family:sans-serif;max-width:600px;margin:60px auto;text-align:center}"
    "button{font-size:2rem;padding:16px 32px;cursor:pointer;border:2px solid #6366f1;"
    "border-radius:8px;background:white;color:#6366f1}</style>"
    "</head><body>"
    "<h1>Island 카운터</h1>"
    "<p>버튼을 클릭하면 숫자가 증가합니다.</p>"
    "ISLAND_PLACEHOLDER"
    "ISLAND_SCRIPTS"
    "<p style='margin-top:32px'><a href='/'>← 홈</a></p>"
    "</body></html>")))
