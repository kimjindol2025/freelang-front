; Argo Crew 화면 — FreeLang Front 구현
; route: /crew/jiwoo

(defstore :crew_card_open true)
(defstore :crew_notice "")
(defstore :crew_session_label "현재 대화")
(defstore :crew_session_id "crew-default")
(defstore :crew_runtime_label "runner 대기")
(defstore :crew_messages [])

(defn nav-item [icon label active]
  (h "div" {:style (str "display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;margin-bottom:3px;" (if active "background:#eef2ff;color:#4338ca;font-weight:700" "color:#64748b"))}
    (str (h "span" {:style "width:18px;text-align:center"} icon) (h "span" {:style "font-size:13px"} label))))

(defn avatar [kind]
  (h "div" {:style (str "width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex:none;" (if (= kind "agent") "background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff" "background:#e2e8f0;color:#334155"))} (if (= kind "agent") "지" "나")))

(defn user-message [body]
  (h "div" {:style "display:flex;justify-content:flex-end;gap:12px;align-items:flex-start;margin:22px 0"}
    (str (h "div" {:style "max-width:560px;padding:12px 16px;border-radius:16px 16px 4px 16px;background:#4f46e5;color:#fff;font-size:14px;line-height:1.65"} body) (avatar "user"))))

(defn agent-message [body]
  (h "div" {:style "display:flex;gap:12px;align-items:flex-start;max-width:760px"}
    (str (avatar "agent") (h "div" {:style "min-width:0"}
      (str (h "div" {:style "display:flex;gap:8px;align-items:center;margin-bottom:6px"} (h "strong" {:style "font-size:13px;color:#0f172a"} "지우") (h "span" {:style "font-size:11px;color:#94a3b8"} "소프트웨어 개발자 · 2:17")) (h "div" {:style "font-size:14px;line-height:1.8;color:#334155"} body))))))

(defn artifact []
  (h "div" {:style "margin:16px 0 8px 46px;max-width:680px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,.05)"}
    (str
      (h "div" {:style "display:flex;justify-content:space-between;align-items:center;padding:13px 16px;border-bottom:1px solid #f1f5f9;background:#fafafa"}
        (str (h "div" {:style "display:flex;align-items:center;gap:9px"} (h "span" {:style "width:28px;height:28px;border-radius:7px;background:#eef2ff;color:#4f46e5;display:flex;align-items:center;justify-content:center;font-size:13px"} "py") (h "strong" {:style "font-size:13px;color:#1e293b"} "pagination.py")) (h "span" {:style "font-size:11px;color:#16a34a;font-weight:700"} "검증 완료")))
      (h "div" {:style "padding:15px 16px"}
        (str (h "p" {:style "margin:0 0 10px;color:#475569;font-size:13px"} "페이지네이션 입력을 검증하고 작은 산출물로 정리했습니다.")
          (h "div" {:style "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:12px"} (h "div" {:style "padding:10px 12px;background:#f8fafc;border-radius:9px;color:#64748b;font-size:12px"} "사용 예: pagination(3, 10)") (h "div" {:style "padding:10px 12px;background:#f8fafc;border-radius:9px;color:#64748b;font-size:12px"} "결과: limit 10 · offset 20"))
          (h "div" {:style "display:flex;gap:6px;flex-wrap:wrap"} (h "span" {:style "padding:5px 8px;border-radius:6px;background:#ecfdf5;color:#15803d;font-size:11px"} "정상 입력 3건") (h "span" {:style "padding:5px 8px;border-radius:6px;background:#fff7ed;color:#c2410c;font-size:11px"} "잘못된 입력 5건 차단") (h "span" {:style "padding:5px 8px;border-radius:6px;background:#f1f5f9;color:#64748b;font-size:11px"} "직접 실행")))))))

(defn evidence-panel []
  (h "div" {:id "evidence" :style "margin:18px 0 10px;max-width:none;border:1px solid #c7d2fe;border-radius:14px;background:#fafaff;overflow:hidden"}
    (str
      (h "div" {:style "display:flex;justify-content:space-between;align-items:center;padding:12px 15px;border-bottom:1px solid #e0e7ff"}
        (str (h "strong" {:style "font-size:12px;color:#3730a3"} "검수 evidence")
             (h "span" {:style "font-size:10px;font-weight:800;color:#15803d"} "● PASS · freelang.workflow/v1")))
      (h "div" {:style "padding:13px 15px"}
        (str
          (h "div" {:style "display:grid;grid-template-columns:1fr;gap:7px;margin-bottom:10px"}
            (h "div" {:style "padding:9px 10px;border-radius:8px;background:#ecfdf5;color:#166534;font-size:11px"} "CONTRACT · PASS")
            (h "div" {:style "padding:9px 10px;border-radius:8px;background:#ecfdf5;color:#166534;font-size:11px"} "SCOPE · PASS")
            (h "div" {:style "padding:9px 10px;border-radius:8px;background:#ecfdf5;color:#166534;font-size:11px"} "FRONT SSE · PASS"))
          (h "div" {:style "padding:9px 10px;border-radius:8px;background:#fff;color:#64748b;font-family:monospace;font-size:10px;line-height:1.7"}
            (str "workflow-test --workflows .\n" "exitCode: 0 · stdout/stderr 보존 · run.test.result 기록")))))))

(island CrewHydrator []
  (let [loaded (atom false)]
    (when (not @loaded)
      (reset! loaded true)
      (fetch! "/crew/api"
        (fn [res]
          (let [state (or (get res "state") {})]
            (dispatch "crew_card_open" (if (= (get state "card_open") nil) true (get state "card_open")))
            (dispatch "crew_notice" (or (get state "notice") ""))
            (dispatch "crew_session_label" (or (get state "session_label") "현재 대화"))
            (dispatch "crew_session_id" (or (get state "session_id") "crew-default"))
            (dispatch "crew_messages" (or (get state "messages") []))))))
    (h "span" {})))

(island CrewToolbar [:watch "crew_card_open" "crew_notice" "crew_session_label"]
  (let [card-open (if (= (get-store "crew_card_open") false) false true)
        notice    (or (get-store "crew_notice") "")
        session   (or (get-store "crew_session_label") "현재 대화")]
    (h "header" {:style "height:72px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid #e2e8f0"}
      (str
        (h "div" {:style "display:flex;align-items:center;gap:12px"}
          (h "div" {:style "width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800"} "지")
          (h "div" {}
            (str
              (h "div" {:style "font-size:15px;font-weight:800;color:#0f172a"} "지우")
              (h "div" {:style "font-size:11px;color:#64748b;margin-top:3px"} (str "bigwash · 소프트웨어 개발자 · " session)))))
        (h "div" {:style "display:flex;align-items:center;gap:7px"}
          (if (= notice "") "" (h "span" {:style "font-size:10px;color:#6366f1;margin-right:4px"} notice))
          (h "button" {:style "padding:8px 11px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;font-size:11px;cursor:pointer"
                        :on-click (fn []
                                    (dispatch "crew_session_label" "새 세션")
                                    (dispatch "crew_notice" "새 세션이 준비되었습니다.")
                                    (dispatch "crew_messages" [])
                                    (fetch-post! "/crew/api"
                                      {"action" "save" "session_label" "새 세션" "notice" "새 세션이 준비되었습니다." "messages" []}
                                      (fn [_] "")))} "새 세션")
          (h "button" {:style "padding:8px 11px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;color:#64748b;font-size:11px;cursor:pointer"
                        :on-click (fn []
                                    (dispatch "crew_card_open" (if card-open false true))
                                    (dispatch "crew_notice" (if card-open "에이전트 카드를 숨겼습니다." "에이전트 카드를 열었습니다."))
                                    (fetch-post! "/crew/api"
                                      {"action" "save"
                                       "card_open" (if card-open false true)
                                       "notice" (if card-open "에이전트 카드를 숨겼습니다." "에이전트 카드를 열었습니다.")}
                                      (fn [_] "")))}
            (if card-open "카드 닫기" "카드 열기"))
          (h "button" {:style "padding:8px 11px;border:0;border-radius:8px;background:#eef2ff;color:#4f46e5;font-size:11px;font-weight:700;cursor:pointer"
                        :on-click (fn []
                                    (dispatch "crew_session_label" "새 대화")
                                    (dispatch "crew_notice" "새 대화가 준비되었습니다.")
                                    (dispatch "crew_messages" [])
                                    (fetch-post! "/crew/api"
                                      {"action" "save" "session_label" "새 대화" "notice" "새 대화가 준비되었습니다." "messages" []}
                                      (fn [_] "")))} "새 대화"))))))

(island CrewComposer [:watch "crew_messages" "crew_session_id" "crew_runtime_label"]
    (let [draft (atom "")
          messages (or (get-store "crew_messages") [])
          session-id (or (get-store "crew_session_id") "crew-default")
          runtime-label (or (get-store "crew_runtime_label") "runner 대기")]
      (h "div" {:style "border:1px solid #e2e8f0;border-radius:16px;background:#fff;box-shadow:0 10px 30px rgba(15,23,42,.08);padding:10px"}
        (str
          (map (fn [message]
                 (h "div" {:style (str "padding:10px 12px;margin-bottom:8px;border-radius:10px;" (if (= (get message "role") "assistant") "background:#eef2ff;color:#3730a3" "background:#f8fafc;color:#475569") ";font-size:12px")}
                   (str (if (= (get message "role") "assistant") "지우: " "나: ") (get message "body"))))
               messages)
          (h "div" {:style "display:flex;align-items:flex-end;gap:10px"}
            (h "textarea" {:placeholder "지우에게 작업을 요청하세요…" :value @draft :rows "2" :style "flex:1;resize:none;border:0;outline:none;padding:8px 10px;font:inherit;font-size:14px;line-height:1.6;color:#0f172a;background:transparent" :on-input (fn [e] (reset! draft (.-value (.-target e))))})
            (h "button" {:style "border:0;border-radius:10px;padding:10px 15px;background:#4f46e5;color:#fff;font-size:12px;font-weight:700;cursor:pointer"
                          :on-click (fn []
                                      (when (not= @draft "")
                                        (let [body @draft
                                              next (push messages {"role" "user" "body" body})]
                                          (dispatch "crew_messages" next)
                                          (fetch-post! "/crew/api" {"action" "append" "role" "user" "body" body} (fn [_] ""))
                                          (fetch-post! "/crew/chat" {"message" body "history" messages "session_id" session-id}
                                            (fn [res]
                                              (let [runtime (or (get res "runtime") {})
                                                    runner (or (get runtime "runner") "runner")
                                                    model (or (get runtime "model") "unknown")
                                                    response-session (or (get runtime "session_id") session-id)
                                                    runtime-label-next (str runner " · " model " · " (str response-session))]
                                                (dispatch "crew_session_id" response-session)
                                                (dispatch "crew_runtime_label" runtime-label-next)
                                              (if (= (get res "ok") true)
                                                (let [reply (get res "message")
                                                      with-reply (push (or (get-store "crew_messages") next) {"role" "assistant" "body" reply "runtime" runtime "evidence" (or (get res "evidence") {})})]
                                                  (dispatch "crew_messages" with-reply)
                                                  (fetch-post! "/crew/api" {"action" "append" "role" "assistant" "body" reply "runtime" runtime "evidence" (or (get res "evidence") {})} (fn [_] "")))
                                                (let [error-text (or (get res "error") "AI 호출 실패")
                                                      with-error (push (or (get-store "crew_messages") next) {"role" "assistant" "body" (str "연결 오류: " error-text) "runtime" runtime "evidence" (or (get res "evidence") {})})]
                                                  (dispatch "crew_messages" with-error)
                                                  (fetch-post! "/crew/api" {"action" "append" "role" "assistant" "body" (str "연결 오류: " error-text) "runtime" runtime "evidence" (or (get res "evidence") {})} (fn [_] "")))))))
                                          (reset! draft ""))))} "보내기")))
          (h "div" {:style "display:flex;justify-content:space-between;padding:5px 8px 0;color:#94a3b8;font-size:11px"} (str (h "span" {} (str "⌘ Enter로 전송 · " runtime-label)) (h "span" {:style "color:#16a34a"} "● 지우 온라인"))))))

(defn sidebar-group [label]
  (h "div" {:style "padding:14px 10px 7px;font-size:10px;font-weight:800;color:#94a3b8;letter-spacing:.08em"} label))

(defn menu-href [label]
  (if (= label "시작") "/crew/jiwoo#start"
    (if (= label "대화") "/crew/jiwoo"
      (if (= label "작업 · 3") "/tasks"
        (if (= label "프로젝트") "/app"
          (if (= label "검수") "/crew/jiwoo#evidence"
            (if (= label "실행 기록") "/logs"
              (if (= label "에이전트") "/people"
                (if (= label "기억·도구") "/vault"
                  (if (= label "설정") "/about"
                    (if (= label "새 대화") "/crew/jiwoo"
                      (if (= label "보관된 대화") "/events" "/crew/jiwoo"))))))))))))

(defn menu-link [icon label active badge]
  (h "a" {:href (menu-href label) :style (str "display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:9px;margin-bottom:3px;font-size:12px;cursor:pointer;text-decoration:none;" (if active "background:#eef2ff;color:#4338ca;font-weight:800" "color:#64748b"))}
    (str (h "span" {:style "width:18px;text-align:center;font-size:14px"} icon)
         (h "span" {:style "flex:1"} label))))

(defn sidebar []
  (h "aside" {:style "width:252px;flex:none;padding:20px 14px;border-right:1px solid #e2e8f0;background:#fff;display:flex;flex-direction:column;overflow:auto"}
    (str
      (h "div" {:style "display:flex;align-items:center;gap:9px;padding:0 10px 18px"} (h "div" {:style "width:30px;height:30px;border-radius:9px;background:#0f172a;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800"} "A") (h "strong" {:style "font-size:15px;color:#0f172a"} "ARGO") (h "span" {:style "font-size:10px;color:#94a3b8;margin-left:auto"} "v0.1"))
      (h "div" {:style "margin:0 6px 13px;padding:10px 11px;border:1px solid #e2e8f0;border-radius:11px;background:#f8fafc"}
        (str (h "div" {:style "font-size:10px;color:#94a3b8;margin-bottom:4px"} "WORKSPACE") (h "div" {:style "font-size:12px;font-weight:800;color:#334155"} "bigwash") (h "div" {:style "font-size:10px;color:#94a3b8;margin-top:3px"} "FreeLang AI workspace")))
      (sidebar-group "MAIN")
      (menu-link "⌂" "시작" false "")
      (menu-link "◉" "대화" true "")
      (menu-link "✓" "작업 · 3" false "3")
      (menu-link "▣" "프로젝트" false "")
      (menu-link "✓" "검수" false "")
      (menu-link "◷" "실행 기록" false "")
      (sidebar-group "CURRENT CONVERSATION")
      (h "div" {:style "padding:11px 12px;border:1px solid #c7d2fe;border-radius:10px;background:#eef2ff;margin-bottom:5px"}
        (str (h "div" {:style "font-size:12px;font-weight:800;color:#3730a3"} "지우와의 작업 대화") (h "div" {:style "font-size:10px;color:#6366f1;margin-top:5px"} "메시지 6 · 방금 전")))
      (menu-link "+" "새 대화" false "")
      (menu-link "▤" "보관된 대화" false "")
      (sidebar-group "WORKSPACE")
      (menu-link "◈" "에이전트" false "")
      (menu-link "✦" "기억·도구" false "")
      (menu-link "⚙" "설정" false "")
      (h "div" {:style "margin-top:auto;padding:13px 11px;border-top:1px solid #f1f5f9;color:#94a3b8;font-size:10px;line-height:1.6"}
        (str (h "div" {:style "color:#16a34a;font-weight:800;margin-bottom:3px"} "● FreeLang Front 연결됨") (h "div" {} "검수 대기  ·  실행 없음"))))))

(defn sessions []
  (h "aside" {:style "width:230px;flex:none;padding:22px 14px;background:#f8fafc;border-right:1px solid #e2e8f0"}
    (str
      (h "div" {:style "display:flex;align-items:center;justify-content:space-between;padding:0 8px 18px"} (h "strong" {:style "font-size:13px;color:#334155"} "대화 세션") (h "button" {:style "border:1px solid #e2e8f0;border-radius:7px;background:#fff;color:#64748b;cursor:pointer;padding:4px 8px"} "+"))
      (h "div" {:style "padding:12px 14px;border-radius:10px;background:#f1f5f9;border:1px solid #e2e8f0"} (str (h "div" {:style "font-size:12px;font-weight:700;color:#0f172a"} "현재 대화") (h "div" {:style "font-size:11px;color:#94a3b8;margin-top:4px"} "메시지 6 · 방금 전")))
      (h "div" {:style "padding:18px 10px 7px;font-size:10px;color:#94a3b8;font-weight:700"} "이전 대화")
      (h "div" {:style "padding:10px;color:#cbd5e1;font-size:11px;line-height:1.6"} "이전 대화가 없습니다.")
      (h "div" {:style "margin-top:150px;padding:11px;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:11px"} "대화명 편집  ·  보관함"))))

(defn context-panel []
  (h "aside" {:style "width:270px;flex:none;padding:22px 18px;border-left:1px solid #e2e8f0;background:#fff"}
    (str
      (h "div" {:style "display:flex;justify-content:space-between;align-items:center;margin-bottom:18px"} (h "strong" {:style "font-size:13px;color:#334155"} "에이전트 카드") (h "span" {:style "font-size:11px;color:#94a3b8"} "패널"))
      (h "div" {:style "padding:16px;border:1px solid #e2e8f0;border-radius:14px;background:linear-gradient(145deg,#fafaff,#fff)"}
        (str
          (h "div" {:style "display:flex;align-items:center;gap:11px"} (h "div" {:style "width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,#4f46e5,#7c3aed);display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;font-weight:800"} "지") (h "div" {} (str (h "strong" {:style "display:block;font-size:14px;color:#0f172a"} "지우") (h "span" {:style "font-size:11px;color:#64748b"} "소프트웨어 개발자"))))
          (h "div" {:style "margin-top:13px;font-size:11px;color:#16a34a"} "● 온라인 · 작업 가능")
          (h "div" {:style "display:flex;gap:5px;flex-wrap:wrap;margin-top:14px"} (h "span" {:style "padding:5px 7px;background:#eef2ff;color:#4f46e5;border-radius:6px;font-size:10px"} "웹 개발") (h "span" {:style "padding:5px 7px;background:#f1f5f9;color:#64748b;border-radius:6px;font-size:10px"} "버그 수정") (h "span" {:style "padding:5px 7px;background:#f1f5f9;color:#64748b;border-radius:6px;font-size:10px"} "검증"))))
      (evidence-panel)
      (h "div" {:style "margin-top:22px"} (str (h "div" {:style "font-size:11px;font-weight:700;color:#475569;margin-bottom:10px"} "작업 컨텍스트") (h "div" {:style "padding:12px;border-radius:10px;background:#f8fafc;margin-bottom:8px"} (str (h "div" {:style "font-size:10px;color:#94a3b8;margin-bottom:4px"} "작업 폴더") (h "div" {:style "font-size:11px;color:#334155;word-break:break-all"} "/home/kim/.argo-selfhost/data/workspaces/bigwash-7lm4/vault"))) (h "div" {:style "padding:12px;border-radius:10px;background:#f8fafc"} (str (h "div" {:style "font-size:10px;color:#94a3b8;margin-bottom:5px"} "권한") (h "div" {:style "font-size:11px;color:#334155"} "보호 영역 제외 · 서버 검색 가능")))))
      (h "div" {:style "margin-top:24px;padding-top:16px;border-top:1px solid #f1f5f9"} (str (h "div" {:style "display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"} (h "span" {:style "font-size:11px;color:#64748b"} "위임 제한") (h "span" {:style "width:31px;height:18px;border-radius:99px;background:#4f46e5;position:relative;display:block"} (h "span" {:style "position:absolute;right:3px;top:3px;width:12px;height:12px;border-radius:50%;background:#fff"} ""))) (h "div" {:style "font-size:10px;color:#94a3b8;line-height:1.6"} "에이전트 위임은 2회 · 2단계로 제한되어 있습니다.")))
      (h "div" {:style "margin-top:26px;font-size:10px;color:#94a3b8"} "ENGINE  ·  FreeLang Front"))))

(island CrewContextPanel [:watch "crew_card_open"]
  (let [card-open (if (= (get-store "crew_card_open") false) false true)]
    (if card-open
      (h "aside" {:style "width:270px;flex:none;padding:22px 18px;border-left:1px solid #e2e8f0;background:#fff"}
        (str
