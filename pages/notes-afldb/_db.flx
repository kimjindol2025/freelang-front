; pages/notes-afldb/_db.flx — Notes 도메인 (저장은 _afldb-coll)
; ns: notes  · 레거시 /notes(SQLite)와 병행

(define notes_ns "notes")

(defn notes-afldb-all []
  (front-collection-all notes_ns))

(defn notes-afldb-add [content]
  (front-collection-create notes_ns {"content" content "pinned" false}))

(defn notes-afldb-toggle-pin [id]
  (let [prev (front-collection-get notes_ns id)]
    (if (= prev nil)
      nil
      (front-collection-update notes_ns id {"pinned" (not (get prev "pinned"))}))))

(defn notes-afldb-delete [id]
  (front-collection-delete notes_ns id))

(defn notes-afldb-history [id]
  (front-collection-history notes_ns id))

; 하위 호환
(define notes_afldb_index (front-collection-index-key notes_ns))

(defn notes-afldb-key [id]
  (front-collection-item-key notes_ns id))
