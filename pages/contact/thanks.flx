; GET /contact/thanks — 문의 완료 페이지
(defn render [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>문의 완료 — FreeLang Front</title>"
    "<style>"
    "body{font-family:sans-serif;margin:0;background:#f9fafb}"
    ".wrap{max-width:560px;margin:80px auto;padding:0 24px;text-align:center}"
    ".card{background:white;border-radius:12px;padding:48px 32px;"
    "box-shadow:0 4px 12px rgba(0,0,0,.1)}"
    ".icon{font-size:3rem;margin-bottom:16px}"
    "h2{color:#111;margin:0 0 8px}"
    "p{color:#6b7280;margin:0 0 24px}"
    "a{display:inline-block;background:#6366f1;color:white;text-decoration:none;"
    "border-radius:6px;padding:10px 24px;font-size:.95rem}"
    "a:hover{background:#4f46e5}"
    "</style>"
    "</head><body>"
    "<div class='wrap'>"
    "<div class='card'>"
    "<div class='icon'>&#x2705;</div>"
    "<h2>감사합니다</h2>"
    "<p>문의가 성공적으로 접수되었습니다.<br>빠른 시일 내에 답변 드리겠습니다.</p>"
    "<a href='/'>홈으로 돌아가기</a>"
    "</div>"
    "</div>"
    "</body></html>")))
