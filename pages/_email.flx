; pages/_email.flx — 이메일 발송 라이브러리
; 지원: SendGrid API / Mailgun API / SMTP (via API)
;
; 환경변수 (.env):
;   EMAIL_PROVIDER=sendgrid       # sendgrid | mailgun
;   SENDGRID_API_KEY=SG.xxx
;   SENDGRID_FROM=noreply@example.com
;   MAILGUN_API_KEY=key-xxx
;   MAILGUN_DOMAIN=mg.example.com
;   MAILGUN_FROM=noreply@example.com
;
; 사용 예:
;   (email-send "user@example.com" "가입 확인" "안녕하세요")
;   (email-html "user@example.com" "영수증" "<h1>결제 완료</h1>")
;   (email-template "user@example.com" "welcome" {"name" "홍길동"})

; ── 설정 ──────────────────────────────────────────────────────

(define EMAIL-PROVIDER (fl-env-get "EMAIL_PROVIDER"))
(define SG-KEY         (fl-env-get "SENDGRID_API_KEY"))
(define SG-FROM        (fl-env-get "SENDGRID_FROM"))
(define MG-KEY         (fl-env-get "MAILGUN_API_KEY"))
(define MG-DOMAIN      (fl-env-get "MAILGUN_DOMAIN"))
(define MG-FROM        (fl-env-get "MAILGUN_FROM"))

; ── SendGrid ──────────────────────────────────────────────────

(defn sg-send [$to $subject $text $html]
  (let [$body {"personalizations" [{"to" [{"email" $to}]}]
               "from"            {"email" SG-FROM}
               "subject"         $subject
               "content"         (if $html
                                   [{"type" "text/plain" "value" $text}
                                    {"type" "text/html"  "value" $html}]
                                   [{"type" "text/plain" "value" $text}])}
        $res  (http_post_json
                "https://api.sendgrid.com/v3/mail/send"
                $body
                {"Authorization" (str "Bearer " SG-KEY)
                 "Content-Type"  "application/json"})]
    {"ok"     (http_ok? $res)
     "status" (http_status $res)}))

; SendGrid 템플릿 발송
(defn sg-template [$to $template-id $data]
  (let [$body {"personalizations" [{"to"                  [{"email" $to}]
                                    "dynamic_template_data" $data}]
               "from"             {"email" SG-FROM}
               "template_id"      $template-id}
        $res  (http_post_json
                "https://api.sendgrid.com/v3/mail/send"
                $body
                {"Authorization" (str "Bearer " SG-KEY)
                 "Content-Type"  "application/json"})]
    {"ok" (http_ok? $res)}))

; ── Mailgun ───────────────────────────────────────────────────

(defn mg-send [$to $subject $text $html]
  (let [$auth (str "Basic " (base64_encode (str "api:" MG-KEY)))
        $url  (str "https://api.mailgun.net/v3/" MG-DOMAIN "/messages")
        $body (str "from=" MG-FROM
                   "&to=" $to
                   "&subject=" $subject
                   "&text=" $text
                   (if $html (str "&html=" $html) ""))
        $res  (http_post_form $url $body)]
    {"ok"     (http_ok? $res)
     "id"     (get (json_parse (get $res :body)) "id")}))

; ── 통합 인터페이스 ───────────────────────────────────────────

; 일반 텍스트 이메일
(defn email-send [$to $subject $text]
  (if (= EMAIL-PROVIDER "mailgun")
    (mg-send $to $subject $text nil)
    (sg-send $to $subject $text nil)))

; HTML 이메일
(defn email-html [$to $subject $html]
  (let [$text (str-replace-in $html "<[^>]+>" "")]
    (if (= EMAIL-PROVIDER "mailgun")
      (mg-send $to $subject $text $html)
      (sg-send $to $subject $text $html))))

; SendGrid 템플릿
(defn email-template [$to $template-id $data]
  (sg-template $to $template-id $data))

; ── 자주 쓰는 이메일 템플릿 ──────────────────────────────────

; 회원가입 환영 메일
(defn email-welcome [$to $name]
  (email-html $to
    "환영합니다!"
    (str "<h1>안녕하세요, " $name "님!</h1>"
         "<p>가입해주셔서 감사합니다.</p>"
         "<p>지금 바로 서비스를 이용해보세요.</p>")))

; 비밀번호 재설정 메일
(defn email-reset-password [$to $reset-link]
  (email-html $to
    "비밀번호 재설정"
    (str "<h1>비밀번호 재설정</h1>"
         "<p>아래 링크를 클릭하여 비밀번호를 재설정하세요.</p>"
         "<p><a href='" $reset-link "' style='background:#6366f1;color:white;"
         "padding:12px 24px;border-radius:6px;text-decoration:none;"
         "display:inline-block'>비밀번호 재설정</a></p>"
         "<p style='color:#9ca3af;font-size:.85rem'>링크는 1시간 동안 유효합니다.</p>")))

; 결제 완료 메일
(defn email-payment-done [$to $name $amount $order-id]
  (email-html $to
    (str "결제 완료 · ₩" $amount)
    (str "<h1>결제가 완료되었습니다</h1>"
         "<table style='border-collapse:collapse;width:100%'>"
         "<tr><td style='padding:8px;border:1px solid #e5e7eb'>주문번호</td>"
         "<td style='padding:8px;border:1px solid #e5e7eb'>" $order-id "</td></tr>"
         "<tr><td style='padding:8px;border:1px solid #e5e7eb'>결제금액</td>"
         "<td style='padding:8px;border:1px solid #e5e7eb'>₩" $amount "</td></tr>"
         "</table>")))

; 인증 코드 메일
(defn email-otp [$to $code]
  (email-html $to
    "인증 코드"
    (str "<h1>인증 코드</h1>"
         "<p>아래 코드를 입력하세요. (5분 유효)</p>"
         "<div style='font-size:2rem;font-weight:800;letter-spacing:.2em;"
         "background:#f3f4f6;padding:20px;border-radius:8px;text-align:center;"
         "margin:20px 0'>" $code "</div>")))
