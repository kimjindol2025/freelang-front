  <div class="stat"><div class="stat-n">없음</div><div class="stat-l">이스케이프 불필요</div></div>
  <div class="stat"><div class="stat-n">✓ ✗ →</div><div class="stat-l">유니코드 직접</div></div>
</div>
"""

    """
<div class="win">
  <div class="win-bar">
    <div class="dd dr"></div><div class="dd dy"></div><div class="dd dg"></div>
    <span class="win-title">pages/hello.flx — 삼중따옴표로 쓴 실제 코드</span>
    <span class="win-tag">✓ 작동함</span>
  </div>
  <div class="code"><pre>
<span class="cm">; CSS DSL — S식으로 선언, scoped 해시 클래스 자동 생성</span>
<span class="kw">(style</span> <span class="fn">card</span>  <span class="sym">:bg "#1c1c28"  :radius "12px"  :p "24px"</span><span class="kw">)</span>
<span class="kw">(style</span> <span class="fn">title</span> <span class="sym">:size "1.4rem"  :weight "700"  :color "#c4b5fd"</span><span class="kw">)</span>

<span class="cm">; Island — 필요한 부분만 JS, 나머지는 SSR</span>
<span class="kw">(island</span> <span class="fn">Counter</span> <span class="sym">[]</span>
  <span class="kw">(let</span> <span class="sym">[n (atom 0)]</span>
    <span class="kw">(h</span> <span class="str">"button"</span> <span class="sym">{"on-click" (fn [] (swap! n inc))}</span>
      <span class="kw">(str</span> <span class="sym">"&#128293; " @n</span><span class="kw">))))</span>

<span class="cm">; 삼중따옴표 — ✓ 유니코드 · "따옴표" → 화살표 이모지 🎯 전부 그냥</span>
<span class="kw">(defn</span> <span class="fn">render</span> <span class="sym">[req]</span>
  <span class="kw">(layout-html</span> <span class="str">"hello"</span>
    <span class="kw">(str</span>
      <span class="str">&quot;&quot;&quot;&lt;div class="${card}"&gt;&quot;&quot;&quot;</span>
      <span class="str">&quot;&quot;&quot;  &lt;h1 class="${title}"&gt;&#10003; 삼중따옴표 안은 자유&lt;/h1&gt;&quot;&quot;&quot;</span>
      <span class="str">&quot;&quot;&quot;  ${Counter}&quot;&quot;&quot;</span>
      <span class="str">&quot;&quot;&quot;&lt;/div&gt;&quot;&quot;&quot;</span><span class="kw">)</span>
    <span class="sym">req</span><span class="kw">))</span>
  </pre></div>
</div>
"""

