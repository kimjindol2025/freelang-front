; CSS 스타일 정의
(style hero_wrap  :bg "#6366f1" :color "white" :radius "16px" :p "64px"
                  :sm-p "32px")
(style feat_grid  :display "grid" :cols 3 :gap "20px"
                  :md-cols 2 :sm-cols 1)
(style feat_card  :bg "white" :radius "12px" :shadow "sm" :p "28px"
                  :sm-p "20px")
(style code_block :bg "#1e1e2e" :radius "12px" :p "24px")
(style stat_row   :display "grid" :cols 4 :gap "16px"
                  :md-cols 2 :sm-cols 2)
(style stat_item  :bg "white" :radius "12px" :shadow "sm" :p "24px")

(defn render [req]
  (server-html
    (layout "FreeLang Front" (str

      ; ── Hero ─────────────────────────────────────────────────
      "<div class='" hero_wrap "'>"
      "<div style='font-size:.85rem;font-weight:600;opacity:.7;letter-spacing:.08em;margin-bottom:16px'>"
      "FREELANG FRONT v0.1"
      "</div>"
      "<h1 style='font-size:2.8rem;font-weight:800;margin:0 0 16px;line-height:1.2'>"
      "npm install 없이<br>풀스택 프론트엔드"
      "</h1>"
      "<p style='font-size:1.15rem;opacity:.85;margin:0 0 36px;max-width:520px;line-height:1.6'>"
      "FreeLang v11 fx 기반. React · Next.js · Tailwind · Zustand 조합 없이 "
      "SSR · CSS DSL · Island 아키텍처를 단일 언어로."
      "</p>"
      "<div style='display:flex;gap:12px;flex-wrap:wrap'>"
      "<a href='/dashboard' style='background:white;color:#6366f1;border-radius:8px;"
      "padding:12px 28px;font-weight:700;text-decoration:none;font-size:1rem'>"
      "데모 보기 →"
      "</a>"
      "<a href='/styled' style='background:rgba(255,255,255,.15);color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none;font-size:1rem;border:1px solid rgba(255,255,255,.3)'>"
      "CSS DSL"
      "</a>"
      "<a href='/todo' style='background:rgba(255,255,255,.15);color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none;font-size:1rem;border:1px solid rgba(255,255,255,.3)'>"
      "Island"
      "</a>"
      "</div>"
      "</div>"

      ; ── 수치 ─────────────────────────────────────────────────
      "<div class='" stat_row "' style='margin:32px 0'>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>0</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>npm 의존성</div>"
      "</div>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>&lt;1KB</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>Island 런타임</div>"
      "</div>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>SSR</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>서버 렌더링</div>"
      "</div>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>100%</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>FreeLang</div>"
      "</div>"
      "</div>"

      ; ── 기능 카드 ──────────────────────────────────────────
      "<h2 style='font-size:1.5rem;font-weight:700;margin:8px 0 20px;color:#111'>핵심 기능</h2>"
      "<div class='" feat_grid "'>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>🗂️</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>파일 기반 라우팅</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "pages/ 디렉토리 스캔 → 자동 라우트 생성.<br>"
      "<code style='background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:.8rem'>"
      "pages/users/[id].flx → /users/:id</code>"
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>🎨</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>CSS DSL</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "S식으로 스타일 선언 → scoped 해시 클래스 자동 생성.<br>"
      "반응형 breakpoint: <code style='background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:.8rem'>"
      ":sm-p :md-cols</code>"
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>🏝️</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>Island 아키텍처</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "필요한 부분만 JS. <code style='background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:.8rem'>"
      "(island Name [] body)</code> → vanilla JS emit. "
      "atom 상태 · 배열 CRUD."
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>📬</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>서버 폼 처리</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "POST body 자동 파싱 · 검증 · redirect.<br>"
      "JS 없는 전통적 폼 흐름 — 서버가 모두 처리."
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>📊</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>SVG 차트 DSL</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "막대·선 차트 SSR 생성. Chart.js 불필요.<br>"
      "<code style='background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:.8rem'>"
      "(chart-bar data w h) → &lt;svg&gt;</code>"
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>⚡</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>Critical CSS 인라인</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "페이지별 사용 CSS만 &lt;head&gt;에 인라인.<br>"
      "불필요한 CSS 로드 없음 · 외부 stylesheet 제로."
      "</div>"
      "</div>"

      "</div>"

      ; ── 코드 예시 ──────────────────────────────────────────
      "<h2 style='font-size:1.5rem;font-weight:700;margin:40px 0 20px;color:#111'>이렇게 씁니다</h2>"
      "<div class='" code_block "'>"
      "<pre style='margin:0;color:#cdd6f4;font-family:monospace;font-size:.875rem;line-height:1.7;overflow-x:auto'>"
      "<span style='color:#cba6f7'>(style</span> <span style='color:#a6e3a1'>hero</span>"
      "  <span style='color:#89b4fa'>:bg</span> <span style='color:#f38ba8'>\"#6366f1\"</span>"
      "  <span style='color:#89b4fa'>:p</span> <span style='color:#f38ba8'>\"48px\"</span>"
      "  <span style='color:#89b4fa'>:sm-p</span> <span style='color:#f38ba8'>\"24px\"</span>"
      "  <span style='color:#89b4fa'>:radius</span> <span style='color:#f38ba8'>\"12px\"</span><span style='color:#cba6f7'>)</span>\n"
      "\n"
      "<span style='color:#cba6f7'>(island</span> <span style='color:#a6e3a1'>Counter</span> <span style='color:#cdd6f4'>[]</span>\n"
      "  <span style='color:#cba6f7'>(let</span> <span style='color:#cdd6f4'>[n (atom 0)]</span>\n"
      "    <span style='color:#cba6f7'>(h</span> <span style='color:#f38ba8'>\"button\"</span>\n"
      "      <span style='color:#cdd6f4'>{</span><span style='color:#f38ba8'>\"on-click\"</span> <span style='color:#cba6f7'>(fn</span> <span style='color:#cdd6f4'>[]</span> <span style='color:#cba6f7'>(swap!</span> n inc<span style='color:#cba6f7'>))</span><span style='color:#cdd6f4'>}</span>\n"
      "      <span style='color:#cba6f7'>(str</span> <span style='color:#cdd6f4'>@n</span><span style='color:#cba6f7'>))))</span>\n"
      "\n"
      "<span style='color:#cba6f7'>(defn</span> <span style='color:#a6e3a1'>render</span> <span style='color:#cdd6f4'>[req]</span>\n"
      "  <span style='color:#cba6f7'>(server-html</span>\n"
      "    <span style='color:#cba6f7'>(layout</span> <span style='color:#f38ba8'>\"홈\"</span> content req<span style='color:#cba6f7'>)))</span>"
      "</pre>"
      "</div>"

      ; ── CTA ──────────────────────────────────────────────
      "<div style='text-align:center;margin:48px 0 16px'>"
      "<p style='color:#6b7280;margin:0 0 20px'>지금 바로 실행해보세요</p>"
      "<div style='display:flex;gap:12px;justify-content:center;flex-wrap:wrap'>"
      "<a href='/dashboard' style='background:#6366f1;color:white;border-radius:8px;"
      "padding:14px 32px;font-weight:700;text-decoration:none;font-size:1rem'>"
      "📊 Dashboard →"
      "</a>"
      "<a href='/todo' style='background:#f3f4f6;color:#374151;border-radius:8px;"
      "padding:14px 32px;font-weight:600;text-decoration:none;font-size:1rem'>"
      "✅ To-do Island"
      "</a>"
      "<a href='/contact' style='background:#f3f4f6;color:#374151;border-radius:8px;"
      "padding:14px 32px;font-weight:600;text-decoration:none;font-size:1rem'>"
      "📬 Contact 폼"
      "</a>"
      "</div>"
      "</div>") req)))
