(defn render [req]
  (server-html
    (layout "홈" (str
      "<h2 style='margin:0 0 8px;font-size:2rem'>FreeLang Front</h2>"
      "<p style='color:#6b7280;margin:0 0 32px'>npm install 0개 · SSR · CSS DSL · Island · SVG Chart</p>"
      "<div style='display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px'>"
      "<a href='/dashboard' style='display:block;background:white;border-radius:10px;padding:24px;"
      "text-decoration:none;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.1)'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>📊</div>"
      "<div style='font-weight:600'>Dashboard</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>SSR · SVG 차트 · 통계</div>"
      "</a>"
      "<a href='/counter' style='display:block;background:white;border-radius:10px;padding:24px;"
      "text-decoration:none;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.1)'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🔢</div>"
      "<div style='font-weight:600'>Counter</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>Island 아키텍처 · 클라이언트 상태</div>"
      "</a>"
      "<a href='/styled' style='display:block;background:white;border-radius:10px;padding:24px;"
      "text-decoration:none;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.1)'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🎨</div>"
      "<div style='font-weight:600'>Styled</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>CSS DSL · Scoped 클래스</div>"
      "</a>"
      "<a href='/contact' style='display:block;background:white;border-radius:10px;padding:24px;"
      "text-decoration:none;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.1)'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>📬</div>"
      "<div style='font-weight:600'>Contact</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>서버 폼 처리 · 검증 · Redirect</div>"
      "</a>"
      "</div>") req)))
