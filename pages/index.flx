    <div class="loop-label">해결 확인</div>
    <div class="loop-desc">고치면 자동으로<br>"루프 완료" 알림</div>
    <span class="loop-new">NEW</span>
  </div>
</div>
"""

    """
<div class="stats">
  <div class="stat"><div class="stat-n">0</div><div class="stat-l">npm 의존성</div></div>
