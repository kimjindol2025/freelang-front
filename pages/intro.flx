; @contract
; route: /intro
; purpose: ai-operating-manifesto
; type: page
; pattern: UI_PAGE
; routes:
;   read: GET /~ai
;   read: GET /roadmap
; state:
;   source: server
;   mutable: false
; requires:
;   auth: none
; checks:
;   syntax: PASS
;   route: PASS
;   schema: PASS
;   smoke: PASS
; last_verified:
;   commit: f0e4a02
; @endcontract

; FreeLang 랜딩 — "AI 개발 운영체제" 선언문
; /intro

(defn render [req]
  (server_html (str
    "<!DOCTYPE html><html lang='ko'><head>"
    "<meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>FreeLang — AI 개발 운영체제</title>"
    "<style>
:root{
  --p:#7c3aed;--p2:#6366f1;--cyan:#06b6d4;--emerald:#10b981;
  --dark:#0a0a0f;--dark2:#12121a;--dark3:#1a1a28;
  --border:rgba(124,58,237,.2);--border2:rgba(255,255,255,.06);
  --text:#e2e8f0;--muted:#64748b;--muted2:#94a3b8;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  background:var(--dark);color:var(--text);min-height:100dvh;overflow-x:hidden}

@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes glow-pulse{0%,100%{opacity:.3}50%{opacity:.7}}
@keyframes slide-up{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes gradient-pan{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@keyframes border-glow{0%,100%{border-color:rgba(124,58,237,.2)}50%{border-color:rgba(124,58,237,.6)}}
@keyframes tag-in{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}

/* 배경 */
.orb{position:fixed;border-radius:50%;filter:blur(100px);pointer-events:none;z-index:0;animation:glow-pulse 5s ease-in-out infinite}
.o1{width:600px;height:600px;background:rgba(124,58,237,.1);top:-200px;right:-150px}
.o2{width:450px;height:450px;background:rgba(99,102,241,.08);bottom:-150px;left:-100px;animation-delay:2.5s}
.o3{width:350px;height:350px;background:rgba(6,182,212,.07);top:45%;left:35%;animation-delay:1.2s}

/* 네비 */
nav{position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(10,10,15,.85);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border2);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 40px;height:58px}
.nav-logo{font-weight:900;font-size:1.05rem;letter-spacing:-.02em;
  background:linear-gradient(90deg,#a78bfa,#67e8f9);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-links{display:flex;gap:2px}
.nav-links a{color:var(--muted2);text-decoration:none;padding:6px 14px;
  border-radius:6px;font-size:.85rem;transition:all .2s}
.nav-links a:hover{color:white;background:rgba(255,255,255,.07)}

/* 히어로 */
.hero{position:relative;z-index:1;min-height:100dvh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:80px 24px 60px}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;
  background:rgba(124,58,237,.12);border:1px solid rgba(124,58,237,.35);
  border-radius:99px;padding:7px 18px;font-size:.78rem;font-weight:700;
  color:#c4b5fd;letter-spacing:.06em;text-transform:uppercase;
  margin-bottom:36px;animation:slide-up .5s ease both}
.pulse{width:7px;height:7px;background:#a78bfa;border-radius:50%;
  box-shadow:0 0 0 0 rgba(167,139,250,.6);
  animation:pulse-out 2s ease infinite}
@keyframes pulse-out{0%{box-shadow:0 0 0 0 rgba(167,139,250,.6)}70%{box-shadow:0 0 0 10px rgba(167,139,250,0)}100%{box-shadow:0 0 0 0 rgba(167,139,250,0)}}
.hero h1{font-size:clamp(2.8rem,6.5vw,5.2rem);font-weight:900;
  line-height:1.08;letter-spacing:-.03em;margin-bottom:12px;
  background:linear-gradient(135deg,#fff 10%,#c4b5fd 50%,#67e8f9 90%);
  background-size:200%;
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  animation:slide-up .6s .05s ease both,gradient-pan 6s ease infinite}
.hero-sub-line{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;
  color:rgba(255,255,255,.15);letter-spacing:-.02em;margin-bottom:28px;
  animation:slide-up .6s .1s ease both}
.hero-desc{font-size:clamp(.95rem,1.8vw,1.2rem);color:var(--muted2);
  max-width:560px;line-height:1.75;margin-bottom:44px;
  animation:slide-up .6s .15s ease both}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;
  animation:slide-up .6s .2s ease both}
.btn-p{background:linear-gradient(135deg,#7c3aed,#6366f1);color:white;
  border-radius:10px;padding:13px 30px;font-weight:700;text-decoration:none;
  font-size:.95rem;box-shadow:0 4px 24px rgba(124,58,237,.35);
  transition:transform .25s,box-shadow .25s}
.btn-p:hover{transform:translateY(-3px);box-shadow:0 8px 36px rgba(124,58,237,.55);color:white;text-decoration:none}
.btn-s{background:rgba(255,255,255,.05);color:var(--muted2);
  border:1px solid var(--border2);border-radius:10px;padding:13px 26px;
  font-weight:600;text-decoration:none;font-size:.95rem;transition:all .2s}
.btn-s:hover{background:rgba(255,255,255,.1);color:white;text-decoration:none}

/* 코드 플로트 */
.code-wrap{position:relative;z-index:1;max-width:720px;margin:64px auto;
  padding:0 24px;animation:float 7s ease-in-out infinite}
.win{background:var(--dark2);border:1px solid var(--border);
  border-radius:16px;overflow:hidden;
  box-shadow:0 32px 80px rgba(0,0,0,.7),0 0 0 1px rgba(124,58,237,.08)}
.win-bar{background:var(--dark3);padding:14px 20px;
  display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}
.d{width:11px;height:11px;border-radius:50%}
.dr{background:#ff5f57}.dy{background:#febc2e}.dg{background:#28c840}
.win-label{margin-left:8px;font-size:.78rem;color:var(--muted);font-family:monospace}
.win-body{padding:28px 32px;font-family:'SF Mono','Fira Code',monospace;
  font-size:.875rem;line-height:2;overflow-x:auto}
.kw{color:#c084fc}.fn{color:#86efac}.str{color:#fca5a5}
.cm{color:#3d4a5c;font-style:italic}.sym{color:#93c5fd}
.op{color:#67e8f9}.num{color:#fdba74}.tag{color:#fde68a}

/* 섹션 공통 */
section{position:relative;z-index:1;max-width:1040px;margin:0 auto;padding:80px 24px}
.s-label{font-size:.72rem;font-weight:700;letter-spacing:.15em;
  color:#7c3aed;text-transform:uppercase;margin-bottom:12px}
.s-title{font-size:clamp(1.9rem,3.2vw,2.8rem);font-weight:800;
  letter-spacing:-.025em;line-height:1.15;margin-bottom:14px}
.s-desc{color:var(--muted2);font-size:1rem;line-height:1.75;
  max-width:560px;margin-bottom:52px}

/* 선언문 박스 */
.manifesto{background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(6,182,212,.06));
  border:1px solid rgba(124,58,237,.3);border-radius:20px;
  padding:52px 48px;margin-bottom:52px;position:relative;overflow:hidden}
.manifesto::before{content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(124,58,237,.04),transparent 60%);pointer-events:none}
.manifesto blockquote{font-size:clamp(1.1rem,2vw,1.4rem);
  font-weight:700;line-height:1.65;color:white;position:relative}
.manifesto blockquote::before{content:'';position:absolute;
  left:-24px;top:0;bottom:0;width:3px;
  background:linear-gradient(to bottom,#a78bfa,#67e8f9);border-radius:99px}
.manifesto .attr{margin-top:20px;font-size:.82rem;color:var(--muted);font-style:normal}

/* 진짜 차별점 — 생태계 카드 */
.eco-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.eco-card{background:var(--dark2);border:1px solid var(--border);
  border-radius:16px;padding:32px;position:relative;overflow:hidden;
  transition:border-color .3s,transform .3s}
.eco-card:hover{border-color:rgba(124,58,237,.45);transform:translateY(-3px)}
.eco-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--p),var(--cyan));opacity:0;transition:opacity .3s}
.eco-card:hover::after{opacity:1}
.eco-icon{font-size:1.8rem;margin-bottom:18px;display:block}
.eco-title{font-size:1.05rem;font-weight:800;margin-bottom:8px;color:white}
.eco-code{display:inline-block;font-family:monospace;font-size:.78rem;
  background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.25);
  color:#c4b5fd;padding:3px 10px;border-radius:6px;margin-bottom:12px}
.eco-desc{font-size:.875rem;color:var(--muted2);line-height:1.7}
.eco-note{margin-top:14px;font-size:.78rem;color:var(--muted);
  border-left:2px solid rgba(124,58,237,.3);padding-left:10px;font-style:italic}

/* S식 포지셔닝 */
.sexp-row{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:40px}
.sexp-box{background:var(--dark2);border:1px solid var(--border);
  border-radius:14px;padding:28px}
.sexp-box.good{border-color:rgba(16,185,129,.25)}
.sexp-box.context{border-color:rgba(124,58,237,.35)}
.sexp-label{font-size:.75rem;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;margin-bottom:14px}
.sexp-label.g{color:#34d399}.sexp-label.c{color:#a78bfa}
.sexp-body{font-size:.85rem;color:var(--muted2);line-height:1.7}
.sexp-body code{background:rgba(255,255,255,.06);border-radius:4px;
  padding:2px 7px;font-size:.8rem;color:#e2e8f0;font-family:monospace}

/* 비교 테이블 */
.tbl-wrap{overflow-x:auto;border-radius:16px;border:1px solid var(--border);background:var(--dark2)}
table{width:100%;border-collapse:collapse;min-width:640px}
thead{background:var(--dark3)}
th{padding:14px 18px;font-size:.78rem;font-weight:700;color:var(--muted);
  text-align:left;border-bottom:1px solid var(--border);letter-spacing:.04em}
th.hl{color:#a78bfa;background:rgba(124,58,237,.1);
  border-left:1px solid rgba(124,58,237,.2);border-right:1px solid rgba(124,58,237,.2)}
td{padding:13px 18px;font-size:.855rem;border-bottom:1px solid rgba(255,255,255,.03)}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(124,58,237,.04)}
td.hl{background:rgba(124,58,237,.07);
  border-left:1px solid rgba(124,58,237,.15);border-right:1px solid rgba(124,58,237,.15)}
.c-ok{color:#4ade80}.c-no{color:#f87171}.c-half{color:#fbbf24}
.row-label{font-size:.78rem;color:var(--muted);font-weight:600;letter-spacing:.03em}

/* 조심 섹션 */
.warn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.warn-card{border-radius:12px;padding:22px;border:1px solid}
.warn-good{background:rgba(16,185,129,.05);border-color:rgba(16,185,129,.2)}
.warn-mid{background:rgba(251,191,36,.05);border-color:rgba(251,191,36,.2)}
.warn-bad{background:rgba(239,68,68,.05);border-color:rgba(239,68,68,.2)}
.warn-card h4{font-size:.9rem;font-weight:700;margin-bottom:8px}
.wg h4{color:#34d399}.wm h4{color:#fbbf24}.wb h4{color:#f87171}
.warn-card p{font-size:.82rem;color:var(--muted2);line-height:1.65}
.warn-card .alt{margin-top:10px;font-size:.78rem;font-family:monospace;
  background:rgba(255,255,255,.04);padding:6px 10px;border-radius:6px;color:#a78bfa}

/* CTA */
.cta{position:relative;z-index:1;padding:80px 24px 120px;text-align:center}
.cta-box{background:linear-gradient(135deg,rgba(124,58,237,.12),rgba(99,102,241,.08));
  border:1px solid rgba(124,58,237,.28);border-radius:24px;
  padding:72px 40px;max-width:680px;margin:0 auto;
  box-shadow:0 0 80px rgba(124,58,237,.08);
  animation:border-glow 4s ease-in-out infinite}
.cta-box h2{font-size:2.2rem;font-weight:900;letter-spacing:-.025em;
  margin-bottom:14px;
  background:linear-gradient(135deg,white,#c4b5fd 60%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent}
.cta-box p{color:var(--muted2);margin-bottom:36px;font-size:1rem;line-height:1.7}

footer{position:relative;z-index:1;text-align:center;padding:28px;
  color:var(--muted);font-size:.78rem;border-top:1px solid var(--border2)}

@media(max-width:768px){
  .eco-grid,.sexp-row{grid-template-columns:1fr}
  .warn-grid{grid-template-columns:1fr}
  nav{padding:0 20px}
  .nav-links{display:none}
  .manifesto{padding:32px 24px}
}
    </style>
  </head><body>

  <div class='orb o1'></div>
  <div class='orb o2'></div>
  <div class='orb o3'></div>

  <nav>
    <div class='nav-logo'>FreeLang</div>
    <div class='nav-links'>
      <a href='#ecosystem'>생태계</a>
      <a href='#sexp'>S식 포지셔닝</a>
      <a href='#compare'>비교</a>
      <a href='#claims'>주장 검증</a>
      <a href='/dashboard'>데모</a>
    </div>
  </nav>

  <!-- 히어로 -->
  <div class='hero'>
    <div class='hero-eyebrow'>
      <span class='pulse'></span>
      AI Operating System for Development
    </div>
    <h1>AI가 개발&middot;운영&middot;<br>유지보수하기 쉬운<br>소프트웨어 생태계</h1>
    <p class='hero-sub-line'>언어가 아닙니다. 선언입니다.</p>
    <p class='hero-desc'>
      새 언어를 소개하는 페이지처럼 보이지만,<br>
      핵심 아이디어는 AI가 전체 소프트웨어 생명주기를<br>
      스스로 이어받을 수 있는 생태계를 만드는 것입니다.
    </p>
    <div class='hero-btns'>
      <a href='#ecosystem' class='btn-p'>핵심 차별점 보기 →</a>
      <a href='/demo' class='btn-s'>라이브 데모</a>
    </div>
  </div>

  <!-- 코드 플로트 -->
  <div class='code-wrap'>
    <div class='win'>
      <div class='win-bar'>
        <div class='d dr'></div><div class='d dy'></div><div class='d dg'></div>
        <span class='win-label'>airc-handoff.fl — AI가 다음 AI에게 넘기는 방식</span>
      </div>
      <div class='win-body'><pre>
<span class='cm'>; AIRC — AI 인수인계 문서. 다음 세션의 AI가 읽는다</span>
<span class='kw'>(define</span> <span class='fn'>handoff</span>
  {<span class='str'>:task</span>    <span class='str'>&quot;user-auth 완료, billing 미구현&quot;</span>
   <span class='str'>:done</span>    [<span class='str'>&quot;login&quot;</span> <span class='str'>&quot;session&quot;</span> <span class='str'>&quot;logout&quot;</span>]
   <span class='str'>:next</span>    [<span class='str'>&quot;stripe-webhook&quot;</span> <span class='str'>&quot;invoice-pdf&quot;</span>]
   <span class='str'>:errors</span>  [{<span class='str'>:file</span> <span class='str'>&quot;auth.fl:42&quot;</span> <span class='str'>:msg</span> <span class='str'>&quot;token-nil 엣지&quot;</span>}]
   <span class='str'>:why</span>     <span class='str'>&quot;session은 Redis 아닌 DB — 인프라 제약&quot;</span>})<span class='cm'>  ; ← 이유까지</span>

<span class='cm'>; /~ai — AI 전용 상태 엔드포인트</span>
<span class='kw'>(server-get</span> <span class='str'>&quot;/~ai&quot;</span>
  <span class='kw'>(fn</span> <span class='sym'>[req]</span>
    <span class='kw'>(server-html</span> <span class='kw'>(airc-render</span> handoff<span class='kw'>))))</span>
      </pre></div>
    </div>
  </div>

  <!-- 선언문 -->
  <section>
    <div class='manifesto'>
      <blockquote>
        새 언어를 소개하는 페이지처럼 보이지만,<br>
        실제 핵심 아이디어는<br>
        <span style='color:#a78bfa'>AI가 개발&middot;운영&middot;유지보수하기 쉬운<br>전체 소프트웨어 생태계를 만들겠다는 선언문</span>에 가깝다.
      </blockquote>
      <p class='attr'>— 기존 언어들의 출발점: 빠르다 / 안전하다 / 생산성이 높다<br>
      FreeLang의 출발점: <strong style='color:#67e8f9'>AI가 다음 AI에게 맥락을 잃지 않고 넘길 수 있는가</strong></p>
    </div>
  </section>

  <!-- 진짜 차별점 -->
  <section id='ecosystem'>
    <div class='s-label'>Real Differentiators</div>
    <div class='s-title'>S식이 차별점이 아닙니다</div>
    <p class='s-desc'>Lisp은 60년 전부터 있었습니다. Clojure도 있습니다.<br>
    FreeLang의 진짜 차별점은 <strong style='color:white'>AI 운영 생태계</strong>입니다.</p>

    <div class='eco-grid'>
      <div class='eco-card'>
        <span class='eco-icon'>📋</span>
        <div class='eco-code'>AIRC</div>
        <div class='eco-title'>AI 인수인계 문서 표준</div>
        <p class='eco-desc'>세션이 끊겨도 다음 AI가 맥락을 잃지 않습니다.
        완료 태스크&middot;미완료&middot;에러&middot;결정 이유까지 구조화된 포맷으로 기록합니다.
        기존 Lisp 계열 어디에도 없는 개념입니다.</p>
        <p class='eco-note'>Confluence가 아닌, AI가 직접 읽고 쓰는 상태 문서</p>
      </div>
      <div class='eco-card'>
        <span class='eco-icon'>🤖</span>
        <div class='eco-code'>/~ai 엔드포인트</div>
        <div class='eco-title'>AI 전용 상태 라우트</div>
        <p class='eco-desc'>모든 FL 앱에 <code style='color:#c4b5fd;font-family:monospace'>/~ai</code>가 내장됩니다.
        AI가 앱에 접근하면 현재 상태&middot;태스크&middot;에러를 JSON이 아닌 FL 구조체로 받습니다.
        AI가 앱의 상태를 스스로 진단할 수 있습니다.</p>
        <p class='eco-note'>사람 대시보드가 아닌, AI 진단 엔드포인트</p>
      </div>
      <div class='eco-card'>
        <span class='eco-icon'>🗂️</span>
        <div class='eco-code'>자동 에러 수집</div>
        <div class='eco-title'>에러 → AI 컨텍스트 자동 주입</div>
        <p class='eco-desc'>런타임 에러가 발생하면 스택트레이스 + 파일 + 줄 번호 + 최근 상태가
        AIRC 포맷으로 자동 기록됩니다. 다음 AI 세션이 시작할 때 에러 맥락이 이미 로드돼 있습니다.</p>
        <p class='eco-note'>Sentry가 아닌, AI 수정을 위한 구조화 에러 저장소</p>
      </div>
      <div class='eco-card'>
        <span class='eco-icon'>⚡</span>
        <div class='eco-code'>AI 친화 런타임</div>
        <div class='eco-title'>즉시 실행 + 즉시 수정</div>
        <p class='eco-desc'>npm install, tsc, pip 없음. AI가 코드를 생성하고 1초 안에 실행&middot;검증&middot;수정합니다.
        검증 루프 속도가 AI 작업 품질을 결정합니다.
        빌드 대기 시간이 곧 맥락 손실입니다.</p>
        <p class='eco-note'>빌드 파이프라인이 AI의 적이다</p>
      </div>
    </div>
  </section>

  <!-- S식 포지셔닝 -->
  <section id='sexp'>
    <div class='s-label'>S-Expression Positioning</div>
    <div class='s-title'>S식은 수단, 생태계가 목적</div>
    <p class='s-desc'>S식이 AI에게 유리한 건 사실입니다. 하지만 그것만으론 충분하지 않습니다.</p>

    <div class='sexp-row'>
      <div class='sexp-box good'>
        <div class='sexp-label g'>&#10003;#10003; S식이 실제로 좋은 이유</div>
        <div class='sexp-body'>
          파서가 단순합니다. <code>(defn f [x] body)</code> 하나로 모든 함수.
          중괄호&middot;세미콜론&middot;들여쓰기 규칙이 없습니다.<br><br>
          AI가 문법 선택을 고민하지 않습니다.
          <code>for</code>&middot;<code>while</code>&middot;<code>foreach</code>&middot;<code>loop</code> 중에 뭘 쓸지 결정 안 해도 됩니다.<br><br>
          AST가 코드 자체입니다. 파싱 실수가 구조적으로 불가능합니다.
        </div>
      </div>
      <div class='sexp-box context'>
        <div class='sexp-label c'>→ 하지만 Clojure도 이미 그렇습니다</div>
        <div class='sexp-body'>
          S식은 필요조건이지 충분조건이 아닙니다.<br><br>
          Clojure도 S식입니다. Racket도, Hy도 그렇습니다.
          이들이 AI 개발 생태계를 갖췄냐가 실제 질문입니다.<br><br>
          FreeLang의 답변: <strong style='color:#a78bfa'>AIRC + /~ai + 자동 에러 수집 + AI 인계 표준</strong>.
          이건 기존 Lisp 계열 어디에도 없습니다.
        </div>
      </div>
    </div>
  </section>

  <!-- 비교 -->
  <section id='compare'>
    <div class='s-label'>Language Comparison</div>
    <div class='s-title'>AI 운영 관점 비교</div>
    <p class='s-desc'>속도&middot;안전성이 아닌 AI 개발 생명주기 기준으로만 비교합니다.</p>

    <div class='tbl-wrap'>
      <table>
        <thead>
          <tr>
            <th style='width:170px'>기준</th>
            <th class='hl'>FreeLang</th>
            <th>Clojure</th>
            <th>Python</th>
            <th>TypeScript</th>
            <th>Go</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class='row-label'>AI 인수인계 표준</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> AIRC 내장</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
          </tr>
          <tr>
            <td class='row-label'>AI 전용 상태 엔드포인트</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> /~ai 기본값</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
            <td><span class='c-no'>&#10007;</span> 없음</td>
          </tr>
          <tr>
            <td class='row-label'>에러 → AI 컨텍스트 자동화</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> 자동</td>
            <td><span class='c-no'>&#10007;</span> 수동</td>
            <td><span class='c-no'>&#10007;</span> 수동</td>
            <td><span class='c-no'>&#10007;</span> 수동</td>
            <td><span class='c-no'>&#10007;</span> 수동</td>
          </tr>
          <tr>
            <td class='row-label'>빌드 없이 즉시 실행</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> 항상</td>
            <td><span class='c-half'>&#9651;</span> JVM 시작</td>
            <td><span class='c-ok'>&#10003;#10003;</span> 가능</td>
            <td><span class='c-no'>&#10007;</span> tsc 필요</td>
            <td><span class='c-no'>&#10007;</span> 빌드 필요</td>
          </tr>
          <tr>
            <td class='row-label'>S식 문법 일관성</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span></td>
            <td><span class='c-ok'>&#10003;#10003;</span></td>
            <td><span class='c-no'>&#10007;</span></td>
            <td><span class='c-no'>&#10007;</span></td>
            <td><span class='c-half'>&#9651;</span></td>
          </tr>
          <tr>
            <td class='row-label'>SSR + API 단일 언어</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> 내장</td>
            <td><span class='c-half'>&#9651;</span> Ring/별도</td>
            <td><span class='c-half'>&#9651;</span> 프레임워크</td>
            <td><span class='c-half'>&#9651;</span> Next 필요</td>
            <td><span class='c-half'>&#9651;</span> 직접 구현</td>
          </tr>
          <tr>
            <td class='row-label'>외부 의존성</td>
            <td class='hl'><span class='c-ok'>&#10003;#10003;</span> 0개</td>
            <td><span class='c-half'>&#9651;</span> Maven</td>
            <td><span class='c-half'>&#9651;</span> pip</td>
            <td><span class='c-no'>&#10007;</span> npm + tsc</td>
            <td><span class='c-ok'>&#10003;#10003;</span> go.mod</td>
