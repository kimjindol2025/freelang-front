{
  "name": "freelang-front",
  "version": "0.2.5",
  "description": "FreeLang v11 기반 파일 라우팅 SSR 프론트엔드 (삼중따옴표 보간 + 가독성 개선)",
  "author": "Claude",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gogs.dclub.kr/kim/freelang-front"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "node fl-front-build.js",
    "build:json": "node fl-front-build.js --json",
    "manifest": "node fl-manifest.js",
    "codes": "node fl-front-build.js --codes",
    "fix": "node fl-front-fix.js",
    "fix:dry": "node fl-front-fix.js --dry",
    "loop": "node fl-front-loop.js",
    "loop:dry": "node fl-front-loop.js --dry",
    "test:loop-humanshare": "node test-fl-loop-humanshare.js",
    "start": "PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost node fl-front-build.js && PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost node runtime/bootstrap.js run _app.fl",
    "dev": "PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost node dev-server.js",
    "init": "node fl-front-init.js"
  },
  "keywords": [
    "freelang",
    "ssr",
    "file-routing",
    "v11",
    "frontend",
    "error-reporting"
  ],
  "dependencies": {
    "freelang-v11": "^11.6.19"
  },
  "devDependencies": {},
  "meta": {
    "pages": 32,
    "phase": "B",
    "build_time_ms": 1180,
    "bundle_size_kb": 205,
    "code_lines_freelang_flx": 129,
    "dx_improvements": ["css_pairing", "file_separation", "triple_quote_interpolation", "multiline_formatting"],
    "features": {
      "error_reporting": true,
      "error_collection_api": true,
      "dev_mode_monitoring": true,
      "error_dashboard": true,
      "error_deduplication": true,
      "error_statistics": true,
      "performance_measurement": true,
      "performance_monitoring": true,
      "api_tracking": true,
      "memory_monitoring": true,
      "css_pairing": true,
      "file_separation": true,
      "triple_quote_strings": true,
      "multiline_html": true
    },
    "last_updated": "2026-06-02T00:40:00Z"
  }
