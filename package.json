  },
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "node fl-front-build.js",
    "build:json": "node fl-front-build.js --json",
    "typecheck": "node scripts/front-typecheck.js",
    "statecheck": "node scripts/state-contract-gate.js",
    "ssecheck": "node scripts/sse-contract-gate.js",
    "spacheck": "node scripts/spa-contract-gate.js",
    "verify": "node scripts/next90-release-gate.js",
    "verify:internal": "BASE_URL=http://127.0.0.1:40860 node scripts/next90-release-gate.js",
    "deploy:internal": "bash .freelang/internal-deploy.sh",
    "deploy:internal:dry": "FL_INTERNAL_DEPLOY_DRY_RUN=1 bash .freelang/internal-deploy.sh",
    "manifest": "node fl-manifest.js",
    "language:check": "node scripts/front-language-contract.js",
    "language:conformance": "node scripts/front-language-conformance.js",
    "language:diagnostics": "node scripts/front-diagnostics-contract.js",
    "contracts:verify": "node scripts/contract-baseline.js",
    "contracts:browser-errors": "node scripts/browser-error-map-contract.js",
    "front:context": "node scripts/front-source-context.js",
    "scaffold:contract": "node scripts/scaffold-contract.js",
    "language:check:fls": "node /home/kim/freelang-script/bin/fl-script-unified.js run --allow-read=.,/home/kim/freelang-script scripts/front-language-contract.fls front-language.contract.json",
    "adapter:collection": "node scripts/front-collection-adapter-contract.js",
    "hmr:contract": "node scripts/hmr-contract.js",
    "multi:contract": "node scripts/multi-instance-contract.js",
    "perf:contract": "node scripts/performance-contract.js",
    "libraries:contract": "node scripts/library-catalog-contract.js",
    "codes": "node fl-front-build.js --codes",
    "fix": "node fl-front-fix.js",
    "fix:dry": "node fl-front-fix.js --dry",
    "loop": "node fl-front-loop.js",
    "loop:dry": "node fl-front-loop.js --dry",
    "scaffold": "node fl-scaffold.js",
    "test:loop-humanshare": "node test-fl-loop-humanshare.js",
    "start": "PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost NODE_OPTIONS=--max-old-space-size=256 node fl-front-build.js && PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost NODE_OPTIONS=--max-old-space-size=256 node runtime/bootstrap.js run server.fl",
    "dev": "PORT=40860 FL_HTTP_ALLOW=127.0.0.1,localhost node dev-server.js",
    "init": "node fl-front-init.js",
    "browser": "node fl-browser.js",
    "browser:attach": "node fl-browser.js attach",
    "browser:check": "node fl-browser.js check active",
    "browser:contract": "bash scripts/browser-contract.sh",
    "browser:watch": "node fl-browser.js watch active",
    "browser:logs": "node fl-browser.js logs active",
    "browser:screenshot": "node fl-browser.js screenshot active",
    "browser:start": "node fl-browser.js start"
  },
  "keywords": [
    "freelang",
    "ssr",
    "file-routing",
    "v11",
    "frontend",
    "error-reporting"
  ],
