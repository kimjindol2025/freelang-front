{
  "name": "freelang-front",
  "version": "0.9.0",
  "description": "FreeLang v11 기반 파일 라우팅 SSR 프론트엔드 + SLO/SLA 운영 검증",
  "language": "FreeLang v11",
  "status": "in_progress",
  "phase": "Phase C: 운영 검증 & v1.0.0 준비",
  "ports": [40850],
