{
  "name": "freelang-front",
  "version": "0.8.0",
  "description": "FreeLang v11 기반 파일 라우팅 SSR 프론트엔드 + 커스텀 메트릭 지원",
  "language": "FreeLang v11",
  "status": "in_progress",
  "phase": "Phase B: 고급 분석 & 맞춤형 메트릭",
  "ports": [40850],
  "entry": "_app.fl",
  "pages_count": 32,
  "components": "pages/*.flx",
  "build_system": "fl-front-build.js",
  "commands": {
    "build": "node fl-front-build.js",
    "start": "node fl-front-build.js && node /home/kimjin/freelang-v11/bootstrap.js run _app.fl",
    "dev": "node dev-server.js",
    "init": "node fl-front-init.js"
  },
  "dependencies": {
    "freelang-v11": "v11.6.19"
  },
  "features": {
    "ssr": true,
    "hsr": true,
    "css_pairing": true,
    "client_side_routing": true,
    "error_reporting": true,
    "error_collection_api": true,
    "error_dashboard": true,
    "error_deduplication": true,
    "error_statistics": true
  },
  "maintainer": "Claude",
  "last_updated": "2026-06-02T00:05:00Z"
}
