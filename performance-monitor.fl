; performance-monitor.fl — 클라이언트 성능 모니터링
; v0.3.0 성능 대시보드 + 실시간 스트림

(load "freelang-stdlib-extensions.fl")

; ── 성능 데이터 저장소 (atom-based) ──
(def performance-log (atom []))
(def MAX-PERF-RECORDS 500)
(def performance-watchers (atom []))

; ── EventSource 등록 함수 ──
(defn register-watcher [$callback]
  (swap! performance-watchers conj $callback))

(defn notify-watchers [$record]
  (let [$watchers (deref performance-watchers)]
    (doseq [$callback $watchers]
      (try
        ($callback $record)
        (catch $e
          (log-warn (str "Watcher error: " $e)))))))

; ── 성능 기록 함수 ──
(defn record-performance [$metric]
  (let [perf-record {
    "metric" (get $metric "metric")
    "value" (get $metric "value")
    "unit" (get $metric "unit")
    "page" (get $metric "page")
    "timestamp" (str (date-now))
  }]

    ; atom에 저장 (최근 500개만 유지)
    (swap! performance-log
      (fn [$logs]
        (let [$new-logs (conj $logs perf-record)]
          (if (>= (length $new-logs) MAX-PERF-RECORDS)
            (rest $new-logs)
            $new-logs))))

    ; 로깅
    (log-info (str "[PERF] " (get perf-record "metric")
                   ": " (get perf-record "value")
                   (get perf-record "unit")))

    ; EventSource 워처 알림
    (notify-watchers perf-record)))

; ── 성능 통계 함수 (5가지 메트릭) ──
(defn get-performance-stats []
  (let [$all (deref performance-log)
        $page-loads (filter (fn [$p] (= (get $p "metric") "page-load")) $all)
        $api-calls (filter (fn [$p] (= (get $p "metric") "api-call")) $all)
        $route-transitions (filter (fn [$p] (= (get $p "metric") "route-transition")) $all)
        $long-tasks (filter (fn [$p] (= (get $p "metric") "long-task")) $all)
        $memory (filter (fn [$p] (= (get $p "metric") "memory")) $all)]
    {
      "total-records" (length $all)
      "page-loads" {
        "count" (length $page-loads)
        "average" (if (> (length $page-loads) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $page-loads))
             (length $page-loads))
          0)
      }
      "api-calls" {
        "count" (length $api-calls)
        "average" (if (> (length $api-calls) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $api-calls))
             (length $api-calls))
          0)
      }
      "route-transitions" {
        "count" (length $route-transitions)
        "average" (if (> (length $route-transitions) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $route-transitions))
             (length $route-transitions))
          0)
      }
      "long-tasks" {
        "count" (length $long-tasks)
        "average" (if (> (length $long-tasks) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $long-tasks))
             (length $long-tasks))
          0)
      }
      "memory" {
        "count" (length $memory)
        "current" (if (> (length $memory) 0)
          (get (last $memory) "value")
          0)
        "average" (if (> (length $memory) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $memory))
             (length $memory))
          0)
      }
      "recent" (take 10 (reverse $all))
    }))

; ── 성능 조회 함수 ──
(defn get-performance-metrics [$metric-type $limit]
  (let [$all (deref performance-log)
        $filtered (if $metric-type
          (filter (fn [$p] (= (get $p "metric") $metric-type)) $all)
          $all)
        $sorted (reverse $filtered)]
    {
      "metric" $metric-type
      "count" (length $sorted)
      "limit" $limit
      "metrics" (take $limit $sorted)
    }))

; ── 성능 범위별 분석 ──
(defn analyze-performance-range [$metric-type]
  (let [$metrics (get-performance-metrics $metric-type 100)
        $values (map (fn [$m] (get $m "value")) (get $metrics "metrics"))]
    {
      "metric" $metric-type
      "count" (length $values)
      "min" (if (> (length $values) 0) (reduce min 99999 $values) 0)
      "max" (if (> (length $values) 0) (reduce max 0 $values) 0)
      "average" (if (> (length $values) 0)
        (/ (reduce + 0 $values) (length $values))
        0)
      "p95" (if (> (length $values) 0)
        (let [$sorted (sort $values)
              $idx (- (length $sorted) (max 1 (round (/ (length $sorted) 20))))]
          (get $sorted $idx))
        0)
    }))

; ── 시간 범위 필터링 함수 (v0.3.0) ──
(defn filter-by-time-range [$records $hours]
  (let [$now (time-now)
        $threshold (* $hours 3600000)]
    (filter (fn [$r]
      (let [$ts (parse-date (get $r "timestamp"))
            $diff (- $now $ts)]
        (< $diff $threshold)))
      $records)))

; ── 페이지별 필터링 함수 (v0.3.0) ──
(defn filter-by-page [$records $page]
  (if (empty? $page)
    $records
    (filter (fn [$r]
      (= (get $r "page") $page))
      $records)))

; ── 메트릭 유형별 필터링 (v0.3.0) ──
(defn filter-by-metric [$records $metric-type]
  (if (nil? $metric-type)
    $records
    (filter (fn [$r]
      (= (get $r "metric") $metric-type))
      $records)))

; ── 고급 필터 조합 (v0.3.0) ──
(defn apply-filters [$metric $page $hours]
  (let [$all (deref performance-log)
        $by-metric (filter-by-metric $all $metric)
        $by-page (filter-by-page $by-metric $page)
        $by-time (filter-by-time-range $by-page $hours)]
    $by-time))

; ── CSV 내보내기 (v0.3.0) ──
(defn export-to-csv []
  (let [$records (deref performance-log)
        $header "metric,value,unit,page,timestamp\n"
        $rows (map (fn [$r]
          (str (get $r "metric") ","
               (get $r "value") ","
               (get $r "unit") ","
               (get $r "page") ","
               (get $r "timestamp")))
          $records)]
    (str $header (str-join "\n" $rows))))

; ── JSON 내보내기 (v0.3.0) ──
(defn export-to-json []
  (let [$records (deref performance-log)]
    (json-stringify {
      "count" (length $records)
      "data" $records
      "exported-at" (str (date-now))
    })))

; ── API: POST /api/metrics (성능 데이터 저장) ──
(defn handle-post-metrics [$req]
  (try
    (let [$body (get $req "body")
          $metric (when-nil (get $body "metric") "unknown")
          $value (when-nil (get $body "value") 0)
          $unit (when-nil (get $body "unit") "ms")
          $page (req-query-default $req "page" "")]

      ; 검증
      (validate-range $value 0 999999 "value")
      (validate-length $metric 3 50 "metric")

      ; 기록
      (record-performance {
        "metric" $metric
        "value" $value
        "unit" $unit
        "page" $page
      })

      (server-json {"ok" true "recorded" true} 200))

    (catch $e
      (log-error (str "Error handling POST /api/metrics: " $e))
      (server-json {"error" "Failed to record metric"} 500))))

; ── API: GET /api/metrics (성능 통계) ──
(defn handle-get-metrics [$req]
  (try
    (let [$metric (req-query-default $req "metric" nil)
          $limit (or (req-query-default $req "limit" "20") "20")
          $limit-num (str-to-num $limit)
          $result (if $metric
            (analyze-performance-range $metric)
            (get-performance-stats))]

      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling GET /api/metrics: " $e))
      (server-json {"error" "Failed to retrieve metrics"} 500))))

; ── API: DELETE /api/metrics (성능 로그 초기화) ──
(defn handle-delete-metrics [$req]
  (try
    (reset! performance-log [])
    (log-info "Performance log cleared")
    (server-json {"ok" true} 200)

    (catch $e
      (log-error (str "Error handling DELETE /api/metrics: " $e))
      (server-json {"error" "Failed to clear metrics"} 500))))
