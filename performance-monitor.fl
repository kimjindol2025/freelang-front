; performance-monitor.fl — 클라이언트 성능 모니터링
; v0.9.0 운영 검증 (SLO/SLA)

(load "freelang-stdlib-extensions.fl")

; ── 성능 데이터 저장소 (atom-based) ──
(define performance-log (atom []))
(define MAX-PERF-RECORDS 500)
(define performance-watchers (atom []))

; ── 알림 저장소 & 임계값 (v0.7.0) ──
(define alert-log (atom []))
(define MAX-ALERTS 200)
(define alert-thresholds {
  "page-load" 2000
  "api-call" 1000
  "memory" 80
  "long-task" 500
})
(define alert-watchers (atom []))

; ── 커스텀 메트릭 저장소 (v0.8.0) ──
(define custom-metrics (atom {}))
(define custom-metric-data (atom []))
(define MAX-CUSTOM-RECORDS 300)

; ── SLO/SLA 정의 (v0.9.0) ──
(define slo-definitions {
  "page-load" {"target" 3000 "threshold" 95}     ; 95% < 3초
  "api-call" {"target" 1500 "threshold" 98}      ; 98% < 1.5초
  "availability" {"target" 99.9 "threshold" 99.9} ; 99.9% uptime
})

(define sla-tracking (atom {
  "page-load" {"total" 0 "passed" 0 "percentage" 0}
  "api-call" {"total" 0 "passed" 0 "percentage" 0}
  "availability" {"uptime" 100}
}))

; ── EventSource 등록 함수 ──
(defn register-watcher [$callback]
  (swap! performance-watchers conj $callback))

(defn notify-watchers [$record]
  (let [$watchers (deref performance-watchers)]
    (doseq [$callback $watchers]
      (try
        ($callback $record)
        (catch $e
          (log-warn (str "Watcher error: " $e)))))))

; ── 성능 기록 함수 ──
(defn record-performance [$metric]
  (let [perf-record {
    "metric" (get $metric "metric")
    "value" (get $metric "value")
    "unit" (get $metric "unit")
    "page" (get $metric "page")
    "timestamp" (str (date-now))
  }]

    ; atom에 저장 (최근 500개만 유지)
    (swap! performance-log
      (fn [$logs]
        (let [$new-logs (conj $logs perf-record)]
          (if (>= (length $new-logs) MAX-PERF-RECORDS)
            (rest $new-logs)
            $new-logs))))

    ; 로깅
    (log-info (str "[PERF] " (get perf-record "metric")
                   ": " (get perf-record "value")
                   (get perf-record "unit")))

    ; EventSource 워처 알림
    (notify-watchers perf-record)

    ; 알림 감지 (v0.7.0)
    (detect-performance-alert perf-record)

    ; SLO 검증 (v0.9.0)
    (check-slo-compliance (get perf-record "metric") (get perf-record "value"))))

; ── 성능 통계 함수 (5가지 메트릭) ──
(defn get-performance-stats []
  (let [$all (deref performance-log)
        $page-loads (filter (fn [$p] (= (get $p "metric") "page-load")) $all)
        $api-calls (filter (fn [$p] (= (get $p "metric") "api-call")) $all)
        $route-transitions (filter (fn [$p] (= (get $p "metric") "route-transition")) $all)
        $long-tasks (filter (fn [$p] (= (get $p "metric") "long-task")) $all)
        $memory (filter (fn [$p] (= (get $p "metric") "memory")) $all)]
    {
      "total-records" (length $all)
      "page-loads" {
        "count" (length $page-loads)
        "average" (if (> (length $page-loads) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $page-loads))
             (length $page-loads))
          0)
      }
      "api-calls" {
        "count" (length $api-calls)
        "average" (if (> (length $api-calls) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $api-calls))
             (length $api-calls))
          0)
      }
      "route-transitions" {
        "count" (length $route-transitions)
        "average" (if (> (length $route-transitions) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $route-transitions))
             (length $route-transitions))
          0)
      }
      "long-tasks" {
        "count" (length $long-tasks)
        "average" (if (> (length $long-tasks) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $long-tasks))
             (length $long-tasks))
          0)
      }
      "memory" {
        "count" (length $memory)
        "current" (if (> (length $memory) 0)
          (get (last $memory) "value")
          0)
        "average" (if (> (length $memory) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $memory))
             (length $memory))
          0)
      }
      "recent" (take 10 (reverse $all))
    }))

; ── 성능 조회 함수 ──
(defn get-performance-metrics [$metric-type $limit]
  (let [$all (deref performance-log)
        $filtered (if $metric-type
          (filter (fn [$p] (= (get $p "metric") $metric-type)) $all)
          $all)
        $sorted (reverse $filtered)]
    {
      "metric" $metric-type
      "count" (length $sorted)
      "limit" $limit
      "metrics" (take $limit $sorted)
    }))

; ── 성능 범위별 분석 ──
(defn analyze-performance-range [$metric-type]
  (let [$metrics (get-performance-metrics $metric-type 100)
        $values (map (fn [$m] (get $m "value")) (get $metrics "metrics"))]
    {
      "metric" $metric-type
      "count" (length $values)
      "min" (if (> (length $values) 0) (reduce min 99999 $values) 0)
      "max" (if (> (length $values) 0) (reduce max 0 $values) 0)
      "average" (if (> (length $values) 0)
        (/ (reduce + 0 $values) (length $values))
        0)
      "p95" (if (> (length $values) 0)
        (let [$sorted (sort $values)
              $idx (- (length $sorted) (max 1 (round (/ (length $sorted) 20))))]
          (get $sorted $idx))
        0)
    }))

; ── 시간 범위 필터링 함수 (v0.3.0) ──
(defn filter-by-time-range [$records $hours]
  (let [$now (time-now)
        $threshold (* $hours 3600000)]
    (filter (fn [$r]
      (let [$ts (parse-date (get $r "timestamp"))
            $diff (- $now $ts)]
        (< $diff $threshold)))
      $records)))

; ── 페이지별 필터링 함수 (v0.3.0) ──
(defn filter-by-page [$records $page]
  (if (empty? $page)
    $records
    (filter (fn [$r]
      (= (get $r "page") $page))
      $records)))

; ── 메트릭 유형별 필터링 (v0.3.0) ──
(defn filter-by-metric [$records $metric-type]
  (if (nil? $metric-type)
    $records
    (filter (fn [$r]
      (= (get $r "metric") $metric-type))
      $records)))

; ── 고급 필터 조합 (v0.3.0) ──
(defn apply-filters [$metric $page $hours]
  (let [$all (deref performance-log)
        $by-metric (filter-by-metric $all $metric)
        $by-page (filter-by-page $by-metric $page)
        $by-time (filter-by-time-range $by-page $hours)]
    $by-time))

; ── CSV 내보내기 (v0.3.0) ──
(defn export-to-csv []
  (let [$records (deref performance-log)
        $header "metric,value,unit,page,timestamp\n"
        $rows (map (fn [$r]
          (str (get $r "metric") ","
               (get $r "value") ","
               (get $r "unit") ","
               (get $r "page") ","
               (get $r "timestamp")))
          $records)]
    (str $header (str-join "\n" $rows))))

; ── JSON 내보내기 (v0.3.0) ──
(defn export-to-json []
  (let [$records (deref performance-log)]
    (json-stringify {
      "count" (length $records)
      "data" $records
      "exported-at" (str (date-now))
    })))

; ── API: POST /api/metrics (성능 데이터 저장) ──
(defn handle-post-metrics [$req]
  (try
    (let [$body (get $req "body")
          $metric (when-nil (get $body "metric") "unknown")
          $value (when-nil (get $body "value") 0)
          $unit (when-nil (get $body "unit") "ms")
          $page (req-query-default $req "page" "")]

      ; 검증
      (validate-range $value 0 999999 "value")
      (validate-length $metric 3 50 "metric")

      ; 기록
      (record-performance {
        "metric" $metric
        "value" $value
        "unit" $unit
        "page" $page
      })

      (server-json {"ok" true "recorded" true} 200))

    (catch $e
      (log-error (str "Error handling POST /api/metrics: " $e))
      (server-json {"error" "Failed to record metric"} 500))))

; ── API: GET /api/metrics (성능 통계) ──
(defn handle-get-metrics [$req]
  (try
    (let [$metric (req-query-default $req "metric" nil)
          $limit (or (req-query-default $req "limit" "20") "20")
          $limit-num (str-to-num $limit)
          $result (if $metric
            (analyze-performance-range $metric)
            (get-performance-stats))]

      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling GET /api/metrics: " $e))
      (server-json {"error" "Failed to retrieve metrics"} 500))))

; ── API: DELETE /api/metrics (성능 로그 초기화) ──
(defn handle-delete-metrics [$req]
  (try
    (reset! performance-log [])
    (log-info "Performance log cleared")
    (server-json {"ok" true} 200)

    (catch $e
      (log-error (str "Error handling DELETE /api/metrics: " $e))
      (server-json {"error" "Failed to clear metrics"} 500))))

; ── 알림 감지 함수 (v0.7.0) ──
(defn detect-performance-alert [$record]
  (let [$metric (get $record "metric")
        $value (get $record "value")
        $threshold (get alert-thresholds $metric)]
    (if (and $threshold (> $value $threshold))
      (let [$alert {
        "id" (str (random))
        "type" "performance"
        "metric" $metric
        "value" $value
        "threshold" $threshold
        "severity" (if (> $value (* $threshold 1.5)) "high" "warning")
        "message" (str $metric " 초과: " $value "ms (임계값: " $threshold "ms)")
        "timestamp" (str (date-now))
      }]
        ; atom에 저장 (최근 200개만 유지)
        (swap! alert-log
          (fn [$alerts]
            (let [$new-alerts (conj $alerts $alert)]
              (if (>= (length $new-alerts) MAX-ALERTS)
                (rest $new-alerts)
                $new-alerts))))

        ; 로깅
        (log-warn (str "[ALERT] " (get $alert "message")))

        ; 알림 워처 알림
        (let [$watchers (deref alert-watchers)]
          (doseq [$callback $watchers]
            (try
              ($callback $alert)
              (catch $e
                (log-warn (str "Alert watcher error: " $e))))))))))

; ── 알림 워처 등록 함수 (v0.7.0) ──
(defn register-alert-watcher [$callback]
  (swap! alert-watchers conj $callback))

; ── 알림 조회 함수 (v0.7.0) ──
(defn get-alerts [$limit]
  (let [$all (deref alert-log)
        $sorted (reverse $all)]
    {
      "total" (length $all)
      "alerts" (take $limit $sorted)
    }))

; ── 커스텀 메트릭 관리 함수 (v0.8.0) ──
(defn create-custom-metric [$name $description $unit $threshold]
  (let [$id (str (random))
        $metric {
          "id" $id
          "name" $name
          "description" $description
          "unit" $unit
          "threshold" $threshold
          "created-at" (str (date-now))
          "records" 0
        }]
    (swap! custom-metrics assoc $id $metric)
    $metric))

(defn record-custom-metric [$metric-id $value]
  (let [$metrics (deref custom-metrics)
        $metric (get $metrics $metric-id)]
    (if $metric
      (let [$record {
        "id" $metric-id
        "value" $value
        "timestamp" (str (date-now))
      }]
        (swap! custom-metric-data
          (fn [$data]
            (let [$new-data (conj $data $record)]
              (if (>= (length $new-data) MAX-CUSTOM-RECORDS)
                (rest $new-data)
                $new-data))))

        ; 임계값 체크
        (if (and (get $metric "threshold") (> $value (get $metric "threshold")))
          (let [$alert {
            "id" (str (random))
            "type" "custom"
            "metric" (get $metric "name")
            "value" $value
            "threshold" (get $metric "threshold")
            "severity" (if (> $value (* (get $metric "threshold") 1.5)) "high" "warning")
            "message" (str (get $metric "name") " 초과: " $value (get $metric "unit"))
            "timestamp" (str (date-now))
          }]
            (swap! alert-log
              (fn [$alerts]
                (let [$new-alerts (conj $alerts $alert)]
                  (if (>= (length $new-alerts) MAX-ALERTS)
                    (rest $new-alerts)
                    $new-alerts))))))

        $record)
      nil)))

(defn get-custom-metrics []
  (deref custom-metrics))

(defn get-custom-metric-data [$metric-id $limit]
  (let [$all (deref custom-metric-data)
        $filtered (filter (fn [$r] (= (get $r "id") $metric-id)) $all)
        $sorted (reverse $filtered)]
    {
      "metric-id" $metric-id
      "count" (length $filtered)
      "data" (take $limit $sorted)
    }))

; ── SLO/SLA 검증 함수 (v0.9.0) ──
(defn check-slo-compliance [$metric $value]
  (let [$slo (get slo-definitions $metric)]
    (if $slo
      (let [$tracking (deref sla-tracking)
            $metric-tracking (get $tracking $metric)
            $total (+ (get $metric-tracking "total") 1)
            $passed (if (<= $value (get $slo "target"))
              (+ (get $metric-tracking "passed") 1)
              (get $metric-tracking "passed"))
            $percentage (round (/ (* $passed 100) $total))]
        (swap! sla-tracking assoc $metric {
          "total" $total
          "passed" $passed
          "percentage" $percentage
          "slo-target" (get $slo "threshold")
          "compliant" (>= $percentage (get $slo "threshold"))
        })))))

(defn get-sla-report []
  (let [$tracking (deref sla-tracking)]
    {
      "timestamp" (str (date-now))
      "metrics" (map (fn [[$k $v]]
        {
          "metric" $k
          "total-requests" (get $v "total")
          "passed-requests" (get $v "passed")
          "success-percentage" (get $v "percentage")
          "slo-target" (get $v "slo-target")
          "compliant" (get $v "compliant")
        })
        $tracking)
    }))

(defn get-sla-status []
  (let [$report (get-sla-report)
        $metrics (get $report "metrics")]
    {
      "timestamp" (get $report "timestamp")
      "all-compliant" (every? (fn [$m] (get $m "compliant")) $metrics)
      "compliance-rate" (round (/ (reduce + 0 (map (fn [$m] (get $m "success-percentage")) $metrics))
                                   (length $metrics)))
      "metrics" $metrics
    }))
