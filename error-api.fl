; error-api.fl — 클라이언트 에러 수집 및 저장
; v0.2.1 에러 리포팅 시스템


; ── 에러 저장소 (atom-based, 최근 100개) ──
(define error-log (atom []))
(define MAX-ERRORS 100)

; ── 에러 추가 함수 ──
(defn add-error [$entry]
  (let [error-with-time {
    "type" (get $entry "type")
    "message" (get $entry "message")
    "source" (get $entry "source")
    "line" (get $entry "line")
    "stack" (get $entry "stack")
    "user-agent" (get $entry "user-agent")
    "timestamp" (str (date-now))
  }]

    ; atom에 저장 (최근 100개만 유지)
    (swap! error-log
      (fn [$errors]
        (let [$new-errors (conj $errors error-with-time)]
          (if (>= (length $new-errors) MAX-ERRORS)
            (rest $new-errors)
            $new-errors))))

    ; 로깅
    (log-error (str "[CLIENT] " (get error-with-time "message")
                    " (" (get error-with-time "type") ")"))))

; ── 에러 조회 함수 ──
(defn get-errors [$limit]
  (let [$errors (deref error-log)
        $count (length $errors)]
    {
      "total" $count
      "limit" $limit
      "returned" (min $count $limit)
      "errors" (take $limit (reverse $errors))
    }))

; ── 에러 초기화 함수 ──
(defn clear-errors []
  (reset! error-log [])
  {"ok" true})

; ── 에러 필터링 함수 ──
(defn filter-errors [$type]
  (let [$all-errors (deref error-log)
        $filtered (filter
          (fn [$e] (= (get $e "type") $type))
          $all-errors)]
    {
      "type" $type
      "count" (length $filtered)
      "errors" (take 20 (reverse $filtered))
    }))

; ── API: POST /api/errors (에러 저장) ──
(defn handle-post-errors [$req]
  (try
    (let [$body (get $req "body")
          $message (or (get $body "message") "Unknown error")
          $type (or (get $body "type") "error")
          $source (get $body "source")
          $line (get $body "line")
          $stack (get $body "stack")
          $user-agent (get (get $req "headers") "user-agent")]

      ; 검증
      (validate-length $message 5 1000 "message")

      ; 에러 추가
      (add-error {
        "type" $type
        "message" $message
        "source" $source
        "line" $line
        "stack" $stack
        "user-agent" $user-agent
      })

      (server-json {"ok" true "received" true} 200))

    (catch $e
      (log-error (str "Error handling POST /api/errors: " $e))
      (server-json {
        "error" "Failed to log error"
        "details" (str $e)
      } 500))))

; ── API: GET /api/errors (에러 목록) ──
(defn handle-get-errors [$req]
  (try
    (let [$limit (or (req-query-default $req "limit" "20") "20")
          $limit-num (str-to-num $limit)
          $type (req-query-default $req "type" nil)
          $result (if $type
            (filter-errors $type)
            (get-errors $limit-num))]

      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling GET /api/errors: " $e))
      (server-json {"error" "Failed to retrieve errors"} 500))))

; ── API: DELETE /api/errors (에러 초기화) ──
(defn handle-delete-errors [$req]
  (try
    (let [$result (clear-errors)]
      (log-info "Error log cleared")
      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling DELETE /api/errors: " $e))
      (server-json {"error" "Failed to clear errors"} 500))))

; ── 통계 함수 ──
(defn get-error-stats []
  (let [$all (deref error-log)
        $errors (filter (fn [$e] (= (get $e "type") "error")) $all)
        $warns (filter (fn [$e] (= (get $e "type") "warn")) $all)
        $promise (filter (fn [$e] (= (get $e "type") "promise")) $all)
        $console (filter (fn [$e] (= (get $e "type") "console")) $all)]
    {
      "total" (length $all)
      "by-type" {
        "error" (length $errors)
        "warn" (length $warns)
        "promise" (length $promise)
        "console" (length $console)
      }
      "recent" (take 5 (reverse $all))
    }))

; ── 에러 중복 제거 함수 ──
(defn deduplicate-errors []
  (let [$all (deref error-log)
        $seen (atom {})
        $unique (filter
          (fn [$e]
            (let [$key (str (get $e "type") ":" (get $e "message"))
                  $seen-map (deref $seen)
                  $is-new (nil? (get $seen-map $key))]
              (if $is-new
                (swap! $seen (fn [m] (assoc m $key true))))
              $is-new))
          $all)]
    {
      "total" (length $all)
      "unique" (length $unique)
      "duplicates" (- (length $all) (length $unique))
    }))

; ── 에러 성능 측정 ──
(defn measure-error-api-time [$fn]
  (measure-time $fn "error-api-call"))

; ── 에러 범위 필터 (최근 N분) ──
(defn get-recent-errors [$minutes]
  (let [$all (deref error-log)
        $cutoff-ms (* $minutes 60 1000)
        $now (date-now)
        $filtered (filter
          (fn [$e]
            (let [$age (- $now (str-to-num (get $e "timestamp")))]
              (< $age $cutoff-ms)))
          $all)]
    {
      "minutes" $minutes
      "count" (length $filtered)
      "errors" (take 20 (reverse $filtered))
    }))

; ── 에러 소스별 통계 ──
(defn get-errors-by-source []
  (let [$all (deref error-log)
        $sources (atom {})]
    (map (fn [$e]
      (let [$source (get $e "source")
            $count (or (get (deref $sources) $source) 0)]
        (swap! $sources (fn [s] (assoc s $source (+ $count 1))))))
    $all)
    (let [$source-map (deref $sources)
          $sorted (sort-by (fn [$pair] (- (get $pair 1))) (into [] $source-map))]
      {
        "by-source" $sorted
        "top-5" (take 5 $sorted)
      })))
