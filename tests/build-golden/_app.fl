", {\"style\": \"text-align:center;padding:60px;color:#9ca3af;background:white;border-radius:16px\"}, _fl_str(_fl.h(\"div\", {\"style\": \"font-size:2.5rem;margin-bottom:8px\"}, \"💳\"), _fl.h(\"p\", {\"style\": \"margin:0\"}, \"등록된 구독이 없습니다\")))) : (_fl.h(\"div\", {\"style\": \"display:flex;flex-direction:column;gap:10px\"}, _fl.map_arr((s) => { return _fl.h(\"div\", {\"style\": _fl_str(\"background:white;border-radius:12px;padding:16px 20px;\", \"box-shadow:0 1px 4px rgba(0,0,0,.06);display:flex;\", \"align-items:center;gap:14px;\", \"opacity:\", ((_fl.get(s, \"active\") === 1)) ? (\"1\") : (\".55\"))}, _fl_str(_fl.h(\"div\", {\"style\": _fl_str(\"width:42px;height:42px;border-radius:10px;background:\", _fl.get(s, \"color\"), \";display:flex;align-items:center;\", \"justify-content:center;color:white;font-weight:800;\", \"font-size:.85rem;flex-shrink:0\")}, str_slice(_fl.get(s, \"name\"), 0, 2)), _fl.h(\"div\", {\"style\": \"flex:1;min-width:0\"}, _fl_str(_fl.h(\"div\", {\"style\": \"font-weight:600;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\"}, _fl.get(s, \"name\")), _fl.h(\"div\", {\"style\": \"font-size:.78rem;color:#9ca3af;margin-top:2px\"}, _fl_str(_fl.get(s, \"category\"), \" · \", cond((_fl.get(s, \"cycle\") === \"yearly\"), \"연간\", (_fl.get(s, \"cycle\") === \"weekly\"), \"주간\", true, \"월간\"), (!((_fl.get(s, \"next_billing\") === \"\"))) ? (_fl_str(\" · \", _fl.get(s, \"next_billing\"))) : (\"\"))))), _fl.h(\"div\", {\"style\": \"text-align:right;flex-shrink:0\"}, _fl_str(_fl.h(\"div\", {\"style\": \"font-weight:700;font-size:1rem\"}, _fl_str(\"₩\", floor(_fl.get(s, \"amount\")))), ((_fl.get(s, \"cycle\") === \"yearly\")) ? (_fl.h(\"div\", {\"style\": \"font-size:.72rem;color:#9ca3af\"}, _fl_str(\"월 ₩\", floor((_fl.get(s, \"amount\") / 12))))) : (\"\"))), _fl.h(\"div\", {\"style\": \"display:flex;gap:4px;flex-shrink:0\"}, _fl_str(_fl.h(\"button\", {\"title\": \"활성/비활성\", \"style\": \"background:none;border:none;cursor:pointer;font-size:1.1rem;padding:4px;line-height:1\", \"on-click\": () => { return tog(_fl_str(_fl.get(s, \"id\"))); }}, ((_fl.get(s, \"active\") === 1)) ? (\"✅\") : (\"⭕\")), _fl.h(\"button\", {\"title\": \"삭제\", \"style\": \"background:none;border:none;cursor:pointer;color:#ef4444;font-size:1.1rem;padding:4px;line-height:1\", \"on-click\": () => { return del(_fl_str(_fl.get(s, \"id\"))); }}, \"×\"))))); }, _fl.get(_fl.deref(data), \"subs\")))))); };\n})());\n//# sourceURL=island-subsapp.flx\n</script>")
