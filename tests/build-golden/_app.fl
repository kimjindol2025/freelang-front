; ── pages/tasks.flx ──
;;; Task Manager (FreeLang Front)
;;; pages/tasks.flx

(defn page_tasks__inner [req]
  (layout-html "Task Manager"
    (h "div" {:class "container"}
      (h "h1" {} "🎯 Task Manager")
      (h "p" {} "포트 40102 API 연동 예정")
      (h "div" {:class "card"}
        (h "h2" {} "Task Card Example")
        (h "p" {} "우선순위: HIGH")
        (h "p" {} "상태: pending")))
    req))

(defn page_tasks_post__inner [req]
  (server-redirect "/tasks"))
(defn page_tasks [req]
  (try (page_tasks__inner req)
    (catch $err (dev-error-page "/tasks" (str $err)))))
(defn page_tasks_post [req]
  (try (page_tasks_post__inner req)
    (catch $err (dev-error-page "/tasks [POST]" (str $err)))))

; ── pages/test-helpers.flx ──
; 주입 헬퍼 검증 페이지 — round / str-slice / map-indexed

(defn page_test_helpers__inner [req]
  (let [; ── round 테스트 ──
        r1 (round 3.7)
        r2 (round 3.2)
        r3 (round 1.5)
        r4 (round 0.4)

        ; ── str-slice 테스트 ──
        s1 (str-slice "Hello, World!" 0 5)
        s2 (str-slice "FreeLang" 4 8)
        s3 (str-slice "abcdef" 2 4)

        ; ── map-indexed 테스트 ──
        items ["사과" "바나나" "체리" "딸기"]
        rows  (map-indexed
                (fn [i item]
                  (h "tr" {}
                    (str
                      (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb;color:#6b7280"} (str i))
                      (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} item))))
                items)]

    (server_html
      (str
        "<!DOCTYPE html><html><head><meta charset='utf-8'>"
        "<title>헬퍼 검증</title>"
        "<style>body{font-family:monospace;padding:40px;background:#f9fafb}"
        "h2{color:#374151;margin-top:32px;margin-bottom:8px}"
        ".box{background:white;border:1px solid #e5e7eb;border-radius:8px;padding:20px;margin-bottom:16px}"
        ".ok{color:#16a34a;font-weight:700}"
        ".fail{color:#dc2626;font-weight:700}"
        "table{border-collapse:collapse;width:100%}"
        "</style></head><body>"

        "<h1 style='color:#111'>주입 헬퍼 검증</h1>"

        ; ── round ──
        "<h2>1. round()</h2>"
        "<div class='box'>"
        "<table>"
        (h "tr" {}
          (str
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "입력")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "결과")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "기댓값")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "상태")))
        (arr-join
          (map (fn [row]
            (h "tr" {}
              (str
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (get row 0))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (str (get row 1)))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (str (get row 2)))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"}
                  (if (= (str (get row 1)) (str (get row 2)))
                    (h "span" {:class "ok"} "✅ PASS")
                    (h "span" {:class "fail"} "❌ FAIL"))))))
            [["3.7" r1 4] ["3.2" r2 3] ["1.5" r3 2] ["0.4" r4 0]])
          "")
        "</table></div>"

        ; ── str-slice ──
        "<h2>2. str-slice()</h2>"
        "<div class='box'>"
        "<table>"
        (h "tr" {}
          (str
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "입력")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "범위")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "결과")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "기댓값")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "상태")))
        (arr-join
          (map (fn [row]
            (h "tr" {}
              (str
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (get row 0))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (get row 1))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb;font-weight:bold"} (str (get row 2)))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"} (get row 3))
                (h "td" {:style "padding:8px 16px;border:1px solid #e5e7eb"}
                  (if (= (get row 2) (get row 3))
                    (h "span" {:class "ok"} "✅ PASS")
                    (h "span" {:class "fail"} "❌ FAIL"))))))
            [["Hello, World!" "0~5" s1 "Hello"]
             ["FreeLang"      "4~8" s2 "Lang"]
             ["abcdef"        "2~4" s3 "cd"]])
          "")
        "</table></div>"

        ; ── map-indexed ──
        "<h2>3. map-indexed()</h2>"
        "<div class='box'>"
        "<table>"
        (h "tr" {}
          (str
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "인덱스")
            (h "th" {:style "text-align:left;padding:8px 16px;background:#f3f4f6"} "값")))
        (arr-join rows "")
        "</table>"
        "<p style='margin-top:12px;color:#6b7280;font-size:.9rem'>"
        "인덱스 0~3, 순서 맞으면 ✅</p>"
        "</div>"

        "</body></html>"))))
(defn page_test_helpers [req]
  (try (page_test_helpers__inner req)
    (catch $err (dev-error-page "/test-helpers" (str $err)))))

; ── pages/todo.flx ──
(defn page_todo__inner [req]
  (layout-html "To-do" (str
      "<h2 style='margin:0 0 8px'>To-do Island</h2>"
      "<p style='color:#6b7280;margin:0 0 24px'>atom 배열 상태 · 추가 / 완료 토글 / 삭제 — 순수 클라이언트 Island</p>"
      "<div id='island-todoapp-0'></div>"
      "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_badge