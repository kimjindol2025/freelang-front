      req)))
(defn page_app_index [req]
  (try (page_app_index__inner req)
    (catch $err (dev-error-page "/app" (str $err)))))

; ── pages/contact/thanks.flx ──
; GET /contact/thanks — 문의 완료 페이지
(defn page_contact_thanks__inner [req]
  (let [name (server-req-query req "name")]
    (server-html (str
      "<!DOCTYPE html><html><head>"
      "<meta charset='utf-8'>"
      "<title>문의 완료 — FreeLang Front</title>"
      "<style>"
      "body{font-family:sans-serif;margin:0;background:#f9fafb}"
      ".wrap{max-width:560px;margin:80px auto;padding:0 24px;text-align:center}"
      ".card{background:white;border-radius:12px;padding:48px 32px;"
      "box-shadow:0 4px 12px rgba(0,0,0,.1)}"
      ".icon{font-size:3rem;margin-bottom:16px}"
      "h2{color:#111;margin:0 0 8px}"
      "p{color:#6b7280;margin:0 0 24px}"
      "a{display:inline-block;background:#6366f1;color:white;text-decoration:none;"
      "border-radius:6px;padding:10px 24px;font-size:.95rem}"
      "a:hover{background:#4f46e5}"
      "</style>"
      "</head><body>"
      "<div class='wrap'>"
      "<div class='card'>"
      "<div class='icon'>&#x2705;</div>"
      "<h2>"
      (if (= name nil) "감사합니다" (str name "님, 감사합니다"))
      "</h2>"
      "<p>문의가 성공적으로 접수되었습니다.<br>빠른 시일 내에 답변 드리겠습니다.</p>"
      "<a href='/'>홈으로 돌아가기</a>"
      "</div>"
      "</div>"
      "</body></html>"))))
(defn page_contact_thanks [req]
  (try (page_contact_thanks__inner req)
    (catch $err (dev-error-page "/contact/thanks" (str $err)))))

; ── pages/contact.flx ──
; GET /contact — 문의 폼 렌더
; POST /contact — 폼 처리 → /contact/thanks redirect (또는 에러 재렌더)

; POST 핸들러 — server-req-json이 {name email message} 객체 반환
; (form-field req "name") → "홍길동" 또는 ""
(defn form-field [req key]
  (let [parsed (server-req-json req)
        val    (get parsed key)]
    (if (= val nil) "" val)))

; GET 핸들러 — ?error=1 시 에러 메시지 표시
(defn page_contact__inner [req]
  (let [err (server-req-query req "error")]
    (server-html (str
      "<!DOCTYPE html><html><head>"
      "<meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>문의하기 — FreeLang Front</title>"
      "<style>"
      "body{font-family:sans-serif;margin:0;background:#f9fafb}"
      ".wrap{max-width:560px;margin:0 auto;padding:48px 24px}"
      "label{display:block;font-size:.9rem;color:#374151;margin-bottom:4px}"
      "input,textarea{width:100%;box-sizing:border-box;border:1px solid #d1d5db;"
      "border-radius:6px;padding:10px 12px;font-size:1rem;margin-bottom:16px}"
      "input:focus,textarea:focus{outline:2px solid #6366f1;border-color:transparent}"
      "button{background:#6366f1;color:white;border:none;border-radius:6px;"
      "padding:12px 32px;font-size:1rem;cursor:pointer;width:100%}"
      "button:hover{background:#4f46e5}"
      ".err{background:#fef2f2;border:1px solid #fecaca;border-radius:6px;"
      "padding:12px 16px;color:#dc2626;margin-bottom:16px;font-size:.9rem}"
      ".nav{margin-bottom:24px}"
      ".nav a{color:#6366f1;text-decoration:none;font-size:.9rem}"
      "</style>"
      "</head><body>"
      "<div class='wrap'>"
      "<div class='nav'><a href='/'>← 홈으로</a></div>"
      "<div class='" form_box "'>"
      "<h2 style='margin:0 0 24px;color:#111'>문의하기</h2>"
      (if (= err "1")
        "<div class='err'>이름과 이메일을 모두 입력해 주세요.</div>"
        "")
      "<form method='POST' action='/contact'>"
      "<label>이름</label>"
      "<input type='text' name='name' placeholder='홍길동' required>"
      "<label>이메일</label>"
      "<input type='email' name='email' placeholder='hello@example.com' required>"
      "<label>메시지</label>"
      "<textarea name='message' rows='5' placeholder='문의 내용을 입력해 주세요...'></textarea>"
      "<button type='submit'>보내기</button>"
      "</form>"
      "</div>"
      "</div>"
      "</body></html>"))))

; POST 핸들러 — form-field 파싱 → 검증 → redirect
; server-redirect가 encodeURI로 한글 자동 인코딩하므로 raw 값 그대로 전달
(defn page_contact_post__inner [req]
  (let [name  (form-field req "name")
        email (form-field req "email")]
    (if (= name "")
      (server-redirect "/contact?error=1")
      (if (= email "")
        (server-redirect "/contact?error=1")
        (server-redirect (str "/contact/thanks?name=" name))))))
(defn page_contact [req]
  (try (page_contact__inner req)
    (catch $err (dev-error-page "/contact" (str $err)))))
(defn page_contact_post [req]
  (try (page_contact_post__inner req)
    (catch $err (dev-error-page "/contact [POST]" (str $err)))))

; ── pages/contacts/api.flx ──
; pages/contacts/api.flx — 연락처 JSON API
; GET  /contacts/api?q=검색어 → {contacts}
; GET  /contacts/api?overdue=1  → {overdue}
; POST /contacts/api → action: add|delete|save-remind

; ── inlined: pages/contacts/_db.flx ──
; ── ns: contacts ──
; pages/contacts/_db.flx — 연락처 DB (독립 CRM)
; 완전 독립: Android/iOS/Google Contacts 등 외부 주소록 연동 없음. 자체 contacts.db 만 사용.
; 활동기록(activities)도 자동수집 없이 사용자 직접 입력(통화 로그/SMS 읽기 X).

(define CONTACTS-DB {:type "sqlite" :path "data/contacts.db"})

(defn contacts-init []
  (do
    (db-exec CONTACTS-DB
      "CREATE TABLE IF NOT EXISTS contacts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        phone TEXT DEFAULT '',
        email TEXT DEFAULT '',
        company TEXT DEFAULT '',
        memo TEXT DEFAULT '',
        group_name TEXT DEFAULT '일반',
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])
    ; 마이그레이션: 누락 컬럼 추가 (이미 있으면 오류 무시)
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN company TEXT DEFAULT ''" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN job_title TEXT DEFAULT ''" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN tags TEXT DEFAULT ''" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN met_at TEXT DEFAULT ''" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN remind_days INTEGER DEFAULT 0" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN last_contact_at TEXT DEFAULT ''" [])
         (catch e nil))
    (try (db-exec CONTACTS-DB "ALTER TABLE contacts ADD COLUMN linked_url TEXT DEFAULT ''" [])
         (catch e nil))
    (db-exec CONTACTS-DB
      "CREATE TABLE IF NOT EXISTS activities (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        contact_id INTEGER NOT NULL,
        log_date TEXT DEFAULT (date('now','localtime')),
        content TEXT NOT NULL,
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])))

; ── 연락처 ─────────────────────────────────────────────────────
(defn contacts-all []
  (db-query CONTACTS-DB "SELECT * FROM contacts ORDER BY name ASC" []))

(defn contacts-search [q]
  (db-query CONTACTS-DB
    "SELECT * FROM contacts WHERE name LIKE ? OR phone LIKE ? OR email LIKE ? OR company LIKE ? ORDER BY name ASC"
    [(str "%" q "%") (str "%" q "%") (str "%" q "%") (str "%" q "%")]))

(defn contacts-by-id [id]
  ; db-one 미존재 → db-query 후 첫 행
  (let [rows (db-query CONTACTS-DB "SELECT * FROM contacts WHERE id=?" [(str-to-num id)])]
    (if (> (length rows) 0)
      (get rows 0)
      nil)))

(defn contacts-add [name phone email company memo group-name job-title tags met-at remind-days linked-url]
  (db-exec CONTACTS-DB
    "INSERT INTO contacts (name,phone,email,company,memo,group_name,job_title,tags,met_at,remind_days,linked_url)
     VALUES (?,?,?,?,?,?,?,?,?,?,?)"
    [name phone email company memo group-name job-title tags met-at (str-to-num remind-days) linked-url]))

(defn contacts-update [id name phone email company memo group-name job-title tags met-at remind-days linked-url]
  (db-exec CONTACTS-DB
    "UPDATE contacts SET name=?,phone=?,email=?,company=?,memo=?,group_name=?,
     job_title=?,tags=?,met_at=?,remind_days=?,linked_url=? WHERE id=?"
    [name phone email company memo group-name job-title tags met-at (str-to-num remind-days) linked-url (str-to-num id)]))

(defn contacts-delete [id]
  (do
    (db-exec CONTACTS-DB "DELETE FROM activities WHERE contact_id=?" [(str-to-num id)])
    (db-exec CONTACTS-DB "DELETE FROM contacts WHERE id=?" [(str-to-num id)])))

; ── 활동 기록 (직접 입력) ───────────────────────────────────────
(defn contacts-activities-by-contact [contact-id]
  (db-query CONTACTS-DB
    "SELECT * FROM activities WHERE contact_id=? ORDER BY log_date DESC, id DESC"
    [(str-to-num contact-id)]))

(defn contacts-update-last-contact [contact-id]
  (db-exec CONTACTS-DB
    "UPDATE contacts SET last_contact_at=date('now','localtime') WHERE id=?"
    [(str-to-num contact-id)]))

(defn contacts-save-remind [contact-id remind-days]
  (db-exec CONTACTS-DB
    "UPDATE contacts SET remind_days=? WHERE id=?"
    [(str-to-num remind-days) (str-to-num contact-id)]))

(defn contacts-overdue []
  (db-query CONTACTS-DB
    "SELECT *,
       CASE
         WHEN last_contact_at='' THEN 9999
         ELSE CAST(julianday('now','localtime') - julianday(last_contact_at) AS INTEGER)
       END AS days_since
     FROM contacts
     WHERE remind_days > 0
       AND (last_contact_at='' OR
            CAST(julianday('now','localtime') - julianday(last_contact_at) AS INTEGER) >= remind_days)
     ORDER BY days_since DESC"
    []))

(defn contacts-add-activity [contact-id log-date content]
  (do
    (if (= (str-trim log-date) "")
      (db-exec CONTACTS-DB
        "INSERT INTO activities (contact_id,content) VALUES (?,?)"
        [(str-to-num contact-id) content])
      (db-exec CONTACTS-DB
        "INSERT INTO activities (contact_id,log_date,content) VALUES (?,?,?)"
        [(str-to-num contact-id) log-date content]))
    (contacts-update-last-contact contact-id)))

(defn contacts-delete-activity [id]
  (db-exec CONTACTS-DB "DELETE FROM activities WHERE id=?" [(str-to-num id)]))
; ── end: pages/contacts/_db.flx ──
(contacts-init)

(defn page_contacts_api__inner [req]
  (let [q       (server-req-query req "q")
        overdue (server-req-query req "overdue")]
    (cond
      (= overdue "1")
        (server-json {"overdue" (contacts-overdue)})
      (and q (not (= (str-trim q) "")))
        (server-json {"contacts" (contacts-search q)})
      true
        (server-json {"contacts" (contacts-all)}))))

(defn page_contacts_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      (= action "add")
        (let [name        (or (get body "name") "")
              phone       (or (get body "phone") "")
              email       (or (get body "email") "")
              company     (or (get body "company") "")
              memo        (or (get body "memo") "")
              group       (or (get body "group") "일반")
              job-title   (or (get body "job_title") "")
              tags        (or (get body "tags") "")
              met-at      (or (get body "met_at") "")
              remind-days (or (get body "remind_days") "0")
              linked-url  (or (get body "linked_url") "")]
          (if (= (str-trim name) "")
            (server-json {"ok" false "error" "이름 필요"} 400)
            (do
              (contacts-add name phone email company memo group job-title tags met-at remind-days linked-url)
              (server-json {"ok" true "contacts" (contacts-all)}))))

      (= action "delete")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (contacts-delete id)
              (server-json {"ok" true "contacts" (contacts-all)}))))

      (= action "save-remind")
        (let [id          (get body "id")
              remind-days (or (get body "remind_days") "0")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (contacts-save-remind id remind-days)
              (server-json {"ok" true}))))

      true
        (server-json {"ok" false "error" (str "unknown: " action)} 400))))
(defn page_contacts_api [req]
  (try (page_contacts_api__inner req)
    (catch $err (dev-error-page "/contacts/api" (str $err)))))
(defn page_contacts_api_post [req]
  (try (page_contacts_api_post__inner req)
    (catch $err (dev-error-page "/contacts/api [POST]" (str $err)))))

; ── pages/contacts/index.flx ──
; pages/contacts/index.flx — 연락처 메인

; (load already inlined)
(contacts-init)



(defn page_contacts_index__inner [req]
  (layout-html "👤 연락처"
    (str
      (h "div" {:style "background:linear-gradient(135deg,#0891b2,#06b6d4);color:white;padding:28px 24px;text-align:center"}
        (str
          (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "👤 연락처")
          (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"} "인맥·연락처 관리")))
