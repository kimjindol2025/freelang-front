      "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_badge=\"ui_badge__e18b\";\nvar ui_badge_green=\"ui_badge_green__c324\";\nvar ui_badge_red=\"ui_badge_red__d2e1\";\nvar ui_badge_yellow=\"ui_badge_yellow__e771\";\nvar ui_badge_blue=\"ui_badge_blue__59fd\";\nvar ui_badge_gray=\"ui_badge_gray__f560\";\nvar ui_avatar=\"ui_avatar__2815\";\nvar ui_divider=\"ui_divider__22a8\";\nvar ui_spinner=\"ui_spinner__719f\";\nvar ui_input_wrap=\"ui_input_wrap__d034\";\nvar ui_input_label=\"ui_input_label__ebfb\";\nvar ui_input_field=\"ui_input_field__ac1d\";\nvar ui_textarea_field=\"ui_textarea_field__1eab\";\nvar ui_checkbox_wrap=\"ui_checkbox_wrap__7110\";\nvar ui_checkbox_input=\"ui_checkbox_input__d495\";\nvar ui_form_group=\"ui_form_group__83c7\";\nvar ui_card=\"ui_card__5be5\";\nvar ui_alert=\"ui_alert__3457\";\nvar ui_alert_success=\"ui_alert_success__99d7\";\nvar ui_alert_error=\"ui_alert_error__f8d5\";\nvar ui_alert_warning=\"ui_alert_warning__627e\";\nvar ui_alert_info=\"ui_alert_info__18ba\";\nvar ui_empty=\"ui_empty__272c\";\nvar ui_progress_wrap=\"ui_progress_wrap__d67f\";\nvar ui_progress_bar=\"ui_progress_bar__675c\";\nvar ui_table_wrap=\"ui_table_wrap__8d07\";\nvar ui_stat_card=\"ui_stat_card__b4e2\";\nvar ui_tag=\"ui_tag__b0e1\";\nvar about_card=\"about_card__70b3\";\nvar about_title=\"about_title__1247\";\nvar stats_container=\"stats_container__aea6\";\nvar stats_grid=\"stats_grid__63be\";\nvar stat_card=\"stat_card__cae2\";\nvar stat_value=\"stat_value__3433\";\nvar stat_label=\"stat_label__5402\";\nvar error_list=\"error_list__f9d4\";\nvar error_item=\"error_item__cd51\";\nvar error_type_error=\"error_type_error__7600\";\nvar error_type_warn=\"error_type_warn__e060\";\nvar error_type_promise=\"error_type_promise__8dc9\";\nvar error_type_console=\"error_type_console__ea09\";\nvar form_box=\"form_box__8f33\";\nvar page_wrap=\"page_wrap__2009\";\nvar counter_page=\"counter_page__35ea\";\nvar counter_box=\"counter_box__4a74\";\nvar counter_btn=\"counter_btn__d6e9\";\nvar counter_num=\"counter_num__57f7\";\nvar counter_label=\"counter_label__85f8\";\nvar store_badge=\"store_badge__d4b2\";\nvar wrap=\"wrap__2b79\";\nvar log_wrap=\"log_wrap__40c9\";\nvar log_title=\"log_title__3e2d\";\nvar log_sub=\"log_sub__8779\";\nvar log_panel=\"log_panel__c640\";\nvar log_head=\"log_head__5dd2\";\nvar log_htext=\"log_htext__ce97\";\nvar log_body=\"log_body__6fa1\";\nvar log_line=\"log_line__57cc\";\nvar log_time=\"log_time__8f18\";\nvar log_info=\"log_info__6216\";\nvar log_warn=\"log_warn__3ebc\";\nvar log_error=\"log_error__13cf\";\nvar log_debug=\"log_debug__4526\";\nvar log_msg_i=\"log_msg_i__c43e\";\nvar log_msg_w=\"log_msg_w__6184\";\nvar log_msg_e=\"log_msg_e__a621\";\nvar log_msg_d=\"log_msg_d__bb1f\";\nvar log_toolbar=\"log_toolbar__cfb7\";\nvar log_fbtn=\"log_fbtn__2b3e\";\nvar log_fbtn_on=\"log_fbtn_on__266d\";\nvar log_count=\"log_count__133b\";\nvar log_dot_on=\"log_dot_on__e946\";\nvar log_dot_off=\"log_dot_off__90b5\";\nvar ni_wrap=\"ni_wrap__c854\";\nvar ni_title=\"ni_title__168f\";\nvar ni_sub=\"ni_sub__6008\";\nvar ni_form=\"ni_form__715a\";\nvar ni_input=\"ni_input__5a32\";\nvar ni_row=\"ni_row__9221\";\nvar ni_search=\"ni_search__2edf\";\nvar ni_btn_add=\"ni_btn_add__55c5\";\nvar ni_btn_del=\"ni_btn_del__8e40\";\nvar ni_btn_pin=\"ni_btn_pin__e850\";\nvar ni_grid=\"ni_grid__9bab\";\nvar ni_card=\"ni_card__47a8\";\nvar ni_card_pin=\"ni_card_pin__b627\";\nvar ni_content=\"ni_content__8d8d\";\nvar ni_meta=\"ni_meta__fe68\";\nvar ni_count=\"ni_count__b025\";\nvar ni_empty=\"ni_empty__a805\";\nvar note_card=\"note_card__3ba9\";\nvar note_input_box=\"note_input_box__f003\";\nvar note_grid=\"note_grid__2843\";\nvar note_action_bar=\"note_action_bar__6ee6\";\nvar search_bar=\"search_bar__4c2a\";\nvar add_btn=\"add_btn__3419\";\nvar pin_badge=\"pin_badge__e0cf\";\nvar note_header=\"note_header__46bd\";\nvar note_count=\"note_count__5d52\";\nvar note_title=\"note_title__1670\";\nvar note_content_area=\"note_content_area__4e00\";\nvar note_view=\"note_view__c3b7\";\nvar note_meta=\"note_meta__7671\";\nvar form_toolbar=\"form_toolbar__a6d8\";\nvar color_row=\"color_row__b5e4\";\nvar note_empty=\"note_empty__b08c\";\nvar note_actions=\"note_actions__dfb1\";\nvar icon_btn=\"icon_btn__4d25\";\nvar del_btn=\"del_btn__8fac\";\nvar search_wrap=\"search_wrap__37a0\";\nvar search_icon=\"search_icon__f263\";\nvar pin_form=\"pin_form__b618\";\nvar textarea_input=\"textarea_input__4bb6\";\nvar pg_wrap=\"pg_wrap__92cf\";\nvar pg_title=\"pg_title__9a36\";\nvar pg_subtitle=\"pg_subtitle__2581\";\nvar pg_grid=\"pg_grid__35a8\";\nvar pg_panel=\"pg_panel__aaad\";\nvar pg_panel_head=\"pg_panel_head__2bce\";\nvar pg_editor=\"pg_editor__f737\";\nvar pg_result=\"pg_result__d0e8\";\nvar pg_result_error=\"pg_result_error__7eff\";\nvar pg_btn=\"pg_btn__538e\";\nvar pg_examples=\"pg_examples__8d1f\";\nvar pg_ex_btn=\"pg_ex_btn__ea5c\";\nvar pg_status=\"pg_status__b570\";\nvar card=\"card__86e7\";\nvar hero=\"hero__43b0\";\nvar badge=\"badge__a154\";\nvar resp_grid=\"resp_grid__7f07\";\nvar resp_card=\"resp_card__789b\";\nvar resp_hero=\"resp_hero__3912\";\n\n_fl.mount(\"island-lightbox-0\", (() => { const sel = _fl.atom(null);\n  return (update) => { const imgs = [{\"id\": 1, \"emoji\": \"🏔\", \"name\": \"산\"}, {\"id\": 2, \"emoji\": \"🌊\", \"name\": \"바다\"}, {\"id\": 3, \"emoji\": \"🌲\", \"name\": \"숲\"}, {\"id\": 4, \"emoji\": \"🏜\", \"name\": \"사막\"}, {\"id\": 5, \"emoji\": \"🌌\", \"name\": \"은하\"}, {\"id\": 6, \"emoji\": \"🌋\", \"name\": \"화산\"}]; return _fl.h(\"div\", {}, _fl_str(_fl.h(\"div\", {\"style\": \"display:grid;grid-template-columns:repeat(3,1fr);gap:10px\"}, _fl.map_arr((im) => { return _fl.h(\"div\", {\"style\": \"aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:2.4rem;background:white;border-radius:10px;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.08)\", \"on-click\": () => { return (_fl.reset(sel, im), update()); }}, _fl.get(im, \"emoji\")); }, imgs)), ((_fl.deref(sel) === null)) ? (\"\") : (_fl.h(\"div\", {\"style\": \"position:fixed;inset:0;background:rgba(0,0,0,.8);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:100;cursor:pointer\", \"on-click\": () => { return (_fl.reset(sel, null), update()); }}, _fl_str(_fl.h(\"div\", {\"style\": \"font-size:8rem\"}, _fl.get(_fl.deref(sel), \"emoji\")), _fl.h(\"div\", {\"style\": \"color:white;font-size:1.2rem;margin-top:12px\"}, _fl.get(_fl.deref(sel), \"name\")), _fl.h(\"div\", {\"style\": \"color:#9ca3af;font-size:.85rem;margin-top:8px\"}, \"아무 곳이나 클릭하면 닫힙니다\")))))); };\n})());\n//# sourceURL=island-lightbox.flx\n</script>")
    req))
(defn page_examples_30_lightbox [req]
  (try (page_examples_30_lightbox__inner req)
    (catch $err (dev-error-page "/examples/30-lightbox" (str $err)))))

; ── pages/examples/index.flx ──
; pages/examples/index.flx
; 예제 갤러리 인덱스 — GET /examples
; 30개 FreeLang 프론트엔드 예제 카드 목록

(defn ex-card [num title desc slug tag]
  (h "a" {:href (str "/examples/" slug) :data-spa "1"
          :style "display:block;background:white;border-radius:12px;padding:18px 20px;box-shadow:0 1px 4px rgba(0,0,0,.08);text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s"}
    (str
      (h "div" {:style "display:flex;align-items:center;gap:8px;margin-bottom:6px"}
        (str
          (h "span" {:style "font-size:.78rem;font-weight:800;color:#6366f1"} num)
          (h "span" {:style "font-size:.68rem;font-weight:700;color:#9ca3af;background:#f3f4f6;border-radius:99px;padding:2px 8px"} tag)))
      (h "div" {:style "font-size:1.05rem;font-weight:700;margin-bottom:4px"} title)
      (h "p" {:style "font-size:.84rem;color:#6b7280;line-height:1.5;margin:0"} desc))))

(defn page_examples_index__inner [req]
  (let [items [["01" "Hello" "render 하나로 그리는 가장 단순한 페이지" "01-hello" "기본"]
               ["02" "카드 그리드" "데이터 배열을 map 으로 반복 렌더링" "02-card-grid" "기본"]
               ["03" "검색 필터" "쿼리스트링으로 서버 사이드 필터링" "03-list-filter" "서버"]
               ["04" "폼 + POST" "입력을 받아 결과 페이지 렌더" "04-form" "서버"]
               ["05" "폼 검증" "필수 필드 검증 후 분기" "05-form-validate" "서버"]
               ["06" "카운터" "Island + atom 으로 클라이언트 상태" "06-counter" "Island"]
               ["07" "토글" "불리언 atom 으로 보이기/숨기기" "07-toggle" "Island"]
               ["08" "탭" "선택 id 를 atom 으로 관리" "08-tabs" "Island"]
               ["09" "아코디언" "열린 항목 추적, 재클릭 시 닫기" "09-accordion" "Island"]
               ["10" "To-Do" "atom 배열로 추가·완료·삭제" "10-todo" "Island"]
               ["11" "라이브 검색" "입력 즉시 클라이언트 필터링" "11-live-search" "Island"]
               ["12" "별점" "클릭으로 평점 선택" "12-star-rating" "Island"]
               ["13" "글자수 카운터" "입력 길이 실시간 표시 + 한도 경고" "13-char-count" "Island"]
               ["14" "토스트" "atom 배열 알림 추가/제거" "14-toast" "Island"]
               ["15" "모달" "오버레이 다이얼로그" "15-modal" "Island"]
               ["16" "드롭다운" "열림+선택 두 atom 협력" "16-dropdown" "Island"]
               ["17" "위저드" "단계 이동 + 진행 표시" "17-wizard" "Island"]
               ["18" "슬라이더" "range 값 실시간 미리보기" "18-slider" "Island"]
               ["19" "색상 선택기" "type=color 값 미리보기" "19-color-picker" "Island"]
               ["20" "비밀번호 강도" "길이·구성 규칙 점수화" "20-password-strength" "Island"]
               ["21" "장바구니" "수량 증감 + reduce 총액" "21-cart" "Island"]
               ["22" "온도 변환기" "atom 에서 산술 파생값 계산" "22-temp-convert" "Island"]
               ["23" "좋아요 (store)" "Island 간 글로벌 store 공유" "23-like-store" "Island"]
               ["24" "페이지네이션" "쿼리로 목록 페이지 분할" "24-pagination" "서버"]
               ["25" "다국어 인사" "?lang= 로 서버 사이드 전환" "25-i18n" "서버"]
               ["26" "JSON API" "render 가 JSON 을 반환" "26-json-api" "서버"]
               ["27" "데이터 로딩" "fetch! 로 JSON API 호출" "27-fetch" "Island"]
               ["28" "실시간 투표" "득표 막대 그래프" "28-poll" "Island"]
               ["29" "BMI 계산기" "산술 + 비교로 분류" "29-bmi" "Island"]
               ["30" "라이트박스" "썸네일 클릭 확대 오버레이" "30-lightbox" "Island"]]]
    (layout-html "FreeLang 예제 갤러리"
      (h "div" {:style "max-width:960px;margin:0 auto;padding:48px 24px"}
        (str
          (h "h1" {:style "font-size:2rem;font-weight:800;margin:0 0 8px"} "예제 갤러리")
          (h "p" {:style "color:#6b7280;margin:0 0 32px;font-size:1.05rem"}
            (str (length items) "개의 FreeLang 프론트엔드 예제 — 기본 / 서버 / Island 패턴"))
          (h "div" {:style "display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px"}
            (arr-join
              (map
                (fn [it]
                  (ex-card (nth it 0) (nth it 1) (nth it 2) (nth it 3) (nth it 4)))
                items)
              ""))))
      req)))
(defn page_examples_index [req]
  (try (page_examples_index__inner req)
    (catch $err (dev-error-page "/examples" (str $err)))))

; ── pages/feed/api.flx ──
; pages/feed/api.flx — RSS 피드 API
; GET  /feed/api → {feeds, recent}
; POST /feed/api → action: add|delete|refresh|mark-read|mark-all-read
;
; RSS 파싱: http_get(url) → XML → str-split("<item>") → 필드 추출

; ── inlined: pages/feed/_db.flx ──
; ── ns: feed ──
; pages/feed/_db.flx — RSS 피드 DB

(define FEED-DB {:type "sqlite" :path "data/feed.db"})

(defn feed-init []
  (do
    (db-exec FEED-DB
      "CREATE TABLE IF NOT EXISTS feeds (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        url TEXT NOT NULL UNIQUE,
        title TEXT DEFAULT '',
        description TEXT DEFAULT '',
        last_fetched TEXT DEFAULT '',
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])
    (db-exec FEED-DB
      "CREATE TABLE IF NOT EXISTS feed_items (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        feed_id INTEGER NOT NULL,
        title TEXT DEFAULT '',
        url TEXT DEFAULT '',
        summary TEXT DEFAULT '',
        published_at TEXT DEFAULT '',
        is_read INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now','localtime')),
        UNIQUE(feed_id, url)
      )" [])))

(defn feed-all-feeds []
  (db-query FEED-DB
    "SELECT f.*, COUNT(CASE WHEN i.is_read=0 THEN 1 END) as unread_count
     FROM feeds f LEFT JOIN feed_items i ON i.feed_id=f.id GROUP BY f.id ORDER BY f.title ASC" []))

(defn feed-by-id [id]
  (db-one FEED-DB "SELECT * FROM feeds WHERE id=?" [(str-to-num id)]))

(defn feed-items-by-feed [feed-id limit]
  (db-query FEED-DB
    "SELECT * FROM feed_items WHERE feed_id=? ORDER BY published_at DESC, id DESC LIMIT ?"
    [(str-to-num feed-id) (str-to-num limit)]))

(defn feed-recent-items [limit]
  (db-query FEED-DB
    "SELECT i.*, f.title as feed_title FROM feed_items i JOIN feeds f ON f.id=i.feed_id ORDER BY i.published_at DESC, i.id DESC LIMIT ?"
    [(str-to-num limit)]))

(defn feed-add-feed [url]
  (db-exec FEED-DB "INSERT OR IGNORE INTO feeds (url) VALUES (?)" [url]))

(defn feed-update-feed-meta [id title description]
  (let [now (str-trim (shell "date '+%Y-%m-%d %H:%M:%S'"))]
    (db-exec FEED-DB
      "UPDATE feeds SET title=?,description=?,last_fetched=? WHERE id=?"
      [title description now (str-to-num id)])))

(defn feed-insert-item [feed-id title url summary published-at]
  (db-exec FEED-DB
    "INSERT OR IGNORE INTO feed_items (feed_id,title,url,summary,published_at) VALUES (?,?,?,?,?)"
    [(str-to-num feed-id) title url summary published-at]))

(defn feed-mark-read [id]
  (db-exec FEED-DB "UPDATE feed_items SET is_read=1 WHERE id=?" [(str-to-num id)]))

(defn feed-mark-all-read [feed-id]
  (db-exec FEED-DB "UPDATE feed_items SET is_read=1 WHERE feed_id=?" [(str-to-num feed-id)]))

(defn feed-delete-feed [id]
  (do
    (db-exec FEED-DB "DELETE FROM feed_items WHERE feed_id=?" [(str-to-num id)])
    (db-exec FEED-DB "DELETE FROM feeds WHERE id=?" [(str-to-num id)])))
; ── end: pages/feed/_db.flx ──
(feed-init)

; XML 태그 내용 추출 (str-split 기반)
(defn xml-tag [xml tag]
  (let [otag   (str "<" tag ">")
        ctag   (str "</" tag ">")
        parts  (str-split xml otag)]
    (if (< (length parts) 2)
      (let [cotag  (str "<" tag "><![CDATA[")
            cparts (str-split xml cotag)]
        (if (< (length cparts) 2)
          ""
          (let [after  (first (rest cparts))
                eparts (str-split after "]]>")]
            (str-trim (first eparts)))))
      (let [after  (first (rest parts))
            eparts (str-split after ctag)]
        (str-trim (first eparts))))))

; RSS <item> 블록들 파싱
(defn parse-rss-items [body]
  (let [chunks (str-split body "<item>")]
    (if (< (length chunks) 2)
      []
      (filter
        (fn [item] (not (= (get item "title") "")))
        (map
          (fn [chunk]
            ; </item> 앞까지만 사용
            (let [end-parts (str-split chunk "</item>")
                  item-xml  (first end-parts)]
              {"title"  (str-slice (xml-tag item-xml "title") 0 150)
               "link"   (xml-tag item-xml "link")
               "desc"   (str-slice (xml-tag item-xml "description") 0 200)
               "pub"    (str-slice (xml-tag item-xml "pubDate") 0 30)}))
          (rest chunks))))))

; 피드 새로고침: http_get → XML 파싱 → DB 저장
(defn do-refresh [feed-id url]
  (let [resp (http_get url)]
    (if (= (get resp "status") 200)
      (let [body  (get resp "body")
            title (xml-tag body "title")
            desc  (xml-tag body "description")
            items (parse-rss-items body)]
        (feed-update-feed-meta feed-id
          (if (= title "") url title)
          (str-slice desc 0 200))
        (map
          (fn [item]
            (feed-insert-item feed-id
              (get item "title")
              (get item "link")
              (get item "desc")
              (get item "pub")))
          items)
        (length items))
      0)))

(defn page_feed_api__inner [req]
  (server-json {
    "feeds"  (feed-all-feeds)
    "recent" (feed-recent-items "30")
  }))

(defn page_feed_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      (= action "add")
        (let [url (str-trim (or (get body "url") ""))]
          (if (= url "")
            (server-json {"ok" false "error" "URL 필요"} 400)
            (do
              (feed-add-feed url)
              ; 추가 후 즉시 새로고침 시도
              (let [feeds    (feed-all-feeds)
                    new-feed (first (filter (fn [f] (= (get f "url") url)) feeds))]
                (when new-feed
                  (do-refresh (str (get new-feed "id")) url))
                (server-json {
                  "ok"     true
                  "feeds"  (feed-all-feeds)
                  "recent" (feed-recent-items "30")
                })))))

      (= action "delete")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (feed-delete-feed id)
              (server-json {
                "ok"     true
                "feeds"  (feed-all-feeds)
                "recent" (feed-recent-items "30")
              }))))

      (= action "refresh")
        (let [id (get body "id")
              f  (feed-feed-by-id id)]
          (if (= f nil)
            (server-json {"ok" false "error" "피드 없음"} 400)
            (let [n (do-refresh id (get f "url"))]
              (server-json {
                "ok"     true
                "count"  n
                "feeds"  (feed-all-feeds)
                "recent" (feed-recent-items "30")
              }))))

      (= action "mark-read")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (feed-mark-read id)
              (server-json {"ok" true}))))

      (= action "mark-all-read")
        (let [feed-id (get body "feed_id")]
          (if (= feed-id nil)
            (server-json {"ok" false "error" "feed_id 필요"} 400)
            (do
              (feed-mark-all-read feed-id)
              (server-json {"ok" true "feeds" (feed-all-feeds)}))))

      true
        (server-json {"ok" false "error" (str "unknown: " action)} 400))))
(defn page_feed_api [req]
  (try (page_feed_api__inner req)
    (catch $err (dev-error-page "/feed/api" (str $err)))))
(defn page_feed_api_post [req]
  (try (page_feed_api_post__inner req)
    (catch $err (dev-error-page "/feed/api [POST]" (str $err)))))

; ── pages/feed/index.flx ──
; pages/feed/index.flx — RSS 피드 리더

; (load already inlined)
(feed-init)



(defn page_feed_index__inner [req]
  (let [feeds  (feed-all-feeds)
        recent (feed-recent-items "20")
        unread (length (filter (fn [i] (= (get i "is_read") 0)) recent))]
    (layout-html "📡 Feed"
      (str
        (h "div" {:style "background:linear-gradient(135deg,#0d9488,#0891b2);color:white;padding:28px 24px;text-align:center"}
          (str
            (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "📡 RSS 피드")
            (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"}
              (str (length feeds) " 피드 · 읽지 않음 " unread " 개"))))
        "<div id='island-feedapp-0'></div>"
        "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_bad