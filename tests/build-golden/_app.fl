a=\"note_meta__7671\";\nvar form_toolbar=\"form_toolbar__a6d8\";\nvar color_row=\"color_row__b5e4\";\nvar note_empty=\"note_empty__b08c\";\nvar note_actions=\"note_actions__dfb1\";\nvar icon_btn=\"icon_btn__4d25\";\nvar del_btn=\"del_btn__8fac\";\nvar search_wrap=\"search_wrap__37a0\";\nvar search_icon=\"search_icon__f263\";\nvar pin_form=\"pin_form__b618\";\nvar textarea_input=\"textarea_input__4bb6\";\nvar pg_wrap=\"pg_wrap__92cf\";\nvar pg_title=\"pg_title__9a36\";\nvar pg_subtitle=\"pg_subtitle__2581\";\nvar pg_grid=\"pg_grid__35a8\";\nvar pg_panel=\"pg_panel__aaad\";\nvar pg_panel_head=\"pg_panel_head__2bce\";\nvar pg_editor=\"pg_editor__f737\";\nvar pg_result=\"pg_result__d0e8\";\nvar pg_result_error=\"pg_result_error__7eff\";\nvar pg_btn=\"pg_btn__538e\";\nvar pg_examples=\"pg_examples__8d1f\";\nvar pg_ex_btn=\"pg_ex_btn__ea5c\";\nvar pg_status=\"pg_status__b570\";\nvar card=\"card__86e7\";\nvar hero=\"hero__43b0\";\nvar badge=\"badge__a154\";\nvar resp_grid=\"resp_grid__7f07\";\nvar resp_card=\"resp_card__789b\";\nvar resp_hero=\"resp_hero__3912\";\n\n_fl.mount(\"island-addtocart-0\", (() => { const pid = _fl.atom(((window.PRODUCT_ID) || (0))); const stock = _fl.atom(((window.PRODUCT_STOCK) || (0))); const uid = _fl.atom(1); const qty = _fl.atom(1); const msg = _fl.atom(\"\"); const busy = _fl.atom(false);\n  return (update) => { return _fl.h(\"div\", {\"style\": \"margin-top:24px\"}, _fl.h(\"div\", {\"style\": \"display:flex;align-items:center;gap:10px;margin-bottom:16px\"}, _fl.h(\"label\", {\"style\": \"font-size:.875rem;color:#6b7280;white-space:nowrap\"}, \"회원 ID\"), _fl.h(\"input\", {\"type\": \"number\", \"value\": _fl_str(_fl.deref(uid)), \"min\": \"1\", \"style\": \"width:80px;padding:8px 12px;border:1px solid #e5e7eb;border-radius:8px;font-size:.9rem\", \"on-change\": (e) => { return (() => { const v = str_to_num((((e)?.[\"target\"])?.[\"value\"] ?? null)); return (!(v => v == null(v))) ? ((_fl.reset(uid, v), update())) : null; })(); }})), _fl.h(\"div\", {\"style\": \"display:flex;align-items:center;gap:10px;margin-bottom:20px\"}, _fl.h(\"label\", {\"style\": \"font-size:.875rem;color:#6b7280;white-space:nowrap\"}, \"수량\"), _fl.h(\"button\", {\"style\": \"width:32px;height:32px;border:1px solid #e5e7eb;border-radius:6px;background:#fff;font-size:1.2rem;cursor:pointer\", \"on-click\": () => { return ((_fl.deref(qty) > 1)) ? ((_fl.swap(qty, (q) => { return (q - 1); }), update())) : null; }}, \"−\"), _fl.h(\"span\", {\"style\": \"font-size:1.1rem;font-weight:700;min-width:32px;text-align:center\"}, _fl_str(_fl.deref(qty))), _fl.h(\"button\", {\"style\": \"width:32px;height:32px;border:1px solid #e5e7eb;border-radius:6px;background:#fff;font-size:1.2rem;cursor:pointer\", \"on-click\": () => { return (_fl.swap(qty, (q) => { return (q + 1); }), update()); }}, \"+\")), _fl.h(\"button\", {\"style\": _fl_str(\"width:100%;padding:14px;border:none;border-radius:10px;font-size:1rem;font-weight:700;cursor:pointer;\", ((_fl.deref(stock) > 0)) ? (\"background:#6366f1;color:#fff\") : (\"background:#e5e7eb;color:#9ca3af;cursor:not-allowed\")), \"on-click\": () => { return ((((_fl.deref(stock) > 0)) && (!(_fl.deref(busy))))) ? ((_fl.reset(busy, true), update())) : null; }}, ((_fl.deref(stock) > 0)) ? ((_fl.deref(busy)) ? (\"처리 중...\") : (\"🛒 장바구니 담기\")) : (\"품절\")), (!(((v => v == null(_fl.deref(msg))) || ((_fl.deref(msg) === \"\"))))) ? (_fl.h(\"div\", {\"style\": \"margin-top:12px;padding:12px 16px;border-radius:8px;font-size:.9rem;font-weight:600;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0\"}, _fl.deref(msg))) : null); };\n})());\n//# sourceURL=island-addtocart.flx\n</script>"
