; ── pages/styled.flx ──
; 기본 스타일
; 반응형 그리드 — 기본 3열, md(768px)에서 2열, sm(640px)에서 1열
; 반응형 카드 — 기본 24px 패딩, sm에서 14px
; 반응형 히어로 — 기본 48px 패딩, sm에서 24px
(defn page_styled__inner [req]
  (layout-html "Styled" (str
      "<h2 style='margin:0 0 8px'>CSS DSL 데모</h2>"
      "<p style='color:#6b7280;margin:0 0 24px'>scoped hash + 반응형 breakpoint — 화면 크기를 줄여보세요</p>"

      ; 반응형 히어로
      "<div class='" resp_hero "'>"
      "<h3 style='margin:0 0 8px'>반응형 히어로</h3>"
      "<p style='margin:0;opacity:.85'>sm(640px): 패딩 24px · md(768px) 이상: 48px</p>"
      "</div>"

      ; 반응형 그리드
      "<h3 style='margin:24px 0 12px;color:#374151'>반응형 그리드 (3 → 2 → 1열)</h3>"
      "<div class='" resp_grid "'>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>📊</div>"
      "<strong>SSR 렌더링</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>서버에서 완전한 HTML 생성</p>"
      "</div>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🎨</div>"
      "<strong>CSS DSL</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>:sm-p :md-cols breakpoint</p>"
      "</div>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🏝️</div>"
      "<strong>Island 아키텍처</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>필요한 부분만 JS</p>"
      "</div>"
      "</div>"

      ; 배지 예제
      "<h3 style='margin:24px 0 12px;color:#374151'>CSS DSL 배지</h3>"
      "<div style='display:flex;gap:8px;flex-wrap:wrap'>"
      "<span class='" badge "'>npm 0개</span>"
      "<span class='" badge "'>SSR</span>"
      "<span class='" badge "'>Island</span>"
      "<span class='" badge "'>반응형</span>"
      "<span class='" badge "'>Critical CSS</span>"
      "<span class='" badge "'>서버 폼</span>"
      "</div>") req))
(defn page_styled [req]
  (try (page_styled__inner req)
    (catch $err (dev-error-page "/styled" (str $err)))))

; ── pages/subs/api.flx ──
; pages/subs/api.flx — 구독 JSON API
; GET  /subs/api → {subs, monthly_total}
; POST /subs/api → action: add|delete|toggle

; ── inlined: pages/subs/_db.flx ──
; ── ns: subs ──
; pages/subs/_db.flx — 구독 관리 DB

(define SUBS-DB {:type "sqlite" :path "data/subs.db"})

(defn subs-init []
  (db-exec SUBS-DB
    "CREATE TABLE IF NOT EXISTS subs (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      amount REAL NOT NULL DEFAULT 0,
      cycle TEXT NOT NULL DEFAULT 'monthly',
      next_billing TEXT DEFAULT '',
      category TEXT DEFAULT '기타',
      color TEXT DEFAULT '#6366f1',
      active INTEGER DEFAULT 1,
      note TEXT DEFAULT '',
      created_at TEXT DEFAULT (datetime('now','localtime'))
    )" []))

(defn subs-all []
  (db-query SUBS-DB "SELECT * FROM subs ORDER BY active DESC, name ASC" []))

(defn subs-add [name amount cycle category color next-billing note]
  (db-exec SUBS-DB
    "INSERT INTO subs (name,amount,cycle,category,color,next_billing,note) VALUES (?,?,?,?,?,?,?)"
    [name (str-to-num amount) cycle category color next-billing note]))

(defn subs-delete [id]
  (db-exec SUBS-DB "DELETE FROM subs WHERE id=?" [(str-to-num id)]))

(defn subs-toggle [id]
  (db-exec SUBS-DB
    "UPDATE subs SET active=CASE WHEN active=1 THEN 0 ELSE 1 END WHERE id=?"
    [(str-to-num id)]))
; ── end: pages/subs/_db.flx ──
(subs-init)

(defn calc-monthly [subs]
  (reduce
    (fn [acc s]
      (if (= (get s "active") 1)
        (let [a (get s "amount")
              c (get s "cycle")]
          (+ acc (cond
            (= c "yearly") (/ a 12)
            (= c "weekly") (* a 4.33)
            true a)))
        acc))
    0
    subs))

(defn page_subs_api__inner [req]
  (let [subs (subs-all)]
    (server-json {"subs" subs "monthly_total" (floor (calc-monthly subs))})))

(defn page_subs_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      (= action "add")
        (let [name     (or (get body "name") "")
              amount   (or (get body "amount") "0")
              cycle    (or (get body "cycle") "monthly")
              category (or (get body "category") "기타")
              color    (or (get body "color") "#6366f1")
              billing  (or (get body "next_billing") "")
              note     (or (get body "note") "")]
          (if (= (str-trim name) "")
            (server-json {"ok" false "error" "서비스명 필요"} 400)
            (do
              (subs-add name amount cycle category color billing note)
              (let [subs (subs-all)]
                (server-json {"ok" true "subs" subs "monthly_total" (floor (calc-monthly subs))})))))

      (= action "delete")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (subs-delete id)
              (let [subs (subs-all)]
                (server-json {"ok" true "subs" subs "monthly_total" (floor (calc-monthly subs))})))))

      (= action "toggle")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (subs-toggle id)
              (let [subs (subs-all)]
                (server-json {"ok" true "subs" subs "monthly_total" (floor (calc-monthly subs))})))))

      true
        (server-json {"ok" false "error" (str "unknown action: " action)} 400))))
(defn page_subs_api [req]
  (try (page_subs_api__inner req)
    (catch $err (dev-error-page "/subs/api" (str $err)))))
(defn page_subs_api_post [req]
  (try (page_subs_api_post__inner req)
    (catch $err (dev-error-page "/subs/api [POST]" (str $err)))))

; ── pages/subs/index.flx ──
; pages/subs/index.flx — 구독 관리 메인

; (load already inlined)
(subs-init)



(defn page_subs_index__inner [req]
  (layout-html "💳 구독 관리"
    (str
      (h "div" {:style "background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;padding:28px 24px;text-align:center"}
        (str
          (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "💳 구독 관리")
          (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"} "정기결제 한눈에 관리")))
      "<div id='island-subsapp-0'></div>"
      "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fe