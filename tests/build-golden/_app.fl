(defn page_shop_cart [req]
  (try (page_shop_cart__inner req)
    (catch $err (dev-error-page "/shop/cart" (str $err)))))

; ── pages/shop/index.flx ──
; pages/shop/index.flx — 쇼핑몰 메인 (상품 목록)
; GET /shop

; (load already inlined)

(defn fetch-products [category kw]
  (let [base (str (shop-api-base) "/api/products?size=30")
        url  (cond
               (not (or (nil? kw) (= kw "")))            (str base "&q=" kw)
               (not (or (nil? category) (= category ""))) (str base "&category=" category)
               true                                       base)
        res    (http-get url)
        parsed (json_parse (get res "body"))]
    (if (get parsed "ok")
      (?? (get (get parsed "data") "data") (get parsed "data"))
      [])))

(defn category-badge [cat active]
  (let [on  "background:#6366f1;color:#fff;border:1px solid #6366f1"
        off "background:#fff;color:#374151;border:1px solid #e5e7eb"]
    (h "a"
      {"href"  (str "/shop?category=" cat)
       "style" (str "display:inline-block;padding:6px 14px;border-radius:20px;font-size:.82rem;font-weight:600;text-decoration:none;margin:0 4px 8px 0;cursor:pointer;" (if active on off))}
      cat)))


(defn product-card [p]
  (let [price (str (get p "price"))
        pid   (str (get p "id"))]
    (h "a"
      {"href"  (str "/shop/products/" pid)
       "style" "background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08);transition:transform .15s,box-shadow .15s;display:flex;flex-direction:column;text-decoration:none;color:inherit;cursor:pointer"}
      (h "div"
        {"style" "background:linear-gradient(135deg,#f3f4f6,#e5e7eb);height:160px;display:flex;align-items:center;justify-content:center;font-size:3rem"}
        (shop-product-emoji (get p "category")))
      (h "div" {"style" "padding:14px 16px;flex:1;display:flex;flex-direction:column;gap:6px"}
        (h "span"
          {"style" "font-size:.72rem;font-weight:700;color:#6366f1;text-transform:uppercase;letter-spacing:.05em"}
          (get p "category"))
        (h "p"
          {"style" "font-size:.92rem;font-weight:600;color:#111827;line-height:1.4;flex:1"}
          (get p "name"))
        (h "p"
          {"style" "font-size:.8rem;color:#9ca3af;line-height:1.4"}
          (?? (get p "description") ""))
        (h "div"
          {"style" "display:flex;align-items:center;justify-content:space-between;margin-top:8px"}
          (h "span"
            {"style" "font-size:1.05rem;font-weight:700;color:#111827"}
            (str "₩" price))
          (h "span"
            {"style" (str "font-size:.75rem;font-weight:600;padding:3px 8px;border-radius:99px;"
                          (if (> (get p "stock") 0)
                            "background:#dcfce7;color:#166534"
                            "background:#fee2e2;color:#991b1b"))}
            (if (> (get p "stock") 0)
              (str "재고 " (get p "stock") "개")
              "품절")))))))

(defn page_shop_index__inner [req]
  (let [q        (get req "query")
        category (?? (get q "category") "")
        kw       (?? (get q "q") "")
        products (fetch-products category kw)
        cats     ["전자제품" "의류" "식품" "생활용품" "스포츠" "뷰티"]]
    (layout-html "🛍 쇼핑몰"
      (str
        """
<style>
body{background:#f9fafb}
.shop-wrap{max-width:1100px;margin:0 auto;padding:32px 20px}
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}
.header h1{font-size:1.6rem;font-weight:800;color:#111827}
.header nav a{margin-left:16px;font-size:.875rem;font-weight:600;color:#6b7280;text-decoration:none}
.header nav a:hover{color:#6366f1}
.search-box{display:flex;gap:8px;margin-bottom:20px}
.search-box input{flex:1;padding:10px 16px;border:1px solid #e5e7eb;border-radius:8px;font-size:.9rem;outline:none}
.search-box input:focus{border-color:#6366f1}
.search-box button{background:#6366f1;color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:600;cursor:pointer;font-size:.9rem}
.cats{margin-bottom:24px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
.empty{text-align:center;padding:60px;color:#9ca3af;font-size:1rem}
.count{font-size:.85rem;color:#6b7280;margin-bottom:16px}
</style>
"""
        (h "div" {"class" "shop-wrap"}
          (h "div" {"class" "header"}
            (h "h1" {} "🛍 FreeLang 쇼핑몰")
            (h "nav" {}
              (h "a" {"href" "/shop"} "전체상품")
              (h "a" {"href" "/shop/cart"} "🛒 장바구니")
              (h "a" {"href" "/shop/orders"} "📦 주문내역")))
          (h "form" {"method" "get" "action" "/shop" "class" "search-box"}
            (h "input"
              {"type" "text" "name" "q" "placeholder" "상품 검색..." "value" kw})
            (h "button" {"type" "submit"} "검색"))
          (h "div" {"class" "cats"}
            (category-badge "전체" (and (or (nil? category) (= category "")) (or (nil? kw) (= kw ""))))
            (str-join (map (fn [c] (category-badge c (= category c))) cats) ""))
          (h "p" {"class" "count"}
            (str (length products) "개 상품"
                 (if (not (or (nil? kw) (= kw ""))) (str " — \"" kw "\" 검색결과") "")
                 (if (not (or (nil? category) (= category ""))) (str " — " category) "")))
          (if (empty? products)
            (h "div" {"class" "empty"} "상품이 없습니다")
            (h "div" {"class" "grid"}
              (str-join (map product-card products) "")))))
      req)))
(defn page_shop_index [req]
  (try (page_shop_index__inner req)
    (catch $err (dev-error-page "/shop" (str $err)))))

; ── pages/shop/orders.flx ──
; pages/shop/orders.flx — 주문 내역
; GET /shop/orders

; (load already inlined)

(defn status-badge [s]
  (let [styles {"paid"    "background:#dcfce7;color:#166534"
                "pending" "background:#fef9c3;color:#854d0e"
                "cancel"  "background:#fee2e2;color:#991b1b"}
        labels {"paid" "결제완료" "pending" "대기중" "cancel" "취소"}]
    (h "span"
      {"style" (str "font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:99px;" (?? (get styles s) "background:#f3f4f6;color:#6b7280"))}
      (?? (get labels s) s))))



(defn page_shop_orders__inner [req]
  (layout-html "📦 주문내역"
    (str
      """
<style>/* skl-utils.css — FreeLang Front 유틸리티 CSS * 자동 주입: fl-front-build.js → <style> 태그 뒤에 삽입 * 사용: class="u-flex u-gap-3 u-p-4" (Island에서도 class 속성으로 사용 가능) * 동적 값(색상 등)은 여전히 {:style ...} 혼용 */ /* ─── 레이아웃 ─────────────────────────────── */ .u-flex { display: flex } .u-flex-col { display: flex; flex-direction: column } .u-flex-row { display: flex; flex-direction: row } .u-flex-wrap { flex-wrap: wrap } .u-items-start { align-items: flex-start } .u-items-center { align-items: center } .u-items-end { align-items: flex-end } .u-justify-start { justify-content: flex-start } .u-justify-center { justify-content: center } .u-justify-end { justify-content: flex-end } .u-justify-between{ justify-content: space-between } .u-justify-around { justify-content: space-around } .u-flex-1 { flex: 1 } .u-flex-shrink-0 { flex-shrink: 0 } .u-grid { display: grid } .u-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px } .u-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px } .u-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px } .u-grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px } .u-block { display: block } .u-inline { display: inline } .u-inline-flex{ display: inline-flex; align-items: center } .u-hidden { display: none !important } .u-relative { position: relative } .u-absolute { position: absolute } .u-fixed { position: fixed } .u-inset-0 { inset: 0 } .u-overflow-hidden { overflow: hidden } .u-overflow-auto { overflow: auto } .u-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .u-w-full { width: 100% } .u-h-full { height: 100% } .u-max-w-sm { max-width: 480px } .u-max-w-md { max-width: 640px } .u-max-w-lg { max-width: 800px } .u-max-w-xl { max-width: 1000px } .u-mx-auto { margin-left: auto; margin-right: auto } /* ─── 간격 (gap / padding / margin) ─────────── */ .u-gap-1 { gap: 4px } .u-gap-2 { gap: 8px } .u-gap-3 { gap: 12px } .u-gap-4 { gap: 16px } .u-gap-5 { gap: 20px } .u-gap-6 { gap: 24px } .u-p-0 { padding: 0 } .u-p-1 { padding: 4px } .u-p-2 { padding: 8px } .u-p-3 { padding: 12px } .u-p-4 { padding: 16px } .u-p-5 { padding: 20px } .u-p-6 { padding: 24px } .u-px-2 { padding-left: 8px; padding-right: 8px } .u-px-3 { padding-left: 12px; padding-right: 12px } .u-px-4 { padding-left: 16px; padding-right: 16px } .u-px-5 { padding-left: 20px; padding-right: 20px } .u-px-6 { padding-left: 24px; padding-right: 24px } .u-py-2 { padding-top: 8px; padding-bottom: 8px } .u-py-3 { padding-top: 12px; padding-bottom: 12px } .u-py-4 { padding-top: 16px; padding-bottom: 16px } .u-py-5 { padding-top: 20px; padding-bottom: 20px } .u-m-0 { margin: 0 } .u-mb-0 { margin-bottom: 0 } .u-mb-1 { margin-bottom: 4px } .u-mb-2 { margin-bottom: 8px } .u-mb-3 { margin-bottom: 12px } .u-mb-4 { margin-bottom: 16px } .u-mb-5 { margin-bottom: 20px } .u-mb-6 { margin-bottom: 24px } .u-mt-auto{ margin-top: auto } /* ─── 색상 (배경/텍스트) ────────────────────── */ .u-bg-white { background: #fff } .u-bg-surface { background: var(--c-surface, #fff) } .u-bg-muted { background: #f9fafb } .u-bg-primary { background: #6366f1; color: #fff } .u-bg-success { background: #10b981; color: #fff } .u-bg-warning { background: #f59e0b; color: #fff } .u-bg-danger { background: #ef4444; color: #fff } .u-bg-info { background: #0891b2; color: #fff } .u-bg-purple { background: #7c3aed; color: #fff } .u-bg-subtle-primary { background: #ede9fe; color: #6366f1 } .u-bg-subtle-success { background: #dcfce7; color: #16a34a } .u-bg-subtle-warning { background: #fef3c7; color: #d97706 } .u-bg-subtle-danger { background: #fef2f2; color: #ef4444 } .u-bg-subtle-info { background: #e0f2fe; color: #0284c7 } .u-text-primary { color: #6366f1 } .u-text-success { color: #10b981 } .u-text-warning { color: #f59e0b } .u-text-danger { color: #ef4444 } .u-text-info { color: #0891b2 } .u-text-muted { color: #9ca3af } .u-text-body { color: #374151 } .u-text-heading { color: #111827 } .u-text-white { color: #fff } /* ─── 타이포그래피 ───────────────────────────── */ .u-text-xs { font-size: .72rem } .u-text-sm { font-size: .82rem } .u-text-base { font-size: .95rem } .u-text-lg { font-size: 1.1rem } .u-text-xl { font-size: 1.3rem } .u-text-2xl { font-size: 1.6rem } .u-font-normal { font-weight: 400 } .u-font-medium { font-weight: 500 } .u-font-semibold { font-weight: 600 } .u-font-bold { font-weight: 700 } .u-font-black { font-weight: 900 } .u-text-center { text-align: center } .u-text-right { text-align: right } .u-text-left { text-align: left } .u-no-underline{ text-decoration: none } .u-leading-tight{ line-height: 1.3 } .u-leading-normal { line-height: 1.6 } .u-leading-loose { line-height: 1.9 } .u-font-mono { font-family: "SF Mono","Fira Code",monospace } /* ─── 테두리 / 그림자 / 반경 ────────────────── */ .u-border { border: 1px solid #e5e7eb } .u-border-t { border-top: 1px solid #e5e7eb } .u-border-b { border-bottom: 1px solid #e5e7eb } .u-border-none{ border: none } .u-rounded-sm { border-radius: 6px } .u-rounded { border-radius: 8px } .u-rounded-md { border-radius: 12px } .u-rounded-lg { border-radius: 16px } .u-rounded-xl { border-radius: 20px } .u-rounded-full { border-radius: 9999px } .u-shadow-sm { box-shadow: 0 1px 3px rgba(0,0,0,.07) } .u-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.08) } .u-shadow-md { box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-shadow-lg { box-shadow: 0 8px 32px rgba(0,0,0,.12) } /* ─── 컴포넌트 ──────────────────────────────── */ .u-card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.07); border: 1px solid #f3f4f6 } .u-card-hover { transition: translate .2s, box-shadow .2s } .u-card-hover:hover { translate: 0 -2px; box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 18px; border-radius: 8px; font-weight: 600; font-size: .88rem; border: none; cursor: pointer; transition: opacity .15s; text-decoration: none } .u-btn:hover { opacity: .85 } .u-btn-primary { background: #6366f1; color: #fff } .u-btn-success { background: #10b981; color: #fff } .u-btn-warning { background: #f59e0b; color: #fff } .u-btn-danger { background: #ef4444; color: #fff } .u-btn-info { background: #0891b2; color: #fff } .u-btn-ghost { background: transparent; border: 1px solid #e5e7eb; color: #374151 } .u-btn-sm { padding: 5px 12px; font-size: .78rem } .u-btn-lg { padding: 12px 24px; font-size: 1rem } .u-btn-full { width: 100% } .u-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 99px; font-size: .72rem; font-weight: 700 } .u-badge-primary { background: #ede9fe; color: #6366f1 } .u-badge-success { background: #dcfce7; color: #16a34a } .u-badge-warning { background: #fef3c7; color: #d97706 } .u-badge-danger { background: #fef2f2; color: #dc2626 } .u-badge-info { background: #e0f2fe; color: #0284c7 } .u-badge-neutral { background: #f3f4f6; color: #6b7280 } .u-input { width: 100%; padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; box-sizing: border-box } .u-input:focus { outline: none; border-color: #6366f1 } .u-input:hover { border-color: #9ca3af } .u-label { display: block; font-size: .78rem; font-weight: 600; color: #6b7280; margin-bottom: 4px } .u-form-group { display: flex; flex-direction: column; gap: 4px } .u-divider { height: 1px; background: #f3f4f6; border: none; margin: 12px 0 } .u-progress { width: 100%; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden } .u-progress-bar { height: 100%; border-radius: 3px; background: #6366f1 } .u-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; flex-shrink: 0 } .u-avatar-sm { width: 28px; height: 28px; font-size: .72rem } .u-avatar-lg { width: 56px; height: 56px; font-size: 1.1rem } .u-empty-state { text-align: center; padding: 60px 24px; color: #9ca3af; background: #fff; border-radius: 16px } .u-empty-state .icon { font-size: 2.5rem; display: block; margin-bottom: 8px } .u-empty-state p { margin: 0 } .u-table { width: 100%; border-collapse: collapse } .u-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #9ca3af; border-bottom: 1px solid #f3f4f6 } .u-table td { padding: 11px 14px; font-size: .88rem; border-bottom: 1px solid #fafafa } .u-table tr:hover td { background: #fafafa } .u-hero-gradient { padding: 28px 24px; text-align: center; color: #fff } .u-hero-gradient h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 4px } .u-hero-gradient p { opacity: .8; margin: 0; font-size: .9rem } /* ─── 반응형 ────────────────────────────────── */ @media(max-width: 640px) { .u-sm-col { flex-direction: column } .u-sm-full { width: 100% } .u-sm-grid-1{ grid-template-columns: 1fr !important } .u-sm-hidden{ display: none !important } }
body{background:#f9fafb}
.wrap{max-width:760px;margin:0 auto;padding:32px 20px}
.top-nav{margin-bottom:24px}
.top-nav a{font-size:.875rem;color:#6b7280;text-decoration:none;margin-right:16px}
.top-nav a:hover{color:#6366f1}
h1{font-size:1.5rem;font-weight:800;color:#111827;margin-bottom:24px}
</style>
"""
      (h "div" {"class" "wrap"}
        (h "div" {"class" "top-nav"}
          (h "a" {"href" "/shop"} "← 쇼핑 계속하기")
          (h "a" {"href" "/shop/cart"} "🛒 장바구니"))
        (h "h1" {} "📦 주문 내역")
        "<div id='island-orderlist-0'></div>"
        "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_badge=\"ui_badge__e18b\";\nvar ui_badge_green=\"ui_badge_green__c324\";\nvar ui_badge_red=\"ui_badge_red__d2e1\";\nvar ui_badge_yellow=\"ui_badge_yellow__e771\";\nvar ui_badge_blue=\"ui_badge_blue__59fd\";\nvar ui_badge_gray=\"ui_badge_gray__f560\";\nvar ui_avatar=\"ui_avatar__2815\";\nvar ui_divider=\"ui_divider__22a8\";\nvar ui_spinner=\"ui_spinner__719f\";\nvar ui_input_wrap=\"ui_input_wrap__d034\";\nvar ui_input_label=\"ui_input_label__ebfb\";\nvar ui_input_field=\"ui_input_field__ac1d\";\nvar ui_textarea_field=\"ui_textarea_field__1eab\";\nvar ui_checkbox_wrap=\"ui_checkbox_wrap__7110\";\nvar ui_checkbox_input=\"ui_checkbox_input__d495\";\nvar ui_form_group=\"ui_form_group__83c7\";\nvar ui_card=\"ui_card__5be5\";\nvar ui_alert=\"ui_alert__3457\";\nvar ui_alert_success=\"ui_alert_success__99d7\";\nvar ui_alert_error=\"ui_alert_error__f8d5\";\nvar ui_alert_warning=\"ui_alert_warning__627e\";\nvar ui_alert_info=\"ui_alert_info__18ba\";\nvar ui_empty=\"ui_empty__272c\";\nvar ui_progress_wrap=\"ui_progress_wrap__d67f\";\nvar ui_progress_bar=\"ui_progress_bar__675c\";\nvar ui_table_wrap=\"ui_table_wrap__8d07\";\nvar ui_stat_card=\"ui_stat_card__b4e2\";\nvar ui_tag=\"ui_tag__b0e1\";\nvar about_card=\"about_card__70b3\";\nvar about_title=\"about_title__1247\";\nvar stats_container=\"stats_container__aea6\";\nvar stats_grid=\"stats_grid__63be\";\nvar stat_card=\"stat_card__cae2\";\nvar stat_value=\"stat_value__3433\";\nvar stat_label=\"stat_label__5402\";\nvar error_list=\"error_list__f9d4\";\nvar error_item=\"error_item__cd51\";\nvar error_type_error=\"error_type_error__7600\";\nvar error_type_warn=\"error_type_warn__e060\";\nvar error_type_promise=\"error_type_promise__8dc9\";\nvar error_type_console=\"error_type_console__ea09\";\nvar form_box=\"form_box__8f33\";\nvar page_wrap=\"page_wrap__2009\";\nvar counter_page=\"counter_page__35ea\";\nvar counter_box=\"counter_box__4a74\";\nvar counter_btn=\"counter_btn__d6e9\";\nvar counter_num=\"counter_num__57f7\";\nvar counter_