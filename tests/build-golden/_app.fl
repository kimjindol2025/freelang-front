ttom:4px\"}, _fl_str(_fl.h(\"span\", {\"style\": \"font-weight:600\"}, _fl.get(o, \"label\")), _fl.h(\"span\", {\"style\": \"color:#6b7280\"}, _fl_str(_fl_str(_fl.get(o, \"votes\")), \"표\")))), _fl.h(\"div\", {\"style\": \"height:14px;background:#eef2ff;border-radius:99px;overflow:hidden\"}, _fl.h(\"div\", {\"style\": _fl_str(\"height:100%;background:#6366f1;border-radius:99px;width:\", _fl_str(pct), \"%\")}, \"\")))); })(); }, _fl.deref(opts))); };\n})());\n//# sourceURL=island-poll.flx\n</script>")
