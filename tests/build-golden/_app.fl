    (catch $err (dev-error-page "/api/alerts/stream" (str $err)))))

; ── pages/api/alerts.flx ──
; pages/api-alerts.flx — 실시간 알림 API (v0.7.0)

; ── inlined: performance-monitor.fl ──
; performance-monitor.fl — 클라이언트 성능 모니터링
; v0.9.0 운영 검증 (SLO/SLA)

(load "freelang-stdlib-extensions.fl")

; ── 성능 데이터 저장소 (atom-based) ──
(define performance-log (atom []))
(define MAX-PERF-RECORDS 500)
(define performance-watchers (atom []))

; ── 알림 저장소 & 임계값 (v0.7.0) ──
(define alert-log (atom []))
(define MAX-ALERTS 200)
(define alert-thresholds {
  "page-load" 2000
  "api-call" 1000
  "memory" 80
  "long-task" 500
})
(define alert-watchers (atom []))

; ── 커스텀 메트릭 저장소 (v0.8.0) ──
(define custom-metrics (atom {}))
(define custom-metric-data (atom []))
(define MAX-CUSTOM-RECORDS 300)

; ── SLO/SLA 정의 (v0.9.0) ──
(define slo-definitions {
  "page-load" {"target" 3000 "threshold" 95}     ; 95% < 3초
  "api-call" {"target" 1500 "threshold" 98}      ; 98% < 1.5초
  "availability" {"target" 99.9 "threshold" 99.9} ; 99.9% uptime
})

(define sla-tracking (atom {
  "page-load" {"total" 0 "passed" 0 "percentage" 0}
  "api-call" {"total" 0 "passed" 0 "percentage" 0}
  "availability" {"uptime" 100}
}))

; ── EventSource 등록 함수 ──
(defn register-watcher [$callback]
  (swap! performance-watchers conj $callback))

(defn notify-watchers [$record]
  (let [$watchers (deref performance-watchers)]
    (doseq [$callback $watchers]
      (try
        ($callback $record)
        (catch $e
          (log-warn (str "Watcher error: " $e)))))))

; ── 성능 기록 함수 ──
(defn record-performance [$metric]
  (let [perf-record {
    "metric" (get $metric "metric")
    "value" (get $metric "value")
    "unit" (get $metric "unit")
    "page" (get $metric "page")
    "timestamp" (str (date-now))
  }]

    ; atom에 저장 (최근 500개만 유지)
    (swap! performance-log
      (fn [$logs]
        (let [$new-logs (conj $logs perf-record)]
          (if (>= (length $new-logs) MAX-PERF-RECORDS)
            (rest $new-logs)
            $new-logs))))

    ; 로깅
    (log-info (str "[PERF] " (get perf-record "metric")
                   ": " (get perf-record "value")
                   (get perf-record "unit")))

    ; EventSource 워처 알림
    (notify-watchers perf-record)

    ; 알림 감지 (v0.7.0)
    (detect-performance-alert perf-record)

    ; SLO 검증 (v0.9.0)
    (check-slo-compliance (get perf-record "metric") (get perf-record "value"))))

; ── 성능 통계 함수 (5가지 메트릭) ──
(defn get-performance-stats []
  (let [$all (deref performance-log)
        $page-loads (filter (fn [$p] (= (get $p "metric") "page-load")) $all)
        $api-calls (filter (fn [$p] (= (get $p "metric") "api-call")) $all)
        $route-transitions (filter (fn [$p] (= (get $p "metric") "route-transition")) $all)
        $long-tasks (filter (fn [$p] (= (get $p "metric") "long-task")) $all)
        $memory (filter (fn [$p] (= (get $p "metric") "memory")) $all)]
    {
      "total-records" (length $all)
      "page-loads" {
        "count" (length $page-loads)
        "average" (if (> (length $page-loads) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $page-loads))
             (length $page-loads))
          0)
      }
      "api-calls" {
        "count" (length $api-calls)
        "average" (if (> (length $api-calls) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $api-calls))
             (length $api-calls))
          0)
      }
      "route-transitions" {
        "count" (length $route-transitions)
        "average" (if (> (length $route-transitions) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $route-transitions))
             (length $route-transitions))
          0)
      }
      "long-tasks" {
        "count" (length $long-tasks)
        "average" (if (> (length $long-tasks) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $long-tasks))
             (length $long-tasks))
          0)
      }
      "memory" {
        "count" (length $memory)
        "current" (if (> (length $memory) 0)
          (get (last $memory) "value")
          0)
        "average" (if (> (length $memory) 0)
          (/ (reduce + 0 (map (fn [$p] (get $p "value")) $memory))
             (length $memory))
          0)
      }
      "recent" (take 10 (reverse $all))
    }))

; ── 성능 조회 함수 ──
(defn get-performance-metrics [$metric-type $limit]
  (let [$all (deref performance-log)
        $filtered (if $metric-type
          (filter (fn [$p] (= (get $p "metric") $metric-type)) $all)
          $all)
        $sorted (reverse $filtered)]
    {
      "metric" $metric-type
      "count" (length $sorted)
      "limit" $limit
      "metrics" (take $limit $sorted)
    }))

; ── 성능 범위별 분석 ──
(defn analyze-performance-range [$metric-type]
  (let [$metrics (get-performance-metrics $metric-type 100)
        $values (map (fn [$m] (get $m "value")) (get $metrics "metrics"))]
    {
      "metric" $metric-type
      "count" (length $values)
      "min" (if (> (length $values) 0) (reduce min 99999 $values) 0)
      "max" (if (> (length $values) 0) (reduce max 0 $values) 0)
      "average" (if (> (length $values) 0)
        (/ (reduce + 0 $values) (length $values))
        0)
      "p95" (if (> (length $values) 0)
        (let [$sorted (sort $values)
              $idx (- (length $sorted) (max 1 (round (/ (length $sorted) 20))))]
          (get $sorted $idx))
        0)
    }))

; ── 시간 범위 필터링 함수 (v0.3.0) ──
(defn filter-by-time-range [$records $hours]
  (let [$now (time-now)
        $threshold (* $hours 3600000)]
    (filter (fn [$r]
      (let [$ts (parse-date (get $r "timestamp"))
            $diff (- $now $ts)]
        (< $diff $threshold)))
      $records)))

; ── 페이지별 필터링 함수 (v0.3.0) ──
(defn filter-by-page [$records $page]
  (if (empty? $page)
    $records
    (filter (fn [$r]
      (= (get $r "page") $page))
      $records)))

; ── 메트릭 유형별 필터링 (v0.3.0) ──
(defn filter-by-metric [$records $metric-type]
  (if (nil? $metric-type)
    $records
    (filter (fn [$r]
      (= (get $r "metric") $metric-type))
      $records)))

; ── 고급 필터 조합 (v0.3.0) ──
(defn apply-filters [$metric $page $hours]
  (let [$all (deref performance-log)
        $by-metric (filter-by-metric $all $metric)
        $by-page (filter-by-page $by-metric $page)
        $by-time (filter-by-time-range $by-page $hours)]
    $by-time))

; ── CSV 내보내기 (v0.3.0) ──
(defn export-to-csv []
  (let [$records (deref performance-log)
        $header "metric,value,unit,page,timestamp\n"
        $rows (map (fn [$r]
          (str (get $r "metric") ","
               (get $r "value") ","
               (get $r "unit") ","
               (get $r "page") ","
               (get $r "timestamp")))
          $records)]
    (str $header (str-join "\n" $rows))))

; ── JSON 내보내기 (v0.3.0) ──
(defn export-to-json []
  (let [$records (deref performance-log)]
    (json-stringify {
      "count" (length $records)
      "data" $records
      "exported-at" (str (date-now))
    })))

; ── API: POST /api/metrics (성능 데이터 저장) ──
(defn handle-post-metrics [$req]
  (try
    (let [$body (get $req "body")
          $metric (or (get $body "metric") "unknown")
          $value (or (get $body "value") 0)
          $unit (or (get $body "unit") "ms")
          $page (req-query-default $req "page" "")]

      ; 검증
      (validate-range $value 0 999999 "value")
      (validate-length $metric 3 50 "metric")

      ; 기록
      (record-performance {
        "metric" $metric
        "value" $value
        "unit" $unit
        "page" $page
      })

      (server-json {"ok" true "recorded" true} 200))

    (catch $e
      (log-error (str "Error handling POST /api/metrics: " $e))
      (server-json {"error" "Failed to record metric"} 500))))

; ── API: GET /api/metrics (성능 통계) ──
(defn handle-get-metrics [$req]
  (try
    (let [$metric (req-query-default $req "metric" nil)
          $limit (or (req-query-default $req "limit" "20") "20")
          $limit-num (str-to-num $limit)
          $result (if $metric
            (analyze-performance-range $metric)
            (get-performance-stats))]

      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling GET /api/metrics: " $e))
      (server-json {"error" "Failed to retrieve metrics"} 500))))

; ── API: DELETE /api/metrics (성능 로그 초기화) ──
(defn handle-delete-metrics [$req]
  (try
    (do
      (reset! performance-log [])
      (log-info "Performance log cleared")
      (server-json {"ok" true} 200))

    (catch $e
      (log-error (str "Error handling DELETE /api/metrics: " $e))
      (server-json {"error" "Failed to clear metrics"} 500))))

; ── 알림 감지 함수 (v0.7.0) ──
(defn detect-performance-alert [$record]
  (let [$metric (get $record "metric")
        $value (get $record "value")
        $threshold (get alert-thresholds $metric)]
    (if (and $threshold (> $value $threshold))
      (let [$alert {
        "id" (str (random))
        "type" "performance"
        "metric" $metric
        "value" $value
        "threshold" $threshold
        "severity" (if (> $value (* $threshold 1.5)) "high" "warning")
        "message" (str $metric " 초과: " $value "ms (임계값: " $threshold "ms)")
        "timestamp" (str (date-now))
      }]
        ; atom에 저장 (최근 200개만 유지)
        (swap! alert-log
          (fn [$alerts]
            (let [$new-alerts (conj $alerts $alert)]
              (if (>= (length $new-alerts) MAX-ALERTS)
                (rest $new-alerts)
                $new-alerts))))

        ; 로깅
        (log-warn (str "[ALERT] " (get $alert "message")))

        ; 알림 워처 알림
        (let [$watchers (deref alert-watchers)]
          (doseq [$callback $watchers]
            (try
              ($callback $alert)
              (catch $e
                (log-warn (str "Alert watcher error: " $e))))))))))

; ── 알림 워처 등록 함수 (v0.7.0) ──
(defn register-alert-watcher [$callback]
  (swap! alert-watchers conj $callback))

; ── 알림 조회 함수 (v0.7.0) ──
(defn get-alerts [$limit]
  (let [$all (deref alert-log)
        $sorted (reverse $all)]
    {
      "total" (length $all)
      "alerts" (take $limit $sorted)
    }))

; ── 커스텀 메트릭 관리 함수 (v0.8.0) ──
(defn create-custom-metric [$name $description $unit $threshold]
  (let [$id (str (random))
        $metric {
          "id" $id
          "name" $name
          "description" $description
          "unit" $unit
          "threshold" $threshold
          "created-at" (str (date-now))
          "records" 0
        }]
    (swap! custom-metrics assoc $id $metric)
    $metric))

(defn record-custom-metric [$metric-id $value]
  (let [$metrics (deref custom-metrics)
        $metric (get $metrics $metric-id)]
    (if $metric
      (let [$record {
        "id" $metric-id
        "value" $value
        "timestamp" (str (date-now))
      }]
        (swap! custom-metric-data
          (fn [$data]
            (let [$new-data (conj $data $record)]
              (if (>= (length $new-data) MAX-CUSTOM-RECORDS)
                (rest $new-data)
                $new-data))))

        ; 임계값 체크
        (if (and (get $metric "threshold") (> $value (get $metric "threshold")))
          (let [$alert {
            "id" (str (random))
            "type" "custom"
            "metric" (get $metric "name")
            "value" $value
            "threshold" (get $metric "threshold")
            "severity" (if (> $value (* (get $metric "threshold") 1.5)) "high" "warning")
            "message" (str (get $metric "name") " 초과: " $value (get $metric "unit"))
            "timestamp" (str (date-now))
          }]
            (swap! alert-log
              (fn [$alerts]
                (let [$new-alerts (conj $alerts $alert)]
                  (if (>= (length $new-alerts) MAX-ALERTS)
                    (rest $new-alerts)
                    $new-alerts))))))

        $record)
      nil)))

(defn get-custom-metrics []
  (deref custom-metrics))

(defn get-custom-metric-data [$metric-id $limit]
  (let [$all (deref custom-metric-data)
        $filtered (filter (fn [$r] (= (get $r "id") $metric-id)) $all)
        $sorted (reverse $filtered)]
    {
      "metric-id" $metric-id
      "count" (length $filtered)
      "data" (take $limit $sorted)
    }))

; ── SLO/SLA 검증 함수 (v0.9.0) ──
(defn check-slo-compliance [$metric $value]
  (let [$slo (get slo-definitions $metric)]
    (if $slo
      (let [$tracking (deref sla-tracking)
            $metric-tracking (get $tracking $metric)
            $total (+ (get $metric-tracking "total") 1)
            $passed (if (<= $value (get $slo "target"))
              (+ (get $metric-tracking "passed") 1)
              (get $metric-tracking "passed"))
            $percentage (round (/ (* $passed 100) $total))]
        (swap! sla-tracking assoc $metric {
          "total" $total
          "passed" $passed
          "percentage" $percentage
          "slo-target" (get $slo "threshold")
          "compliant" (>= $percentage (get $slo "threshold"))
        })))))

(defn get-sla-report []
  (let [$tracking (deref sla-tracking)]
    {
      "timestamp" (str (date-now))
      "metrics" (map (fn [[$k $v]]
        {
          "metric" $k
          "total-requests" (get $v "total")
          "passed-requests" (get $v "passed")
          "success-percentage" (get $v "percentage")
          "slo-target" (get $v "slo-target")
          "compliant" (get $v "compliant")
        })
        $tracking)
    }))

(defn get-sla-status []
  (let [$report (get-sla-report)
        $metrics (get $report "metrics")]
    {
      "timestamp" (get $report "timestamp")
      "all-compliant" (every? (fn [$m] (get $m "compliant")) $metrics)
      "compliance-rate" (round (/ (reduce + 0 (map (fn [$m] (get $m "success-percentage")) $metrics))
                                   (length $metrics)))
      "metrics" $metrics
    }))
; ── end: performance-monitor.fl ──

(defn page_api_alerts__inner [req]
  (let [$path (get $req "path")]
    (cond
      (str-includes $path "/api/alerts/stream")
      (handle-alerts-stream $req)

      (str-includes $path "/api/alerts")
      (handle-get-alerts $req)

      true
      (server-json {"error" "Not Found"} 404))))

; ── GET /api/alerts (알림 목록) ──
(defn handle-get-alerts [$req]
  (try
    (let [$query (get $req "query")
          $limit (str-to-num (or (get $query "limit") "50"))]
      (let [$result (get-alerts $limit)]
        (server-json $result 200)))

    (catch $e
      (log-error (str "Error handling GET /api/alerts: " $e))
      (server-json {"error" "Failed to retrieve alerts"} 500))))

; ── GET /api/alerts/stream (SSE 미지원 → 폴링 안내) ──
(defn handle-alerts-stream [$req]
  (server-json {
    "error" "SSE streaming not supported"
    "hint" "Use GET /api/alerts with polling instead"
    "poll_interval_ms" 3000
  } 501))
(defn page_api_alerts [req]
  (try (page_api_alerts__inner req)
    (catch $err (dev-error-page "/api/alerts" (str $err)))))

; ── pages/api/custom-metrics.flx ──
; pages/api-custom-metrics.flx — 커스텀 메트릭 API (v0.8.0)

; (load already inlined)

(defn page_api_custom_metrics__inner [req]
  (let [$path (get $req "path")
        $method (get $req "method")]
    (cond
      (and (= $method "POST") (str-includes $path "/api/custom-metrics"))
      (handle-create-custom-metric $req)

      (and (= $method "GET") (str-includes $path "/api/custom-metrics"))
      (handle-list-custom-metrics $req)

      (and (= $method "POST") (str-includes $path "/api/custom-metrics/record"))
      (handle-record-custom-metric $req)

      (and (= $method "GET") (str-includes $path "/api/custom-metrics/data"))
      (handle-get-custom-metric-data $req)

      true
      (server-json {"error" "Not Found"} 404))))

; ── POST /api/custom-metrics (커스텀 메트릭 생성) ──
(defn handle-create-custom-metric [$req]
  (try
    (let [$body (get $req "body")]
      (let [$name (get $body "name")
            $description (get $body "description")
            $unit (get $body "unit")
            $threshold (get $body "threshold")]
        (if (and $name $unit)
          (let [$metric (create-custom-metric $name $description $unit $threshold)]
            (server-json $metric 201))
          (server-json {"error" "Missing required fields (name, unit)"} 400))))

    (catch $e
      (log-error (str "Error creating custom metric: " $e))
      (server-json {"error" "Failed to create metric"} 500))))

; ── GET /api/custom-metrics (메트릭 목록) ──
(defn handle-list-custom-metrics [$req]
  (try
    (let [$metrics (get-custom-metrics)]
      (server-json {
        "total" (length $metrics)
        "metrics" (obj-values $metrics)
      } 200))

    (catch $e
      (log-error (str "Error listing custom metrics: " $e))
      (server-json {"error" "Failed to list metrics"} 500))))

; ── POST /api/custom-metrics/record (데이터 기록) ──
(defn handle-record-custom-metric [$req]
  (try
    (let [$body (get $req "body")
          $metric-id (get $body "metric-id")
          $value (get $body "value")]
      (if (and $metric-id $value)
        (let [$record (record-custom-metric $metric-id (str-to-num $value))]
          (if $record
            (server-json $record 200)
            (server-json {"error" "Metric not found"} 404)))
        (server-json {"error" "Missing required fields (metric-id, value)"} 400)))

    (catch $e
      (log-error (str "Error recording custom metric: " $e))
      (server-json {"error" "Failed to record metric"} 500))))

; ── GET /api/custom-metrics/data (메트릭 데이터 조회) ──
(defn handle-get-custom-metric-data [$req]
  (try
    (let [$query (get $req "query")
          $metric-id (get $query "metric-id")
          $limit (str-to-num (or (get $query "limit") "50"))]
      (if $metric-id
        (let [$data (get-custom-metric-data $metric-id $limit)]
          (server-json $data 200))
        (server-json {"error" "Missing metric-id parameter"} 400)))

    (catch $e
      (log-error (str "Error getting custom metric data: " $e))
      (server-json {"error" "Failed to retrieve metric data"} 500))))
(defn page_api_custom_metrics [req]
  (try (page_api_custom_metrics__inner req)
    (catch $err (dev-error-page "/api/custom-metrics" (str $err)))))

; ── pages/api/errors-stats.flx ──
; pages/errors-stats.flx — 에러 통계 대시보드 (간단한 버전)
; GET /errors-stats — 에러 현황 시각화

; ── inlined: error-api.fl ──
; error-api.fl — 클라이언트 에러 수집 및 저장
; v0.2.1 에러 리포팅 시스템

(load "freelang-stdlib-extensions.fl")

; ── 에러 저장소 (atom-based, 최근 100개) ──
(define error-log (atom []))
(define MAX-ERRORS 100)

; ── 에러 추가 함수 ──
(defn add-error [$entry]
  (let [error-with-time {
    "type" (get $entry "type")
    "message" (get $entry "message")
    "source" (get $entry "source")
    "line" (get $entry "line")
    "stack" (get $entry "stack")
    "user-agent" (get $entry "user-agent")
    "timestamp" (str (date-now))
  }]

    ; atom에 저장 (최근 100개만 유지)
    (swap! error-log
      (fn [$errors]
        (let [$new-errors (conj $errors error-with-time)]
          (if (>= (length $new-errors) MAX-ERRORS)
            (rest $new-errors)
            $new-errors))))

    ; 로깅
    (log-error (str "[CLIENT] " (get error-with-time "message")
                    " (" (get error-with-time "type") ")"))))

; ── 에러 조회 함수 ──
(defn get-errors [$limit]
  (let [$errors (deref error-log)
        $count (length $errors)]
    {
      "total" $count
      "limit" $limit
      "returned" (min $count $limit)
      "errors" (take $limit (reverse $errors))
    }))

; ── 에러 초기화 함수 ──
(defn clear-errors []
  (reset! error-log [])
  {"ok" true})

; ── 에러 필터링 함수 ──
(defn filter-errors [$type]
  (let [$all-errors (deref error-log)
        $filtered (filter
          (fn [$e] (= (get $e "type") $type))
          $all-errors)]
    {
      "type" $type
      "count" (length $filtered)
      "errors" (take 20 (reverse $filtered))
    }))

; ── API: POST /api/errors (에러 저장) ──
(defn handle-post-errors [$req]
  (try
    (let [$body (get $req "body")
          $message (or (get $body "message") "Unknown error")
          $type (or (get $body "type") "error")
          $source (get $body "source")
          $line (get $body "line")
          $stack (get $body "stack")
          $user-agent (get (get $req "headers") "user-agent")]

      ; 검증
      (validate-length $message 5 1000 "message")

      ; 에러 추가
      (add-error {
        "type" $type
        "message" $message
        "source" $source
        "line" $line
        "stack" $stack
        "user-agent" $user-agent
      })

      (server-json {"ok" true "received" true} 200))

    (catch $e
      (log-error (str "Error handling POST /api/errors: " $e))
      (server-json {
        "error" "Failed to log error"
        "details" (str $e)
      } 500))))

; ── API: GET /api/errors (에러 목록) ──
(defn handle-get-errors [$req]
  (try
    (let [$limit (or (req-query-default $req "limit" "20") "20")
          $limit-num (str-to-num $limit)
          $type (req-query-default $req "type" nil)
          $result (if $type
            (filter-errors $type)
            (get-errors $limit-num))]

      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling GET /api/errors: " $e))
      (server-json {"error" "Failed to retrieve errors"} 500))))

; ── API: DELETE /api/errors (에러 초기화) ──
(defn handle-delete-errors [$req]
  (try
    (let [$result (clear-errors)]
      (log-info "Error log cleared")
      (server-json $result 200))

    (catch $e
      (log-error (str "Error handling DELETE /api/errors: " $e))
      (server-json {"error" "Failed to clear errors"} 500))))

; ── 통계 함수 ──
(defn get-error-stats []
  (let [$all (deref error-log)
        $errors (filter (fn [$e] (= (get $e "type") "error")) $all)
        $warns (filter (fn [$e] (= (get $e "type") "warn")) $all)
        $promise (filter (fn [$e] (= (get $e "type") "promise")) $all)
        $console (filter (fn [$e] (= (get $e "type") "console")) $all)]
    {
      "total" (length $all)
      "by-type" {
        "error" (length $errors)
        "warn" (length $warns)
        "promise" (length $promise)
        "console" (length $console)
      }
      "recent" (take 5 (reverse $all))
    }))

; ── 에러 중복 제거 함수 ──
(defn deduplicate-errors []
  (let [$all (deref error-log)
        $seen (atom {})
        $unique (filter
          (fn [$e]
            (let [$key (str (get $e "type") ":" (get $e "message"))
                  $seen-map (deref $seen)
                  $is-new (nil? (get $seen-map $key))]
              (if $is-new
                (swap! $seen (fn [m] (assoc m $key true))))
              $is-new))
          $all)]
    {
      "total" (length $all)
      "unique" (length $unique)
      "duplicates" (- (length $all) (length $unique))
    }))

; ── 에러 성능 측정 ──
(defn measure-error-api-time [$fn]
  (measure-time $fn "error-api-call"))

; ── 에러 범위 필터 (최근 N분) ──
(defn get-recent-errors [$minutes]
  (let [$all (deref error-log)
        $cutoff-ms (* $minutes 60 1000)
        $now (date-now)
        $filtered (filter
          (fn [$e]
            (let [$age (- $now (str-to-num (get $e "timestamp")))]
              (< $age $cutoff-ms)))
          $all)]
    {
      "minutes" $minutes
      "count" (length $filtered)
      "errors" (take 20 (reverse $filtered))
    }))

; ── 에러 소스별 통계 ──
(defn get-errors-by-source []
  (let [$all (deref error-log)
        $sources (atom {})]
    (map (fn [$e]
      (let [$source (get $e "source")
            $count (or (get (deref $sources) $source) 0)]
        (swap! $sources (fn [s] (assoc s $source (+ $count 1))))))
    $all)
    (let [$source-map (deref $sources)
          $sorted (sort-by (fn [$pair] (- (get $pair 1))) (into [] $source-map))]
      {
        "by-source" $sorted
        "top-5" (take 5 $sorted)
      })))
; ── end: error-api.fl ──

(defn page_api_errors_stats__inner [req]
  (let [$stats (get-error-stats)
        $errors (get $stats "recent")
        $total (get $stats "total")
        $by-type (get $stats "by-type")]

    (layout-html "에러 통계"
      (h "div" {:class stats-container}
        (h "h1" {:style "mb:24px;font-size:2rem;font-weight:bold"} "에러 통계 대시보드")

        ; 통계 카드
        (h "div" {:class stats-grid}
          (h "div" {:class stat-card}
            (h "div" {:class stat-value} $total)
            (h "div" {:class stat-label} "총 에러 개수"))

          (h "div" {:class stat-card}
            (h "div" {:class stat-value} (or (get $by-type "error") 0))
            (h "div" {:class stat-label} "에러"))

          (h "div" {:class stat-card}
            (h "div" {:class stat-value} (or (get $by-type "warn") 0))
            (h "div" {:class stat-label} "경고"))

          (h "div" {:class stat-card}
            (h "div" {:class stat-value} (or (get $by-type "promise") 0))
            (h "div" {:class stat-label} "Promise 거부")))

        ; 최근 에러 목록
        (h "h2" {:style "mt:32px;mb:16px;font-size:1.25rem;font-weight:bold"} "최근 5개 에러")

        (h "div" {:class error-list}
          (if (> $total 0)
            (map (fn [$error]
              (let [$type (get $error "type")
                    $color (cond
                      (= $type "error") error-type-error
                      (= $type "warn") error-type-warn
                      (= $type "promise") error-type-promise
                      true error-type-console)]
                (h "div" {:class error-item}
                  (h "div" {:style "display:flex;gap:8px;align-items:start"}
                    (h "span" {:style (str "display:inline-block;padding:2px 8px;border-radius:4px;" $color)} $type)
                    (h "div" {:style "flex:1"}
                      (h "p" {:style "margin:0;font-weight:600"} (get $error "message"))
                      (h "p" {:style "margin:4px 0 0;color:#9ca3af;font-size:.8rem"} (get $error "source"))
                      (h "p" {:style "margin:2px 0 0;color:#d1d5db;font-size:.75rem"} (get $error "timestamp")))))))
            $errors)

            (h "div" {:class error-item :style "color:#9ca3af"} "에러 없음")))

        ; 하단 작업
        (h "div" {:style "mt:24px;display:flex;gap:8px"}
          (h "a" {:href "/api/errors?limit=50" :class "btn" :style "display:inline-block;padding:10px 16px;background:#6366f1;color:white;border-radius:6px;text-decoration:none;font-weight:600;cursor:pointer"}
            "📥 JSON 다운로드")
          (h "button" {:onclick "fetch('/api/errors',{method:'DELETE'}).then(()=>location.reload())" :style "padding:10px 16px;background:#ef4444;color:white;border:none;border-radius:6px;font-weight:600;cursor:pointer"}
            "🗑️ 에러 초기화")))

      $req)))
(defn page_api_errors_stats [req]
  (try (page_api_errors_stats__inner req)
    (catch $err (dev-error-page "/api/errors-stats" (str $err)))))

; ── pages/api/errors.flx ──
; pages/api-errors.flx — 에러 수집 API 라우트
; GET /api/errors — 에러 목록 조회
; POST /api/errors — 에러 저장
; DELETE /api/errors — 에러 초기화

; (load already inlined)

(defn page_api_errors__inner [req]
  (let [$method (get $req "method")]
    (cond
      (= $method "POST")
        (handle-post-errors $req)

      (= $method "GET")
        (handle-get-errors $req)

      (= $method "DELETE")
        (handle-delete-errors $req)

      ; 다른 메서드는 405
      true
        (server-json {"error" "Method not allowed"} 405))))

(defn page_api_errors_post__inner [req]
  (handle-post-errors req))
(defn page_api_errors [req]
  (try (page_api_errors__inner req)
    (catch $err (dev-error-page "/api/errors" (str $err)))))
(defn page_api_errors_post [req]
  (try (page_api_errors_post__inner req)
    (catch $err (dev-error-page "/api/errors [POST]" (str $err)))))

; ── pages/api/hello.flx ──
(defn page_api_hello__inner [req]
  (server-json {:ok true :message "Hello from FL-Front API" :version "0.1"}))
(defn page_api_hello [req]
  (try (page_api_hello__inner req)
    (catch $err (dev-error-page "/api/hello" (str $err)))))

; ── pages/api/logs/recent.flx ──
; pages/api/logs/recent — 최근 로그 JSON (폴링용)
; GET /api/logs/recent  또는  /api/logs/stream

(define LOG-LEVELS ["info" "info" "info" "warn" "error" "debug"])
(define LOG-MSGS {
  "info"  ["요청 처리 완료" "DB 쿼리 실행" "캐시 히트" "응답 전송" "세션 갱신"]
  "warn"  ["응답 지연 감지" "메모리 사용량 높음" "재시도 발생" "인증 만료 임박"]
  "error" ["DB 연결 실패" "타임아웃 발생" "인증 오류" "파일 없음"]
  "debug" ["변수 상태 확인" "함수 진입" "조건 분기" "캐시 미스"]
})

(defn rand-log []
  (let [t   (mod (now-ms) 1000000)
        lv  (nth LOG-LEVELS (mod t (length LOG-LEVELS)))
        msgs (get LOG-MSGS lv)
        msg (nth msgs (mod (quot t 7) (length msgs)))]
    {:time (format-date (now-ms) "HH:mm:ss")
     :level lv
     :msg msg}))

(defn page_api_logs_recent__inner [req]
  (let [logs (map (fn [_] (rand-log)) (range 0 5))]
    (server-json {:ok true :logs logs})))
(defn page_api_logs_recent [req]
  (try (page_api_logs_recent__inner req)
    (catch $err (dev-error-page "/api/logs/recent" (str $err)))))

; ── pages/api/metrics/export.flx ──
; (load already inlined)
(defn page_api_metrics_export__inner [req]
  (try
    (let [$query  (get $req "query")
          $format (or (get $query "format") "json")
          $data   (get-performance-stats)]
      (if (= $format "csv")
        (server-html (export-to-csv $data) 200)
        (server-json $data 200)))
    (catch $e
      (server-json {"error" "Export failed"} 500))))
(defn page_api_metrics_export [req]
  (try (page_api_metrics_export__inner req)
    (catch $err (dev-error-page "/api/metrics/export" (str $err)))))

; ── pages/api/metrics/filter.flx ──
; (load already inlined)
(defn page_api_metrics_filter__inner [req]
  (try
    (let [$query  (get $req "query")
          $metric (or (get $query "metric") "")
          $hours  (str-to-num (or (get $query "hours") "24"))
          $data   (apply-filters (get-performance-stats) $metric $hours)]
      (server-json {"data" $data "count" (length $data)} 200))
    (catch $e
      (server-json {"error" "Filter failed"} 500))))
(defn page_api_metrics_filter [req]
  (try (page_api_metrics_filter__inner req)
    (catch $err (dev-error-page "/api/metrics/filter" (str $err)))))

; ── pages/api/metrics/stream.flx ──
(defn page_api_metrics_stream__inner [req]
  (server-json {"error" "SSE not supported" "hint" "Use GET /api/metrics with polling" "poll_interval_ms" 5000} 501))
