  (try (page_api_metrics_stream__inner req)
    (catch $err (dev-error-page "/api/metrics/stream" (str $err)))))

; ── pages/api/metrics.flx ──
; pages/api-metrics.flx — 성능 메트릭 API 라우트 (v0.3.0)
; GET /api/metrics — 성능 통계 조회
; POST /api/metrics — 성능 데이터 저장
; DELETE /api/metrics — 성능 로그 초기화
; GET /api/metrics/filter — 고급 필터링 (v0.3.0)
; GET /api/metrics/export — CSV/JSON 내보내기 (v0.3.0)
; GET /api/metrics/stream — EventSource 실시간 스트림 (v0.3.0)

; (load already inlined)

(defn page_api_metrics__inner [req]
  (let [$method (get $req "method")
        $path (get $req "path")]
    (cond
      ; 경로 기반 라우팅 (v0.3.0)
      (and (= $method "GET") (str-includes $path "/filter"))
        (handle-filter-metrics $req)

      (and (= $method "GET") (str-includes $path "/export"))
        (handle-export-metrics $req)

      (and (= $method "GET") (str-includes $path "/stream"))
        (handle-stream-metrics $req)

      (= $method "POST")
        (handle-post-metrics $req)

      (= $method "GET")
        (handle-get-metrics $req)

      (= $method "DELETE")
        (handle-delete-metrics $req)

      ; 다른 메서드는 405
      true
        (server-json {"error" "Method not allowed"} 405))))

; ── 고급 필터링 엔드포인트 (v0.3.0) ──
(defn handle-filter-metrics [$req]
  (try
    (let [$metric (req-query-default $req "metric" nil)
          $page (req-query-default $req "page" "")
          $hours (or (req-query-default $req "hours" "24") "24")
          $hours-num (str-to-num $hours)
          $filtered (apply-filters $metric $page $hours-num)
          $stats {
            "count" (length $filtered)
            "metric" $metric
            "page" $page
            "hours" $hours-num
            "data" (take 100 (reverse $filtered))
          }]
      (server-json $stats 200))
    (catch $e
      (log-error (str "Error filtering metrics: " $e))
      (server-json {"error" "Filter failed"} 500))))

; ── 내보내기 엔드포인트 (v0.3.0) ──
(defn handle-export-metrics [$req]
  (try
    (let [$format (req-query-default $req "format" "json")]
      (cond
        (= $format "csv")
          (let [$csv (export-to-csv)]
            (server-response 200 {"Content-Type" "text/csv"
                                  "Content-Disposition" "attachment; filename=metrics.csv"} $csv))

        (= $format "json")
          (let [$json (export-to-json)]
            (server-json (json-parse $json) 200))

        true
          (server-json {"error" "Invalid format (csv|json)"} 400)))
    (catch $e
      (log-error (str "Error exporting metrics: " $e))
      (server-json {"error" "Export failed"} 500))))

; ── 실시간 스트림 엔드포인트 (SSE 미지원 → 폴링 안내) ──
(defn handle-stream-metrics [$req]
  (server-json {
    "error" "SSE streaming not supported"
    "hint" "Use GET /api/metrics with polling instead"
    "poll_interval_ms" 5000
  } 501))

; POST/DELETE 라우트 — fl-front-build가 render_post를 인식해서 server-post 등록
(defn page_api_metrics_post__inner [req]
  (handle-post-metrics req))
(defn page_api_metrics [req]
  (try (page_api_metrics__inner req)
    (catch $err (dev-error-page "/api/metrics" (str $err)))))
(defn page_api_metrics_post [req]
  (try (page_api_metrics_post__inner req)
    (catch $err (dev-error-page "/api/metrics [POST]" (str $err)))))

; ── pages/api/notes.flx ──
; pages/api/notes.flx — 노트 CRUD API (SQLite)
; GET  /api/notes  → 목록
; POST /api/notes  → 추가

(define NOTES-DB {:type "sqlite" :path "/tmp/fl-notes.sqlite"})

(defn ensure-notes-db []
  (db-exec NOTES-DB "CREATE TABLE IF NOT EXISTS notes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    content TEXT NOT NULL,
    pinned INTEGER DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )" []))

(defn page_api_notes__inner [req]
  (ensure-notes-db)
  (let [rows (db-query NOTES-DB
                "SELECT * FROM notes ORDER BY pinned DESC, id DESC" [])]
    (server-json {:ok true :notes rows})))

(defn page_api_notes_post__inner [req]
  (ensure-notes-db)
  (let [body    (get req "body")
        content (str-trim (str (get body "content")))]
    (if (str-blank? content)
      (server-json {:ok false :error "내용이 없습니다"})
      (do
        (db-exec NOTES-DB "INSERT INTO notes (content) VALUES (?)" [content])
        (let [rows (db-query NOTES-DB
                     "SELECT * FROM notes ORDER BY id DESC LIMIT 1" [])]
          (server-json {:ok true :note (first rows)}))))))
(defn page_api_notes [req]
  (try (page_api_notes__inner req)
    (catch $err (dev-error-page "/api/notes" (str $err)))))
(defn page_api_notes_post [req]
  (try (page_api_notes_post__inner req)
    (catch $err (dev-error-page "/api/notes [POST]" (str $err)))))

; ── pages/api/playground/eval.flx ──
; pages/api/playground/eval.flx — FL 코드 실행 API
; POST /api/playground/eval  { "code": "(+ 1 2)" }

(defn page_api_playground_eval__inner [req]
  (server-json {:ok false :error "POST 메서드를 사용하세요"}))

(defn page_api_playground_eval_post__inner [req]
  (let [body (get req "body")
        code (get body "code")]
    (if (nil-or-empty? code)
      (server-json {:ok false :error "코드가 없습니다"})
      (let [tmp (str "/tmp/pg-" (uuid) ".fl")]
        (file-write tmp (str "(println " code ")"))
        (let [out (shell-exec-stdout (str "timeout 5 node /root/freelang-v11/bootstrap.js run " tmp " 2>&1"))]
          (file-delete tmp)
          (if (nil? out)
            (server-json {:ok false :error "실행 실패 또는 타임아웃 (5초)"})
            (if (str-includes out "실행 오류")
              (server-json {:ok false :error (str-trim out)})
              (server-json {:ok true :result (str-trim out)}))))))))
(defn page_api_playground_eval [req]
  (try (page_api_playground_eval__inner req)
    (catch $err (dev-error-page "/api/playground/eval" (str $err)))))
(defn page_api_playground_eval_post [req]
  (try (page_api_playground_eval_post__inner req)
    (catch $err (dev-error-page "/api/playground/eval [POST]" (str $err)))))

; ── pages/api/sla/report.flx ──
; (load already inlined)
(defn page_api_sla_report__inner [req]
  (try
    (server-json (get-sla-report) 200)
    (catch $e (server-json {"error" "SLA report failed"} 500))))
(defn page_api_sla_report [req]
  (try (page_api_sla_report__inner req)
    (catch $err (dev-error-page "/api/sla/report" (str $err)))))

; ── pages/api/sla/status.flx ──
; (load already inlined)
(defn page_api_sla_status__inner [req]
  (try
    (server-json (get-sla-status) 200)
    (catch $e (server-json {"error" "SLA status failed"} 500))))
(defn page_api_sla_status [req]
  (try (page_api_sla_status__inner req)
    (catch $err (dev-error-page "/api/sla/status" (str $err)))))

; ── pages/api/sla.flx ──
; pages/api-sla.flx — SLO/SLA API (v0.9.0)

; (load already inlined)

(defn page_api_sla__inner [req]
  (let [$path (get $req "path")]
    (cond
      (str-includes $path "/api/sla/status")
      (handle-get-sla-status $req)

      (str-includes $path "/api/sla/report")
      (handle-get-sla-report $req)

      true
      (server-json {"error" "Not Found"} 404))))

; ── GET /api/sla/status (SLA 상태) ──
(defn handle-get-sla-status [$req]
  (try
    (let [$status (get-sla-status)]
      (server-json $status 200))

    (catch $e
      (log-error (str "Error getting SLA status: " $e))
      (server-json {"error" "Failed to get SLA status"} 500))))

; ── GET /api/sla/report (SLA 상세 보고서) ──
(defn handle-get-sla-report [$req]
  (try
    (let [$report (get-sla-report)]
      (server-json $report 200))

    (catch $e
      (log-error (str "Error getting SLA report: " $e))
      (server-json {"error" "Failed to get SLA report"} 500))))
(defn page_api_sla [req]
  (try (page_api_sla__inner req)
    (catch $err (dev-error-page "/api/sla" (str $err)))))

; ── pages/app/api-init.flx ──
; pages/app/api-init.flx — Island 초기 데이터 로드
; GET /app/api-init → {"notes": [...]}

; ── inlined: pages/app/_db.flx ──
; ── ns: app ──
; pages/app/_db.flx — 노트앱 SQLite 헬퍼
; (ns app) → 모든 defn에 app- 접두사 자동 적용
; 외부에서: (app-notes-init), (app-notes-all), (app-note-add content) ...

(define APP-DB {:type "sqlite" :path "data/notes-app.db"})

(defn app-notes-init []
  (db-exec APP-DB
    "CREATE TABLE IF NOT EXISTS notes (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      content TEXT NOT NULL,
      pinned INTEGER DEFAULT 0,
      created_at TEXT DEFAULT (datetime('now','localtime'))
    )" []))

(defn app-notes-all []
  (db-query APP-DB
    "SELECT * FROM notes ORDER BY pinned DESC, id DESC" []))

(defn app-note-add [content]
  (db-exec APP-DB
    "INSERT INTO notes (content) VALUES (?)" [(str-trim content)]))

(defn app-note-delete [id]
  (db-exec APP-DB
    "DELETE FROM notes WHERE id = ?" [(str-to-num id)]))

(defn app-note-pin-toggle [id]
  (db-exec APP-DB
    "UPDATE notes SET pinned = CASE WHEN pinned=1 THEN 0 ELSE 1 END WHERE id = ?"
    [(str-to-num id)]))
; ── end: pages/app/_db.flx ──

(app-notes-init)

(defn page_app_api_init__inner [req]
  (server-json {"ok" true "notes" (app-notes-all)}))
(defn page_app_api_init [req]
  (try (page_app_api_init__inner req)
    (catch $err (dev-error-page "/app/api-init" (str $err)))))

; ── pages/app/api.flx ──
; pages/app/api.flx — 노트앱 JSON API
; POST /app/api  body: {action: "add"|"delete"|"pin", content?, id?}
; GET  /app/api  → 노트 목록

; (load already inlined)

(app-notes-init)

(defn page_app_api__inner [req]
  (server-json {"ok" true "notes" (app-notes-all)}))

(defn page_app_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      (= action "add")
        (let [content (or (get body "content") "")]
          (if (= (str-trim content) "")
            (server-json {"ok" false "error" "내용을 입력하세요"} 400)
            (do
              (app-note-add content)
              (server-json {"ok" true "notes" (app-notes-all)}))))

      (= action "delete")
        (let [id (get body "id")]
          (if (nil? id)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (app-note-delete id)
              (server-json {"ok" true "notes" (app-notes-all)}))))

      (= action "pin")
        (let [id (get body "id")]
          (if (nil? id)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (app-note-pin-toggle id)
              (server-json {"ok" true "notes" (app-notes-all)}))))

      true
        (server-json {"ok" false "error" (str "알 수 없는 action: " action)} 400))))
(defn page_app_api [req]
  (try (page_app_api__inner req)
    (catch $err (dev-error-page "/app/api" (str $err)))))
(defn page_app_api_post [req]
  (try (page_app_api_post__inner req)
    (catch $err (dev-error-page "/app/api [POST]" (str $err)))))

; ── pages/app/index.flx ──
; pages/app/index.flx — 노트앱
; SSR 초기 목록 + Island 폼·삭제·핀
; GET /app

; (load already inlined)

(app-notes-init)

; ── Island: 노트 UI 전체 ───────────────────────────────────


; ── GET /app/api-init — Island 초기 로드용 ──────────────────
; (별도 api.flx 없이 같은 파일에서 처리 가능하나
;  fl-front는 파일 = 라우트이므로 api.flx 사용)

; ── SSR 렌더 ─────────────────────────────────────────────────
(defn page_app_index__inner [req]
  (let [notes (app-notes-all)]
    (layout-html "노트앱"
      (str
        (h "div" {:style "background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;padding:32px 24px;text-align:center;margin-bottom:0"}
          (str
            (h "h1" {:style "font-size:1.8rem;font-weight:800;margin:0 0 6px"} "📝 노트앱")
            (h "p" {:style "opacity:.85;margin:0;font-size:.9rem"}
              (str "FreeLang Island + SSR + SQLite · " (length notes) "개 노트"))))
        "<div id='island-noteapp-0'></div>"
        "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_bad