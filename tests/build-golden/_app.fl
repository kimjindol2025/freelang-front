border:1px solid #e5e7eb;border-radius:7px;text-decoration:none;color:#374151;font-size:.8rem\"}, \"편집\"), _fl.h(\"button\", {\"style\": \"background:none;border:none;cursor:pointer;color:#ef4444;font-size:1.1rem;padding:4px\", \"on-click\": () => { return del_goal(_fl_str(_fl.get(g, \"id\"))); }}, \"×\"))))), _fl.h(\"div\", {\"style\": \"height:6px;background:#f3f4f6;border-radius:3px;margin-bottom:16px;overflow:hidden\"}, _fl.h(\"div\", {\"style\": _fl_str(\"height:100%;border-radius:3px;background:\", c, \";width:\", p, \"%\")}, \"\")), (((_fl.get(g, \"krs\"))?.length ?? 0 === 0)) ? (_fl.h(\"p\", {\"style\": \"color:#9ca3af;font-size:.85rem;margin:0\"}, \"KR을 추가하려면 편집 버튼을 누르세요\")) : (_fl.h(\"div\", {\"style\": \"display:flex;flex-direction:column;gap:10px\"}, _fl.map_arr((kr) => { return (() => { const kp = ((_fl.get(kr, \"target\") > 0)) ? (floor(((_fl.get(kr, \"current\") / _fl.get(kr, \"target\")) * 100))) : (0); return _fl.h(\"div\", {}, _fl_str(_fl.h(\"div\", {\"style\": \"display:flex;justify-content:space-between;align-items:center;margin-bottom:4px\"}, _fl_str(_fl.h(\"span\", {\"style\": \"font-size:.85rem;font-weight:600\"}, _fl.get(kr, \"title\")), _fl.h(\"span\", {\"style\": \"font-size:.8rem;color:#6b7280\"}, _fl_str(_fl.get(kr, \"current\"), \"/\", _fl.get(kr, \"target\"), \" \", _fl.get(kr, \"unit\"))))), _fl.h(\"div\", {\"style\": \"height:4px;background:#f3f4f6;border-radius:2px;overflow:hidden\"}, _fl.h(\"div\", {\"style\": _fl_str(\"height:100%;background:\", progress_color(kp), \";width:\", kp, \"%\")}, \"\")))); })(); }, _fl.get(g, \"krs\")))))); })(); }, _fl.deref(goals)))))); };\n})());\n//# sourceURL=island-goalsapp.flx\n</script>")
