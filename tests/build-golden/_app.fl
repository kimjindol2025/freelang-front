1.6rem;font-weight:700;margin-bottom:8px;color:var(--c-primary);} .pg_subtitle__2581{color:var(--c-muted);margin-bottom:24px;font-size:.9rem;} .pg_grid__35a8{display:grid;grid-template-columns:repeat(1fr 1fr,1fr);gap:20px;} .pg_panel__aaad{background:var(--c-surface);border-radius:12px;border:1px solid var(--c-border);overflow:hidden;} .pg_panel_head__2bce{padding:12px 16px;font-weight:600;color:var(--c-muted);display:flex;justify-content:space-between;align-items:center;} .pg_editor__f737{width:100%;min-height:320px;padding:16px;border:none;outline:none;background:var(--c-surface);color:var(--c-text);} .pg_result__d0e8{padding:16px;min-height:320px;color:var(--c-text);} .pg_result_error__7eff{color:#ef4444;} .pg_btn__538e{padding:8px 20px;border-radius:8px;background:var(--c-primary);color:white;border:none;cursor:pointer;font-weight:600;} .pg_examples__8d1f{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;} .pg_ex_btn__ea5c{padding:4px 12px;border-radius:6px;background:var(--c-surface);border:1px solid var(--c-border);cursor:pointer;color:var(--c-muted);} .pg_status__b570{color:var(--c-muted);} .card__86e7{background:white;padding:24px;border-radius:8px;box-shadow:0 4px 12px rgba(0,0,0,.15);} .hero__43b0{background:#6366f1;color:white;padding:48px;border-radius:12px;} .badge__a154{background:#f3f4f6;color:#374151;padding:4px;border-radius:4px;font-size:12px;font-weight:600;} .resp_grid__7f07{display:grid;gap:20px;grid-template-columns:repeat(3,1fr);} @media(max-width:768px){.resp_grid__7f07{grid-template-columns:repeat(2,1fr);}} @media(max-width:640px){.resp_grid__7f07{grid-template-columns:repeat(1,1fr);}} .resp_card__789b{background:white;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.12);padding:24px;} @media(max-width:640px){.resp_card__789b{padding:14px;}} .resp_hero__3912{background:#6366f1;color:white;border-radius:12px;padding:48px;} @media(max-width:640px){.resp_hero__3912{padding:24px;}} /* FreeLang 공식 홈페이지 CSS — 2026-06-01 Phase A 분리 */  * { margin: 0; padding: 0; box-sizing: border-box; }  :root {   --bg: #080810;   --surface: #0f0f1e;   --surface2: #1a1a2e;   --accent: #7c3aed;   --accent-light: #a78bfa;   --cyan: #06b6d4;   --text: #e0e0ff;   --text-muted: #a0a0bf;   --radius: 12px; }  html {   background: var(--bg);   color: var(--text);   font-family: -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;   line-height: 1.6; }  body {   background: var(--bg);   overflow-x: hidden; }  nav {   position: fixed;   top: 0;   left: 0;   right: 0;   height: 64px;   background: rgba(8,8,16,.8);   backdrop-filter: blur(10px);   display: flex;   align-items: center;   justify-content: space-between;   padding: 0 40px;   z-index: 1000;   border-bottom: 1px solid rgba(255,255,255,.05); }  .nav-brand {   font-size: 1.4rem;   font-weight: 700;   background: linear-gradient(135deg, #7c3aed, #06b6d4);   -webkit-background-clip: text;   -webkit-text-fill-color: transparent;   text-decoration: none;   cursor: pointer; }  .nav-links {   display: flex;   gap: 30px; }  .nav-link {   color: var(--text-muted);   text-decoration: none;   font-size: 0.95rem;   transition: color 0.3s; }  .nav-link:hover {   color: var(--accent); }  main {   margin-top: 64px; }  .section {   padding: 80px 40px;   max-width: 1200px;   margin: 0 auto; }  .section.hero {   min-height: calc(100vh - 64px);   display: flex;   flex-direction: column;   justify-content: center;   padding: 120px 40px;   position: relative;   overflow: hidden; }  .hero-orb {   position: absolute;   width: 300px;   height: 300px;   background: radial-gradient(circle, rgba(124,58,237,.2), transparent);   border-radius: 50%;   top: 10%;   right: 10%;   animation: float 6s ease-in-out infinite; }  @keyframes float {   0%, 100% { transform: translate(0, 0); }   50% { transform: translate(-30px, 30px); } }  .hero-content {   position: relative;   z-index: 1;   max-width: 700px; }  h1 {   font-size: clamp(3rem, 8vw, 6rem);   font-weight: 800;   line-height: 1.1;   margin-bottom: 20px;   background: linear-gradient(135deg, #7c3aed, #06b6d4);   -webkit-background-clip: text;   -webkit-text-fill-color: transparent; }  .hero-subtitle {   font-size: 1.3rem;   color: var(--text-muted);   margin-bottom: 40px;   line-height: 1.6; }  .btn-group {   display: flex;   gap: 20px;   flex-wrap: wrap;   margin-bottom: 40px; }  .btn {   padding: 12px 32px;   border-radius: 8px;   border: none;   font-size: 1rem;   font-weight: 600;   cursor: pointer;   transition: all 0.3s;   text-decoration: none;   display: inline-block; }  .btn-primary {   background: var(--accent);   color: white; }  .btn-primary:hover {   background: var(--accent-light);   transform: translate(0, -4px); }  .btn-secondary {   background: transparent;   border: 2px solid var(--accent);   color: var(--accent); }  .btn-secondary:hover {   background: rgba(124,58,237,.1);   transform: translate(0, -4px); }  .stats {   display: grid;   grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));   gap: 30px;   margin-top: 80px; }  .stat {   background: rgba(255,255,255,.02);   border: 1px solid rgba(124,58,237,.2);   padding: 30px;   border-radius: var(--radius);   text-align: center; }  .stat-value {   font-size: 2.5rem;   font-weight: 700;   color: var(--accent);   margin-bottom: 10px; }  .stat-label {   font-size: 0.95rem;   color: var(--text-muted); }  h2 {   font-size: 2.5rem;   font-weight: 700;   margin-bottom: 50px;   text-align: center;   background: linear-gradient(135deg, #7c3aed, #06b6d4);   -webkit-background-clip: text;   -webkit-text-fill-color: transparent; }  .grid-3 {   display: grid;   grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));   gap: 30px; }  .feature-card {   background: rgba(255,255,255,.02);   border: 1px solid rgba(124,58,237,.2);   padding: 40px;   border-radius: var(--radius);   transition: all 0.3s; }  .feature-card:hover {   background: rgba(255,255,255,.05);   border-color: rgba(124,58,237,.5);   transform: translate(0, -4px); }  .feature-icon {   font-size: 2.5rem;   margin-bottom: 15px; }  .feature-title {   font-size: 1.2rem;   font-weight: 700;   margin-bottom: 12px; }  .feature-desc {   color: var(--text-muted);   font-size: 0.95rem; }  .comparison {   display: grid;   grid-template-columns: 1fr 1fr;   gap: 30px;   margin-top: 40px; }  .comparison-box {   background: rgba(255,255,255,.02);   border: 1px solid rgba(124,58,237,.2);   padding: 30px;   border-radius: var(--radius); }  .comparison-box h3 {   font-size: 1.2rem;   margin-bottom: 20px;   color: var(--accent); }  .comparison-item {   display: flex;   gap: 10px;   margin-bottom: 15px;   font-size: 0.95rem; }  .eco-grid {   display: grid;   grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));   gap: 20px;   margin-top: 40px; }  .eco-box {   background: rgba(255,255,255,.02);   border: 1px solid rgba(124,58,237,.2);   padding: 25px;   border-radius: var(--radius);   text-align: center; }  .eco-title {   font-weight: 700;   margin-bottom: 10px;   color: var(--accent); }  .eco-desc {   font-size: 0.9rem;   color: var(--text-muted); }  footer {   background: rgba(0,0,0,.3);   border-top: 1px solid rgba(124,58,237,.2);   padding: 40px;   text-align: center;   color: var(--text-muted); }  .cta-footer {   text-align: center;   margin-bottom: 40px; }  .cta-footer h2 {   margin-bottom: 20px; }  @media (max-width: 768px) {   nav {     padding: 0 20px;   }    .section {     padding: 40px 20px;   }    .section.hero {     padding: 80px 20px;   }    h1 {     font-size: clamp(2rem, 6vw, 4rem);   }    .hero-orb {     width: 150px;     height: 150px;   }    .comparison {     grid-template-columns: 1fr;   } }</style>")

; 다크모드 토글 — localStorage 기반 영구 저장
(define DARK-MODE-SCRIPT
  "<script>(function(){
var root=document.documentElement;
var btn=document.getElementById('dark-btn');
var DARK='fl-dark';
function apply(dark){
  root.style.colorScheme=dark?'dark':'light';
  if(btn){btn.textContent=dark?'☀️':'🌙';btn.style.color=dark?'#fbbf24':'#94a3b8';}
}
apply(localStorage.getItem(DARK)==='1');
if(btn){btn.addEventListener('click',function(){
  var next=root.style.colorScheme!=='dark';
  localStorage.setItem(DARK,next?'1':'0');
  apply(next);
});}
})()</script>")

; HMR 클라이언트 스크립트
(define HMR-SCRIPT
  "<script>(function(){var es=new EventSource('http://'+location.hostname+':40851/~hmr');es.onmessage=function(e){if(e.data==='reload')location.reload();};es.onerror=function(){setTimeout(function(){es.close();},5000);};})()</script>")

; FL DevTools — dev 전용 floating 디버그 패널
; store 현재값 · Island 마운트 목록 · 최근 에러 표시
; 단축키: Ctrl+Shift+D
(define DEBUG-PANEL
  "<script>(function(){
var isDev=location.hostname==='localhost'||location.hostname==='127.0.0.1';
if(!isDev)return;
var islands={};
var errors=[];
var open=false;

function waitFl(cb){if(window._fl){cb();}else{setTimeout(function(){waitFl(cb);},80);}}

waitFl(function(){
  var omR=_fl.mount_reactive.bind(_fl);
  var omM=_fl.mount.bind(_fl);
  var odD=_fl.dispatch.bind(_fl);
  _fl.mount=function(id,fn){
    islands[id]={id:id,watch:null};
    if(open)render();
    return omM(id,fn);
  };
  _fl.mount_reactive=function(id,fn,keys){
    islands[id]={id:id,watch:keys};
    if(open)render();
    return omR(id,fn,keys);
  };
  _fl.dispatch=function(k,v){
    var r=odD(k,v);
    if(open)render();
    return r;
  };
});

function fetchErrors(){
  fetch('/api/errors?limit=5')
    .then(function(r){return r.json();})
    .then(function(d){errors=(d.data||d||[]).slice(0,5);render();})
    .catch(function(){});
}

function esc(s){return String(s).replace(/</g,'&lt;').replace(/>/g,'&gt;');}

function render(){
  if(!open||!panel)return;
  var store=window._fl?window._fl._store.v:{};
  var sk=Object.keys(store);
  var ik=Object.keys(islands);
  var sec=function(title,n,body){
    return '<div style=\"padding:10px 16px;border-top:1px solid #2d3748\">'+
      '<div style=\"color:#94a3b8;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px\">'+title+' ('+n+')</div>'+
      body+'</div>';
  };
  var storeHtml=sk.length===0?'<div style=\"color:#4a5568\">비어있음</div>':
    sk.map(function(k){
      return '<div style=\"display:flex;justify-content:space-between;padding:2px 0;border-bottom:1px solid #2d3748\">'+
        '<span style=\"color:#a78bfa\">'+esc(k)+'</span>'+
        '<span style=\"color:#34d399\">'+esc(JSON.stringify(store[k]).slice(0,28))+'</span></div>';
    }).join('');
  var islandHtml=ik.length===0?'<div style=\"color:#4a5568\">없음</div>':
    ik.map(function(id){
      var w=islands[id].watch;
      return '<div style=\"padding:2px 0;border-bottom:1px solid #2d3748\">'+
        '<span style=\"color:#60a5fa\">'+esc(id)+'</span>'+
        (w?'<span style=\"color:#94a3b8\"> ↺['+w.join(',')+']</span>':'')+
        '</div>';
    }).join('');
  var errHtml=errors.length===0?'<div style=\"color:#4a5568\">없음 ✓</div>':
    errors.map(function(e){
      return '<div style=\"padding:2px 0;border-bottom:1px solid #2d3748;color:#f87171\">'+esc((e.message||'').slice(0,52))+'</div>';
    }).join('');
  panel.innerHTML=
    '<div style=\"padding:10px 16px;display:flex;justify-content:space-between;align-items:center\">'+
      '<span style=\"font-weight:700;color:#818cf8;font-size:.82rem\">🔧 FL DevTools</span>'+
      '<button id=\"fl-dp-x\" style=\"background:none;border:none;color:#94a3b8;cursor:pointer;font-size:1.1rem;line-height:1\">×</button>'+
    '</div>'+
    sec('Store',sk.length,storeHtml)+
    sec('Islands',ik.length,islandHtml)+
    sec('Errors',errors.length,errHtml);
  document.getElementById('fl-dp-x').onclick=toggle;
}

var btn=document.createElement('button');
btn.title='FL DevTools (Ctrl+Shift+D)';
btn.textContent='🔧';
btn.style.cssText='position:fixed;bottom:16px;right:16px;z-index:9999;width:36px;height:36px;border-radius:50%;background:#6366f1;color:white;border:none;font-size:1rem;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.35);transition:background .15s;';

var panel=document.createElement('div');
panel.style.cssText='display:none;position:fixed;bottom:60px;right:16px;z-index:9998;width:300px;max-height:440px;overflow-y:auto;background:#1e2433;color:#e2e8f0;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.5);font-family:monospace;font-size:.76rem;';

document.body.appendChild(btn);
document.body.appendChild(panel);

function toggle(){
  open=!open;
  panel.style.display=open?'block':'none';
  btn.style.background=open?'#4f46e5':'#6366f1';
  if(open){fetchErrors();render();}
}

btn.onclick=toggle;
document.addEventListener('keydown',function(e){
  if(e.ctrlKey&&e.shiftKey&&e.key==='D'){e.preventDefault();toggle();}
});
setInterval(function(){if(open)fetchErrors();},3000);
})()</script>")

; 브라우저 에러 수집 (개발: 40851/~errors, 프로덕션: /api/errors)
; v0.2.1: 프로덕션 에러 리포팅 추가
(define ERROR-COLLECTOR
  "<script>(function(){
var isDev=location.hostname==='localhost' || location.hostname==='127.0.0.1';
var EVs=[
  isDev ? 'http://'+location.hostname+':40851/~errors' : null,
  '/api/errors'
].filter(function(u){return u;});

function send(type,msg,src,line,stack){
  var payload={type:type,message:String(msg),source:src,line:line,stack:String(stack||''),url:location.href};
  EVs.forEach(function(url){
    fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).catch(function(){});
  });
}

window.onerror=function(m,s,l,c,e){send('error',m,s,l,c,e&&e.stack);return false;};
window.addEventListener('unhandledrejection',function(e){send('promise',e.reason&&e.reason.message||String(e.reason),'',0,0,e.reason&&e.reason.stack);});
var _ce=console.error.bind(console);
console.error=function(){_ce.apply(console,arguments);send('console',Array.from(arguments).join(' '),'',0,0,'');};
})()</script>")

; 성능 모니터링 스크립트 — 서킷 브레이커 탑재 (dec-009)
; v0.3.0: 서킷 브레이커(timeout 500ms, 3회 실패→OPEN 30초)
(define PERFORMANCE-MONITOR
  "<script>(function(){
var perfStart=performance.now();
var apiCallStart={};
var routeTransitionStart=null;

// ── 서킷 브레이커 (dec-009) ──────────────────────────────────
var CB={
  state:'closed',      // closed | open | half-open
  failures:0,
  FAIL_THRESHOLD:3,
  TIMEOUT_MS:500,
  RESET_MS:30000,
  openedAt:null
};

function cbSend(payload){
  if(CB.state==='open'){
    var elapsed=Date.now()-CB.openedAt;
    if(elapsed>CB.RESET_MS){
      CB.state='half-open';
      console.log('[circuit] half-open — 재시도');
    } else {
      return; // 차단
    }
  }
  var ctrl=new AbortController();
  var timer=setTimeout(function(){ctrl.abort();},CB.TIMEOUT_MS);
  fetch('/api/metrics',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(payload),
    signal:ctrl.signal
  }).then(function(){
    clearTimeout(timer);
    if(CB.state==='half-open'){
      CB.state='closed'; CB.failures=0;
      console.log('[circuit] closed — 복구');
    }
  }).catch(function(e){
    clearTimeout(timer);
    CB.failures++;
    if(CB.failures>=CB.FAIL_THRESHOLD&&CB.state!=='open'){
      CB.state='open'; CB.openedAt=Date.now();
      console.warn('[circuit] open — 모니터링 일시 중단 (30s)');
    } else if(CB.state==='half-open'){
      CB.state='open'; CB.openedAt=Date.now();
    }
  });
}
// ─────────────────────────────────────────────────────────────

// 1️⃣  페이지 로드 시간
window.addEventListener('load',function(){
  var loadTime=performance.now()-perfStart;
  cbSend({metric:'page-load',value:Math.round(loadTime),unit:'ms'});
});

// 2️⃣  API 응답 시간 추적 (모니터링 자신 제외)
var origFetch=window.fetch;
window.fetch=function(){
  var args=Array.from(arguments);
  var url=String(args[0]||'');
  if(url.indexOf('/api/metrics')===0) return origFetch.apply(this,args);
  var callId=Math.random().toString(36);
  apiCallStart[callId]=performance.now();
  return origFetch.apply(this,args).then(function(r){
    var elapsed=Math.round(performance.now()-apiCallStart[callId]);
    cbSend({metric:'api-call',value:elapsed,unit:'ms',endpoint:url.split('?')[0]});
    return r;
  }).catch(function(e){
    var elapsed=Math.round(performance.now()-apiCallStart[callId]);
    cbSend({metric:'api-error',value:elapsed,unit:'ms',error:String(e)});
    throw e;
  });
};

// 3️⃣  라우트 전환 시간 (SPA 네비게이션)
var origPushState=history.pushState;
history.pushState=function(){
  if(routeTransitionStart!==null){
    var elapsed=Math.round(performance.now()-routeTransitionStart);
    cbSend({metric:'route-transition',value:elapsed,unit:'ms',href:location.pathname});
    routeTransitionStart=null;
  }
  return origPushState.apply(this,arguments);
};

// SPA 라우트 시작 감지
document.addEventListener('click',function(e){
  var a=e.target.closest('[data-spa]');
  if(a){routeTransitionStart=performance.now();}
});

// 4️⃣  Long Task 감지 (Performance Observer)
if(window.PerformanceObserver){
  try{
    var longTaskObs=new PerformanceObserver(function(list){
      list.getEntries().forEach(function(entry){
        if(entry.duration>50){
          cbSend({metric:'long-task',value:Math.round(entry.duration),unit:'ms'});
        }
      });
    });
    longTaskObs.observe({entryTypes:['longtask']});
  }catch(e){}
}

// 5️⃣  메모리 모니터링 (5초마다)
if(performance.memory){
  setInterval(function(){
    var used=Math.round(performance.memory.usedJSHeapSize/1048576);
    cbSend({metric:'memory',value:used,unit:'MB'});
  },5000);
}
})()</script>")

; SPA 클라이언트 라우터 — View Transitions API 적용
(define SPA-ROUTER
  "<script>(function(){
function doNav(href){
  return fetch(href,{headers:{'X-SPA':'1'}})
    .then(function(r){return r.text();})
    .then(function(html){
      var doc=new DOMParser().parseFromString(html,'text/html');
      var nw=doc.querySelector('[class*=\"layout_wrap\"]');
      var cw=document.querySelector('[class*=\"layout_wrap\"]');
      if(nw&&cw)cw.innerHTML=nw.innerHTML;
      doc.querySelectorAll('script:not([src])').forEach(function(s){
        if(s.textContent.indexOf('_fl.')>-1){try{eval(s.textContent);}catch(e){}}
      });
      if(window._fl)window._fl.dispatch('route',href);
      history.pushState({href:href},'',href);
      window.scrollTo(0,0);
    })
    .catch(function(){location.href=href;});
}
function spa(href){
  if(document.startViewTransition){
    document.startViewTransition(function(){return doNav(href);});
  }else{
    doNav(href);
  }
}
document.addEventListener('click',function(e){
  var a=e.target.closest('[data-spa]');
  if(!a)return;
  e.preventDefault();
  spa(a.getAttribute('href'));
});
window.addEventListener('popstate',function(e){
  var href=e.state&&e.state.href?e.state.href:location.pathname;
  spa(href);
});
})()</script>")

; ── SEO meta 태그 생성 ──
; 사용: (seo-tags {:title "제목" :desc "설명" :image "/og.png" :type "article"})
(defn seo-tags [m]
  (let [title  (if (= (get m "title") nil) "" (str (get m "title")))
        desc   (if (= (get m "desc") nil) "" (str (get m "desc")))
        image  (get m "image")
        type   (if (= (get m "type") nil) "website" (str (get m "type")))
        url    (if (= (get m "url") nil) "" (str (get m "url")))]
    (str
      (h! "meta" {:name "description" :content desc})
      (h! "meta" {:property "og:title" :content title})
      (h! "meta" {:property "og:description" :content desc})
      (h! "meta" {:property "og:type" :content type})
      (if (= image nil) "" (h! "meta" {:property "og:image" :content (str image)}))
      (if (= url "") "" (h! "meta" {:property "og:url" :content url}))
      (h! "meta" {:name "twitter:card" :content "summary_large_image"})
      (h! "meta" {:name "twitter:title" :content title})
      (h! "meta" {:name "twitter:description" :content desc})
      (if (= image nil) "" (h! "meta" {:name "twitter:image" :content (str image)})))))

; 공통 레이아웃 → HTML 문자열 (meta-str: seo-tags 결과 또는 nil)
(defn layout-core [title content req meta-str]
  (let [path (server-req-path req)]
    (str
      "<!DOCTYPE html>"
      (h "html" {:lang "ko"}
        (str
          (h "head" {}
            (str
              (h! "meta" {:charset "utf-8"})
              (h! "meta" {:name "viewport" :content "width=device-width,initial-scale=1"})
              (h "title" {} (str title " — FreeLang Front"))
              (if (= meta-str nil) "" meta-str)
              GLOBAL-CSS))
          (h "body" {}
            (str
              (h "nav" {:class layout_nav}
                (str
                  (h "a" {:href "/" :class nav-brand} "FL Front")
                  (nav-link "/" "홈" path)
                  (nav-link "/dashboard" "대시보드" path)
                  (nav-link "/counter" "카운터" path)
                  (nav-link "/contact" "문의" path)
                  (nav-link "/styled" "스타일" path)
                  (nav-link "/todo" "To-do" path)
                  (nav-link "/notes" "Notes" path)
                  (nav-link "/about" "About" path)
                  (h "a" {:href "/logout" :class nav-link-base :style "opacity:.8;margin-left:auto"} "로그아웃")
                  (h "button" {:id "dark-btn" :title "다크모드" :style "background:none;border:1px solid rgba(255,255,255,.2);color:#94a3b8;border-radius:6px;padding:5px 10px;font-size:.85rem;cursor:pointer;margin-left:8px;transition:all .15s;flex-shrink:0"} "🌙")))
              (h "div" {:class layout_wrap} content)
              (h "footer" {:class layout_foot} "FreeLang Front v0.1 · npm install 0개 · SSR · Island")
              ERROR-COLLECTOR
              PERFORMANCE-MONITOR
              SPA-ROUTER
              DARK-MODE-SCRIPT
              HMR-SCRIPT
              DEBUG-PANEL)))))))

; layout — 기존 호환 유지
(defn layout [title content req]
  (layout-core title content req nil))

; layout-html — server-html + DEV CSP
(defn layout-html [title content req]
  (server_header
    (server-html (layout title content req))
    "Content-Security-Policy" DEV-CSP))

; layout-html-seo — SEO meta 포함 버전
; 사용: (layout-html-seo "제목" content req {:title "..." :desc "..." :image "/og.png"})
(defn layout-html-seo [title content req seo-opts]
  (server_header
    (server-html (layout-core title content req (seo-tags seo-opts)))
    "Content-Security-Policy" DEV-CSP))

; ── _db.flx ──
; pages/_db.flx — SQLite DB 연결 헬퍼
; DB 설정 — data/app.db
(define DB {:type "sqlite" :path "data/app.db"})

; 마이그레이션 — 서버 시작 시 자동 실행
(defn db-migrate []
  (db-exec DB "CREATE TABLE IF NOT EXISTS sessions (
    id TEXT PRIMARY KEY,
    username TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS stats (
    id INTEGER PRIMARY KEY,
    users INTEGER DEFAULT 0,
    revenue INTEGER DEFAULT 0,
    orders INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS monthly_stats (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    label TEXT NOT NULL,
    value INTEGER NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  ; 초기 데이터 없으면 삽입
  (let [existing (db-query DB "SELECT id FROM stats LIMIT 1" [])]
    (if (= (length existing) 0)
      (do
        (db-exec DB "INSERT INTO stats (id, users, revenue, orders) VALUES (1, 1247, 23450000, 892)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('1월', 1200)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('2월', 1800)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('3월', 2100)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('4월', 1700)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('5월', 2400)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('6월', 2800)" []))
      nil)))

; DB에서 대시보드 통계 조회
(defn db-fetch-stats []
  (let [rows    (db-query DB "SELECT * FROM stats WHERE id = 1" [])
        monthly (db-query DB "SELECT label, value FROM monthly_stats ORDER BY id" [])
        weekly  [{:label "월" :value 320}
                 {:label "화" :value 410}
                 {:label "수" :value 290}
                 {:label "목" :value 500}
                 {:label "금" :value 460}
                 {:label "토" :value 230}
                 {:label "일" :value 180}]]
    (if (= (length rows) 0)
      {:users 0 :revenue 0 :orders 0 :monthly [] :weekly weekly}
      (let [row (first rows)]
        {:users   (get row "users")
         :revenue (get row "revenue")
         :orders  (get row "orders")
          ; SQLite string key → keyword key 변환 (chart-bar 호환)
         :monthly (map (fn [r] {:label (get r "label") :value (get r "value")}) monthly)
         :weekly  weekly}))))

; 마이그레이션 즉시 실행
(db-migrate)

; ── _auth.flx ──
; pages/_auth.flx — 쿠키 세션 인증 헬퍼
; 데모 계정: admin / admin123

(define COOKIE_NAME "fl_session")
(define DEMO_USER "admin")
(define DEMO_PASS "admin123")

; 쿠키에서 세션 ID 읽기
(defn auth-session-id [req]
  (server-req-cookie req COOKIE_NAME))

; 세션 유효성 검사 → username 또는 nil
(defn auth-check [req]
  (let [sid (auth-session-id req)]
    (if sid
      (let [rows (db-query DB "SELECT username FROM sessions WHERE id = ?" [sid])]
        (if (> (length rows) 0)
          (get (first rows) "username")
          nil))
      nil)))

; 로그인 → 세션 생성 + 쿠키 문자열 반환 (실패 시 nil)
(defn auth-login [username password]
  (if (and (= username DEMO_USER) (= password DEMO_PASS))
    (let [sid (uuid)]
      (db-exec DB "INSERT INTO sessions (id, username) VALUES (?, ?)" [sid username])
      (server-set-cookie COOKIE_NAME sid {:max_age 86400 :secure false}))
    nil))

; 로그아웃 → 세션 삭제 + 만료 쿠키 문자열 반환
(defn auth-logout [req]
  (let [sid (auth-session-id req)]
    (if sid
      (db-exec DB "DELETE FROM sessions WHERE id = ?" [sid])
      nil)
    (server-set-cookie COOKIE_NAME "" {:max_age 0 :secure false})))

; 인증 필요 라우트 가드 — 미인증 시 /login redirect
(defn auth-required [req handler]
  (let [user (auth-check req)]
    (if user
      (handler user)
      (server-redirect "/login"))))

; ── _error.flx ──
; pages/_error.flx — 에러 페이지 헬퍼
; (page-404 req) → server-html 404 응답
; (page-500 msg req) → server-html 500 응답

(defn page-404 [req]
  (server-status 404
    (layout "404 — 페이지를 찾을 수 없음" (str
      "<div style='text-align:center;padding:48px 0'>"
      "<div style='font-size:5rem;margin-bottom:16px'>🔍</div>"
      "<h2 style='font-size:2rem;font-weight:800;color:#111;margin:0 0 12px'>404</h2>"
      "<p style='color:#6b7280;font-size:1.1rem;margin:0 0 32px'>페이지를 찾을 수 없습니다</p>"
      "<a href='/' style='background:#6366f1;color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none'>← 홈으로</a>"
      "</div>") req)))

(defn page-500 [msg req]
  (server-status 500
    (layout "500 — 서버 오류" (str
      "<div style='text-align:center;padding:48px 0'>"
      "<div style='font-size:5rem;margin-bottom:16px'>💥</div>"
      "<h2 style='font-size:2rem;font-weight:800;color:#111;margin:0 0 12px'>500</h2>"
      "<p style='color:#6b7280;font-size:1.1rem;margin:0 0 8px'>서버에서 오류가 발생했습니다</p>"
      "<p style='color:#9ca3af;font-size:.85rem;font-family:monospace;margin:0 0 32px'>" msg "</p>"
      "<a href='/' style='background:#6366f1;color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none'>← 홈으로</a>"
      "</div>") req)))

; 와일드카드 핸들러 — 등록되지 않은 모든 경로
(defn not-found-handler [req]
  (page-404 req))

; ── _charts.flx ──
; pages/_charts.flx — SVG 차트 DSL 헬퍼
; (chart-bar data w h) : [{:label "A" :value 40} ...] → SVG 문자열
; (chart-line data w h): [{:label "A" :value 40} ...] → SVG 문자열

; 막대 차트
(defn chart-bar [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        bar-w   (- (/ inner-w n) 6)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  bar-h (round (* inner-h (/ val max-v)))
                  x     (+ pad (* i (+ bar-w 6)))
                  y     (+ pad (- inner-h bar-h))]
              (str
                "<rect x='" x "' y='" y "' width='" bar-w "' height='" bar-h
                "' fill='#6366f1' rx='3' opacity='0.85'/>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (- y 4)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

; 선 차트
(defn chart-line [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        min-v   (reduce (fn [a b] (if (< a b) a b)) max-v values)
        range-v (if (= max-v min-v) 1 (- max-v min-v))
        step-x  (if (= n 1) inner-w (/ inner-w (- n 1)))
        ; 포인트 좌표 계산
        points  (map-indexed
                  (fn [i d]
                    (let [val (get d :value)
                          cx  (+ pad (* i step-x))
                          cy  (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
                      (str cx "," cy)))
                  data)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      ; 그라데이션 영역 (fill)
      "<defs><linearGradient id='grad' x1='0' y1='0' x2='0' y2='1'>"
      "<stop offset='0%' stop-color='#6366f1' stop-opacity='0.2'/>"
      "<stop offset='100%' stop-color='#6366f1' stop-opacity='0'/>"
      "</linearGradient></defs>"
      "<polyline points='"
      (reduce str "" (map (fn [p] (str p " ")) points))
      "' fill='none' stroke='#6366f1' stroke-width='2.5' stroke-linejoin='round'/>"
      ; 데이터 포인트 + 레이블
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  cx    (+ pad (* i step-x))
                  cy    (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
              (str
                "<circle cx='" cx "' cy='" cy "' r='4' fill='#6366f1'/>"
                "<text x='" cx "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" cx "' y='" (- cy 8)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

; ── _email.flx ──
; pages/_email.flx — 이메일 발송 라이브러리
; 지원: SendGrid API / Mailgun API / SMTP (via API)
;
; 환경변수 (.env):
;   EMAIL_PROVIDER=sendgrid       # sendgrid | mailgun
;   SENDGRID_API_KEY=SG.xxx
;   SENDGRID_FROM=noreply@example.com
;   MAILGUN_API_KEY=key-xxx
;   MAILGUN_DOMAIN=mg.example.com
;   MAILGUN_FROM=noreply@example.com
;
; 사용 예:
;   (email-send "user@example.com" "가입 확인" "안녕하세요")
;   (email-html "user@example.com" "영수증" "<h1>결제 완료</h1>")
;   (email-template "user@example.com" "welcome" {"name" "홍길동"})

; ── 설정 ──────────────────────────────────────────────────────

(define EMAIL-PROVIDER (fl-env-get "EMAIL_PROVIDER"))
(define SG-KEY         (fl-env-get "SENDGRID_API_KEY"))
(define SG-FROM        (fl-env-get "SENDGRID_FROM"))
(define MG-KEY         (fl-env-get "MAILGUN_API_KEY"))
(define MG-DOMAIN      (fl-env-get "MAILGUN_DOMAIN"))
(define MG-FROM        (fl-env-get "MAILGUN_FROM"))

; ── SendGrid ──────────────────────────────────────────────────

(defn sg-send [$to $subject $text $html]
  (let [$body {"personalizations" [{"to" [{"email" $to}]}]
               "from"            {"email" SG-FROM}
               "subject"         $subject
               "content"         (if $html
                                   [{"type" "text/plain" "value" $text}
                                    {"type" "text/html"  "value" $html}]
                                   [{"type" "text/plain" "value" $text}])}
        $res  (http_post_json
                "https://api.sendgrid.com/v3/mail/send"
                $body
                {"Authorization" (str "Bearer " SG-KEY)
                 "Content-Type"  "application/json"})]
    {"ok"     (http_ok? $res)
     "status" (http_status $res)}))

; SendGrid 템플릿 발송
(defn sg-template [$to $template-id $data]
  (let [$body {"personalizations" [{"to"                  [{"email" $to}]
                                    "dynamic_template_data" $data}]
               "from"             {"email" SG-FROM}
               "template_id"      $template-id}
        $res  (http_post_json
                "https://api.sendgrid.com/v3/mail/send"
                $body
                {"Authorization" (str "Bearer " SG-KEY)
                 "Content-Type"  "application/json"})]
    {"ok" (http_ok? $res)}))

; ── Mailgun ───────────────────────────────────────────────────

(defn mg-send [$to $subject $text $html]
  (let [$auth (str "Basic " (base64_encode (str "api:" MG-KEY)))
        $url  (str "https://api.mailgun.net/v3/" MG-DOMAIN "/messages")
        $body (str "from=" MG-FROM
                   "&to=" $to
                   "&subject=" $subject
                   "&text=" $text
                   (if $html (str "&html=" $html) ""))
        $res  (http_post_form $url $body)]
    {"ok"     (http_ok? $res)
     "id"     (get (json_parse (get $res :body)) "id")}))

; ── 통합 인터페이스 ───────────────────────────────────────────

; 일반 텍스트 이메일
(defn email-send [$to $subject $text]
  (if (= EMAIL-PROVIDER "mailgun")
    (mg-send $to $subject $text nil)
    (sg-send $to $subject $text nil)))

; HTML 이메일
(defn email-html [$to $subject $html]
  (let [$text (str-replace-in $html "<[^>]+>" "")]
    (if (= EMAIL-PROVIDER "mailgun")
      (mg-send $to $subject $text $html)
      (sg-send $to $subject $text $html))))

; SendGrid 템플릿
(defn email-template [$to $template-id $data]
  (sg-template $to $template-id $data))

; ── 자주 쓰는 이메일 템플릿 ──────────────────────────────────

; 회원가입 환영 메일
(defn email-welcome [$to $name]
  (email-html $to
    "환영합니다!"
    (str "<h1>안녕하세요, " $name "님!</h1>"
         "<p>가입해주셔서 감사합니다.</p>"
         "<p>지금 바로 서비스를 이용해보세요.</p>")))

; 비밀번호 재설정 메일
(defn email-reset-password [$to $reset-link]
  (email-html $to
    "비밀번호 재설정"
    (str "<h1>비밀번호 재설정</h1>"
         "<p>아래 링크를 클릭하여 비밀번호를 재설정하세요.</p>"
         "<p><a href='" $reset-link "' style='background:#6366f1;color:white;"
         "padding:12px 24px;border-radius:6px;text-decoration:none;"
         "display:inline-block'>비밀번호 재설정</a></p>"
         "<p style='color:#9ca3af;font-size:.85rem'>링크는 1시간 동안 유효합니다.</p>")))

; 결제 완료 메일
(defn email-payment-done [$to $name $amount $order-id]
  (email-html $to
    (str "결제 완료 · ₩" $amount)
    (str "<h1>결제가 완료되었습니다</h1>"
         "<table style='border-collapse:collapse;width:100%'>"
         "<tr><td style='padding:8px;border:1px solid #e5e7eb'>주문번호</td>"
         "<td style='padding:8px;border:1px solid #e5e7eb'>" $order-id "</td></tr>"
         "<tr><td style='padding:8px;border:1px solid #e5e7eb'>결제금액</td>"
         "<td style='padding:8px;border:1px solid #e5e7eb'>₩" $amount "</td></tr>"
         "</table>")))

; 인증 코드 메일
(defn email-otp [$to $code]
  (email-html $to
    "인증 코드"
    (str "<h1>인증 코드</h1>"
         "<p>아래 코드를 입력하세요. (5분 유효)</p>"
         "<div style='font-size:2rem;font-weight:800;letter-spacing:.2em;"
         "background:#f3f4f6;padding:20px;border-radius:8px;text-align:center;"
         "margin:20px 0'>" $code "</div>")))

; ── _oauth.flx ──
; pages/_oauth.flx — OAuth2 소셜 로그인 라이브러리
; 지원: Google / Kakao / GitHub / Naver
;
; 환경변수 (.env):
;   OAUTH_REDIRECT_BASE=https://myapp.com
;   GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
;   GOOGLE_CLIENT_SECRET=GOCSPX-xxx
;   KAKAO_CLIENT_ID=xxx
;   KAKAO_CLIENT_SECRET=xxx
;   GITHUB_CLIENT_ID=xxx
;   GITHUB_CLIENT_SECRET=xxx
;   NAVER_CLIENT_ID=xxx
;   NAVER_CLIENT_SECRET=xxx
;
; 사용 예:
;   ; 1. 로그인 URL로 redirect
;   (server-redirect (oauth-google-url "/auth/google/callback"))
;
;   ; 2. 콜백에서 사용자 정보 받기
;   (let [user (oauth-google-callback code "/auth/google/callback")]
;     (if (get user "ok")
;       (let [email (get user "email")] ...)
;       (server-redirect "/login?error=oauth")))

; ── 설정 ──────────────────────────────────────────────────────

(define OAUTH-BASE      (fl-env-get "OAUTH_REDIRECT_BASE"))
(define GOOGLE-ID       (fl-env-get "GOOGLE_CLIENT_ID"))
(define GOOGLE-SECRET   (fl-env-get "GOOGLE_CLIENT_SECRET"))
(define KAKAO-ID        (fl-env-get "KAKAO_CLIENT_ID"))
(define KAKAO-SECRET    (fl-env-get "KAKAO_CLIENT_SECRET"))
(define GITHUB-ID       (fl-env-get "GITHUB_CLIENT_ID"))
(define GITHUB-SECRET   (fl-env-get "GITHUB_CLIENT_SECRET"))
(define NAVER-ID        (fl-env-get "NAVER_CLIENT_ID"))
(define NAVER-SECRET    (fl-env-get "NAVER_CLIENT_SECRET"))

; ── Google OAuth ──────────────────────────────────────────────

; Google 로그인 URL 생성
(defn oauth-google-url [$redirect-path]
  (str "https://accounts.google.com/o/oauth2/v2/auth"
       "?client_id=" GOOGLE-ID
       "&redirect_uri=" OAUTH-BASE $redirect-path
       "&response_type=code"
       "&scope=openid%20email%20profile"
       "&access_type=offline"
       "&prompt=select_account"))

; Google 콜백 처리 → 사용자 정보 반환
(defn oauth-google-callback [$code $redirect-path]
  (let [; 1. code → access_token 교환
        $token-res (http_post_json
                     "https://oauth2.googleapis.com/token"
                     {"code"          $code
                      "client_id"     GOOGLE-ID
                      "client_secret" GOOGLE-SECRET
                      "redirect_uri"  (str OAUTH-BASE $redirect-path)
                      "grant_type"    "authorization_code"}
                     {"Content-Type" "application/json"})]
    (if (not (http_ok? $token-res))
      {"ok" false "error" "token_exchange_failed"}
      ; 2. access_token → 사용자 정보
      (let [$token   (get (http_body $token-res) "access_token")
            $user-res (http_get_json
                        "https://www.googleapis.com/oauth2/v2/userinfo"
                        {"Authorization" (str "Bearer " $token)})]
        (if (not (http_ok? $user-res))
          {"ok" false "error" "userinfo_failed"}
          (let [$user (http_body $user-res)]
            {"ok"      true
             "email"   (get $user "email")
             "name"    (get $user "name")
             "picture" (get $user "picture")
             "id"      (get $user "id")
             "provider" "google"}))))))

; ── Kakao OAuth ───────────────────────────────────────────────

(defn oauth-kakao-url [$redirect-path]
  (str "https://kauth.kakao.com/oauth/authorize"
       "?client_id=" KAKAO-ID
       "&redirect_uri=" OAUTH-BASE $redirect-path
       "&response_type=code"))

(defn oauth-kakao-callback [$code $redirect-path]
  (let [; 1. code → access_token
        $token-res (http_post_form
                     "https://kauth.kakao.com/oauth/token"
                     (str "grant_type=authorization_code"
                          "&client_id=" KAKAO-ID
                          "&client_secret=" KAKAO-SECRET
                          "&redirect_uri=" OAUTH-BASE $redirect-path
                          "&code=" $code))]
    (if (not (http_ok? $token-res))
      {"ok" false "error" "token_exchange_failed"}
      (let [$token    (get (json_parse (get $token-res :body)) "access_token")
            ; 2. access_token → 사용자 정보
            $user-res (http_get_json
                        "https://kapi.kakao.com/v2/user/me"
                        {"Authorization" (str "Bearer " $token)})]
        (if (not (http_ok? $user-res))
          {"ok" false "error" "userinfo_failed"}
          (let [$user    (http_body $user-res)
                $kakao   (get $user "kakao_account")
                $profile (get $kakao "profile")]
            {"ok"      true
             "email"   (get $kakao "email")
             "name"    (get $profile "nickname")
             "picture" (get $profile "profile_image_url")
             "id"      (str (get $user "id"))
             "provider" "kakao"}))))))

; ── GitHub OAuth ──────────────────────────────────────────────

(defn oauth-github-url [$redirect-path]
  (str "https://github.com/login/oauth/authorize"
       "?client_id=" GITHUB-ID
       "&redirect_uri=" OAUTH-BASE $redirect-path
       "&scope=user:email"))

(defn oauth-github-callback [$code $redirect-path]
  (let [; 1. code → access_token
        $token-res (http_post_json
                     "https://github.com/login/oauth/access_token"
                     {"client_id"     GITHUB-ID
                      "client_secret" GITHUB-SECRET
                      "code"          $code
                      "redirect_uri"  (str OAUTH-BASE $redirect-path)}
                     {"Accept"       "application/json"
                      "Content-Type" "application/json"})]
    (if (not (http_ok? $token-res))
      {"ok" false "error" "token_exchange_failed"}
      (let [$token    (get (http_body $token-res) "access_token")
            ; 2. 사용자 정보
            $user-res (http_get_json
                        "https://api.github.com/user"
                        {"Authorization" (str "Bearer " $token)
                         "User-Agent"    "fl-front"})]
        (if (not (http_ok? $user-res))
          {"ok" false "error" "userinfo_failed"}
          (let [$user (http_body $user-res)]
            {"ok"      true
             "email"   (get $user "email")
             "name"    (get $user "name")
             "picture" (get $user "avatar_url")
             "id"      (str (get $user "id"))
             "provider" "github"}))))))

; ── Naver OAuth ───────────────────────────────────────────────

(defn oauth-naver-url [$redirect-path $state]
  (str "https://nid.naver.com/oauth2.0/authorize"
       "?response_type=code"
       "&client_id=" NAVER-ID
       "&redirect_uri=" OAUTH-BASE $redirect-path
       "&state=" $state))

(defn oauth-naver-callback [$code $state $redirect-path]
  (let [$token-res (http_post_json
                     "https://nid.naver.com/oauth2.0/token"
                     {"grant_type"    "authorization_code"
                      "client_id"     NAVER-ID
                      "client_secret" NAVER-SECRET
                      "code"          $code
                      "state"         $state}
                     {"Content-Type" "application/json"})]
    (if (not (http_ok? $token-res))
      {"ok" false "error" "token_exchange_failed"}
      (let [$token    (get (http_body $token-res) "access_token")
            $user-res (http_get_json
                        "https://openapi.naver.com/v1/nid/me"
                        {"Authorization" (str "Bearer " $token)})]
        (if (not (http_ok? $user-res))
          {"ok" false "error" "userinfo_failed"}
          (let [$user (get (http_body $user-res) "response")]
            {"ok"      true
             "email"   (get $user "email")
             "name"    (get $user "name")
             "picture" (get $user "profile_image")
             "id"      (get $user "id")
             "provider" "naver"}))))))

; ── 통합 헬퍼 ────────────────────────────────────────────────

; 어떤 provider든 DB upsert하는 패턴
; user = {"ok" true "email" "..." "name" "..." "provider" "google"}
(defn oauth-upsert-user [$provider-user]
  (if (not (get $provider-user "ok"))
    nil
    (let [$email    (get $provider-user "email")
          $name     (get $provider-user "name")
          $provider (get $provider-user "provider")
          $existing (db-query DB
                      "SELECT id FROM users WHERE email = ?" [$email])]
      (if (> (length $existing) 0)
        ; 기존 사용자 → 로그인
        (get (first $existing) "id")
        ; 신규 사용자 → 자동 가입
        (let [$_ (db-exec DB
                   "INSERT INTO users (email, name, provider, created_at) VALUES (?,?,?,datetime('now'))"
                   [$email $name $provider])]
          (get (first (db-query DB "SELECT id FROM users WHERE email = ?" [$email])) "id"))))))

; ── _payment.flx ──
; pages/_payment.flx — 결제 라이브러리
; 지원: Toss Payments (한국 표준) + 포트원(구 아임포트)
;
; 환경변수 (.env):
;   TOSS_SECRET_KEY=test_sk_...
;   PORTONE_API_KEY=...
;   PORTONE_API_SECRET=...
;
; 사용 예:
;   (payment-confirm "pay_key_xxx" 10000 "order_001")
;   (payment-cancel "pay_key_xxx" "고객 변심")
;   (payment-virtual-account 10000 "order_001" "홍길동")

; ── Toss Payments ─────────────────────────────────────────────

(define TOSS-BASE  "https://api.tosspayments.com/v1")
(define TOSS-KEY   (fl-env-get "TOSS_SECRET_KEY"))

; Toss Basic Auth 헤더 생성
(defn toss-auth []
  (str "Basic " (base64_encode (str TOSS-KEY ":"))))

; 결제 승인 (클라이언트 SDK → 서버 최종 승인)
; paymentKey: Toss SDK에서 받은 키
; amount: 결제 금액 (위조 방지: DB 주문 금액과 반드시 비교 후 호출)
; orderId: 주문 번호
(defn payment-confirm [$payment-key $amount $order-id]
  (let [$res (http_post_json
               (str TOSS-BASE "/payments/confirm")
               {"paymentKey" $payment-key
                "amount"     $amount
                "orderId"    $order-id}
               {"Authorization" (toss-auth)
                "Content-Type"  "application/json"})]
    (if (http_ok? $res)
      {"ok"      true
       "data"    (http_body $res)
       "status"  (get (http_body $res) "status")}
      {"ok"      false
       "code"    (get (http_body $res) "code")
       "message" (get (http_body $res) "message")})))

; 결제 조회
(defn payment-get [$payment-key]
  (let [$res (http_get_json
               (str TOSS-BASE "/payments/" $payment-key)
               {"Authorization" (toss-auth)})]
    (if (http_ok? $res) (http_body $res) nil)))

; 결제 취소 (전액)
(defn payment-cancel [$payment-key $reason]
  (let [$res (http_post_json
               (str TOSS-BASE "/payments/" $payment-key "/cancel")
               {"cancelReason" $reason}
               {"Authorization" (toss-auth)
                "Content-Type"  "application/json"})]
    {"ok" (http_ok? $res)
     "data" (http_body $res)}))

; 결제 부분 취소
(defn payment-partial-cancel [$payment-key $amount $reason]
  (let [$res (http_post_json
               (str TOSS-BASE "/payments/" $payment-key "/cancel")
               {"cancelReason"  $reason
                "cancelAmount"  $amount}
               {"Authorization" (toss-auth)
                "Content-Type"  "application/json"})]
    {"ok" (http_ok? $res)
     "data" (http_body $res)}))

; 가상계좌 발급
(defn payment-virtual-account [$amount $order-id $customer-name]
  (let [$res (http_post_json
               (str TOSS-BASE "/virtual-accounts")
               {"amount"       $amount
                "orderId"      $order-id
                "orderName"    $order-id
                "customerName" $customer-name
                "bank"         "카카오뱅크"
                "validHours"   24}
               {"Authorization" (toss-auth)
                "Content-Type"  "application/json"})]
    (if (http_ok? $res)
      {"ok" true "data" (http_body $res)}
      {"ok" false "message" (get (http_body $res) "message")})))

; 주문 금액 위조 방지 헬퍼
; DB에서 실제 금액 확인 후 결제 승인해야 함
(defn payment-safe-confirm [$payment-key $db-amount $req-amount $order-id]
  (if (= $db-amount $req-amount)
    (payment-confirm $payment-key $db-amount $order-id)
    {"ok" false "message" "결제 금액 불일치 — 위조 의심"}))

; ── 포트원 (구 아임포트) ──────────────────────────────────────

(define PORTONE-BASE   "https://api.iamport.kr")
(define PORTONE-KEY    (fl-env-get "PORTONE_API_KEY"))
(define PORTONE-SECRET (fl-env-get "PORTONE_API_SECRET"))

; 포트원 액세스 토큰 발급
(defn portone-token []
  (let [$res (http_post_json
               (str PORTONE-BASE "/users/getToken")
               {"imp_key"    PORTONE-KEY
                "imp_secret" PORTONE-SECRET}
               {"Content-Type" "application/json"})]
    (if (http_ok? $res)
      (get (get (http_body $res) "response") "access_token")
      nil)))

; 포트원 결제 검증
(defn portone-verify [$imp-uid $expected-amount]
  (let [$token (portone-token)]
    (if (= $token nil)
      {"ok" false "message" "포트원 인증 실패"}
      (let [$res (http_get_json
                   (str PORTONE-BASE "/payments/" $imp-uid)
                   {"Authorization" $token})]
        (if (http_ok? $res)
          (let [$payment (get (http_body $res) "response")
                $paid    (get $payment "amount")]
            (if (= $paid $expected-amount)
              {"ok" true "data" $payment}
              {"ok" false "message" "결제 금액 불일치"}))
          {"ok" false "message" "결제 정보 조회 실패"})))))

; ── _storage.flx ──
; pages/_storage.flx — S3 호환 파일 스토리지 라이브러리
; 지원: AWS S3 / MinIO / Cloudflare R2 / Backblaze B2
;
; 환경변수 (.env):
;   S3_ENDPOINT=https://s3.amazonaws.com   # MinIO: http://localhost:9000
;   S3_REGION=ap-northeast-2
;   S3_BUCKET=my-bucket
;   S3_ACCESS_KEY=AKIA...
;   S3_SECRET_KEY=xxx
;   S3_CDN_URL=https://cdn.example.com     # 선택 (CloudFront 등)
;
; 사용 예:
;   (storage-put "uploads/photo.jpg" "/tmp/photo.jpg" "image/jpeg")
;   (storage-url "uploads/photo.jpg")
;   (storage-presign "uploads/photo.jpg" 3600)
;   (storage-delete "uploads/photo.jpg")

; ── 설정 ──────────────────────────────────────────────────────

(define S3-ENDPOINT (fl-env-get "S3_ENDPOINT"))
(define S3-REGION   (or (fl-env-get "S3_REGION") "ap-northeast-2"))
(define S3-BUCKET   (fl-env-get "S3_BUCKET"))
(define S3-KEY      (fl-env-get "S3_ACCESS_KEY"))
(define S3-SECRET   (fl-env-get "S3_SECRET_KEY"))
(define S3-CDN      (fl-env-get "S3_CDN_URL"))

; ── 내부 헬퍼 ────────────────────────────────────────────────

; 오브젝트 공개 URL (CDN 있으면 CDN, 없으면 S3 직접)
(defn s3-public-url [$key]
  (if S3-CDN
    (str S3-CDN "/" $key)
    (str S3-ENDPOINT "/" S3-BUCKET "/" $key)))

; S3 서명 문자열 생성 (HMAC-SHA256 기반)
(defn s3-sign [$string-to-sign $date $region]
  (let [$k-date   (hmac_sha256 (str "AWS4" S3-SECRET) $date)
        $k-region (hmac_sha256 $k-date $region)
        $k-service (hmac_sha256 $k-region "s3")
        $k-signing (hmac_sha256 $k-service "aws4_request")]
    (hmac_sha256 $k-signing $string-to-sign)))

; ── 파일 업로드 (서버사이드 → S3) ────────────────────────────

; 로컬 파일을 S3에 업로드
(defn storage-put [$key $local-path $content-type]
  (let [$content (file-read $local-path)
        $url     (str S3-ENDPOINT "/" S3-BUCKET "/" $key)
        $res     (http_put $url $content)]
    (if (= (get $res :status) 200)
      {"ok" true  "url" (s3-public-url $key) "key" $key}
      {"ok" false "status" (get $res :status)})))

; Base64 데이터를 S3에 업로드 (클라이언트 전송 데이터)
(defn storage-put-base64 [$key $base64-data $content-type]
  (let [$content (base64_decode $base64-data)
        $url     (str S3-ENDPOINT "/" S3-BUCKET "/" $key)
        $res     (http_put $url $content)]
    (if (= (get $res :status) 200)
      {"ok" true  "url" (s3-public-url $key) "key" $key}
      {"ok" false "status" (get $res :status)})))

; ── URL 생성 ──────────────────────────────────────────────────

; 공개 URL (Public 버킷)
(defn storage-url [$key]
  (s3-public-url $key))

; 프리사인드 URL (Private 버킷 임시 접근, 업로드/다운로드)
; expires: 초 단위 (기본 3600 = 1시간)
(defn storage-presign [$key $expires]
  (let [$now     (format-date (now-ms) "YYYYMMDD")
        $exp     (or $expires 3600)
        $params  (str "X-Amz-Algorithm=AWS4-HMAC-SHA256"
                      "&X-Amz-Credential=" S3-KEY "%2F" $now "%2F" S3-REGION "%2Fs3%2Faws4_request"
                      "&X-Amz-Date=" $now "T000000Z"
                      "&X-Amz-Expires=" $exp
                      "&X-Amz-SignedHeaders=host")]
    ; 실제 프로덕션에서는 전체 v4 서명 구현 필요
    ; 간소화 버전: presigned URL 구조만 제공
    (str S3-ENDPOINT "/" S3-BUCKET "/" $key "?" $params)))

; 클라이언트 직접 업로드용 presigned PUT URL
(defn storage-presign-upload [$key $content-type $expires]
  {"url"          (storage-presign $key (or $expires 600))
   "method"       "PUT"
   "content-type" $content-type
   "key"          $key
   "final-url"    (s3-public-url $key)})

; ── 파일 관리 ─────────────────────────────────────────────────

; 파일 삭제
(defn storage-delete [$key]
  (let [$url (str S3-ENDPOINT "/" S3-BUCKET "/" $key)
        $res (http_delete $url)]
    {"ok" (= (get $res :status) 204)}))

; 파일 존재 확인
(defn storage-exists? [$key]
  (let [$url (str S3-ENDPOINT "/" S3-BUCKET "/" $key)
        $res (http_head $url)]
    (= (get $res :status) 200)))

; ── 파일 키 생성 헬퍼 ─────────────────────────────────────────

; 유니크한 업로드 키 생성
; (storage-key "avatars" "photo.jpg") → "avatars/2026/06/uuid.jpg"
(defn storage-key [$folder $filename]
  (let [$ext  (str-slice $filename (- (length $filename) 4) (length $filename))
        $date (format-date (now-ms) "YYYY/MM")]
    (str $folder "/" $date "/" (uuid) $ext)))

; 이미지 업로드용 키 (user-id 기반)
(defn storage-avatar-key [$user-id]
  (str "avatars/" $user-id "/profile.jpg"))

; 첨부파일 키 (order-id + 파일명)
(defn storage-attachment-key [$order-id $filename]
  (str "attachments/" $order-id "/" $filename))

; ── _styles.flx ──
; pages/_styles.flx — SKL 다크 테마 CSS 헬퍼
; 인라인 style 문자열 반복 제거

; ── 색상 토큰 ────────────────────────────────────────────────
(define $bg     "#0d1829")
(define $panel  "#0f1d33")
(define $bdr    "#1e3050")
(define $muted  "#64748b")
(define $sub    "#94a3b8")
(define $text   "#e2e8f0")
(define $accent "#6366f1")
(define $ok     "#10b981")
(define $warn   "#f59e0b")
(define $danger "#ef4444")

; ── style 조합 함수 ──────────────────────────────────────────
(defn s [& parts]
  "여러 style 조각을 ;로 합치기
   (s (row 8) (p 12) (rounded 8))
   → 'display:flex;align-items:center;gap:8px;padding:12px;border-radius:8px'"
  (str-join (filter (fn [x] (not (= x ""))) parts) ";"))

; ── 레이아웃 ─────────────────────────────────────────────────
(defn row [gap]
  (str "display:flex;align-items:center;gap:" gap "px"))

(defn col [gap]
  (str "display:flex;flex-direction:column;gap:" gap "px"))

(defn between []
  "display:flex;align-items:center;justify-content:space-between")

(defn center []
  "display:flex;align-items:center;justify-content:center")

(defn full []
  "width:100%;height:100%")

(defn flex1 []
  "flex:1;min-width:0")

; ── 간격 ─────────────────────────────────────────────────────
(defn p [v]  (str "padding:" v "px"))
(defn px [v] (str "padding-left:" v "px;padding-right:" v "px"))
(defn py [v] (str "padding-top:" v "px;padding-bottom:" v "px"))
(defn mg [v] (str "margin:" v "px"))

; ── 크기 ─────────────────────────────────────────────────────
(defn w [v]   (str "width:" v))
(defn ht [v]  (str "height:" v))
(defn wh [v]  (str "width:" v ";height:" v))
(defn mxw [v] (str "max-width:" v))

; ── 테두리 ───────────────────────────────────────────────────
(defn rounded [r]
  (str "border-radius:" r "px"))

(defn border []
  (str "border:1px solid " $bdr))

(defn border-b []
  (str "border-bottom:1px solid " $bdr))

(defn border-r []
  (str "border-right:1px solid " $bdr))

; ── 배경/색상 ────────────────────────────────────────────────
(defn bg [c]  (str "background:" c))
(defn fg [c]  (str "color:" c))
(defn bg-panel []  (bg $panel))
(defn bg-page []   (bg $bg))

; ── 텍스트 ───────────────────────────────────────────────────
(defn fs [v]  (str "font-size:" v "px"))
(defn fw [v]  (str "font-weight:" v))
(defn truncate [] "overflow:hidden;text-overflow:ellipsis;white-space:nowrap")
(defn upper []   "text-transform:uppercase;letter-spacing:1px")
(defn mono []    "font-family:monospace")

; ── 커서/상호작용 ────────────────────────────────────────────
(defn pointer [] "cursor:pointer")
(defn none []    "display:none")
(defn abs []     "position:absolute")
(defn fixed []   "position:fixed")
(defn rel []     "position:relative")
(defn inset []   "top:0;left:0;right:0;bottom:0")
(defn ovh []     "overflow:hidden")
(defn ova []     "overflow-y:auto")

; ── 공통 컴포넌트 ────────────────────────────────────────────
(defn $card []
  (s (bg-panel) (border) (rounded 12) (p 16)))

(defn $card-hover []
  (s ($card) (pointer) "transition:border-color .15s"))

(defn $input []
  (s (w "100%") "padding:10px 12px" (bg-page) (border)
     (fg $text) (rounded 8) "font-size:13px;outline:none"))

(defn $textarea []
  (s ($input) "resize:vertical;min-height:120px;line-height:1.7"))

(defn $btn-primary []
  (s "padding:9px 18px" (bg $accent) (fg "white")
     "border:none" (rounded 8) (pointer) "font-size:13px;font-weight:600"))

(defn $btn-ghost []
  (s "padding:9px 18px;background:transparent"
     (str "border:1px solid " $bdr) (fg $muted)
     (rounded 8) (pointer) "font-size:13px"))

(defn $btn-danger []
  (s "padding:9px 18px;background:transparent"
     (str "border:1px solid " $danger) (fg $danger)
     (rounded 8) (pointer) "font-size:13px"))

(defn $btn-icon []
  (s "background:transparent;border:none" (fg $muted) (pointer) "font-size:14px;padding:2px 6px"))

(defn $badge [color]
  (s "padding:2px 8px" (rounded 4) "font-size:11px" (fg color)
     (str "background:" color "1a")))

(defn $sidebar []
  (s "width:220px" (bg-panel) (border-r)
     "display:flex;flex-direction:column;flex-shrink:0"))

(defn $topbar []
  (s (between) "padding:12px 20px" (border-b) (bg-panel)))

(defn $nav-item [active?]
  (s "display:flex;align-items:center;gap:10px;padding:9px 12px"
     (rounded 6) (pointer) "font-size:13px;margin-bottom:2px;border:none;width:100%;text-align:left"
     (if active?
       (str "background:" $panel ";color:" $text)
       (str "background:transparent;color:" $sub))))

(defn $modal-bg []
  (s (fixed) (inset) "background:rgba(0,0,0,0.7);z-index:100"
     (center) "padding:16px"))

(defn $modal []
  (s (bg-panel) (border) (rounded 14)
     "padding:24px;max-width:480px;width:100%"))

(defn $empty-state []
  (s (center) "flex-direction:column;padding:60px 20px" (fg $muted)))

(defn $scroll []
  "::-webkit-scrollbar{width:6px}::-webkit-scrollbar-thumb{background:#1e3050;border-radius:3px}")

; ── _ui.flx ──
; FL-UI — FreeLang Front UI 컴포넌트 라이브러리
; AI-Native 생태계 표준 컴포넌트 모음
; 사용법: ; ── inlined: ./pages/_ui.flx ──
; FL-UI — FreeLang Front UI 컴포넌트 라이브러리
; AI-Native 생태계 표준 컴포넌트 모음
; 사용법: (load "./pages/_ui.flx") 또는 자동 포함됨 (_app.fl에)

; ========== 1. 기본 요소 (Atoms) ==========

(style ui-btn :display "inline-flex" :items "center" :justify "center" :gap "8px" :px "16px" :py "10px" :radius "8px" :weight "600" :font-size "14px" :border "none" :cursor "pointer" :transition "all 0.2s" :text-decoration "none")

(style ui-btn-primary :bg "var(--c-primary)" :color "white" :hover-bg "var(--c-primary-d)" :hover-scale "1.02")

(style ui-btn-secondary :bg "#f3f4f6" :color "#374151" :border "1px solid #d1d5db" :hover-bg "#e5e7eb")

(style ui-btn-danger :bg "var(--c-danger)" :color "white" :hover-bg "#b91c1c")

(style ui-btn-ghost :bg "transparent" :color "var(--c-primary)" :hover-bg "var(--c-primary-l)")

(defn ui-btn [type label]
  (let [class-name (cond
    (= type "secondary") (str ui-btn " " ui-btn-secondary)
    (= type "danger") (str ui-btn " " ui-btn-danger)
    (= type "ghost") (str ui-btn " " ui-btn-ghost)
    :else (str ui-btn " " ui-btn-primary))]
    (h "button" {:class class-name :type "button"} label)))

; ===== Badge =====
(style ui-badge :display "inline-block" :px "9px" :py "3px" :radius "99px" :font-size "12px" :weight "600" :white-space "nowrap")

(style ui-badge-green :bg "#dcfce7" :color "var(--c-success)")
(style ui-badge-red :bg "#fee2e2" :color "var(--c-danger)")
(style ui-badge-yellow :bg "#fef3c7" :color "var(--c-warning)")
(style ui-badge-blue :bg "var(--c-primary-l)" :color "var(--c-primary-d)")
(style ui-badge-gray :bg "#f3f4f6" :color "#6b7280")

(defn ui-badge [text color]
  (let [class-name (cond
    (= color "red") (str ui-badge " " ui-badge-red)
    (= color "yellow") (str ui-badge " " ui-badge-yellow)
    (= color "blue") (str ui-badge " " ui-badge-blue)
    (= color "gray") (str ui-badge " " ui-badge-gray)
    :else (str ui-badge " " ui-badge-green))]
    (h "span" {:class class-name} text)))

; ===== Avatar =====
(style ui-avatar :display "inline-flex" :items "center" :justify "center" :radius "50%" :weight "600" :bg "var(--c-primary-l)" :color "var(--c-primary-d)" :font-size "14px")

(defn ui-avatar [name size]
  (let [initials (str (str-slice name 0 1) (if (> (length name) 1) (str-slice name 1 2) ""))
        sty (cond
          (= size "lg") :width "48px" :height "48px"
          (= size "sm") :width "28px" :height "28px"
          :else :width "36px" :height "36px")]
    (h "div" {:class ui-avatar :style (str "width:" (cond (= size "lg") "48px" (= size "sm") "28px" :else "36px") ";height:" (cond (= size "lg") "48px" (= size "sm") "28px" :else "36px") ";")} initials)))

; ===== Divider =====
(style ui-divider :my "20px" :border "none" :height "1px" :bg "var(--c-border)")

(defn ui-divider []
  (h "hr" {:class ui-divider}))

; ===== Spinner =====
(style ui-spinner :display "inline-block" :width "20px" :height "20px" :border "2px solid #f3f4f6" :border-top "2px solid var(--c-primary)" :radius "50%" :animation "spin 0.6s linear infinite")

(defn ui-spinner []
  (str
    "<style>@keyframes spin{to{transform:rotate(360deg);}}</style>"
    (h "div" {:class ui-spinner})))

; ========== 2. 폼 요소 ==========

(style ui-input-wrap :display "flex" :flex-dir "column" :gap "6px" :mb "16px")
(style ui-input-label :font-size "14px" :weight "600" :color "var(--c-text)")
(style ui-input-field :padding "9px 12px" :border "1px solid #d1d5db" :radius "8px" :font-size "14px" :font-family "inherit" :bg "var(--c-surface)" :color "var(--c-text)" :transition "all 0.2s")

(defn ui-input [name label type placeholder]
  (str
    (h "div" {:class ui-input-wrap}
      (str
        (h "label" {:class ui-input-label :for name} label)
        (h "input" {:class ui-input-field :type (or type "text") :name name :placeholder placeholder :required "true"})))))

; ===== Textarea =====
(style ui-textarea-field :padding "9px 12px" :border "1px solid #d1d5db" :radius "8px" :font-size "14px" :font-family "inherit" :bg "var(--c-surface)" :color "var(--c-text)" :min-h "90px" :resize "vertical")

(defn ui-textarea [name label rows]
  (str
    (h "div" {:class ui-input-wrap}
      (str
        (h "label" {:class ui-input-label :for name} label)
        (h "textarea" {:class ui-textarea-field :name name :rows (or rows 4)})))))

; ===== Select =====
(defn ui-select [name label options]
  (let [opt-html (arr-join
    (map (fn [opt] (h "option" {:value (get opt "value")} (get opt "label")))
      options) "")]
    (str
      (h "div" {:class ui-input-wrap}
        (str
          (h "label" {:class ui-input-label :for name} label)
          (h "select" {:class ui-input-field :name name} opt-html))))))

; ===== Checkbox =====
(style ui-checkbox-wrap :display "flex" :items "center" :gap "8px" :mb "12px")
(style ui-checkbox-input :width "18px" :height "18px" :cursor "pointer" :accent-color "var(--c-primary)")

(defn ui-checkbox [name label checked]
  (h "div" {:class ui-checkbox-wrap}
    (str
      (h "input" {:class ui-checkbox-input :type "checkbox" :name name :id name :checked (if checked "checked" nil)})
      (h "label" {:for name :style "cursor:pointer;font-weight:500;"} label))))

; ===== Form Group =====
(style ui-form-group :display "grid" :gap "16px")

(defn ui-form-group [& fields]
  (h "div" {:class ui-form-group} (arr-join fields "")))

; ========== 3. 레이아웃 ==========

(style ui-card :bg "var(--c-surface)" :border "1px solid var(--c-border)" :radius "12px" :p "20px" :shadow "var(--shadow-sm)" :transition "all 0.3s")

(defn ui-card [title content]
  (h "div" {:class ui-card}
    (str
      (h "h3" {:style "margin:0 0 16px;color:var(--c-text);font-size:16px;"} title)
      content)))

; ===== Grid =====
(defn ui-grid [cols content]
  (let [grid-cols (str "repeat(" cols ", 1fr)")
        grid-style (str "display:grid;grid-template-columns:" grid-cols ";gap:16px;")]
    (h "div" {:style grid-style} content)))

; ===== Stack =====
(defn ui-stack [content]
  (h "div" {:style "display:flex;flex-direction:column;gap:16px;"} content))

; ===== Row =====
(defn ui-row [content]
  (h "div" {:style "display:flex;gap:16px;align-items:center;"} content))

; ========== 4. 피드백 ==========

(style ui-alert :padding "16px" :radius "8px" :font-size "14px" :mb "16px" :border-left "4px solid")

(style ui-alert-success :bg "#dcfce7" :border-left-color "var(--c-success)" :color "var(--c-success)")
(style ui-alert-error :bg "#fee2e2" :border-left-color "var(--c-danger)" :color "var(--c-danger)")
(style ui-alert-warning :bg "#fef3c7" :border-left-color "var(--c-warning)" :color "var(--c-warning)")
(style ui-alert-info :bg "#dbeafe" :border-left-color "#3b82f6" :color "#1e40af")

(defn ui-alert [type message]
  (let [class-name (cond
    (= type "error") (str ui-alert " " ui-alert-error)
    (= type "warning") (str ui-alert " " ui-alert-warning)
    (= type "info") (str ui-alert " " ui-alert-info)
    :else (str ui-alert " " ui-alert-success))]
    (h "div" {:class class-name} message)))

; ===== Empty State =====
(style ui-empty :text-align "center" :py "48px" :color "var(--c-muted)")

(defn ui-empty [icon message]
  (h "div" {:class ui-empty}
    (str
      (h "div" {:style "font-size:48px;margin-bottom:16px;"} icon)
      (h "p" {:style "font-size:16px;margin:0;"} message))))

; ===== Progress =====
(style ui-progress-wrap :width "100%" :height "8px" :bg "#e5e7eb" :radius "4px" :overflow "hidden")
(style ui-progress-bar :height "100%" :bg "var(--c-primary)" :transition "width 0.3s")

(defn ui-progress [value max]
  (let [pct (str (* (/ value max) 100) "%")]
    (h "div" {:class ui-progress-wrap}
      (h "div" {:class ui-progress-bar :style (str "width:" pct ";")}))))

; ========== 5. 데이터 ==========

; ===== Table =====
(style ui-table-wrap :bg "var(--c-surface)" :border "1px solid var(--c-border)" :radius "12px" :overflow "hidden" :box-shadow "var(--shadow-sm)" :mb "16px")

(defn ui-table [headers rows]
  (let [header-html (h "thead" {}
    (h "tr" {} (arr-join (map (fn [col] (h "th" {:style "padding:10px 14px;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid var(--c-border);text-align:left;"} col)) headers) "")))
    row-html (arr-join
      (map (fn [row]
        (h "tr" {:style "border-bottom:1px solid #f1f3f6;"}
          (arr-join
            (map (fn [cell] (h "td" {:style "padding:11px 14px;font-size:14px;"} (str cell)))
              (if (= (type row) "map")
                (map (fn [k] (get row k)) headers)
                row))
            "")))
        rows) "")]
    (h "div" {:class ui-table-wrap}
      (h "table" {:style "width:100%;border-collapse:collapse;"} (str header-html row-html)))))

; ===== Stat Card =====
(style ui-stat-card :bg "var(--c-surface)" :border "1px solid var(--c-border)" :radius "12px" :p "20px" :shadow "var(--shadow-sm)" :transition "all 0.3s" :hover-shadow "var(--shadow-md)" :hover-transform "translateY(-2px)")

(defn ui-stat [label value diff]
  (let [diff-color (if (string? diff)
    (if (str-starts diff "-") "#dc2626" "#16a34a")
    (if (< diff 0) "#dc2626" "#16a34a"))]
    (h "div" {:class ui-stat-card}
      (str
        (h "div" {:style "font-size:12px;color:var(--c-muted);margin-bottom:8px;"} label)
        (h "div" {:style "font-size:28px;font-weight:800;color:var(--c-primary);line-height:1;margin-bottom:8px;"} value)
        (if diff
          (h "div" {:style (str "font-size:12px;color:" diff-color ";")} diff)
          (h "div" {}))))))

; ===== Tag List =====
(style ui-tag :display "inline-block" :px "12px" :py "6px" :radius "20px" :bg "#f3f4f6" :color "#374151" :font-size "13px" :mr "8px" :mb "8px")

(defn ui-tags [& tags]
  (h "div" {}
    (arr-join
      (map (fn [tag] (h "span" {:class ui-tag} tag)) tags)
      "")))

; ========== 추가 헬퍼 ==========

(define str-starts
  (fn [$s $prefix]
    (= (str-slice $s 0 (length $prefix)) $prefix)))

(defn if* [$cond $true $false]
  (if $cond $true $false))

; end of _ui.flx
; ── end: ./pages/_ui.flx ── 또는 자동 포함됨 (_app.fl에)

; ========== 1. 기본 요소 (Atoms) ==========

(defn ui-btn [type label]
  (let [class-name (cond
    (= type "secondary") (str ui-btn " " ui-btn-secondary)
    (= type "danger") (str ui-btn " " ui-btn-danger)
    (= type "ghost") (str ui-btn " " ui-btn-ghost)
    :else (str ui-btn " " ui-btn-primary))]
    (h "button" {:class class-name :type "button"} label)))

; ===== Badge =====
(defn ui-badge [text color]
  (let [class-name (cond
    (= color "red") (str ui-badge " " ui-badge-red)
    (= color "yellow") (str ui-badge " " ui-badge-yellow)
    (= color "blue") (str ui-badge " " ui-badge-blue)
    (= color "gray") (str ui-badge " " ui-badge-gray)
    :else (str ui-badge " " ui-badge-green))]
    (h "span" {:class class-name} text)))

; ===== Avatar =====
(defn ui-avatar [name size]
  (let [initials (str (str-slice name 0 1) (if (> (length name) 1) (str-slice name 1 2) ""))
        sty (cond
          (= size "lg") :width "48px" :height "48px"
          (= size "sm") :width "28px" :height "28px"
          :else :width "36px" :height "36px")]
    (h "div" {:class ui-avatar :style (str "width:" (cond (= size "lg") "48px" (= size "sm") "28px" :else "36px") ";height:" (cond (= size "lg") "48px" (= size "sm") "28px" :else "36px") ";")} initials)))

; ===== Divider =====
(defn ui-divider []
  (h "hr" {:class ui-divider}))

; ===== Spinner =====
(defn ui-spinner []
  (str
    "<style>@keyframes spin{to{transform:rotate(360deg);}}</style>"
    (h "div" {:class ui-spinner})))

; ========== 2. 폼 요소 ==========

(defn ui-input [name label type placeholder]
  (str
    (h "div" {:class ui-input-wrap}
      (str
        (h "label" {:class ui-input-label :for name} label)
        (h "input" {:class ui-input-field :type (or type "text") :name name :placeholder placeholder :required "true"})))))

; ===== Textarea =====
(defn ui-textarea [name label rows]
  (str
    (h "div" {:class ui-input-wrap}
      (str
        (h "label" {:class ui-input-label :for name} label)
        (h "textarea" {:class ui-textarea-field :name name :rows (or rows 4)})))))

; ===== Select =====
(defn ui-select [name label options]
  (let [opt-html (arr-join
    (map (fn [opt] (h "option" {:value (get opt "value")} (get opt "label")))
      options) "")]
    (str
      (h "div" {:class ui-input-wrap}
        (str
          (h "label" {:class ui-input-label :for name} label)
          (h "select" {:class ui-input-field :name name} opt-html))))))

; ===== Checkbox =====
(defn ui-checkbox [name label checked]
  (h "div" {:class ui-checkbox-wrap}
    (str
      (h "input" {:class ui-checkbox-input :type "checkbox" :name name :id name :checked (if checked "checked" nil)})
      (h "label" {:for name :style "cursor:pointer;font-weight:500;"} label))))

; ===== Form Group =====
(defn ui-form-group [& fields]
  (h "div" {:class ui-form-group} (arr-join fields "")))

; ========== 3. 레이아웃 ==========

(defn ui-card [title content]
  (h "div" {:class ui-card}
    (str
      (h "h3" {:style "margin:0 0 16px;color:var(--c-text);font-size:16px;"} title)
      content)))

; ===== Grid =====
(defn ui-grid [cols content]
  (let [grid-cols (str "repeat(" cols ", 1fr)")
        grid-style (str "display:grid;grid-template-columns:" grid-cols ";gap:16px;")]
    (h "div" {:style grid-style} content)))

; ===== Stack =====
(defn ui-stack [content]
  (h "div" {:style "display:flex;flex-direction:column;gap:16px;"} content))

; ===== Row =====
(defn ui-row [content]
  (h "div" {:style "display:flex;gap:16px;align-items:center;"} content))

; ========== 4. 피드백 ==========

(defn ui-alert [type message]
  (let [class-name (cond
    (= type "error") (str ui-alert " " ui-alert-error)
    (= type "warning") (str ui-alert " " ui-alert-warning)
    (= type "info") (str ui-alert " " ui-alert-info)
    :else (str ui-alert " " ui-alert-success))]
    (h "div" {:class class-name} message)))

; ===== Empty State =====
(defn ui-empty [icon message]
  (h "div" {:class ui-empty}
    (str
      (h "div" {:style "font-size:48px;margin-bottom:16px;"} icon)
      (h "p" {:style "font-size:16px;margin:0;"} message))))

; ===== Progress =====
(defn ui-progress [value max]
  (let [pct (str (* (/ value max) 100) "%")]
    (h "div" {:class ui-progress-wrap}
      (h "div" {:class ui-progress-bar :style (str "width:" pct ";")}))))

; ========== 5. 데이터 ==========

; ===== Table =====
(defn ui-table [headers rows]
  (let [header-html (h "thead" {}
    (h "tr" {} (arr-join (map (fn [col] (h "th" {:style "padding:10px 14px;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid var(--c-border);text-align:left;"} col)) headers) "")))
    row-html (arr-join
      (map (fn [row]
        (h "tr" {:style "border-bottom:1px solid #f1f3f6;"}
          (arr-join
            (map (fn [cell] (h "td" {:style "padding:11px 14px;font-size:14px;"} (str cell)))
              (if (= (type row) "map")
                (map (fn [k] (get row k)) headers)
                row))
            "")))
        rows) "")]
    (h "div" {:class ui-table-wrap}
      (h "table" {:style "width:100%;border-collapse:collapse;"} (str header-html row-html)))))

; ===== Stat Card =====
(defn ui-stat [label value diff]
  (let [diff-color (if (string? diff)
    (if (str-starts diff "-") "#dc2626" "#16a34a")
    (if (< diff 0) "#dc2626" "#16a34a"))]
    (h "div" {:class ui-stat-card}
      (str
        (h "div" {:style "font-size:12px;color:var(--c-muted);margin-bottom:8px;"} label)
        (h "div" {:style "font-size:28px;font-weight:800;color:var(--c-primary);line-height:1;margin-bottom:8px;"} value)
        (if diff
          (h "div" {:style (str "font-size:12px;color:" diff-color ";")} diff)
          (h "div" {}))))))

; ===== Tag List =====
(defn ui-tags [& tags]
  (h "div" {}
    (arr-join
      (map (fn [tag] (h "span" {:class ui-tag} tag)) tags)
      "")))

; ========== 추가 헬퍼 ==========

(define str-starts
  (fn [$s $prefix]
    (= (str-slice $s 0 (length $prefix)) $prefix)))

(defn if* [$cond $true $false]
  (if $cond $true $false))

; end of _ui.flx

