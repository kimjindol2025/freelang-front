eta__7671\";\nvar form_toolbar=\"form_toolbar__a6d8\";\nvar color_row=\"color_row__b5e4\";\nvar note_empty=\"note_empty__b08c\";\nvar note_actions=\"note_actions__dfb1\";\nvar icon_btn=\"icon_btn__4d25\";\nvar del_btn=\"del_btn__8fac\";\nvar search_wrap=\"search_wrap__37a0\";\nvar search_icon=\"search_icon__f263\";\nvar pin_form=\"pin_form__b618\";\nvar textarea_input=\"textarea_input__4bb6\";\nvar pg_wrap=\"pg_wrap__92cf\";\nvar pg_title=\"pg_title__9a36\";\nvar pg_subtitle=\"pg_subtitle__2581\";\nvar pg_grid=\"pg_grid__35a8\";\nvar pg_panel=\"pg_panel__aaad\";\nvar pg_panel_head=\"pg_panel_head__2bce\";\nvar pg_editor=\"pg_editor__f737\";\nvar pg_result=\"pg_result__d0e8\";\nvar pg_result_error=\"pg_result_error__7eff\";\nvar pg_btn=\"pg_btn__538e\";\nvar pg_examples=\"pg_examples__8d1f\";\nvar pg_ex_btn=\"pg_ex_btn__ea5c\";\nvar pg_status=\"pg_status__b570\";\nvar card=\"card__86e7\";\nvar hero=\"hero__43b0\";\nvar badge=\"badge__a154\";\nvar resp_grid=\"resp_grid__7f07\";\nvar resp_card=\"resp_card__789b\";\nvar resp_hero=\"resp_hero__3912\";\n\n_fl.mount(\"island-todoapp-0\", (() => { const items = _fl.atom([]); const inp_val = _fl.atom(\"\"); const next_id = _fl.atom(0);\n  return (update) => { return _fl.h(\"div\", {\"style\": \"max-width:480px\"}, _fl.h(\"div\", {\"style\": \"display:flex;gap:8px;margin-bottom:16px\"}, _fl.h(\"input\", {\"type\": \"text\", \"value\": _fl.deref(inp_val), \"placeholder\": \"할 일을 입력하세요...\", \"style\": \"flex:1;padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:1rem\", \"on-input\": (e) => { return (_fl.reset(inp_val, (((e)?.[\"target\"])?.[\"value\"] ?? null)), update()); }, \"on-keydown\": (e) => { return ((((e)?.[\"key\"] ?? null) === \"Enter\")) ? ((!((_fl.deref(inp_val) === \"\"))) ? ((() => { (_fl.swap(items, (arr) => { return _fl.push(arr, {\"id\": _fl.deref(next_id), \"text\": _fl.deref(inp_val), \"done\": false}); }), update()); (_fl.swap(next_id, v => v + 1), update()); (_fl.reset(inp_val, \"\"), update()) })()) : null) : null; }}), _fl.h(\"button\", {\"style\": \"background:#6366f1;color:white;border:none;border-radius:6px;padding:10px 20px;cursor:pointer;font-size:1rem;white-space:nowrap\", \"on-click\": () => { return (!((_fl.deref(inp_val) === \"\"))) ? ((() => { (_fl.swap(items, (arr) => { return _fl.push(arr, {\"id\": _fl.deref(next_id), \"text\": _fl.deref(inp_val), \"done\": false}); }), update()); (_fl.swap(next_id, v => v + 1), update()); (_fl.reset(inp_val, \"\"), update()) })()) : null; }}, \"추가\")), _fl.h(\"ul\", {\"style\": \"list-style:none;margin:0;padding:0\"}, _fl.map_arr((item) => { return (() => { const done = _fl.get(item, \"done\"); const id = _fl.get(item, \"id\"); const text = _fl.get(item, \"text\"); return _fl.h(\"li\", {\"style\": \"display:flex;align-items:center;gap:10px;padding:12px 14px;background:white;border-radius:8px;margin-bottom:8px;box-shadow:0 1px 3px rgba(0,0,0,.08)\"}, _fl.h(\"input\", {\"type\": \"checkbox\", \"style\": \"width:18px;height:18px;cursor:pointer;accent-color:#6366f1\", \"checked\": (done) ? (\"checked\") : (\"\"), \"on-click\": () => { return (_fl.swap(items, (arr) => { return _fl.map_arr((it) => { return ((_fl.get(it, \"id\") === id)) ? (_fl.assoc(it, \"done\", !(_fl.get(it, \"done\")))) : (it); }, arr); }), update()); }}), _fl.h(\"span\", {\"style\": (done) ? (\"flex:1;color:#9ca3af;text-decoration:line-through\") : (\"flex:1\")}, text), _fl.h(\"button\", {\"style\": \"background:none;border:none;color:#ef4444;cursor:pointer;font-size:1.3rem;line-height:1;padding:0 2px\", \"on-click\": () => { return (_fl.swap(items, (arr) => { return _fl.filter_arr((it) => { return (_fl.get(it, \"id\") !== id); }, arr); }), update()); }}, \"×\")); })(); }, _fl.deref(items))), _fl.h(\"p\", {\"style\": \"color:#9ca3af;font-size:.85rem;margin-top:12px\"}, _fl_str((_fl.deref(items))?.length ?? 0, \"개 항목\"))); };\n})());\n//# sourceURL=island-todoapp.flx\n</script>") req))
(defn page_todo [req]
  (try (page_todo__inner req)
    (catch $err (dev-error-page "/todo" (str $err)))))

; ── pages/upload.flx ──
(defn page_upload__inner [req]
  (let [msg (server-req-query req "msg")
        err (server-req-query req "err")]
    (layout-html "파일 업로드" (str
        "<h2 style='margin:0 0 8px'>파일 업로드</h2>"
        "<p style='color:#6b7280;margin:0 0 24px'>최대 2MB · 이미지/텍스트/PDF</p>"

        (if err
          (str "<div style='background:#fef2f2;border:1px solid #fecaca;border-radius:8px;"
               "padding:12px 16px;color:#dc2626;margin-bottom:16px'>" err "</div>")
          "")
        (if msg
          (str "<div style='background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;"
               "padding:12px 16px;color:#16a34a;margin-bottom:16px'>" msg "</div>")
          "")

        "<form method='POST' action='/upload' enctype='multipart/form-data'"
        " style='background:white;border-radius:12px;padding:32px;box-shadow:0 1px 3px rgba(0,0,0,.1);max-width:480px'>"
        "<div style='border:2px dashed #d1d5db;border-radius:8px;padding:32px;text-align:center;margin-bottom:20px'>"
        "<div style='font-size:2.5rem;margin-bottom:8px'>📎</div>"
        "<label style='cursor:pointer;color:#6366f1;font-weight:600'>"
        "<input type='file' name='file' accept='image/*,.pdf,.txt,.csv'"
        " style='display:none' onchange='this.parentElement.nextElementSibling.textContent=this.files[0]?.name||\"\"' required>"
        "파일 선택"
        "</label>"
        "<p id='fname' style='color:#6b7280;font-size:.875rem;margin:8px 0 0'></p>"
        "</div>"
        "<button type='submit' style='width:100%;background:#6366f1;color:white;border:none;"
        "border-radius:8px;padding:12px;font-size:1rem;font-weight:600;cursor:pointer'>"
        "업로드"
        "</button>"
        "</form>") req)))

(defn page_upload_post__inner [req]
  (let [files (server-req-files req)
        file  (if (> (length files) 0) (first files) nil)]
    (if file
      (let [orig  (get file "originalname")
            size  (get file "size")
            mime  (get file "mimetype")
            tmp   (get file "path")
            ext   (if (> (length orig) 4)
                    (str-slice orig (- (length orig) 4) (length orig))
                    "")
            dest  (str "public/uploads/" orig)]
        (if (> size 2097152)
          (server-redirect "/upload?err=파일이 2MB를 초과합니다")
          (do
            (shell (str "cp " tmp " " dest))
            (server-redirect (str "/upload?msg=업로드 완료: " orig " (" size "bytes)")))))
      (server-redirect "/upload?err=파일을 선택해주세요"))))
(defn page_upload [req]
  (try (page_upload__inner req)
    (catch $err (dev-error-page "/upload" (str $err)))))
(defn page_upload_post [req]
  (try (page_upload_post__inner req)
    (catch $err (dev-error-page "/upload [POST]" (str $err)))))

; ── pages/vault/api.flx ──
; pages/vault/api.flx — 비밀번호 금고 API (envelope 암호화)
; GET  /vault/api?token=SID → {ok, items}  (잠금해제 세션 유효 시, password 평문 복호화)
; POST /vault/api → action: status|setup|unlock|lock|add|delete|change-master|gen-password
; ── inlined: pages/vault/_db.flx ──
; ── ns: vault ──
; pages/vault/_db.flx — 비밀번호 금고 DB (envelope 암호화)
; 보안 설계:
;   - DEK(데이터 키): 최초 1회 random_bytes(32). 항목 password를 AES-256-GCM으로 암호화.
;   - KEK(키 암호화 키): 마스터 비밀번호에서 scrypt_kdf로 유도. DEK를 감싸는 데만 사용.
;   - DB에는 kdf_salt + wrapped_dek 만 저장 → 마스터 평문은 어디에도 없음.
;   - 잠금해제 = DEK를 인메모리 세션(TTL 15분)에 보관. 프로세스 재시작 시 자동 잠김.
;   - shell 호출 0개 (과거 base64 obfuscation + shell injection 제거).

(define VAULT-DB {:type "sqlite" :path "data/vault.db"})
(define SESSION-TTL-MS 900000)              ; 15분
(define vault-sessions (atom {}))           ; sid -> {"dek" hex "exp" ms}

(defn vault-init []
  (do
    (db-exec VAULT-DB
      "CREATE TABLE IF NOT EXISTS vault_config (
        id INTEGER PRIMARY KEY,
        kdf_salt TEXT NOT NULL,
        wrapped_dek TEXT NOT NULL,
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])
    (db-exec VAULT-DB
      "CREATE TABLE IF NOT EXISTS vault_items (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        label TEXT NOT NULL,
        username TEXT DEFAULT '',
        password_enc TEXT DEFAULT '',
        url TEXT DEFAULT '',
        note TEXT DEFAULT '',
        category TEXT DEFAULT '기타',
        created_at TEXT DEFAULT (datetime('now','localtime'))
      )" [])))

; ── config / setup ────────────────────────────────────────────
(defn vault-get-config []
  (let [rows (db-query VAULT-DB "SELECT * FROM vault_config WHERE id=1" [])]
    (if (> (length rows) 0)
      (get rows 0)
      nil)))

(defn vault-is-setup [] ; 주의: '?' 금지 — ns 접두 치환 정규식이 '?'를 처리 못함
  (not (= (vault-get-config) nil)))

(defn vault-setup [master]
  (if (vault-is-setup)
    false
    (let [salt    (random_bytes 16)
          dek     (random_bytes 32)
          kek     (scrypt_kdf master salt)
          wrapped (aes_encrypt dek kek)]
      (db-exec VAULT-DB
        "INSERT INTO vault_config (id,kdf_salt,wrapped_dek) VALUES (1,?,?)"
        [salt wrapped])
      true)))

; ── 인메모리 세션 (요청 간 유지되는 전역 atom) ──────────────────
(defn vault-session-new [dek]
  (let [sid (uuid)]
    (swap! vault-sessions assoc sid {"dek" dek "exp" (+ (now-ms) SESSION-TTL-MS)})
    sid))

(defn vault-session-dek [sid]
  (let [s (get @vault-sessions sid)]
    (if (= s nil)
      nil
      (if (> (get s "exp") (now-ms))
        (get s "dek")
        (do (swap! vault-sessions dissoc sid) nil)))))

(defn vault-session-touch [sid]
  (let [s (get @vault-sessions sid)]
    (when (not (= s nil))
      (swap! vault-sessions assoc sid (assoc s "exp" (+ (now-ms) SESSION-TTL-MS))))))

(defn vault-lock [sid]
  (do (swap! vault-sessions dissoc sid) true))

; ── unlock: 마스터로 DEK 복호 → 세션 발급 (실패 시 nil) ──────────
(defn vault-unlock [master]
  (let [cfg (vault-get-config)]
    (if (= cfg nil)
      nil
      (let [kek (scrypt_kdf master (get cfg "kdf_salt"))
            dek (aes_decrypt (get cfg "wrapped_dek") kek)]
        (if (= dek nil)
          nil
          (vault-session-new dek))))))

(defn vault-change-master [sid old-master new-master]
  (let [dek (vault-session-dek sid)
        cfg (vault-get-config)]
    (if (or (= dek nil) (= cfg nil))
      false
      (let [old-kek (scrypt_kdf old-master (get cfg "kdf_salt"))
            check   (aes_decrypt (get cfg "wrapped_dek") old-kek)]
        (if (= check nil)
          false
          (let [new-salt    (random_bytes 16)
                new-kek     (scrypt_kdf new-master new-salt)
                new-wrapped (aes_encrypt dek new-kek)]
            (db-exec VAULT-DB
              "UPDATE vault_config SET kdf_salt=?, wrapped_dek=? WHERE id=1"
              [new-salt new-wrapped])
            true))))))

; ── 강력 비밀번호 생성기 (서버 crypto random) ──────────────────
(defn vault-gen-password []
  (let [chars "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*-_"
        n     (length chars)]
    (reduce
      (fn [acc x]
        (let [i (random_int 0 (- n 1))]
          (str acc (str-slice chars i (+ i 1)))))
      ""
      (range 0 20))))

; ── 항목 CRUD (DEK로 직접 암복호화, scrypt 불필요) ──────────────
(defn vault-add [sid label username password url note category]
  (let [dek (vault-session-dek sid)]
    (if (= dek nil)
      false
      (do
        (db-exec VAULT-DB
          "INSERT INTO vault_items (label,username,password_enc,url,note,category) VALUES (?,?,?,?,?,?)"
          [label username (aes_encrypt password dek) url note category])
        true))))

(defn vault-all-items [sid]
  (let [dek (vault-session-dek sid)]
    (if (= dek nil)
      nil
      (let [raw (db-query VAULT-DB
                  "SELECT * FROM vault_items ORDER BY category ASC, label ASC" [])]
        ; db row 는 JS 네이티브 객체라 obj-merge/obj-omit 미동작 → 명시적 맵 구성.
        ; password_enc 는 응답에서 자연히 제외(복호화한 password 만 노출).
        (map
          (fn [item]
            {"id"       (get item "id")
             "label"    (get item "label")
             "username" (get item "username")
             "url"      (get item "url")
             "note"     (get item "note")
             "category" (get item "category")
             "password" (or (aes_decrypt (get item "password_enc") dek) "")})
          raw)))))

(defn vault-delete [sid id]
  (if (= (vault-session-dek sid) nil)
    false
    (do
      (db-exec VAULT-DB "DELETE FROM vault_items WHERE id=?" [(str-to-num id)])
      true)))
; ── end: pages/vault/_db.flx ──
(vault-init)

(defn page_vault_api__inner [req]
  (let [token (or (server-req-query req "token") "")
        items (vault-all-items token)]
    (if (= items nil)
      (server-json {"ok" false "locked" true} 401)
      (do
        (vault-session-touch token)
        (server-json {"ok" true "items" items})))))

(defn page_vault_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      ; 최초 설정 여부 — UI 분기용 (인증 불필요)
      (= action "status")
        (server-json {"ok" true "setup" (vault-is-setup)})

      ; 최초 마스터 설정 (config 없을 때만)
      (= action "setup")
        (let [master (or (get body "master") "")]
          (if (< (length (str-trim master)) 4)
            (server-json {"ok" false "error" "마스터 비밀번호는 4자 이상이어야 합니다"} 400)
            (if (vault-setup master)
              (server-json {"ok" true})
              (server-json {"ok" false "error" "이미 금고가 설정되어 있습니다"} 409))))

      ; 잠금 해제
      (= action "unlock")
        (let [master (or (get body "password") "")
              sid    (vault-unlock master)]
          (if (= sid nil)
            (server-json {"ok" false "error" "비밀번호가 틀렸거나 금고가 미설정입니다"} 401)
            (server-json {"ok" true "token" sid})))

      ; 잠금
      (= action "lock")
        (let [token (or (get body "token") "")]
          (vault-lock token)
          (server-json {"ok" true}))

      ; 강력 비밀번호 생성 (잠금해제 세션 필요)
      (= action "gen-password")
        (let [token (or (get body "token") "")]
          (if (= (vault-session-dek token) nil)
            (server-json {"ok" false "locked" true} 401)
            (server-json {"ok" true "password" (vault-gen-password)})))

      ; 마스터 변경
      (= action "change-master")
        (let [token (or (get body "token") "")
              old   (or (get body "old") "")
              new   (or (get body "new") "")]
          (if (< (length (str-trim new)) 4)
            (server-json {"ok" false "error" "새 마스터는 4자 이상이어야 합니다"} 400)
            (if (vault-change-master token old new)
              (server-json {"ok" true})
              (server-json {"ok" false "error" "현재 마스터가 틀렸거나 세션이 만료되었습니다"} 401))))

      ; 항목 추가
      (= action "add")
        (let [token (or (get body "token") "")]
          (if (= (vault-session-dek token) nil)
            (server-json {"ok" false "locked" true} 401)
            (let [label    (or (get body "label") "")
                  username (or (get body "username") "")
                  password (or (get body "password") "")
                  url      (or (get body "url") "")
                  note     (or (get body "note") "")
                  category (or (get body "category") "기타")]
              (if (= (str-trim label) "")
                (server-json {"ok" false "error" "레이블 필요"} 400)
                (if (vault-add token label username password url note category)
                  (server-json {"ok" true})
                  (server-json {"ok" false "locked" true} 401))))))

      ; 항목 삭제
      (= action "delete")
        (let [token (or (get body "token") "")
              id    (get body "id")]
          (if (= (vault-session-dek token) nil)
            (server-json {"ok" false "locked" true} 401)
            (if (= id nil)
              (server-json {"ok" false "error" "id 필요"} 400)
              (do
                (vault-delete token id)
                (server-json {"ok" true})))))

      true
        (server-json {"ok" false "error" (str "unknown action: " action)} 400))))
(defn page_vault_api [req]
  (try (page_vault_api__inner req)
    (catch $err (dev-error-page "/vault/api" (str $err)))))
(defn page_vault_api_post [req]
  (try (page_vault_api_post__inner req)
    (catch $err (dev-error-page "/vault/api [POST]" (str $err)))))

; ── pages/vault/index.flx ──
; pages/vault/index.flx — 비밀번호 금고 (envelope 암호화)
; 보안: 마스터 평문은 저장 안 함. 항목은 AES-256-GCM. 잠금해제 15분 후 자동 잠김.
; island 안전규칙: 문자열 안 ')' 회피, 삼중따옴표 금지, 1글자 람다 변수 금지, JSON은 "키".



(defn page_vault_index__inner [req]
  (layout-html "🔐 Vault"
    (str
      (h "div" {:style "background:linear-gradient(135deg,#374151,#1f2937);color:white;padding:28px 24px;text-align:center"}
        (str
          (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "🔐 Vault")
          (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"} "비밀번호 금고 · AES-256-GCM 암호화")))
      "<div id='island-vaultapp-0'></div>"
      "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_badge=\"ui_badge__e18b\";\nvar ui_badge_green=\"ui_badge_green__c324\";\nvar ui_badge_red=\"ui_badge_red__d2e1\";\nvar ui_badge_yellow=\"ui_badge_yellow__e771\";\nvar ui_badge_blue=\"ui_badge_blue__59fd\";\nvar ui_badge_gray=\"ui_badge_gray__f560\";\nvar ui_avatar=\"ui_avatar__2815\";\nvar ui_divider=\"ui_divider__22a8\";\nvar ui_spinner=\"ui_spinner__719f\";\nvar ui_input_wrap=\"ui_input_wrap__d034\";\nvar ui_input_label=\"ui_input_label__ebfb\";\nvar ui_input_field=\"ui_input_field__ac1d\";\nvar ui_textarea_field=\"ui_textarea_field__1eab\";\nvar ui_checkbox_wrap=\"ui_checkbox_wrap__7110\";\nvar ui_checkbox_input=\"ui_checkbox_input__d495\";\nvar ui_form_group=\"ui_form_group__83c7\";\nvar ui_card=\"ui_card__5be5\";\nvar ui_alert=\"ui_alert__3457\";\nvar ui_alert_success=\"ui_alert_success__99d7\";\nvar ui_alert_error=\"ui_alert_error__f8d5\";\nvar ui_alert_warning=\"ui_alert_warning__627e\";\nvar ui_alert_info=\"ui_alert_info__18ba\";\nvar ui_empty=\"ui_empty__272c\";\nvar ui_progress_wrap=\"ui_progress_wrap__d67f\";\nvar ui_progress_bar=\"ui_progress_bar__675c\";\nvar ui_table_wrap=\"ui_table_wrap__8d07\";\nvar ui_stat_card=\"ui_stat_card__b4e2\";\nvar ui_tag=\"ui_tag__b0e1\";\nvar about_card=\"about_card__70b3\";\nvar about_title=\"about_title__1247\";\nvar stats_container=\"stats_container__aea6\";\nvar stats_grid=\"stats_grid__63be\";\nvar stat_card=\"stat_card__cae2\";\nvar stat_value=\"stat_value__3433\";\nvar stat_label=\"stat_label__5402\";\nvar error_list=\"error_list__f9d4\";\nvar error_item=\"error_item__cd51\";\nvar error_type_error=\"error_type_error__7600\";\nvar error_type_warn=\"error_type_warn__e060\";\nvar error_type_promise=\"error_type_promise__8dc9\";\nvar error_type_console=\"error_type_console__ea09\";\nvar form_box=\"form_box__8f33\";\nvar page_wrap=\"page_wrap__2009\";\nvar counter_page=\"counter_page__35ea\";\nvar counter_box=\"counter_box__4a74\";\nvar counter_btn=\"counter_btn__d6e9\";\nvar counter_num=\"counter_num__57f7\";\nvar counter_la