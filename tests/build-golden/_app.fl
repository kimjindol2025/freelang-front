(defn page_vault_index [req]
  (try (page_vault_index__inner req)
    (catch $err (dev-error-page "/vault" (str $err)))))

; ── pages/api/notes/[id]/delete.flx ──
; POST /api/notes/:id/delete
(defn page_api_notes_id_delete__inner [req]
  (let [id (get (get req "params") "id")
        db {:type "sqlite" :path "/tmp/fl-notes.sqlite"}]
    (db-exec db "DELETE FROM notes WHERE id=?" [id])
    (server-json {:ok true})))
(defn page_api_notes_id_delete [req]
  (try (page_api_notes_id_delete__inner req)
    (catch $err (dev-error-page "/api/notes/:id/delete" (str $err)))))

; ── pages/api/notes/[id]/pin.flx ──
; POST /api/notes/:id/pin
(defn page_api_notes_id_pin__inner [req]
  (let [id (get (get req "params") "id")
        db {:type "sqlite" :path "/tmp/fl-notes.sqlite"}]
    (db-exec db
      "UPDATE notes SET pinned = CASE WHEN pinned=1 THEN 0 ELSE 1 END WHERE id=?" [id])
    (server-json {:ok true})))
(defn page_api_notes_id_pin [req]
  (try (page_api_notes_id_pin__inner req)
    (catch $err (dev-error-page "/api/notes/:id/pin" (str $err)))))

; ── pages/contacts/[id].flx ──
; pages/contacts/[id].flx — 연락처 상세/편집 + 활동 타임라인
; GET  /contacts/:id
; POST /contacts/:id  (action: update | add-activity | del-activity)

; (load already inlined)
(contacts-init)

; ── 헬퍼: 날짜 표시 ─────────────────────────────────────────────
(defn days-ago-label [last-contact]
  (if (or (= last-contact nil) (= (str-trim last-contact) ""))
    ""
    (str "마지막 연락: " last-contact)))

; ── 활동 한 줄 렌더 ──────────────────────────────────────────────
(defn activity-row [arow]
  (h "div" {:style "display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid #f1f5f9"}
    (str
      (h "div" {:style "font-size:.78rem;color:#0891b2;font-weight:600;white-space:nowrap;min-width:90px"}
        (get arow "log_date"))
      (h "div" {:style "flex:1;font-size:.88rem;color:#374151;white-space:pre-wrap"}
        (html-escape (get arow "content")))
      (h "form" {:method "POST" :style "margin:0"}
        (str
          (h! "input" {:type "hidden" :name "action" :value "del-activity"})
          (h! "input" {:type "hidden" :name "activity_id" :value (str (get arow "id"))})
          (h "button" {:type "submit" :title "삭제"
                       :style "background:none;border:none;color:#cbd5e1;cursor:pointer;font-size:1rem;line-height:1"}
            "×"))))))

; ── 활동 목록: 연월 헤더로 그루핑 ───────────────────────────────
(defn group-activities [acts]
  (if (= (length acts) 0)
    []
    (let [grouped (reduce
                    (fn [acc arow]
                      (let [dt       (or (get arow "log_date") "")
                            ym       (if (> (length dt) 6) (str-slice dt 0 7) dt)
                            existing (get acc ym)]
                        (if existing
                          (assoc acc ym (conj existing arow))
                          (assoc acc ym [arow]))))
                    {}
                    acts)
          keys    (sort (js-keys grouped))]
      (map (fn [k] {:ym k :rows (get grouped k)}) (reverse keys)))))

(defn render-timeline [acts]
  (if (= (length acts) 0)
    (h "div" {:style "text-align:center;padding:24px;color:#cbd5e1;font-size:.85rem"} "기록된 활동이 없습니다")
    (h "div" {}
      (arr-join
        (map
          (fn [grp]
            (h "div" {:style "margin-bottom:8px"}
              (str
                (h "div" {:style "font-size:.75rem;font-weight:700;color:#9ca3af;padding:6px 0;border-bottom:1px solid #e5e7eb;margin-bottom:4px"}
                  (get grp "ym"))
                (arr-join (map activity-row (get grp "rows")) ""))))
          (group-activities acts))
        ""))))

(defn page_contacts_id__inner [req]
  (let [id (server-req-param req "id")
        cc (contacts-by-id id)]
    (if (= cc nil)
      (server-redirect "/contacts")
      (let [acts       (contacts-activities-by-contact id)
            job-title  (or (get cc "job_title") "")
            tags-val   (or (get cc "tags") "")
            met-at     (or (get cc "met_at") "")
            remind-val (str (or (get cc "remind_days") 0))
            linked     (or (get cc "linked_url") "")
            last-c     (or (get cc "last_contact_at") "")]
        (layout-html (get cc "name")
          (h "div" {:style "max-width:580px;margin:0 auto;padding:32px 24px"}
            (str
              ; 브레드크럼
              (h "div" {:style "display:flex;align-items:center;gap:12px;margin-bottom:24px"}
                (str
                  (h "a" {:href "/contacts" :style "color:#6366f1;text-decoration:none;font-size:.9rem"} "← 연락처")
                  (h "span" {:style "color:#d1d5db"} "/")
                  (h "span" {:style "font-size:.9rem;color:#374151;font-weight:600"} (get cc "name"))))

              ; 사람 카드 헤더
              (h "div" {:style "background:white;border-radius:16px;padding:24px;box-shadow:0 2px 8px rgba(0,0,0,.08);margin-bottom:16px"}
                (str
                  (h "div" {:style "display:flex;gap:16px;align-items:flex-start;margin-bottom:16px"}
                    (str
                      (h "div" {:style "width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:white;font-weight:800;font-size:1.5rem;flex-shrink:0"}
                        (str-slice (get cc "name") 0 1))
                      (h "div" {:style "flex:1"}
                        (str
                          (h "h1" {:style "font-size:1.3rem;font-weight:800;margin:0 0 2px"} (get cc "name"))
                          (when (not (= job-title ""))
                            (h "div" {:style "font-size:.85rem;color:#6b7280;margin-bottom:2px"} job-title))
                          (when (not (= (or (get cc "company") "") ""))
                            (h "div" {:style "font-size:.85rem;color:#6b7280"} (get cc "company")))
                          (when (not (= met-at ""))
                            (h "div" {:style "font-size:.78rem;color:#9ca3af;margin-top:4px"}
                              (str "📍 " met-at)))
                          (when (not (= last-c ""))
                            (h "div" {:style "font-size:.78rem;color:#0891b2;margin-top:4px"}
                              (str "🕐 " (days-ago-label last-c))))
                          (when (not (= linked ""))
                            (h "a" {:href linked :target "_blank" :style "font-size:.78rem;color:#6366f1;margin-top:4px;display:block"}
                              "🔗 링크"))))))
                  (when (not (= tags-val ""))
                    (h "div" {:style "display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px"}
                      (arr-join
                        (map (fn [tg]
                               (when (not (= (str-trim tg) ""))
                                 (h "span" {:style "font-size:.75rem;background:#ede9fe;color:#6d28d9;padding:2px 8px;border-radius:12px"}
                                   (str "#" (str-trim tg)))))
                             (str-split tags-val ","))
                        "")))
                  ; 연락 주기 설정
                  (h "div" {:style "display:flex;align-items:center;gap:10px;padding:10px 14px;background:#f8fafc;border-radius:10px"}
                    (str
                      (h "span" {:style "font-size:.85rem;color:#6b7280;flex:1"} "연락 주기")
                      (h "form" {:method "POST" :style "display:flex;align-items:center;gap:6px"}
                        (str
                          (h! "input" {:type "hidden" :name "action" :value "save-remind"})
                          (h "select" {:name "remind_days"
                                       :style "padding:5px 10px;border:1px solid #d1d5db;border-radius:8px;font-size:.85rem;background:white"}
                            (arr-join
                              (map
                                (fn [opt]
                                  (let [val (get opt "v") lbl (get opt "l")]
                                    (if (= val remind-val)
                                      (str "<option value='" val "' selected>" lbl "</option>")
                                      (str "<option value='" val "'>" lbl "</option>"))))
                                [{"v" "0" "l" "없음"} {"v" "7" "l" "7일"} {"v" "14" "l" "14일"}
                                 {"v" "30" "l" "30일"} {"v" "60" "l" "60일"} {"v" "90" "l" "90일"}])
                              ""))
                          (h "button" {:type "submit"
                                       :style "padding:5px 12px;background:#6366f1;color:white;border:none;border-radius:8px;font-size:.8rem;cursor:pointer"}
                            "저장")))))))

              ; 편집 폼
              (h "details" {:style "background:white;border-radius:16px;box-shadow:0 2px 8px rgba(0,0,0,.08);margin-bottom:16px"}
                (str
                  (h "summary" {:style "padding:16px 24px;cursor:pointer;font-weight:700;font-size:.95rem;list-style:none;display:flex;align-items:center;gap:8px"}
                    (str "✏️ 정보 편집"))
                  (h "div" {:style "padding:0 24px 24px"}
                    (h "form" {:method "POST" :style "display:flex;flex-direction:column;gap:12px"}
                      (str
                        (h! "input" {:type "hidden" :name "action" :value "update"})
                        (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px"}
                          (str
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "이름 *")
                                (h! "input" {:type "text" :name "name" :value (get cc "name") :required "true"
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "직함")
                                (h! "input" {:type "text" :name "job_title" :value job-title
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))))
                        (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px"}
                          (str
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "전화번호")
                                (h! "input" {:type "tel" :name "phone" :value (or (get cc "phone") "")
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "이메일")
                                (h! "input" {:type "email" :name "email" :value (or (get cc "email") "")
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))))
                        (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px"}
                          (str
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "회사")
                                (h! "input" {:type "text" :name "company" :value (or (get cc "company") "")
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "그룹")
                                (h "select" {:name "group_name"
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"}
                                  (arr-join
                                    (map
                                      (fn [gg]
                                        (if (= gg (or (get cc "group_name") "일반"))
                                          (str "<option value='" gg "' selected>" gg "</option>")
                                          (str "<option value='" gg "'>" gg "</option>")))
                                      ["일반" "가족" "친구" "직장" "비즈니스"])
                                    ""))))))
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "태그")
                            (h! "input" {:type "text" :name "tags" :value tags-val :placeholder "개발자,부산 (쉼표 구분)"
                                         :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))
                        (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px"}
                          (str
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "만난 곳")
                                (h! "input" {:type "text" :name "met_at" :value met-at
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))
                            (h "div" {}
                              (str
                                (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "링크")
                                (h! "input" {:type "url" :name "linked_url" :value linked :placeholder "https://linkedin.com/in/..."
                                             :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem"})))))
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "메모")
                            (h "textarea" {:name "memo" :rows "3"
                                           :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem;resize:none"}
                              (or (get cc "memo") ""))))
                        (h! "input" {:type "hidden" :name "remind_days" :value remind-val})
                        (h "button" {:type "submit"
                                     :style "background:#6366f1;color:white;border:none;border-radius:8px;padding:10px;font-weight:700;cursor:pointer"}
                          "저장"))))))

              ; 활동 타임라인
              (h "div" {:style "background:white;border-radius:16px;padding:24px 28px;box-shadow:0 2px 8px rgba(0,0,0,.08)"}
                (str
                  (h "h2" {:style "font-size:1rem;font-weight:700;margin:0 0 4px"} "활동 타임라인")
                  (h "p" {:style "font-size:.78rem;color:#9ca3af;margin:0 0 16px"}
                    "통화·미팅 등을 직접 기록하세요. 기록 시 마지막 연락일이 자동 갱신됩니다.")
                  (h "form" {:method "POST" :style "display:flex;gap:8px;margin-bottom:16px"}
                    (str
                      (h! "input" {:type "hidden" :name "action" :value "add-activity"})
                      (h! "input" {:type "date" :name "log_date"
                                   :style "padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.85rem"})
                      (h! "input" {:type "text" :name "content" :placeholder "예: 견적 문의 전화" :required "true"
                                   :style "flex:1;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem;min-width:0"})
                      (h "button" {:type "submit"
                                   :style "background:#0891b2;color:white;border:none;border-radius:8px;padding:9px 16px;font-weight:600;cursor:pointer;white-space:nowrap"}
                        "기록")))
                  (render-timeline acts)))))
          req)))))

(defn page_contacts_id_post__inner [req]
  (let [id     (server-req-param req "id")
        cc     (contacts-by-id id)
        action (form-get req "action")]
    (if (= cc nil)
      (server-redirect "/contacts")
      (cond
        (= action "add-activity")
          (let [dt (form-get req "log_date")
                ct (form-get req "content")]
            (when (not (= (str-trim ct) ""))
              (contacts-add-activity id dt ct))
            (server-redirect (str "/contacts/" id)))

        (= action "del-activity")
          (do
            (contacts-delete-activity (form-get req "activity_id"))
            (server-redirect (str "/contacts/" id)))

        (= action "save-remind")
          (do
            (contacts-save-remind id (or (form-get req "remind_days") "0"))
            (server-redirect (str "/contacts/" id)))

        true ; update
          (let [nm          (form-get req "name")
                phone       (or (form-get req "phone") "")
                email       (or (form-get req "email") "")
                company     (or (form-get req "company") "")
                memo        (or (form-get req "memo") "")
                group       (or (form-get req "group_name") "일반")
                job-title   (or (form-get req "job_title") "")
                tags-val    (or (form-get req "tags") "")
                met-at      (or (form-get req "met_at") "")
                remind-days (or (form-get req "remind_days") "0")
                linked-url  (or (form-get req "linked_url") "")]
            (if (= (str-trim nm) "")
              (server-redirect (str "/contacts/" id "?error=이름을 입력하세요"))
              (do
                (contacts-update id nm phone email company memo group job-title tags-val met-at remind-days linked-url)
                (server-redirect (str "/contacts/" id)))))))))
(defn page_contacts_id [req]
  (try (page_contacts_id__inner req)
    (catch $err (dev-error-page "/contacts/:id" (str $err)))))
(defn page_contacts_id_post [req]
  (try (page_contacts_id_post__inner req)
    (catch $err (dev-error-page "/contacts/:id [POST]" (str $err)))))

; ── pages/flash/[id].flx ──
; pages/flash/[id].flx — 덱 카드 편집
; GET  /flash/:id
; POST /flash/:id

; (load already inlined)
(flash-init)

(defn page_flash_id__inner [req]
  (let [id    (server-req-param req "id")
        deck  (flash-deck-by-id id)
        cards (flash-cards-by-deck id)]
    (if (= deck nil)
      (server-redirect "/flash")
      (layout-html (str (get deck "name") " — 카드 편집")
        (h "div" {:style "max-width:720px;margin:0 auto;padding:24px"}
          (str
            (h "div" {:style "display:flex;align-items:center;gap:12px;margin-bottom:24px"}
              (str
                (h "a" {:href "/flash" :style "color:#f59e0b;text-decoration:none;font-size:.9rem"} "← 덱 목록")
                (h "h1" {:style "font-size:1.3rem;font-weight:800;margin:0;flex:1"} (get deck "name"))
                (h "a" {:href (str "/flash/study?deck=" id)
                        :style "background:#f59e0b;color:white;padding:8px 16px;border-radius:8px;text-decoration:none;font-weight:700;font-size:.85rem"}
                  "▶ 학습")))
            ; 카드 추가 폼
            (h "div" {:style "background:white;border-radius:14px;padding:20px;margin-bottom:20px;box-shadow:0 1px 4px rgba(0,0,0,.07)"}
              (str
                (h "h3" {:style "font-size:.9rem;font-weight:700;margin:0 0 12px"} "카드 추가")
                (h "form" {:method "POST"}
                  (str
                    (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px"}
                      (str
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "앞면 (질문)")
                            (h "textarea" {:name "front" :rows "3" :required "true"
                                           :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem;resize:none"}
                              "")))
                        (h "div" {}
                          (str
                            (h "label" {:style "font-size:.78rem;color:#6b7280;display:block;margin-bottom:3px"} "뒷면 (답)")
                            (h "textarea" {:name "back" :rows "3" :required "true"
                                           :style "width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.9rem;resize:none"}
                              "")))))
                    (h! "input" {:type "hidden" :name "action" :value "add"})
                    (h "button" {:type "submit"
                                 :style "background:#f59e0b;color:white;border:none;border-radius:8px;padding:8px 24px;font-weight:600;cursor:pointer"}
                      "+ 카드 추가")))))
            ; 카드 목록
            (h "div" {:style "font-size:.8rem;color:#9ca3af;margin-bottom:10px"}
              (str (length cards) " 카드"))
            (if (= (length cards) 0)
              (h "div" {:style "background:white;border-radius:12px;padding:32px;text-align:center;color:#9ca3af"}
                "카드를 추가해보세요")
              (h "div" {:style "display:flex;flex-direction:column;gap:8px"}
                (arr-join
                  (map
                    (fn [c]
                      (h "div" {:style "background:white;border-radius:10px;padding:14px 16px;box-shadow:0 1px 3px rgba(0,0,0,.06);display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:start"}
                        (str
                          (h "div" {}
                            (str
                              (h "div" {:style "font-size:.72rem;color:#f59e0b;font-weight:700;margin-bottom:4px"} "앞면")
                              (h "p" {:style "margin:0;font-size:.88rem;line-height:1.5"} (get c "front"))))
                          (h "div" {}
                            (str
                              (h "div" {:style "font-size:.72rem;color:#6b7280;font-weight:700;margin-bottom:4px"} "뒷면")
                              (h "p" {:style "margin:0;font-size:.88rem;line-height:1.5"} (get c "back"))))
                          (h "div" {:style "display:flex;flex-direction:column;gap:4px;align-items:flex-end"}
                            (str
                              (h "span" {:style "font-size:.68rem;color:#9ca3af;white-space:nowrap"}
                                (str "다음: " (get c "next_at")))
                              (h "form" {:method "POST"}
                                (str
                                  (h! "input" {:type "hidden" :name "card_id" :value (str (get c "id"))})
                                  (h! "input" {:type "hidden" :name "action" :value "delete"})
                                  (h "button" {:type "submit"
                                               :style "background:none;border:1px solid #fecaca;border-radius:6px;color:#ef4444;cursor:pointer;padding:3px 8px;font-size:.75rem"}
                                    "삭제"))))))))
                  cards)
                "")))))
        req))))

(defn page_flash_id_post__inner [req]
  (let [id     (server-req-param req "id")
        action (form-get req "action")]
    (cond
      (= action "add")
        (let [front (form-get req "front")
              back  (form-get req "back")]
          (if (or (= (str-trim front) "") (= (str-trim back) ""))
            (server-redirect (str "/flash/" id))
            (do
              (flash-add-card id front back)
              (server-redirect (str "/flash/" id)))))

      (= action "delete")
        (let [card-id (form-get req "card_id")]
          (do
            (flash-delete-card card-id)
            (server-redirect (str "/flash/" id))))

      true
        (server-redirect (str "/flash/" id)))))
(defn page_flash_id [req]
  (try (page_flash_id__inner req)
    (catch $err (dev-error-page "/flash/:id" (str $err)))))
(defn page_flash_id_post [req]
  (try (page_flash_id_post__inner req)
    (catch $err (dev-error-page "/flash/:id [POST]" (str $err)))))

; ── pages/goals/[id].flx ──
; pages/goals/[id].flx — 목표 상세/KR 관리
; GET  /goals/:id
; POST /goals/:id

; (load already inlined)
(goals-init)

(defn page_goals_id__inner [req]
  (let [id  (server-req-param req "id")
        g   (goals-by-id id)
        krs (goals-krs-by-goal id)
        p   (goals-goal-progress id)]
    (if (= g nil)
      (server-redirect "/goals")
      (layout-html (get g "title")
        (h "div" {:style "max-width:640px;margin:0 auto;padding:24px"}
          (str
            (h "a" {:href "/goals" :style "color:#6366f1;text-decoration:none;font-size:.9rem;display:inline-block;margin-bottom:20px"} "← 목표 목록")
            (h "div" {:style "background:white;border-radius:16px;padding:28px;box-shadow:0 2px 8px rgba(0,0,0,.08);margin-bottom:16px"}
              (str
                (h "div" {:style "display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px"}
                  (str
                    (h "div" {}
                      (str
                        (h "h1" {:style "font-size:1.3rem;font-weight:800;margin:0 0 6px"} (get g "title"))
                        (h "span" {:style "font-size:.78rem;background:#ede9fe;color:#7c3aed;padding:2px 8px;border-radius:4px"}
                          (get g "period"))))
                    (h "div" {:style "font-size:2rem;font-weight:900;color:#6366f1"} (str p "%"))))
                (h "div" {:style "height:8px;background:#f3f4f6;border-radius:4px;overflow:hidden;margin-bottom:24px"}
                  (h "div" {:style (str "height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:4px;width:" p "%")} ""))
                ; KR 목록
                (h "h3" {:style "font-size:.9rem;font-weight:700;margin:0 0 12px;color:#6b7280"} "Key Results")
                (if (= (length krs) 0)
                  (h "p" {:style "color:#9ca3af;font-size:.85rem"} "아직 KR이 없습니다")
                  (h "div" {:style "display:flex;flex-direction:column;gap:12px;margin-bottom:20px"}
                    (arr-join
                      (map
                        (fn [kr]
                          (let [kp (if (> (get kr "target") 0)
                                     (floor (* (/ (get kr "current") (get kr "target")) 100))
                                     0)
                                c  (if (>= kp 80) "#10b981"
                                     (if (>= kp 50) "#f59e0b" "#ef4444"))]
                            (h "div" {:style "border:1px solid #f3f4f6;border-radius:10px;padding:14px 16px"}
                              (str
                                (h "div" {:style "display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"}
                                  (str
                                    (h "span" {:style "font-size:.9rem;font-weight:600"} (get kr "title"))
                                    (h "span" {:style (str "font-size:.8rem;font-weight:700;color:" c)} (str kp "%"))))
                                (h "div" {:style "height:4px;background:#f3f4f6;border-radius:2px;overflow:hidden;margin-bottom:8px"}
                                  (h "div" {:style (str "height:100%;background:" c ";width:" kp "%")} ""))
                                (h "form" {:method "POST" :style "display:flex;gap:8px;align-items:center"}
                                  (str
                                    (h! "input" {:type "hidden" :name "kr_id" :value (str (get kr "id"))})
                                    (h! "input" {:type "number" :name "current" :value (str (get kr "current"))
                                                 :step "0.1" :max (str (get kr "target"))
                                                 :style "flex:1;padding:6px 10px;border:1px solid #d1d5db;border-radius:7px;font-size:.85rem"})
                                    (h "span" {:style "font-size:.8rem;color:#9ca3af"}
                                      (str "/ " (get kr "target") " " (get kr "unit")))
                                    (h! "input" {:type "hidden" :name "action" :value "update-kr"})
                                    (h "button" {:type "submit"
                                                 :style "padding:6px 14px;background:#6366f1;color:white;border:none;border-radius:7px;cursor:pointer;font-size:.8rem;font-weight:600"}
                                      "업데이트")))))))
                        krs)
                      "")))
                ; KR 추가 폼
                (h "h3" {:style "font-size:.9rem;font-weight:700;margin:0 0 12px;color:#6b7280;border-top:1px solid #f3f4f6;padding-top:16px"}
                  "KR 추가")
                (h "form" {:method "POST"}
                  (str
                    (h "div" {:style "display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;margin-bottom:8px"}
                      (str
                        (h! "input" {:type "text" :name "kr_title" :placeholder "KR 제목"
                                     :style "padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.85rem"})
                        (h! "input" {:type "number" :name "target" :placeholder "목표값" :value "100"
                                     :style "padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.85rem"})
                        (h! "input" {:type "text" :name "unit" :placeholder "단위" :value "%"
                                     :style "padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:.85rem"})))
                    (h! "input" {:type "hidden" :name "action" :value "add-kr"})
                    (h "button" {:type "submit"
                                 :style "width:100%;padding:8px;background:#10b981;color:white;border:none;border-radius:8px;cursor:pointer;font-weight:600"}
                      "+ KR 추가")))))
          ))
        req))))

(defn page_goals_id_post__inner [req]
  (let [id     (server-req-param req "id")
        action (form-get req "action")]
    (cond
      (= action "add-kr")
        (let [title  (form-get req "kr_title")
              target (form-get req "target")
              unit   (form-get req "unit")]
          (if (= (str-trim title) "")
            (server-redirect (str "/goals/" id))
            (do
              (goals-add-kr id title target unit)
              (server-redirect (str "/goals/" id)))))

      (= action "update-kr")
        (let [kr-id   (form-get req "kr_id")
              current (form-get req "current")]
          (do
            (goals-update-kr kr-id current)
            (server-redirect (str "/goals/" id))))

      true
        (server-redirect (str "/goals/" id)))))
(defn page_goals_id [req]
  (try (page_goals_id__inner req)
    (catch $err (dev-error-page "/goals/:id" (str $err)))))
(defn page_goals_id_post [req]
  (try (page_goals_id_post__inner req)
    (catch $err (dev-error-page "/goals/:id [POST]" (str $err)))))

; ── pages/reading/[id].flx ──
; pages/reading/[id].flx — 책 상세 + 편집
; GET  /reading/:id
; POST /reading/:id

; (load already inlined)
(reading-init)

; 별점 텍스트 (HTML 태그 미사용 — 색상은 부모 div로)
(defn reading-stars [rating]
  (arr-join
    (map (fn [idx] (if (<= idx rating) "★" "☆")) [1 2 3 4 5])
    ""))

(defn reading-status-badge [status]
  (cond
    (= status "reading") (h "span" {:style "padding:4px 12px;border-radius:99px;font-size:.78rem;font-weight:700;background:#ede9fe;color:#7c3aed"} "📖 읽는 중")
    (= status "done")    (h "span" {:style "padding:4px 12px;border-radius:99px;font-size:.78rem;font-weight:700;background:#dcfce7;color:#16a34a"} "✅ 완독")
    true                 (h "span" {:style "padding:4px 12px;border-radius:99px;font-size:.78rem;font-weight:700;background:#fef3c7;color:#d97706"} "📌 읽고 싶어요")))

(defn reading-meta-row [label value]
  (if (not (= value ""))
    (h "div" {:style "display:flex;gap:12px;align-items:baseline;margin-bottom:8px"}
      (str
        (h "span" {:style "font-size:.75rem;color:var(--c-muted);width:64px;flex-shrink:0"} label)
        (h "span" {:style "font-size:.9rem;color:var(--c-text);font-weight:500"} value)))
    ""))

(defn page_reading_id__inner [req]
  (let [id  (server-req-param req "id")
        bk  (reading-by-id id)]
    (if (= bk nil)
      (server-redirect "/reading")
      (let [progress (if (> (get bk "pages_total") 0)
                       (floor (* (/ (get bk "pages_read") (get bk "pages_total")) 100))
                       0)]
        (layout-html (get bk "title")
          (h "div" {:style "max-width:640px;margin:0 auto;padding:24px"}
            (str
              (h "a" {:href "/reading" :style "color:#7c3aed;text-decoration:none;font-size:.9rem;display:inline-block;margin-bottom:20px;transition:color .15s"} "← 서재로")

              (h "div" {:style "background:var(--c-surface);border:1px solid var(--c-border);border-radius:16px;overflow:hidden;box-shadow:0 2px 12px oklch(0 0 0 / .08)"}
                (str
                  ; 커버 헤더
                  (h "div" {:style (str "background:" (get bk "cover_color") ";padding:32px;display:flex;align-items:flex-end;gap:20px")}
                    (str
                      (h "div" {:style "font-size:3rem"} "📖")
                      (h "div" {:style "color:white;flex:1"}
                        (str
                          (h "h1" {:style "font-size:1.4rem;font-weight:800;margin:0 0 4px"} (get bk "title"))
                          (h "p" {:style "opacity:.85;margin:0;font-size:.9rem"}
                            (if (= (get bk "author") "") "저자 미상" (get bk "author")))))))

                  (h "div" {:style "padding:24px"}
                    (str
                      ; 상태 배지 + 페이지 정보
                      (h "div" {:style "display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center"}
                        (str
                          (reading-status-badge (get bk "status"))
                          (if (> (get bk "pages_total") 0)
                            (h "span" {:style "padding:4px 12px;border-radius:99px;font-size:.78rem;background:var(--c-border);color:var(--c-muted)"}
                              (str (get bk "pages_read") "/" (get bk "pages_total") "p · " progress "%"))
                            "")
                          (if (not (= (get bk "genre") ""))
                            (h "span" {:style "padding:4px 12px;border-radius:99px;font-size:.78rem;background:#ede9fe;color:#7c3aed"}
                              (get bk "genre"))
                            "")))

                      ; 진행률 바
                      (if (> (get bk "pages_total") 0)
                        (h "div" {:style "margin-bottom:20px"}
                          (str
                            (h "div" {:style "height:6px;background:var(--c-border);border-radius:3px;overflow:hidden"}
                              (h "div" {:style (str "height:100%;background:#7c3aed;border-radius:3px;width:" progress "%")} ""))
                            (h "div" {:style "font-size:.75rem;color:var(--c-muted);margin-top:6px;text-align:right"}
                              (str progress "% 완료"))))
                        "")

                      ; 책 메타데이터 섹션
                      (h "div" {:style "background:var(--c-bg);border-radius:10px;padding:16px;margin-bottom:20px"}
                        (str
                          (h "div" {:style "font-size:.72rem;font-weight:700;color:var(--c-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px"} "책 정보")
                          (reading-meta-row "출판사" (get bk "publisher"))
                          (reading-meta-row "출판연도" (if (> (get bk "pub_year") 0) (str (get bk "pub_year") "년") ""))
                          (reading-meta-row "ISBN" (get bk "isbn"))
                          (if (and (= (get bk "publisher") "")
                                   (= (get bk "isbn") "")
                                   (= (get bk "pub_year") 0))
                            (h "p" {:style "color:var(--c-muted);font-size:.8rem;margin:0"} "메타데이터 없음 — 아래 폼에서 추가하세요")
                            "")))

                      ; 별점 (완독 시)
                      (if (= (get bk "status") "done")
                        (h "div" {:style "margin-bottom:20px"}
                          (str
                            (h "div" {:style "font-size:.8rem;color:var(--c-muted);margin-bottom:4px"} "평점")
                            (h "div" {:style "font-size:1.5rem"} (reading-stars (get bk "rating")))))
                        "")

                      ; 서평
                      (if (not (= (get bk "review") ""))
                        (h "div" {:style "background:var(--c-bg);border-left:3px solid #7c3aed;border-radius:0 10px 10px 0;padding:16px;margin-bottom:20px"}
                          (str
                            (h "div" {:style "font-size:.72rem;font-weight:700;color:#7c3aed;margin-bottom:8px;text-transform:uppercase;letter-spacing:.06em"} "서평")
                            (h "p" {:style "margin:0;line-height:1.75;font-size:.92rem;color:var(--c-text)"}
                              (get bk "review"))))
                        "")

                      ; 날짜 정보
                      (h "div" {:style "display:flex;gap:24px;margin-bottom:24px;flex-wrap:wrap"}
                        (str
                          (if (not (= (get bk "started_at") ""))
                            (h "div" {}
                              (str
                                (h "div" {:style "font-size:.72rem;color:var(--c-muted);text-transform:uppercase;letter-spacing:.04em"} "시작일")
                                (h "div" {:style "font-size:.9rem;font-weight:600;color:var(--c-text)"} (get bk "started_at"))))
                            "")
                          (if (not (= (get bk "finished_at") ""))
                            (h "div" {}
                              (str
                                (h "div" {:style "font-size:.72rem;color:var(--c-muted);text-transform:uppercase;letter-spacing:.04em"} "완독일")
                                (h "div" {:style "font-size:.9rem;font-weight:600;color:var(--c-text)"} (get bk "finished_at"))))
                            "")))

                      ; 편집 폼
                      (h "form" {:method "POST" :style "border-top:1px solid var(--c-border);padding-top:20px;max-width:none"}
                        (str
                          (h "h3" {:style "font-size:.9rem;font-weight:700;margin:0 0 16px;color:var(--c-text)"} "기록 업데이트")

                          ; 진행 정보
                          (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px"}
                            (str
                              (h "div" {}
                                (str
                                  (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "읽은 페이지")
                                  (h! "input" {:type "number" :name "pages_read" :value (str (get bk "pages_read"))
                                               :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))
                              (h "div" {}
                                (str
                                  (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "상태")
                                  (h "select" {:name "status"
                                               :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"}
                                    (arr-join
                                      (map
                                        (fn [opt]
                                          (if (= (get opt "key") (get bk "status"))
                                            (str "<option value='" (get opt "key") "' selected>" (get opt "label") "</option>")
                                            (str "<option value='" (get opt "key") "'>" (get opt "label") "</option>")))
                                        [{"key" "wish"    "label" "읽고 싶어요"}
                                         {"key" "reading" "label" "읽는 중"}
                                         {"key" "done"    "label" "완독"}])
                                      ""))))))

                          ; 별점 + 완독일
                          (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px"}
                            (str
                              (h "div" {}
                                (str
                                  (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "별점 (1-5)")
                                  (h! "input" {:type "number" :name "rating" :min "0" :max "5" :value (str (get bk "rating"))
                                               :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))
                              (h "div" {}
                                (str
                                  (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "완독일")
                                  (h! "input" {:type "date" :name "finished_at" :value (get bk "finished_at")
                                               :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))))

                          ; 메타데이터 편집
                          (h "div" {:style "background:var(--c-bg);border-radius:8px;padding:12px;margin-bottom:12px"}
                            (str
                              (h "div" {:style "font-size:.72rem;font-weight:700;color:var(--c-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px"} "책 메타데이터")
                              (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px"}
                                (str
                                  (h "div" {}
                                    (str
                                      (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "출판사")
                                      (h! "input" {:type "text" :name "publisher" :value (or (get bk "publisher") "")
                                                   :placeholder "출판사명"
                                                   :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))
                                  (h "div" {}
                                    (str
                                      (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "출판연도")
                                      (h! "input" {:type "number" :name "pub_year"
                                                   :value (if (> (or (get bk "pub_year") 0) 0) (str (get bk "pub_year")) "")
                                                   :placeholder "2024"
                                                   :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))))
                              (h "div" {:style "display:grid;grid-template-columns:1fr 1fr;gap:10px"}
                                (str
                                  (h "div" {}
                                    (str
                                      (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "ISBN")
                                      (h! "input" {:type "text" :name "isbn" :value (or (get bk "isbn") "")
                                                   :placeholder "978-..."
                                                   :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))
                                  (h "div" {}
                                    (str
                                      (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "장르")
                                      (h! "input" {:type "text" :name "genre" :value (or (get bk "genre") "")
                                                   :placeholder "소설·에세이·…"
                                                   :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;background:var(--c-surface);color:var(--c-text)"})))))))

                          ; 서평
                          (h "div" {:style "margin-bottom:14px"}
                            (str
                              (h "label" {:style "font-size:.78rem;color:var(--c-muted);display:block;margin-bottom:3px"} "서평")
                              (h "textarea" {:name "review" :rows "4"
                                             :style "width:100%;padding:8px 10px;border:1px solid var(--c-border);border-radius:7px;font-size:.9rem;resize:none;background:var(--c-surface);color:var(--c-text)"}
                                (get bk "review"))))

                          (h "button" {:type "submit"
                                       :style "width:100%;background:#7c3aed;color:white;border:none;border-radius:8px;padding:10px;font-weight:700;cursor:pointer;transition:all .2s"}
                            "저장")))))))))
          req)))))

(defn page_reading_id_post__inner [req]
  (let [id          (server-req-param req "id")
        bk          (reading-by-id id)]
    (if (= bk nil)
      (server-redirect "/reading")
      (let [pages-read  (form-get req "pages_read")
            status      (form-get req "status")
            rating      (form-get req "rating")
            review      (form-get req "review")
            finished-at (form-get req "finished_at")
            publisher   (form-get req "publisher")
            isbn        (form-get req "isbn")
            pub-year    (form-get req "pub_year")
            genre       (form-get req "genre")
            started-at  (get bk "started_at")]
        (do
          (reading-update-progress id pages-read status started-at finished-at)
          (reading-update-review id rating review)
          (reading-update-meta id publisher isbn pub-year genre)
          (server-redirect (str "/reading/" id)))))))
(defn page_reading_id [req]
  (try (page_reading_id__inner req)
    (catch $err (dev-error-page "/reading/:id" (str $err)))))
(defn page_reading_id_post [req]
  (try (page_reading_id_post__inner req)
    (catch $err (dev-error-page "/reading/:id [POST]" (str $err)))))

; ── pages/shop/orders/[id].flx ──
; pages/shop/orders/[id].flx — 주문 상세
; GET /shop/orders/:id

(defn SHOP_API [] "http://localhost:40081")

(defn fetch-order [id]
  (let [res (http-get (str (SHOP_API) "/api/orders/" id))
        p   (json_parse (get res "body"))]
    (if (get p "ok") (get p "data") nil)))

(defn page_shop_orders_id__inner [req]
  (let [id    (get (get req "params") "id")
        order (fetch-order id)]
    (if (nil? order)
      (server-status 404 "주문을 찾을 수 없습니다")
      (let [items  (?? (get order "items") [])
            total  (get order "total")
            status (get order "status")
            uid    (get order "user_id")]
        (layout-html (str "주문 #" id " 상세")
          (str
            """
<style>
body{background:#f9fafb}
.wrap{max-width:680px;margin:0 auto;padding:32px 20px}
.nav{margin-bottom:20px;font-size:.875rem}
.nav a{color:#6b7280;text-decoration:none}
.nav a:hover{color:#6366f1}
.nav span{color:#9ca3af;margin:0 6px}
.head-card{background:#fff;border-radius:14px;padding:24px;box-shadow:0 2px 8px rgba(0,0,0,.07);margin-bottom:16px;display:flex;justify-content:space-between;align-items:center}
.order-id{font-size:1.2rem;font-weight:800;color:#111827}
.order-date{font-size:.8rem;color:#9ca3af;margin-top:4px}
.status-badge{padding:6px 16px;border-radius:99px;font-size:.8rem;font-weight:700}
.st-paid{background:#dcfce7;color:#166534}
.st-pending{background:#fef9c3;color:#854d0e}
.st-cancel{background:#fee2e2;color:#991b1b}
.items-card{background:#fff;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;margin-bottom:16px}
.item-row{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid #f3f4f6}
.item-row:last-child{border-bottom:none}
.item-name{font-weight:600;color:#111827;font-size:.9rem}
.item-meta{font-size:.78rem;color:#9ca3af;margin-top:3px}
.item-subtotal{font-weight:700;color:#111827}
.total-card{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center}
.total-label{font-size:.875rem;color:#166534;font-weight:600}
.total-amount{font-size:1.5rem;font-weight:800;color:#111827}
.btn-row{display:flex;gap:10px;margin-top:20px}
.btn-row a{padding:11px 22px;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none}
.btn-outline{border:1px solid #e5e7eb;color:#6b7280}
.btn-primary{background:#6366f1;color:#fff}
</style>
"""
            (h "div" {"class" "wrap"}
              (h "div" {"class" "nav"}
                (h "a" {"href" "/shop"} "쇼핑몰")
                (h "span" {} "›")
                (h "a" {"href" "/shop/orders"} "주문내역")
                (h "span" {} "›")
                (h "span" {"style" "color:#111827"} (str "주문 #" id)))

              ;; 주문 헤더
              (h "div" {"class" "head-card"}
                (h "div" {}
                  (h "p" {"class" "order-id"} (str "주문 #" id))
                  (h "p" {"class" "order-date"} (get order "created_at")))
                (h "span"
                  {"class" (str "status-badge "
                                (cond (= status "paid")    "st-paid"
                                      (= status "pending") "st-pending"
                                      true                 "st-cancel"))}
                  (cond (= status "paid") "결제완료" (= status "pending") "대기중" true "취소")))

              ;; 주문 상품 목록
              (h "div" {"class" "items-card"}
                (str-join
                  (map (fn [item]
                    (h "div" {"class" "item-row"}
                      (h "div" {}
                        (h "p" {"class" "item-name"} (get item "name"))
                        (h "p" {"class" "item-meta"}
                          (str "₩" (get item "unit_price") " × " (get item "qty") "개"
                               (when (not (nil? (get item "category")))
                                 (str " · " (get item "category"))))))
                      (h "p" {"class" "item-subtotal"}
                        (str "₩" (get item "subtotal")))))
                  items)))

              ;; 합계
              (h "div" {"class" "total-card"}
                (h "span" {"class" "total-label"} (str "총 " (length items) "종 상품"))
                (h "span" {"class" "total-amount"} (str "₩" total)))

              ;; 버튼
              (h "div" {"class" "btn-row"}
                (h "a" {"href" "/shop/orders" "class" "btn-row a btn-outline"
                        "style" "padding:11px 22px;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none;border:1px solid #e5e7eb;color:#6b7280"}
                  "← 주문목록")
                (h "a" {"href" (str "/shop/users/" uid)
                        "style" "padding:11px 22px;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none;background:#6366f1;color:#fff"}
                  "회원 정보 보기")
                (h "a" {"href" "/shop"
                        "style" "padding:11px 22px;border-radius:8px;font-size:.875rem;font-weight:600;text-decoration:none;border:1px solid #6366f1;color:#6366f1"}
                  "쇼핑 계속하기"))))
          req)))))
(defn page_shop_orders_id [req]
  (try (page_shop_orders_id__inner req)
    (catch $err (dev-error-page "/shop/orders/:id" (str $err)))))

; ── pages/shop/products/[id].flx ──
; pages/shop/products/[id].flx — 상품 상세
; GET /shop/products/:id

; (load already inlined)

(defn fetch-product [id]
  (let [res    (http-get (str (shop-api-base) "/api/products/" id))
        parsed (json_parse (get res "body"))]
    (if (get parsed "ok") (get parsed "data") nil)))

;; 장바구니 담기 Island — 상품 정보는 서버가 JS 변수로 주입


(defn page_shop_products_id__inner [req]
  (let [id (get (get req "params") "id")
        p  (fetch-product id)]
    (if (nil? p)
      (server-status 404 "상품을 찾을 수 없습니다")
      (layout-html (str (get p "name") " — 쇼핑몰")
        (str
          """
<style>/* skl-utils.css — FreeLang Front 유틸리티 CSS * 자동 주입: fl-front-build.js → <style> 태그 뒤에 삽입 * 사용: class="u-flex u-gap-3 u-p-4" (Island에서도 class 속성으로 사용 가능) * 동적 값(색상 등)은 여전히 {:style ...} 혼용 */ /* ─── 레이아웃 ─────────────────────────────── */ .u-flex { display: flex } .u-flex-col { display: flex; flex-direction: column } .u-flex-row { display: flex; flex-direction: row } .u-flex-wrap { flex-wrap: wrap } .u-items-start { align-items: flex-start } .u-items-center { align-items: center } .u-items-end { align-items: flex-end } .u-justify-start { justify-content: flex-start } .u-justify-center { justify-content: center } .u-justify-end { justify-content: flex-end } .u-justify-between{ justify-content: space-between } .u-justify-around { justify-content: space-around } .u-flex-1 { flex: 1 } .u-flex-shrink-0 { flex-shrink: 0 } .u-grid { display: grid } .u-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px } .u-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px } .u-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px } .u-grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px } .u-block { display: block } .u-inline { display: inline } .u-inline-flex{ display: inline-flex; align-items: center } .u-hidden { display: none !important } .u-relative { position: relative } .u-absolute { position: absolute } .u-fixed { position: fixed } .u-inset-0 { inset: 0 } .u-overflow-hidden { overflow: hidden } .u-overflow-auto { overflow: auto } .u-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .u-w-full { width: 100% } .u-h-full { height: 100% } .u-max-w-sm { max-width: 480px } .u-max-w-md { max-width: 640px } .u-max-w-lg { max-width: 800px } .u-max-w-xl { max-width: 1000px } .u-mx-auto { margin-left: auto; margin-right: auto } /* ─── 간격 (gap / padding / margin) ─────────── */ .u-gap-1 { gap: 4px } .u-gap-2 { gap: 8px } .u-gap-3 { gap: 12px } .u-gap-4 { gap: 16px } .u-gap-5 { gap: 20px } .u-gap-6 { gap: 24px } .u-p-0 { padding: 0 } .u-p-1 { padding: 4px } .u-p-2 { padding: 8px } .u-p-3 { padding: 12px } .u-p-4 { padding: 16px } .u-p-5 { padding: 20px } .u-p-6 { padding: 24px } .u-px-2 { padding-left: 8px; padding-right: 8px } .u-px-3 { padding-left: 12px; padding-right: 12px } .u-px-4 { padding-left: 16px; padding-right: 16px } .u-px-5 { padding-left: 20px; padding-right: 20px } .u-px-6 { padding-left: 24px; padding-right: 24px } .u-py-2 { padding-top: 8px; padding-bottom: 8px } .u-py-3 { padding-top: 12px; padding-bottom: 12px } .u-py-4 { padding-top: 16px; padding-bottom: 16px } .u-py-5 { padding-top: 20px; padding-bottom: 20px } .u-m-0 { margin: 0 } .u-mb-0 { margin-bottom: 0 } .u-mb-1 { margin-bottom: 4px } .u-mb-2 { margin-bottom: 8px } .u-mb-3 { margin-bottom: 12px } .u-mb-4 { margin-bottom: 16px } .u-mb-5 { margin-bottom: 20px } .u-mb-6 { margin-bottom: 24px } .u-mt-auto{ margin-top: auto } /* ─── 색상 (배경/텍스트) ────────────────────── */ .u-bg-white { background: #fff } .u-bg-surface { background: var(--c-surface, #fff) } .u-bg-muted { background: #f9fafb } .u-bg-primary { background: #6366f1; color: #fff } .u-bg-success { background: #10b981; color: #fff } .u-bg-warning { background: #f59e0b; color: #fff } .u-bg-danger { background: #ef4444; color: #fff } .u-bg-info { background: #0891b2; color: #fff } .u-bg-purple { background: #7c3aed; color: #fff } .u-bg-subtle-primary { background: #ede9fe; color: #6366f1 } .u-bg-subtle-success { background: #dcfce7; color: #16a34a } .u-bg-subtle-warning { background: #fef3c7; color: #d97706 } .u-bg-subtle-danger { background: #fef2f2; color: #ef4444 } .u-bg-subtle-info { background: #e0f2fe; color: #0284c7 } .u-text-primary { color: #6366f1 } .u-text-success { color: #10b981 } .u-text-warning { color: #f59e0b } .u-text-danger { color: #ef4444 } .u-text-info { color: #0891b2 } .u-text-muted { color: #9ca3af } .u-text-body { color: #374151 } .u-text-heading { color: #111827 } .u-text-white { color: #fff } /* ─── 타이포그래피 ───────────────────────────── */ .u-text-xs { font-size: .72rem } .u-text-sm { font-size: .82rem } .u-text-base { font-size: .95rem } .u-text-lg { font-size: 1.1rem } .u-text-xl { font-size: 1.3rem } .u-text-2xl { font-size: 1.6rem } .u-font-normal { font-weight: 400 } .u-font-medium { font-weight: 500 } .u-font-semibold { font-weight: 600 } .u-font-bold { font-weight: 700 } .u-font-black { font-weight: 900 } .u-text-center { text-align: center } .u-text-right { text-align: right } .u-text-left { text-align: left } .u-no-underline{ text-decoration: none } .u-leading-tight{ line-height: 1.3 } .u-leading-normal { line-height: 1.6 } .u-leading-loose { line-height: 1.9 } .u-font-mono { font-family: "SF Mono","Fira Code",monospace } /* ─── 테두리 / 그림자 / 반경 ────────────────── */ .u-border { border: 1px solid #e5e7eb } .u-border-t { border-top: 1px solid #e5e7eb } .u-border-b { border-bottom: 1px solid #e5e7eb } .u-border-none{ border: none } .u-rounded-sm { border-radius: 6px } .u-rounded { border-radius: 8px } .u-rounded-md { border-radius: 12px } .u-rounded-lg { border-radius: 16px } .u-rounded-xl { border-radius: 20px } .u-rounded-full { border-radius: 9999px } .u-shadow-sm { box-shadow: 0 1px 3px rgba(0,0,0,.07) } .u-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.08) } .u-shadow-md { box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-shadow-lg { box-shadow: 0 8px 32px rgba(0,0,0,.12) } /* ─── 컴포넌트 ──────────────────────────────── */ .u-card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.07); border: 1px solid #f3f4f6 } .u-card-hover { transition: translate .2s, box-shadow .2s } .u-card-hover:hover { translate: 0 -2px; box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 18px; border-radius: 8px; font-weight: 600; font-size: .88rem; border: none; cursor: pointer; transition: opacity .15s; text-decoration: none } .u-btn:hover { opacity: .85 } .u-btn-primary { background: #6366f1; color: #fff } .u-btn-success { background: #10b981; color: #fff } .u-btn-warning { background: #f59e0b; color: #fff } .u-btn-danger { background: #ef4444; color: #fff } .u-btn-info { background: #0891b2; color: #fff } .u-btn-ghost { background: transparent; border: 1px solid #e5e7eb; color: #374151 } .u-btn-sm { padding: 5px 12px; font-size: .78rem } .u-btn-lg { padding: 12px 24px; font-size: 1rem } .u-btn-full { width: 100% } .u-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 99px; font-size: .72rem; font-weight: 700 } .u-badge-primary { background: #ede9fe; color: #6366f1 } .u-badge-success { background: #dcfce7; color: #16a34a } .u-badge-warning { background: #fef3c7; color: #d97706 } .u-badge-danger { background: #fef2f2; color: #dc2626 } .u-badge-info { background: #e0f2fe; color: #0284c7 } .u-badge-neutral { background: #f3f4f6; color: #6b7280 } .u-input { width: 100%; padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; box-sizing: border-box } .u-input:focus { outline: none; border-color: #6366f1 } .u-input:hover { border-color: #9ca3af } .u-label { display: block; font-size: .78rem; font-weight: 600; color: #6b7280; margin-bottom: 4px } .u-form-group { display: flex; flex-direction: column; gap: 4px } .u-divider { height: 1px; background: #f3f4f6; border: none; margin: 12px 0 } .u-progress { width: 100%; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden } .u-progress-bar { height: 100%; border-radius: 3px; background: #6366f1 } .u-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; flex-shrink: 0 } .u-avatar-sm { width: 28px; height: 28px; font-size: .72rem } .u-avatar-lg { width: 56px; height: 56px; font-size: 1.1rem } .u-empty-state { text-align: center; padding: 60px 24px; color: #9ca3af; background: #fff; border-radius: 16px } .u-empty-state .icon { font-size: 2.5rem; display: block; margin-bottom: 8px } .u-empty-state p { margin: 0 } .u-table { width: 100%; border-collapse: collapse } .u-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #9ca3af; border-bottom: 1px solid #f3f4f6 } .u-table td { padding: 11px 14px; font-size: .88rem; border-bottom: 1px solid #fafafa } .u-table tr:hover td { background: #fafafa } .u-hero-gradient { padding: 28px 24px; text-align: center; color: #fff } .u-hero-gradient h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 4px } .u-hero-gradient p { opacity: .8; margin: 0; font-size: .9rem } /* ─── 반응형 ────────────────────────────────── */ @media(max-width: 640px) { .u-sm-col { flex-direction: column } .u-sm-full { width: 100% } .u-sm-grid-1{ grid-template-columns: 1fr !important } .u-sm-hidden{ display: none !important } }
body{background:#f9fafb}
.wrap{max-width:900px;margin:0 auto;padding:32px 20px}
.nav{margin-bottom:20px;font-size:.875rem}
.nav a{color:#6b7280;text-decoration:none}
.nav a:hover{color:#6366f1}
.nav span{color:#9ca3af;margin:0 6px}
.card{background:#fff;border-radius:16px;box-shadow:0 2px 8px rgba(0,0,0,.08);overflow:hidden;display:grid;grid-template-columns:1fr 1fr;gap:0}
@media(max-width:640px){.card{grid-template-columns:1fr}}
.img-side{background:linear-gradient(135deg,#f3f4f6,#e5e7eb);display:flex;align-items:center;justify-content:center;font-size:8rem;min-height:300px}
.info-side{padding:32px}
.cat-badge{display:inline-block;font-size:.72rem;font-weight:700;color:#6366f1;background:#ede9fe;padding:4px 12px;border-radius:99px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px}
.prod-name{font-size:1.5rem;font-weight:800;color:#111827;line-height:1.3;margin-bottom:12px}
.prod-desc{font-size:.9rem;color:#6b7280;line-height:1.7;margin-bottom:20px}
.price-row{display:flex;align-items:baseline;gap:8px;margin-bottom:8px}
.price{font-size:2rem;font-weight:800;color:#111827}
.price-unit{font-size:.875rem;color:#6b7280}
.stock-badge{display:inline-block;font-size:.8rem;font-weight:600;padding:4px 10px;border-radius:99px;margin-bottom:20px}
.stock-ok{background:#dcfce7;color:#166534}
.stock-none{background:#fee2e2;color:#991b1b}
.divider{height:1px;background:#f3f4f6;margin:20px 0}
.meta{font-size:.8rem;color:#9ca3af}
</style>
"""
          ;; 상품 ID·재고를 JS 전역 변수로 주입
          (str "<script>var PRODUCT_ID=" (get p "id") ";var PRODUCT_STOCK=" (get p "stock") ";</script>")
          (h "div" {"class" "wrap"}
            (h "div" {"class" "nav"}
              (h "a" {"href" "/shop"} "상품 목록")
              (h "span" {} "›")
              (h "a" {"href" (str "/shop?category=" (get p "category"))} (get p "category"))
              (h "span" {} "›")
              (h "span" {"style" "color:#111827"} (get p "name")))
            (h "div" {"class" "card"}
              (h "div" {"class" "img-side"} (shop-product-emoji (get p "category")))
              (h "div" {"class" "info-side"}
                (h "span" {"class" "cat-badge"} (get p "category"))
                (h "h1" {"class" "prod-name"} (get p "name"))
                (h "p" {"class" "prod-desc"} (?? (get p "description") ""))
                (h "div" {"class" "price-row"}
                  (h "span" {"class" "price"} (str "₩" (get p "price")))
                  (h "span" {"class" "price-unit"} "원"))
                (h "span"
                  {"class" (if (> (get p "stock") 0) "stock-badge stock-ok" "stock-badge stock-none")}
                  (if (> (get p "stock") 0) (str "재고 " (get p "stock") "개") "품절"))
                (h "div" {"class" "divider"})
                "<div id='island-addtocart-0'></div>"
                "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nva