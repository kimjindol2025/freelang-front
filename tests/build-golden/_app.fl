    (catch $err (dev-error-page "/examples/23-like-store" (str $err)))))

; ── pages/examples/24-pagination.flx ──
; pages/examples/24-pagination.flx
; 예제 24 — 페이지네이션: 쿼리 파라미터로 목록을 페이지 단위로 분할
; 배우는 것: server-req-query, range/nth 로 슬라이스, 페이지 링크 생성

(defn page-num [req]
  (let [raw (server-req-query req "page")]
    (if (or (= raw nil) (= raw "")) 1 (str-to-num raw))))

(defn page_examples_24_pagination__inner [req]
  (let [all   ["사과" "바나나" "포도" "딸기" "수박" "참외" "복숭아" "오렌지"
               "자두" "체리" "망고" "키위" "레몬" "라임" "멜론" "감"]
        per   5
        page  (page-num req)
        total (length all)
        pages (floor (/ (+ total (- per 1)) per))
        start (* (- page 1) per)
        idxs  (filter (fn [i] (and (>= i start) (< i (+ start per)))) (range 0 total))
        rows  (map (fn [i] (nth all i)) idxs)]
    (layout-html "24 · 페이지네이션"
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "페이지네이션")
          (h "p" {:style "color:#6b7280;margin:0 0 20px"} (str "총 " (str total) "개 · " (str page) " 페이지"))
          (h "ul" {:style "list-style:none;margin:0 0 20px;padding:0"}
            (arr-join
              (map
                (fn [x] (h "li" {:style "padding:12px 14px;background:white;border-radius:8px;margin-bottom:6px;box-shadow:0 1px 3px rgba(0,0,0,.06)"} x))
                rows)
              ""))
          (h "div" {:style "display:flex;gap:6px;justify-content:center"}
            (arr-join
              (map
                (fn [p]
                  (h "a" {:href (str "/examples/24-pagination?page=" (str p))
                          :style (str "padding:8px 14px;border-radius:8px;text-decoration:none;font-weight:600;"
                                      (if (= p page) "background:#6366f1;color:white" "background:white;color:#6366f1;border:1px solid #e5e7eb"))}
                    (str p)))
                (map (fn [i] (+ i 1)) (range 0 pages)))
              ""))
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      req)))
(defn page_examples_24_pagination [req]
  (try (page_examples_24_pagination__inner req)
    (catch $err (dev-error-page "/examples/24-pagination" (str $err)))))

; ── pages/examples/25-i18n.flx ──
; pages/examples/25-i18n.flx
; 예제 25 — 다국어 인사: 쿼리 파라미터로 언어 전환 (서버 사이드)
; 배우는 것: server-req-query 분기, 활성 링크 스타일

(defn lang-link [cur code label]
  (h "a" {:href (str "/examples/25-i18n?lang=" code)
          :style (str "padding:8px 16px;border-radius:8px;text-decoration:none;font-weight:600;"
                      (if (= cur code) "background:#6366f1;color:white" "background:white;color:#6366f1;border:1px solid #e5e7eb"))}
    label))

(defn page_examples_25_i18n__inner [req]
  (let [lang  (let [q (server-req-query req "lang")] (if (or (= q nil) (= q "")) "ko" q))
        greet (if (= lang "en") "Hello, FreeLang!"
                (if (= lang "ja") "こんにちは、FreeLang!"
                  (if (= lang "es") "¡Hola, FreeLang!" "안녕하세요, FreeLang!")))]
    (layout-html "25 · 다국어 인사"
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "다국어 인사")
          (h "p" {:style "color:#6b7280;margin:0 0 24px"} "?lang= 쿼리 파라미터로 서버에서 인사말을 선택합니다.")
          (h "div" {:style "display:flex;gap:6px;margin-bottom:24px"}
            (str
              (lang-link lang "ko" "한국어")
              (lang-link lang "en" "English")
              (lang-link lang "ja" "日本語")
              (lang-link lang "es" "Español")))
          (h "div" {:style "background:white;border-radius:12px;padding:40px 24px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.08)"}
            (h "p" {:style "font-size:1.6rem;font-weight:700;margin:0"} greet))
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      req)))
(defn page_examples_25_i18n [req]
  (try (page_examples_25_i18n__inner req)
    (catch $err (dev-error-page "/examples/25-i18n" (str $err)))))

; ── pages/examples/26-json-api.flx ──
; pages/examples/26-json-api.flx
; 예제 26 — JSON API: render 가 HTML 대신 JSON 을 반환하는 엔드포인트
; 배우는 것: server-json, 예제 27(fetch)이 호출하는 백엔드

(defn page_examples_26_json_api__inner [req]
  (server-json
    {:ok true
     :time "2026-06-03"
     :items [{:id 1 :name "FreeLang" :stars 4200}
             {:id 2 :name "Island"   :stars 1800}
             {:id 3 :name "FreeDoc"  :stars 950}]}))
(defn page_examples_26_json_api [req]
  (try (page_examples_26_json_api__inner req)
    (catch $err (dev-error-page "/examples/26-json-api" (str $err)))))

; ── pages/examples/27-fetch.flx ──
; pages/examples/27-fetch.flx
; 예제 27 — 데이터 로딩: Island 에서 fetch! 로 JSON API(예제 26) 호출
; 배우는 것: fetch!, atom 으로 로딩/데이터 상태, get 으로 응답 파싱



(defn page_examples_27_fetch__inner [req]
  (layout-html "27 · 데이터 로딩"
    (str
      (h "div" {:style "max-width:480px;margin:0 auto;padding:40px 24px"}
        (str
          (h "h1" {:style "font-size:1.6rem;margin:0 0 8px"} "fetch! 데이터 로딩")
          (h "p" {:style "color:#6b7280;margin:0 0 24px"} "Island 에서 fetch! 로 JSON API 를 호출하고, 응답을 atom 에 담아 렌더합니다.")
          "<div id='island-fetcher-0'></div>"
          (h "p" {:style "margin-top:24px"}
            (h "a" {:href "/examples" :data-spa "1" :style "color:#6366f1;text-decoration:none"} "← 예제 갤러리로"))))
      "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(upd