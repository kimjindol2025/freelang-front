<style>/* skl-utils.css — FreeLang Front 유틸리티 CSS * 자동 주입: fl-front-build.js → <style> 태그 뒤에 삽입 * 사용: class="u-flex u-gap-3 u-p-4" (Island에서도 class 속성으로 사용 가능) * 동적 값(색상 등)은 여전히 {:style ...} 혼용 */ /* ─── 레이아웃 ─────────────────────────────── */ .u-flex { display: flex } .u-flex-col { display: flex; flex-direction: column } .u-flex-row { display: flex; flex-direction: row } .u-flex-wrap { flex-wrap: wrap } .u-items-start { align-items: flex-start } .u-items-center { align-items: center } .u-items-end { align-items: flex-end } .u-justify-start { justify-content: flex-start } .u-justify-center { justify-content: center } .u-justify-end { justify-content: flex-end } .u-justify-between{ justify-content: space-between } .u-justify-around { justify-content: space-around } .u-flex-1 { flex: 1 } .u-flex-shrink-0 { flex-shrink: 0 } .u-grid { display: grid } .u-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px } .u-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px } .u-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px } .u-grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px } .u-block { display: block } .u-inline { display: inline } .u-inline-flex{ display: inline-flex; align-items: center } .u-hidden { display: none !important } .u-relative { position: relative } .u-absolute { position: absolute } .u-fixed { position: fixed } .u-inset-0 { inset: 0 } .u-overflow-hidden { overflow: hidden } .u-overflow-auto { overflow: auto } .u-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .u-w-full { width: 100% } .u-h-full { height: 100% } .u-max-w-sm { max-width: 480px } .u-max-w-md { max-width: 640px } .u-max-w-lg { max-width: 800px } .u-max-w-xl { max-width: 1000px } .u-mx-auto { margin-left: auto; margin-right: auto } /* ─── 간격 (gap / padding / margin) ─────────── */ .u-gap-1 { gap: 4px } .u-gap-2 { gap: 8px } .u-gap-3 { gap: 12px } .u-gap-4 { gap: 16px }