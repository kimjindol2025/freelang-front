(defn page_notes_island [req]
  (try (page_notes_island__inner req)
    (catch $err (dev-error-page "/notes-island" (str $err)))))

; ── pages/notes.flx ──
; pages/notes.flx — 개선된 메모장 (h() + style DSL 완전 적용)
; GET  /notes        → 목록 (검색 포함)
; POST /notes        → 추가 / 수정 / 삭제 / 핀 (action 필드로 구분)

; ── 스타일 정의 ──
; ── DB 마이그레이션 ──
(db-exec DB "CREATE TABLE IF NOT EXISTS notes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  content TEXT NOT NULL,
  color TEXT DEFAULT '#fff9c4',
  pinned INTEGER DEFAULT 0,
  created_at TEXT DEFAULT (datetime('now','localtime')),
  updated_at TEXT DEFAULT (datetime('now','localtime'))
)" [])
(try (db-exec DB "ALTER TABLE notes ADD COLUMN pinned INTEGER DEFAULT 0" []) (catch $e nil))
(try (db-exec DB "ALTER TABLE notes ADD COLUMN updated_at TEXT DEFAULT (datetime('now','localtime'))" []) (catch $e nil))

; ── DB 헬퍼 ──
(defn notes-fetch [q]
  (if (= q "")
    (db-query DB "SELECT * FROM notes ORDER BY pinned DESC, id DESC" [])
    (db-query DB "SELECT * FROM notes WHERE content LIKE ? ORDER BY pinned DESC, id DESC" [(str "%" q "%")])))

(defn notes-add [content color]
  (db-exec DB "INSERT INTO notes (content, color) VALUES (?, ?)" [content color]))

(defn notes-del [id]
  (db-exec DB "DELETE FROM notes WHERE id = ?" [id]))

(defn notes-update [id content]
  (db-exec DB "UPDATE notes SET content=?, updated_at=datetime('now','localtime') WHERE id=?" [content id]))

(defn notes-pin [id pinned]
  (db-exec DB "UPDATE notes SET pinned=? WHERE id=?" [pinned id]))

; ── 색상 팔레트 ──
(define NOTE-COLORS ["#fff9c4" "#c8e6c9" "#bbdefb" "#f8bbd0" "#e1bee7" "#ffe0b2" "#ffffff"])

(defn color-btn [c]
  (str "<button type='button'"
       " onclick=\"document.getElementById('color-inp').value='" c "';"
       "document.querySelectorAll('.cbtn').forEach(b=>b.style.outline='none');"
       "this.style.outline='3px solid #6366f1'\""
       " class='cbtn'"
       " style='width:26px;height:26px;border-radius:50%;background:" c
       ";border:1px solid #d1d5db;cursor:pointer'></button>"))

; ── 메모 카드 ──
(defn note-card [note]
  (let [id     (str (get note "id"))
        text   (get note "content")
        color  (get note "color")
        pinned (get note "pinned")
        at     (get note "updated_at")
        is-pin (= pinned 1)]
    (str
      (h "div" {:id (str "card-" id)
                :class note-card
                :style (str "background:" color (if is-pin ";border:2px solid #6366f1" ""))}
        (str
          ; 핀 배지
          (if is-pin
            (h "div" {:class pin-badge :style "top:-8px;left:12px"} "📌 고정")
            "")

          ; 내용 영역
          (h "div" {:class note-content-area}
            (str
              (h "div" {:id (str "view-" id)
                        :class note-view
                        :onclick (str "startEdit('" id "')")
                        :title "클릭하여 수정"} text)
              (h "textarea" {:id (str "edit-" id)
                             :style "display:none;width:100%;border:none;background:transparent;font-size:.95rem;line-height:1.65;resize:none;outline:none;font-family:inherit;min-height:80px"
                             :onblur (str "saveEdit('" id "')")
                             :onkeydown (str "if(event.key==='Escape')cancelEdit('" id "')")} "")))

          ; 액션 바
          (h "div" {:class note-action-bar}
            (str
              (h "span" {:class note-meta} at)
              (h "div" {:class note-actions}
                (str
                  (h "form" {:method "POST" :action "/notes" :class pin-form}
                    (str
                      (h! "input" {:type "hidden" :name "action" :value "pin"})
                      (h! "input" {:type "hidden" :name "id" :value id})
                      (h! "input" {:type "hidden" :name "pinned" :value (if is-pin "0" "1")})
                      (h "button" {:type "submit"
                                   :class icon-btn
                                   :style (str "opacity:" (if is-pin "1" ".4"))
                                   :title (if is-pin "핀 해제" "핀 고정")} "📌")))
                  (h "form" {:method "POST" :action "/notes" :class pin-form}
                    (str
                      (h! "input" {:type "hidden" :name "action" :value "del"})
                      (h! "input" {:type "hidden" :name "id" :value id})
                      (h "button" {:type "submit" :class del-btn :title "삭제"} "🗑"))))))))))))

; ── 인라인 편집 스크립트 ──
(define EDIT-SCRIPT
  "<script>
function startEdit(id){var v=document.getElementById('view-'+id),e=document.getElementById('edit-'+id);e.value=v.textContent;v.style.display='none';e.style.display='block';e.focus();e.style.height='auto';e.style.height=e.scrollHeight+'px';}
function cancelEdit(id){document.getElementById('view-'+id).style.display='block';document.getElementById('edit-'+id).style.display='none';}
async function saveEdit(id){var e=document.getElementById('edit-'+id),v=document.getElementById('view-'+id),c=e.value.trim();if(!c||c===v.textContent.trim()){cancelEdit(id);return;}await fetch('/notes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'edit',id:id,content:c})});v.textContent=c;v.style.display='block';e.style.display='none';}
document.getElementById('search-inp')?.addEventListener('input',function(){var q=this.value.toLowerCase();document.querySelectorAll('[id^=card-]').forEach(function(c){c.style.display=c.textContent.toLowerCase().includes(q)?'':'none';});});
</script>")

; ── GET 핸들러 ──
(defn page_notes__inner [req]
  (let [q-raw (server-req-query req "q")
        q     (if (nil? q-raw) "" (str q-raw))
        notes (notes-fetch q)
        count (length notes)
        pin-c (length (filter (fn [n] (= (get n "pinned") 1)) notes))
        cards (if (= count 0)
                (h "div" {:class note-empty}
                  (str (h "div" {:style "font-size:3rem;margin-bottom:16px"} "📝")
                       (h "p" {:style "margin:0"} "메모가 없습니다")))
                (arr-join (map note-card notes) ""))]
    (layout-html "Notes"
      (str
        ; 헤더
        (h "div" {:class note-header}
          (h "div" {}
            (str (h "h2" {:class note-title} "📝 Notes")
                 (h "p" {:class note-count}
                   (str (str count) "개 메모"
                        (if (> pin-c 0) (str " · 📌 " (str pin-c) "개 고정") ""))))))

        ; 검색바
        (h "div" {:class search-wrap}
          (str
            (h! "input" {:id "search-inp" :class search-bar :type "text"
                         :placeholder "메모 검색..." :value q})
            (h "span" {:class search-icon :style "left:14px;top:50%;transform:translateY(-50%)"} "🔍")))

        ; 입력 폼
        (h "form" {:method "POST" :action "/notes" :class note-input-box}
          (str
            (h! "input" {:type "hidden" :name "action" :value "add"})
            (h "textarea" {:name "content" :rows "2"
                           :placeholder "새 메모... (Ctrl+Enter 추가)"
                           :maxlength "1000"
                           :style "width:100%;border:none;outline:none;font-size:.95rem;resize:none;font-family:inherit;line-height:1.6;box-sizing:border-box"
                           :onkeydown "if(event.ctrlKey&&event.key==='Enter')this.closest('form').submit()"
                           :required "true"} "")
            (h "div" {:class form-toolbar}
              (str
                (h "div" {:class color-row}
                  (str (arr-join (map color-btn NOTE-COLORS) "")
                       (h! "input" {:type "hidden" :name "color" :id "color-inp" :value "#fff9c4"})))
                (h "button" {:type "submit" :class add-btn} "추가")))))

        ; 메모 그리드
        (h "div" {:class note-grid :style "grid-template-columns:repeat(auto-fill,minmax(260px,1fr))"}
          cards)

        EDIT-SCRIPT)
      req)))

; ── POST 핸들러 ──
(defn page_notes_post__inner [req]
  (let [parsed  (get req "body")
        action  (get parsed "action")
        id      (str (get parsed "id"))
        content (str (get parsed "content"))
        color   (str (get parsed "color"))
        pinned  (str (get parsed "pinned"))]
    (if (= action "del")
      (do (notes-del id) (server-redirect "/notes"))
    (if (= action "pin")
      (do (notes-pin id (if (= pinned "1") 1 0)) (server-redirect "/notes"))
    (if (= action "edit")
      (do
        (if (not (= content "")) (notes-update id content) nil)
        (server-json {:ok true}))
    (do
      (if (not (= content ""))
        (notes-add content (if (= color "") "#fff9c4" color))
        nil)
      (server-redirect "/notes")))))))
(defn page_notes [req]
  (try (page_notes__inner req)
    (catch $err (dev-error-page "/notes" (str $err)))))
(defn page_notes_post [req]
  (try (page_notes_post__inner req)
    (catch $err (dev-error-page "/notes [POST]" (str $err)))))

; ── pages/photos/api.flx ──
; pages/photos/api.flx — 사진만 반환
; GET /photos/api → {files: [이미지만]}

; (load already inlined)
(files-init)

(defn page_photos_api__inner [req]
  (server-json {"files" (files-images)}))
(defn page_photos_api [req]
  (try (page_photos_api__inner req)
    (catch $err (dev-error-page "/photos/api" (str $err)))))

; ── pages/photos/index.flx ──
; pages/photos/index.flx — 사진 갤러리

; (load already inlined)
(files-init)



(defn page_photos_index__inner [req]
  (let [photos (files-images)
        count  (length photos)]
    (layout-html "🖼️ 사진"
      (str
        (h "div" {:style "background:linear-gradient(135deg,#e11d48,#be185d);color:white;padding:28px 24px;text-align:center"}
          (str
            (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "🖼️ 사진")
            (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"}
              (str count " 장 · "
                (h "a" {:href "/files" :style "color:rgba(255,255,255,.8)"} "파일 드라이브에서 업로드")))))
        "<div id='island-photosapp-0'></div>"
        "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_bad