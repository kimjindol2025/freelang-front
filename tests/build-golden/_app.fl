__4e00\";\nvar note_view=\"note_view__c3b7\";\nvar note_meta=\"note_meta__7671\";\nvar form_toolbar=\"form_toolbar__a6d8\";\nvar color_row=\"color_row__b5e4\";\nvar note_empty=\"note_empty__b08c\";\nvar note_actions=\"note_actions__dfb1\";\nvar icon_btn=\"icon_btn__4d25\";\nvar del_btn=\"del_btn__8fac\";\nvar search_wrap=\"search_wrap__37a0\";\nvar search_icon=\"search_icon__f263\";\nvar pin_form=\"pin_form__b618\";\nvar textarea_input=\"textarea_input__4bb6\";\nvar pg_wrap=\"pg_wrap__92cf\";\nvar pg_title=\"pg_title__9a36\";\nvar pg_subtitle=\"pg_subtitle__2581\";\nvar pg_grid=\"pg_grid__35a8\";\nvar pg_panel=\"pg_panel__aaad\";\nvar pg_panel_head=\"pg_panel_head__2bce\";\nvar pg_editor=\"pg_editor__f737\";\nvar pg_result=\"pg_result__d0e8\";\nvar pg_result_error=\"pg_result_error__7eff\";\nvar pg_btn=\"pg_btn__538e\";\nvar pg_examples=\"pg_examples__8d1f\";\nvar pg_ex_btn=\"pg_ex_btn__ea5c\";\nvar pg_status=\"pg_status__b570\";\nvar card=\"card__86e7\";\nvar hero=\"hero__43b0\";\nvar badge=\"badge__a154\";\nvar resp_grid=\"resp_grid__7f07\";\nvar resp_card=\"resp_card__789b\";\nvar resp_hero=\"resp_hero__3912\";\n\n_fl.mount(\"island-playground-0\", (() => { const code = _fl.atom(\"(str \\\"Hello, \\\" \\\"FreeLang!\\\")\"); const result = _fl.atom(\"\"); const loading = _fl.atom(false); const error = _fl.atom(false);\n  return (update) => { return _fl.h(\"div\", {\"class\": pg_wrap}, _fl.h(\"h1\", {\"class\": pg_title}, \"FL Playground\"), _fl.h(\"p\", {\"class\": pg_subtitle}, \"FreeLang 코드를 브라우저에서 바로 실행해보세요\"), _fl.h(\"div\", {\"class\": pg_examples}, _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(let [xs [1 2 3 4 5]]n  (filter (fn [x] (> x 2)) xs))\"), update()); }}, \"배열 필터\"), _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(let [m {:name \\\"Kim\\\" :age 30}]n  (str (get m :name) \\\"는 \\\" (get m :age) \\\"살\\\"))\"), update()); }}, \"맵 접근\"), _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(let [n (atom 0)]n  (swap! n (fn [v] (+ v 10)))n  (str \\\"atom 값: \\\" @n))\"), update()); }}, \"atom\"), _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(loop [i 0 acc 0]n  (if (> i 10)n    (str \\\"합계: \\\" acc)n    (recur (inc i) (+ acc i))))\"), update()); }}, \"loop/recur\"), _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(map (fn [x] (* x x)) [1 2 3 4 5])\"), update()); }}, \"map\"), _fl.h(\"button\", {\"class\": pg_ex_btn, \"on-click\": () => { return (_fl.reset(code, \"(let [name \\\"FreeLang\\\"]n  \\\"\\\"\\\"<b>안녕, ${name}!</b>\\\"\\\"\\\")\"), update()); }}, \"삼중따옴표\")), _fl.h(\"div\", {\"class\": pg_grid}, _fl.h(\"div\", {\"class\": pg_panel}, _fl.h(\"div\", {\"class\": pg_panel_head}, _fl.h(\"span\", {}, \"코드 입력\"), _fl.h(\"button\", {\"class\": pg_btn, \"on-click\": () => { (_fl.reset(loading, true), update()); (_fl.reset(error, false), update()); return _fl.fetch_post(\"/api/playground/eval\", {\"code\": _fl.deref(code)}, (res) => { (_fl.reset(loading, false), update()); return (_fl.get(res, \"ok\")) ? ((() => { (_fl.reset(result, _fl.get(res, \"result\")), update()); (_fl.reset(error, false), update()) })()) : ((() => { (_fl.reset(result, _fl.get(res, \"error\")), update()); (_fl.reset(error, true), update()) })()); }); }}, (_fl.deref(loading)) ? (\"실행 중...\") : (\"▶ 실행\"))), _fl.h(\"textarea\", {\"class\": pg_editor, \"value\": _fl.deref(code), \"on-input\": (e) => { return (_fl.reset(code, ((e).target).value), update()); }})), _fl.h(\"div\", {\"class\": pg_panel}, _fl.h(\"div\", {\"class\": pg_panel_head}, _fl.h(\"span\", {}, \"실행 결과\"), _fl.h(\"span\", {\"class\": pg_status}, (_fl.deref(error)) ? (\"오류\") : (((_fl.deref(result) === \"\")) ? (\"대기중\") : (\"완료\")))), _fl.h(\"div\", {\"class\": _fl_str(pg_result, (_fl.deref(error)) ? (_fl_str(\" \", pg_result_error)) : (\"\"))}, ((_fl.deref(result) === \"\")) ? (\"코드를 입력하고 실행 버튼을 눌러보세요.\") : (_fl.deref(result)))))); };\n})());\n//# sourceURL=island-playground.flx\n</script>") req))
(defn page_playground [req]
  (try (page_playground__inner req)
    (catch $err (dev-error-page "/playground" (str $err)))))

; ── pages/reading/api.flx ──
; pages/reading/api.flx — 독서 JSON API
; GET  /reading/api → {books}
; POST /reading/api → action: add|delete|update-progress|update-review|update-meta

; ── inlined: pages/reading/_db.flx ──
; ── ns: reading ──
; pages/reading/_db.flx — 독서 기록 DB (v2: 메타데이터 포함)

(define READING-DB {:type "sqlite" :path "data/reading.db"})

(defn reading-init []
  (db-exec READING-DB
    "CREATE TABLE IF NOT EXISTS books (
      id           INTEGER PRIMARY KEY AUTOINCREMENT,
      title        TEXT NOT NULL,
      author       TEXT DEFAULT '',
      status       TEXT DEFAULT 'wish',
      rating       INTEGER DEFAULT 0,
      pages_total  INTEGER DEFAULT 0,
      pages_read   INTEGER DEFAULT 0,
      cover_color  TEXT DEFAULT '#7c3aed',
      review       TEXT DEFAULT '',
      started_at   TEXT DEFAULT '',
      finished_at  TEXT DEFAULT '',
      publisher    TEXT DEFAULT '',
      isbn         TEXT DEFAULT '',
      pub_year     INTEGER DEFAULT 0,
      genre        TEXT DEFAULT '',
      created_at   TEXT DEFAULT (datetime('now','localtime'))
    )" []))

(defn reading-all []
  (db-query READING-DB "SELECT * FROM books ORDER BY status ASC, created_at DESC" []))

(defn reading-by-status [status]
  (db-query READING-DB "SELECT * FROM books WHERE status=? ORDER BY created_at DESC" [status]))

(defn reading-by-id [id]
  (db-one READING-DB "SELECT * FROM books WHERE id=?" [(str-to-num id)]))

(defn reading-add [title author status pages-total cover-color publisher isbn pub-year genre]
  (db-exec READING-DB
    "INSERT INTO books (title,author,status,pages_total,cover_color,publisher,isbn,pub_year,genre)
     VALUES (?,?,?,?,?,?,?,?,?)"
    [title author status (str-to-num pages-total) cover-color
     publisher isbn (str-to-num pub-year) genre]))

(defn reading-update-progress [id pages-read status started-at finished-at]
  (db-exec READING-DB
    "UPDATE books SET pages_read=?,status=?,started_at=?,finished_at=? WHERE id=?"
    [(str-to-num pages-read) status started-at finished-at (str-to-num id)]))

(defn reading-update-review [id rating review]
  (db-exec READING-DB
    "UPDATE books SET rating=?,review=? WHERE id=?"
    [(str-to-num rating) review (str-to-num id)]))

(defn reading-update-meta [id publisher isbn pub-year genre]
  (db-exec READING-DB
    "UPDATE books SET publisher=?,isbn=?,pub_year=?,genre=? WHERE id=?"
    [publisher isbn (str-to-num pub-year) genre (str-to-num id)]))

(defn reading-delete [id]
  (db-exec READING-DB "DELETE FROM books WHERE id=?" [(str-to-num id)]))
; ── end: pages/reading/_db.flx ──
(reading-init)

(defn page_reading_api__inner [req]
  (server-json {"books" (reading-all)}))

(defn page_reading_api_post__inner [req]
  (let [body   (get req "body")
        action (or (get body "action") "")]
    (cond
      (= action "add")
        (let [title     (or (get body "title") "")
              author    (or (get body "author") "")
              status    (or (get body "status") "wish")
              pages     (or (get body "pages_total") "0")
              color     (or (get body "cover_color") "#7c3aed")
              publisher (or (get body "publisher") "")
              isbn      (or (get body "isbn") "")
              pub-year  (or (get body "pub_year") "0")
              genre     (or (get body "genre") "")]
          (if (= (str-trim title) "")
            (server-json {"ok" false "error" "제목 필요"} 400)
            (do
              (reading-add title author status pages color publisher isbn pub-year genre)
              (server-json {"ok" true "books" (reading-all)}))))

      (= action "delete")
        (let [id (get body "id")]
          (if (= id nil)
            (server-json {"ok" false "error" "id 필요"} 400)
            (do
              (reading-delete id)
              (server-json {"ok" true "books" (reading-all)}))))

      (= action "update-progress")
        (let [id       (get body "id")
              pages    (or (get body "pages_read") "0")
              status   (or (get body "status") "reading")
              started  (or (get body "started_at") "")
              finished (or (get body "finished_at") "")]
          (reading-update-progress id pages status started finished)
          (server-json {"ok" true "books" (reading-all)}))

      (= action "update-review")
        (let [id     (get body "id")
              rating (or (get body "rating") "0")
              review (or (get body "review") "")]
          (reading-update-review id rating review)
          (server-json {"ok" true}))

      (= action "update-meta")
        (let [id        (get body "id")
              publisher (or (get body "publisher") "")
              isbn      (or (get body "isbn") "")
              pub-year  (or (get body "pub_year") "0")
              genre     (or (get body "genre") "")]
          (reading-update-meta id publisher isbn pub-year genre)
          (server-json {"ok" true}))

      true
        (server-json {"ok" false "error" (str "unknown: " action)} 400))))
(defn page_reading_api [req]
  (try (page_reading_api__inner req)
    (catch $err (dev-error-page "/reading/api" (str $err)))))
(defn page_reading_api_post [req]
  (try (page_reading_api_post__inner req)
    (catch $err (dev-error-page "/reading/api [POST]" (str $err)))))

; ── pages/reading/index.flx ──
; pages/reading/index.flx — 독서 기록 서재 (reading.skl.kr 디자인 참조)

; (load already inlined)
(reading-init)

; OKLCH 기반 독서 전용 CSS (reading.skl.kr 스타일)
(define READING-CSS "<style>/* skl-utils.css — FreeLang Front 유틸리티 CSS * 자동 주입: fl-front-build.js → <style> 태그 뒤에 삽입 * 사용: class="u-flex u-gap-3 u-p-4" (Island에서도 class 속성으로 사용 가능) * 동적 값(색상 등)은 여전히 {:style ...} 혼용 */ /* ─── 레이아웃 ─────────────────────────────── */ .u-flex { display: flex } .u-flex-col { display: flex; flex-direction: column } .u-flex-row { display: flex; flex-direction: row } .u-flex-wrap { flex-wrap: wrap } .u-items-start { align-items: flex-start } .u-items-center { align-items: center } .u-items-end { align-items: flex-end } .u-justify-start { justify-content: flex-start } .u-justify-center { justify-content: center } .u-justify-end { justify-content: flex-end } .u-justify-between{ justify-content: space-between } .u-justify-around { justify-content: space-around } .u-flex-1 { flex: 1 } .u-flex-shrink-0 { flex-shrink: 0 } .u-grid { display: grid } .u-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px } .u-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px } .u-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px } .u-grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px } .u-block { display: block } .u-inline { display: inline } .u-inline-flex{ display: inline-flex; align-items: center } .u-hidden { display: none !important } .u-relative { position: relative } .u-absolute { position: absolute } .u-fixed { position: fixed } .u-inset-0 { inset: 0 } .u-overflow-hidden { overflow: hidden } .u-overflow-auto { overflow: auto } .u-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .u-w-full { width: 100% } .u-h-full { height: 100% } .u-max-w-sm { max-width: 480px } .u-max-w-md { max-width: 640px } .u-max-w-lg { max-width: 800px } .u-max-w-xl { max-width: 1000px } .u-mx-auto { margin-left: auto; margin-right: auto } /* ─── 간격 (gap / padding / margin) ─────────── */ .u-gap-1 { gap: 4px } .u-gap-2 { gap: 8px } .u-gap-3 { gap: 12px } .u-gap-4 { gap: 16px } .u-gap-5 { gap: 20px } .u-gap-6 { gap: 24px } .u-p-0 { padding: 0 } .u-p-1 { padding: 4px } .u-p-2 { padding: 8px } .u-p-3 { padding: 12px } .u-p-4 { padding: 16px } .u-p-5 { padding: 20px } .u-p-6 { padding: 24px } .u-px-2 { padding-left: 8px; padding-right: 8px } .u-px-3 { padding-left: 12px; padding-right: 12px } .u-px-4 { padding-left: 16px; padding-right: 16px } .u-px-5 { padding-left: 20px; padding-right: 20px } .u-px-6 { padding-left: 24px; padding-right: 24px } .u-py-2 { padding-top: 8px; padding-bottom: 8px } .u-py-3 { padding-top: 12px; padding-bottom: 12px } .u-py-4 { padding-top: 16px; padding-bottom: 16px } .u-py-5 { padding-top: 20px; padding-bottom: 20px } .u-m-0 { margin: 0 } .u-mb-0 { margin-bottom: 0 } .u-mb-1 { margin-bottom: 4px } .u-mb-2 { margin-bottom: 8px } .u-mb-3 { margin-bottom: 12px } .u-mb-4 { margin-bottom: 16px } .u-mb-5 { margin-bottom: 20px } .u-mb-6 { margin-bottom: 24px } .u-mt-auto{ margin-top: auto } /* ─── 색상 (배경/텍스트) ────────────────────── */ .u-bg-white { background: #fff } .u-bg-surface { background: var(--c-surface, #fff) } .u-bg-muted { background: #f9fafb } .u-bg-primary { background: #6366f1; color: #fff } .u-bg-success { background: #10b981; color: #fff } .u-bg-warning { background: #f59e0b; color: #fff } .u-bg-danger { background: #ef4444; color: #fff } .u-bg-info { background: #0891b2; color: #fff } .u-bg-purple { background: #7c3aed; color: #fff } .u-bg-subtle-primary { background: #ede9fe; color: #6366f1 } .u-bg-subtle-success { background: #dcfce7; color: #16a34a } .u-bg-subtle-warning { background: #fef3c7; color: #d97706 } .u-bg-subtle-danger { background: #fef2f2; color: #ef4444 } .u-bg-subtle-info { background: #e0f2fe; color: #0284c7 } .u-text-primary { color: #6366f1 } .u-text-success { color: #10b981 } .u-text-warning { color: #f59e0b } .u-text-danger { color: #ef4444 } .u-text-info { color: #0891b2 } .u-text-muted { color: #9ca3af } .u-text-body { color: #374151 } .u-text-heading { color: #111827 } .u-text-white { color: #fff } /* ─── 타이포그래피 ───────────────────────────── */ .u-text-xs { font-size: .72rem } .u-text-sm { font-size: .82rem } .u-text-base { font-size: .95rem } .u-text-lg { font-size: 1.1rem } .u-text-xl { font-size: 1.3rem } .u-text-2xl { font-size: 1.6rem } .u-font-normal { font-weight: 400 } .u-font-medium { font-weight: 500 } .u-font-semibold { font-weight: 600 } .u-font-bold { font-weight: 700 } .u-font-black { font-weight: 900 } .u-text-center { text-align: center } .u-text-right { text-align: right } .u-text-left { text-align: left } .u-no-underline{ text-decoration: none } .u-leading-tight{ line-height: 1.3 } .u-leading-normal { line-height: 1.6 } .u-leading-loose { line-height: 1.9 } .u-font-mono { font-family: "SF Mono","Fira Code",monospace } /* ─── 테두리 / 그림자 / 반경 ────────────────── */ .u-border { border: 1px solid #e5e7eb } .u-border-t { border-top: 1px solid #e5e7eb } .u-border-b { border-bottom: 1px solid #e5e7eb } .u-border-none{ border: none } .u-rounded-sm { border-radius: 6px } .u-rounded { border-radius: 8px } .u-rounded-md { border-radius: 12px } .u-rounded-lg { border-radius: 16px } .u-rounded-xl { border-radius: 20px } .u-rounded-full { border-radius: 9999px } .u-shadow-sm { box-shadow: 0 1px 3px rgba(0,0,0,.07) } .u-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.08) } .u-shadow-md { box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-shadow-lg { box-shadow: 0 8px 32px rgba(0,0,0,.12) } /* ─── 컴포넌트 ──────────────────────────────── */ .u-card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.07); border: 1px solid #f3f4f6 } .u-card-hover { transition: translate .2s, box-shadow .2s } .u-card-hover:hover { translate: 0 -2px; box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 18px; border-radius: 8px; font-weight: 600; font-size: .88rem; border: none; cursor: pointer; transition: opacity .15s; text-decoration: none } .u-btn:hover { opacity: .85 } .u-btn-primary { background: #6366f1; color: #fff } .u-btn-success { background: #10b981; color: #fff } .u-btn-warning { background: #f59e0b; color: #fff } .u-btn-danger { background: #ef4444; color: #fff } .u-btn-info { background: #0891b2; color: #fff } .u-btn-ghost { background: transparent; border: 1px solid #e5e7eb; color: #374151 } .u-btn-sm { padding: 5px 12px; font-size: .78rem } .u-btn-lg { padding: 12px 24px; font-size: 1rem } .u-btn-full { width: 100% } .u-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 99px; font-size: .72rem; font-weight: 700 } .u-badge-primary { background: #ede9fe; color: #6366f1 } .u-badge-success { background: #dcfce7; color: #16a34a } .u-badge-warning { background: #fef3c7; color: #d97706 } .u-badge-danger { background: #fef2f2; color: #dc2626 } .u-badge-info { background: #e0f2fe; color: #0284c7 } .u-badge-neutral { background: #f3f4f6; color: #6b7280 } .u-input { width: 100%; padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; box-sizing: border-box } .u-input:focus { outline: none; border-color: #6366f1 } .u-input:hover { border-color: #9ca3af } .u-label { display: block; font-size: .78rem; font-weight: 600; color: #6b7280; margin-bottom: 4px } .u-form-group { display: flex; flex-direction: column; gap: 4px } .u-divider { height: 1px; background: #f3f4f6; border: none; margin: 12px 0 } .u-progress { width: 100%; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden } .u-progress-bar { height: 100%; border-radius: 3px; background: #6366f1 } .u-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; flex-shrink: 0 } .u-avatar-sm { width: 28px; height: 28px; font-size: .72rem } .u-avatar-lg { width: 56px; height: 56px; font-size: 1.1rem } .u-empty-state { text-align: center; padding: 60px 24px; color: #9ca3af; background: #fff; border-radius: 16px } .u-empty-state .icon { font-size: 2.5rem; display: block; margin-bottom: 8px } .u-empty-state p { margin: 0 } .u-table { width: 100%; border-collapse: collapse } .u-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #9ca3af; border-bottom: 1px solid #f3f4f6 } .u-table td { padding: 11px 14px; font-size: .88rem; border-bottom: 1px solid #fafafa } .u-table tr:hover td { background: #fafafa } .u-hero-gradient { padding: 28px 24px; text-align: center; color: #fff } .u-hero-gradient h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 4px } .u-hero-gradient p { opacity: .8; margin: 0; font-size: .9rem } /* ─── 반응형 ────────────────────────────────── */ @media(max-width: 640px) { .u-sm-col { flex-direction: column } .u-sm-full { width: 100% } .u-sm-grid-1{ grid-template-columns: 1fr !important } .u-sm-hidden{ display: none !important } }
.rapp{
  --c-primary:   oklch(0.50 0.22 296);
  --c-primary-d: oklch(from var(--c-primary) calc(l - 0.07) c h);
  --c-primary-l: oklch(from var(--c-primary) 0.94 0.05 h);
}
.book-card{
  background:var(--c-surface);
  border:1px solid var(--c-border);
  border-radius:12px;
  overflow:hidden;
  box-shadow:0 1px 4px oklch(0 0 0 / .07);
  cursor:pointer;
  transition:box-shadow .3s var(--ease-spring),transform .3s var(--ease-spring);
}
.book-card:hover{
  box-shadow:0 8px 24px oklch(0 0 0 / .14);
  transform:translateY(-3px);
}
@keyframes bk-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.book-card{
  animation:bk-in linear both;
  animation-timeline:view();
  animation-range:entry 0% entry 30%;
}
@starting-style{.book-card{opacity:0;transform:translateY(14px)}}
@view-transition{navigation:auto}
::view-transition-old(root){animation:.25s cubic-bezier(.4,0,1,1) both vt-out}
::view-transition-new(root){animation:.28s cubic-bezier(0,0,.2,1) both vt-in}
@keyframes vt-out{to{opacity:0;transform:translateX(-14px) scale(.99)}}
@keyframes vt-in{from{opacity:0;transform:translateX(14px) scale(.99)}}
.r-tab{
  padding:8px 18px;border-radius:8px;border:none;cursor:pointer;
  font-weight:600;font-size:.85rem;transition:all .2s var(--ease-spring);
}
.r-tab:hover{transform:translateY(-1px)}
.r-tab-active{background:oklch(0.50 0.22 296);color:white}
.r-tab-idle{background:var(--c-surface);color:var(--c-muted);border:1px solid var(--c-border)}
.r-form-wrap{
  background:var(--c-surface);border:1px solid var(--c-border);
  border-radius:16px;padding:24px;margin-bottom:16px;
  box-shadow:0 2px 8px oklch(0 0 0 / .06);
}
.r-progress{height:4px;background:var(--c-border);border-radius:2px;overflow:hidden}
.r-progress-fill{height:100%;background:oklch(0.50 0.22 296);transition:width .4s}
.r-genre-badge{
  display:inline-block;padding:2px 8px;border-radius:99px;
  font-size:.7rem;font-weight:600;
  background:oklch(from var(--c-primary) 0.94 0.05 h);
  color:oklch(from var(--c-primary) 0.35 0.15 h);
}
</style>")



(defn page_reading_index__inner [req]
  (let [total   (length (reading-all))
        reading (length (reading-by-status "reading"))
        done    (length (reading-by-status "done"))]
    (layout-html "📚 독서 기록"
      (str
        READING-CSS
        (h "div" {:style "background:linear-gradient(135deg,#7c3aed,#6366f1);color:white;padding:28px 24px;text-align:center;margin:-32px -24px 24px;border-radius:0 0 16px 16px"}
          (str
            (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"} "📚 독서 기록")
            (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"}
              (str "읽는 중 " reading " · 완독 " done " · 합계 " total))))
        "<div id='island-readingapp-0'></div>"
        "<script>\nconst _fl={\n  // ── 로컬 atom ──\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // ── 글로벌 store (Island 간 상태 공유) ──\n  _store:{v:{}},\n  _watchers:[],\n  get_store:(key)=>key?(_fl._store.v[key]??null):_fl._store.v,\n  dispatch:(key,val)=>{\n    const prev=_fl._store.v;\n    _fl._store.v=typeof key==='object'\n      ? {...prev,...key}\n      : {...prev,[key]:val};\n    _fl._watchers.forEach(fn=>fn(prev,_fl._store.v,key));\n  },\n  watch_store:(fn)=>{_fl._watchers.push(fn);return ()=>{_fl._watchers=_fl._watchers.filter(w=>w!==fn);};},\n  // ── 배열/맵 조작 ──\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  // ── DOM 빌더 ──\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    function app(c){\n      if(c==null)return;\n      if(Array.isArray(c)){c.forEach(app);return;}\n      if(c instanceof Node)el.appendChild(c);\n      else{const s=String(c);if(s)el.appendChild(document.createTextNode(s));}\n    }\n    ch.forEach(app);\n    return el;\n  },\n  // ── fetch! — Island 내부 API 호출 (GET, JSON 자동 파싱) ──\n  // 사용: (fetch! \"/api/users\" (fn [data] (reset! items data)))\n  fetch:(url,cb)=>{\n    fetch(url,{headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch!',new Error('GET '+url+' → '+err),'request'); });\n  },\n  // fetch-post! — POST JSON → Island 콜백\n  fetch_post:(url,body,cb)=>{\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-post!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-post!',new Error('POST '+url+' → '+err),'request'); });\n  },\n  // fetch-delete! — DELETE → Island 콜백\n  fetch_delete:(url,cb)=>{\n    fetch(url,{method:'DELETE',headers:{'Accept':'application/json'}})\n      .then(r=>r.ok?r.json():Promise.reject(r.status))\n      .then(data=>{ try{ cb(data); }catch(e){ _fl._err('fetch-delete!',e,'callback'); } })\n      .catch(err=>{ _fl._err('fetch-delete!',new Error('DELETE '+url+' → '+err),'request'); });\n  },\n  // ── Island 에러 리포터 → /~errors (dev 전용) ──\n  _err:(islandId,err,phase)=>{\n    const msg=err&&err.message?err.message:String(err);\n    const stack=err&&err.stack?err.stack:'';\n    console.error('[Island:'+islandId+']['+phase+'] '+msg+'\n'+stack);\n    try{\n      if(location.hostname==='localhost'||location.port==='40850'||location.port==='40851'){\n        const EV='http://'+location.hostname+':40851/~errors';\n        const lineMatch=stack.match(/:(d+):d+)?$/m);\n        const lineNo=lineMatch?parseInt(lineMatch[1]):0;\n        fetch(EV,{method:'POST',headers:{'Content-Type':'application/json'},\n          body:JSON.stringify({type:'island',message:'['+islandId+']['+phase+'] '+msg,source:'island-'+islandId+'.flx',line:lineNo,col:0,stack:stack,url:location.href})\n        }).catch(function(){});\n      }\n    }catch(e){}\n  },\n  // ── Island 마운트 (store watch 통합) ──\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{\n      try{\n        while(el.firstChild)el.removeChild(el.firstChild);\n        const r=renderFn(update);\n        if(r)el.appendChild(r);\n      }catch(e){\n        _fl._err(id,e,'render');\n        el.innerHTML='<div style=\"color:#ef4444;font-family:monospace;font-size:.8rem;padding:8px;background:#1a1a1a;border-radius:4px\">[Island Error] '+String(e.message)+'</div>';\n      }\n    };\n    try{ update(); }catch(e){ _fl._err(id,e,'mount'); }\n    return update;\n  },\n  // ── store 구독 + 자동 재렌더 ──\n  mount_reactive:(id,renderFn,keys)=>{\n    const update=_fl.mount(id,renderFn);\n    if(!update)return;\n    _fl.watch_store((prev,next,changed)=>{\n      if(!keys||keys.includes(changed))update();\n    });\n  },\n};\n// str: Node 포함 시 children 컨텍스트용 배열 반환, 순수 문자열이면 join\n// 주의: 속성값에 Node를 섞어 쓰는 패턴은 지원하지 않음 (String([node]) → 깨짐)\nfunction _fl_str(...xs){\n  const flat=[];\n  function col(v){if(v==null)return;if(v instanceof Node){flat.push(v);return;}if(Array.isArray(v)){v.forEach(col);return;}flat.push(String(v));}\n  xs.forEach(col);\n  return flat.some(x=>x instanceof Node)?flat:flat.join('');\n}\nwindow._fl=_fl;\n// ── Island 전역 헬퍼 (arr-join, concat, str-* 등) ──\nconst arr_join=(arr,sep)=>{const a=arr||[];return a.some(x=>x instanceof Node)?a:a.join(sep??'');};\nconst concat=(a,b)=>[...(a||[]),...(b||[])];\nconst str_contains=(s,sub)=>String(s??'').includes(String(sub??''));\nconst str_blank_q=(s)=>!s||String(s).trim()==='';\nconst str_slice=(s,start,end)=>String(s??'').slice(start,end);\nconst js_prompt=(msg,def)=>window.prompt(msg,def??'');\nconst js_confirm=(msg)=>window.confirm(msg);\n</script><script>\nvar layout_nav=\"layout_nav__9b42\";\nvar layout_wrap=\"layout_wrap__5aaf\";\nvar layout_foot=\"layout_foot__a6f2\";\nvar nav_brand=\"nav_brand__c420\";\nvar nav_link_base=\"nav_link_base__8b84\";\nvar global_style=\"global_style__f39f\";\nvar ui_btn=\"ui_btn__c22f\";\nvar ui_btn_primary=\"ui_btn_primary__422c\";\nvar ui_btn_secondary=\"ui_btn_secondary__ce94\";\nvar ui_btn_danger=\"ui_btn_danger__e732\";\nvar ui_btn_ghost=\"ui_btn_ghost__b391\";\nvar ui_bad