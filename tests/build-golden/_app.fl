; ── pages/health/log.flx ──
; pages/health/log.flx — 건강 기록 히스토리
; GET /health/log?type=weight

; (load already inlined)
(health-init)

(defn type-label [t]
  (cond
    (= t "weight") "⚖️ 체중"
    (= t "sleep")  "😴 수면"
    (= t "workout") "💪 운동"
    (= t "water")  "💧 수분"
    (= t "steps")  "🚶 걸음수"
    true t))

(defn page_health_log__inner [req]
  (let [type (or (server-req-query req "type") "weight")
        logs (health-by-type type)
        chart-data (health-recent-week type)]
    (layout-html (str (type-label type) " 기록")
      (str
        (h "div" {:style "background:linear-gradient(135deg,#10b981,#059669);color:white;padding:28px 24px;text-align:center"}
          (str
            (h "h1" {:style "font-size:1.6rem;font-weight:800;margin:0 0 4px"}
              (type-label type))
            (h "p" {:style "opacity:.8;margin:0;font-size:.9rem"}
              (str (length logs) "개 기록"))))
        (h "div" {:style "max-width:680px;margin:0 auto;padding:24px"}
          (str
            ; 탭 네비게이션
            (h "div" {:style "display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap"}
              (arr-join
                (map
                  (fn [t]
                    (let [active (= (get t "key") type)]
                      (h "a"
                        {:href (str "/health/log?type=" (get t "key"))
                         :style (str "padding:8px 16px;border-radius:8px;text-decoration:none;font-size:.85rem;font-weight:600;"
                                     (if active
                                       "background:#10b981;color:white"
                                       "background:white;color:#6b7280;border:1px solid #e5e7eb"))}
                        (str (get t "icon") " " (get t "label")))))
                  [{"key" "weight" "icon" "⚖️" "label" "체중"}
                   {"key" "sleep"  "icon" "😴" "label" "수면"}
                   {"key" "workout" "icon" "💪" "label" "운동"}
                   {"key" "water"  "icon" "💧" "label" "수분"}
                   {"key" "steps"  "icon" "🚶" "label" "걸음수"}])
                ""))

            ; 미니 차트 (최근 7일)
            (if (> (length chart-data) 0)
              (h "div" {:style "background:white;border-radius:12px;padding:20px;margin-bottom:20px;box-shadow:0 1px 4px rgba(0,0,0,.06)"}
                (str
                  (h "h3" {:style "font-size:.9rem;font-weight:700;margin:0 0 12px;color:#6b7280"} "최근 7일")
                  (h "div" {:style "display:flex;gap:6px;align-items:flex-end;height:60px"}
                    (let [max-v (reduce (fn [m r] (if (> (get r "value") m) (get r "value") m)) 0.001 chart-data)]
                      (arr-join
                        (map
                          (fn [row]
                            (let [pct (* (/ (get row "value") max-v) 100)]
                              (h "div" {:style "flex:1;display:flex;flex-direction:column;align-items:center;gap:3px"}
                                (str
                                  (h "div" {:style "font-size:.65rem;color:#6b7280"} (str (get row "value")))
                                  (h "div" {:style (str "background:#10b981;border-radius:3px 3px 0 0;width:100%;height:" pct "%")} "")
                                  (h "div" {:style "font-size:.6rem;color:#9ca3af"}
                                    (str-slice (get row "date") 5 10))))))
                          chart-data)
                        "")))))
              "")

            ; 기록 목록
            (if (= (length logs) 0)
              (h "div" {:style "background:white;border-radius:12px;padding:40px;text-align:center;color:#9ca3af"}
                "기록이 없습니다")
              (h "div" {:style "background:white;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.06)"}
                (arr-join
                  (map
                    (fn [log]
                      (h "div" {:style "padding:12px 18px;border-bottom:1px solid #f3f4f6;display:flex;align-items:center;gap:12px"}
                        (str
                          (h "div" {:style "font-size:.8rem;color:#9ca3af;min-width:80px"} (get log "date"))
                          (h "div" {:style "flex:1;font-weight:600"}
                            (str (get log "value") " " (get log "unit")))
                          (if (not (= (get log "note") ""))
                            (h "div" {:style "font-size:.8rem;color:#6b7280"} (get log "note"))
                            ""))))
                    logs)
                  ""))))))
      req)))
(defn page_health_log [req]
  (try (page_health_log__inner req)
    (catch $err (dev-error-page "/health/log" (str $err)))))

; ── pages/index.flx ──
; index.flx — 새로 작성. 삼중따옴표 전면 사용.

(defn page_index__inner [req]
  (layout-html "FreeLang" (str

    """
<style>/* skl-utils.css — FreeLang Front 유틸리티 CSS * 자동 주입: fl-front-build.js → <style> 태그 뒤에 삽입 * 사용: class="u-flex u-gap-3 u-p-4" (Island에서도 class 속성으로 사용 가능) * 동적 값(색상 등)은 여전히 {:style ...} 혼용 */ /* ─── 레이아웃 ─────────────────────────────── */ .u-flex { display: flex } .u-flex-col { display: flex; flex-direction: column } .u-flex-row { display: flex; flex-direction: row } .u-flex-wrap { flex-wrap: wrap } .u-items-start { align-items: flex-start } .u-items-center { align-items: center } .u-items-end { align-items: flex-end } .u-justify-start { justify-content: flex-start } .u-justify-center { justify-content: center } .u-justify-end { justify-content: flex-end } .u-justify-between{ justify-content: space-between } .u-justify-around { justify-content: space-around } .u-flex-1 { flex: 1 } .u-flex-shrink-0 { flex-shrink: 0 } .u-grid { display: grid } .u-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px } .u-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px } .u-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px } .u-grid-auto { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 12px } .u-block { display: block } .u-inline { display: inline } .u-inline-flex{ display: inline-flex; align-items: center } .u-hidden { display: none !important } .u-relative { position: relative } .u-absolute { position: absolute } .u-fixed { position: fixed } .u-inset-0 { inset: 0 } .u-overflow-hidden { overflow: hidden } .u-overflow-auto { overflow: auto } .u-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .u-w-full { width: 100% } .u-h-full { height: 100% } .u-max-w-sm { max-width: 480px } .u-max-w-md { max-width: 640px } .u-max-w-lg { max-width: 800px } .u-max-w-xl { max-width: 1000px } .u-mx-auto { margin-left: auto; margin-right: auto } /* ─── 간격 (gap / padding / margin) ─────────── */ .u-gap-1 { gap: 4px } .u-gap-2 { gap: 8px } .u-gap-3 { gap: 12px } .u-gap-4 { gap: 16px } .u-gap-5 { gap: 20px } .u-gap-6 { gap: 24px } .u-p-0 { padding: 0 } .u-p-1 { padding: 4px } .u-p-2 { padding: 8px } .u-p-3 { padding: 12px } .u-p-4 { padding: 16px } .u-p-5 { padding: 20px } .u-p-6 { padding: 24px } .u-px-2 { padding-left: 8px; padding-right: 8px } .u-px-3 { padding-left: 12px; padding-right: 12px } .u-px-4 { padding-left: 16px; padding-right: 16px } .u-px-5 { padding-left: 20px; padding-right: 20px } .u-px-6 { padding-left: 24px; padding-right: 24px } .u-py-2 { padding-top: 8px; padding-bottom: 8px } .u-py-3 { padding-top: 12px; padding-bottom: 12px } .u-py-4 { padding-top: 16px; padding-bottom: 16px } .u-py-5 { padding-top: 20px; padding-bottom: 20px } .u-m-0 { margin: 0 } .u-mb-0 { margin-bottom: 0 } .u-mb-1 { margin-bottom: 4px } .u-mb-2 { margin-bottom: 8px } .u-mb-3 { margin-bottom: 12px } .u-mb-4 { margin-bottom: 16px } .u-mb-5 { margin-bottom: 20px } .u-mb-6 { margin-bottom: 24px } .u-mt-auto{ margin-top: auto } /* ─── 색상 (배경/텍스트) ────────────────────── */ .u-bg-white { background: #fff } .u-bg-surface { background: var(--c-surface, #fff) } .u-bg-muted { background: #f9fafb } .u-bg-primary { background: #6366f1; color: #fff } .u-bg-success { background: #10b981; color: #fff } .u-bg-warning { background: #f59e0b; color: #fff } .u-bg-danger { background: #ef4444; color: #fff } .u-bg-info { background: #0891b2; color: #fff } .u-bg-purple { background: #7c3aed; color: #fff } .u-bg-subtle-primary { background: #ede9fe; color: #6366f1 } .u-bg-subtle-success { background: #dcfce7; color: #16a34a } .u-bg-subtle-warning { background: #fef3c7; color: #d97706 } .u-bg-subtle-danger { background: #fef2f2; color: #ef4444 } .u-bg-subtle-info { background: #e0f2fe; color: #0284c7 } .u-text-primary { color: #6366f1 } .u-text-success { color: #10b981 } .u-text-warning { color: #f59e0b } .u-text-danger { color: #ef4444 } .u-text-info { color: #0891b2 } .u-text-muted { color: #9ca3af } .u-text-body { color: #374151 } .u-text-heading { color: #111827 } .u-text-white { color: #fff } /* ─── 타이포그래피 ───────────────────────────── */ .u-text-xs { font-size: .72rem } .u-text-sm { font-size: .82rem } .u-text-base { font-size: .95rem } .u-text-lg { font-size: 1.1rem } .u-text-xl { font-size: 1.3rem } .u-text-2xl { font-size: 1.6rem } .u-font-normal { font-weight: 400 } .u-font-medium { font-weight: 500 } .u-font-semibold { font-weight: 600 } .u-font-bold { font-weight: 700 } .u-font-black { font-weight: 900 } .u-text-center { text-align: center } .u-text-right { text-align: right } .u-text-left { text-align: left } .u-no-underline{ text-decoration: none } .u-leading-tight{ line-height: 1.3 } .u-leading-normal { line-height: 1.6 } .u-leading-loose { line-height: 1.9 } .u-font-mono { font-family: "SF Mono","Fira Code",monospace } /* ─── 테두리 / 그림자 / 반경 ────────────────── */ .u-border { border: 1px solid #e5e7eb } .u-border-t { border-top: 1px solid #e5e7eb } .u-border-b { border-bottom: 1px solid #e5e7eb } .u-border-none{ border: none } .u-rounded-sm { border-radius: 6px } .u-rounded { border-radius: 8px } .u-rounded-md { border-radius: 12px } .u-rounded-lg { border-radius: 16px } .u-rounded-xl { border-radius: 20px } .u-rounded-full { border-radius: 9999px } .u-shadow-sm { box-shadow: 0 1px 3px rgba(0,0,0,.07) } .u-shadow { box-shadow: 0 2px 8px rgba(0,0,0,.08) } .u-shadow-md { box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-shadow-lg { box-shadow: 0 8px 32px rgba(0,0,0,.12) } /* ─── 컴포넌트 ──────────────────────────────── */ .u-card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.07); border: 1px solid #f3f4f6 } .u-card-hover { transition: translate .2s, box-shadow .2s } .u-card-hover:hover { translate: 0 -2px; box-shadow: 0 4px 16px rgba(0,0,0,.10) } .u-btn { display: inline-flex; align-items: center; justify-content: center; padding: 8px 18px; border-radius: 8px; font-weight: 600; font-size: .88rem; border: none; cursor: pointer; transition: opacity .15s; text-decoration: none } .u-btn:hover { opacity: .85 } .u-btn-primary { background: #6366f1; color: #fff } .u-btn-success { background: #10b981; color: #fff } .u-btn-warning { background: #f59e0b; color: #fff } .u-btn-danger { background: #ef4444; color: #fff } .u-btn-info { background: #0891b2; color: #fff } .u-btn-ghost { background: transparent; border: 1px solid #e5e7eb; color: #374151 } .u-btn-sm { padding: 5px 12px; font-size: .78rem } .u-btn-lg { padding: 12px 24px; font-size: 1rem } .u-btn-full { width: 100% } .u-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 99px; font-size: .72rem; font-weight: 700 } .u-badge-primary { background: #ede9fe; color: #6366f1 } .u-badge-success { background: #dcfce7; color: #16a34a } .u-badge-warning { background: #fef3c7; color: #d97706 } .u-badge-danger { background: #fef2f2; color: #dc2626 } .u-badge-info { background: #e0f2fe; color: #0284c7 } .u-badge-neutral { background: #f3f4f6; color: #6b7280 } .u-input { width: 100%; padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; box-sizing: border-box } .u-input:focus { outline: none; border-color: #6366f1 } .u-input:hover { border-color: #9ca3af } .u-label { display: block; font-size: .78rem; font-weight: 600; color: #6b7280; margin-bottom: 4px } .u-form-group { display: flex; flex-direction: column; gap: 4px } .u-divider { height: 1px; background: #f3f4f6; border: none; margin: 12px 0 } .u-progress { width: 100%; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden } .u-progress-bar { height: 100%; border-radius: 3px; background: #6366f1 } .u-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; flex-shrink: 0 } .u-avatar-sm { width: 28px; height: 28px; font-size: .72rem } .u-avatar-lg { width: 56px; height: 56px; font-size: 1.1rem } .u-empty-state { text-align: center; padding: 60px 24px; color: #9ca3af; background: #fff; border-radius: 16px } .u-empty-state .icon { font-size: 2.5rem; display: block; margin-bottom: 8px } .u-empty-state p { margin: 0 } .u-table { width: 100%; border-collapse: collapse } .u-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #9ca3af; border-bottom: 1px solid #f3f4f6 } .u-table td { padding: 11px 14px; font-size: .88rem; border-bottom: 1px solid #fafafa } .u-table tr:hover td { background: #fafafa } .u-hero-gradient { padding: 28px 24px; text-align: center; color: #fff } .u-hero-gradient h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 4px } .u-hero-gradient p { opacity: .8; margin: 0; font-size: .9rem } /* ─── 반응형 ────────────────────────────────── */ @media(max-width: 640px) { .u-sm-col { flex-direction: column } .u-sm-full { width: 100% } .u-sm-grid-1{ grid-template-columns: 1fr !important } .u-sm-hidden{ display: none !important } }
:root{
  --ink:#0d0d12;--surface:#13131c;--raised:#1c1c28;--rim:rgba(139,92,246,.18);
  --pop:#8b5cf6;--pop2:#6366f1;--sea:#06b6d4;--go:#10b981;--warn:#f59e0b;
  --tx:#dde1f0;--dim:#6b7280;--faint:#2a2a3a;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100dvh}

/* 애니메이션 */
@keyframes up{from{opacity:0;translate:0 20px}to{opacity:1;translate:0}}
@keyframes orb{0%,100%{opacity:.2}50%{opacity:.5}}
@keyframes pan{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@keyframes bob{0%,100%{translate:0}50%{translate:0 -8px}}
@keyframes spin{to{rotate:360deg}}

/* 배경 오브 */
.orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;animation:orb 6s ease-in-out infinite}
.o1{width:560px;height:560px;background:rgba(139,92,246,.1);top:-160px;right:-120px}
.o2{width:420px;height:420px;background:rgba(6,182,212,.07);bottom:-100px;left:-80px;animation-delay:3s}

/* 히어로 */
.hero{position:relative;overflow:hidden;
  border:1px solid var(--rim);border-radius:20px;
  background:var(--surface);padding:80px 56px 72px;margin-bottom:28px;
  box-shadow:0 40px 100px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.04)}
.badge{display:inline-flex;align-items:center;gap:8px;
  border:1px solid rgba(139,92,246,.35);border-radius:99px;
  background:rgba(139,92,246,.1);padding:5px 14px;
  font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:#c4b5fd;margin-bottom:32px;animation:up .5s ease both}
.dot{width:6px;height:6px;border-radius:50%;background:#a78bfa;
  box-shadow:0 0 0 3px rgba(167,139,250,.3);animation:orb 2s ease infinite}
.hero h1{font-size:clamp(2.6rem,5.5vw,4.8rem);font-weight:900;line-height:1.08;
  letter-spacing:-.03em;margin-bottom:20px;
  background:linear-gradient(135deg,#fff 0%,#c4b5fd 45%,#67e8f9 100%);
  background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  animation:up .6s .05s ease both,pan 7s ease infinite}
.hero p{font-size:1.1rem;color:var(--dim);line-height:1.8;
  max-width:540px;margin-bottom:40px;animation:up .6s .1s ease both}
.hero p strong{color:var(--tx);font-weight:600}
.btns{display:flex;gap:10px;flex-wrap:wrap;animation:up .6s .15s ease both}
.btn-fill{background:linear-gradient(135deg,var(--pop),var(--pop2));color:#fff;
  border-radius:10px;padding:12px 26px;font-weight:700;text-decoration:none;
  font-size:.9rem;box-shadow:0 4px 20px rgba(139,92,246,.4);
  transition:translate .2s,box-shadow .2s;display:inline-block}
.btn-fill:hover{translate:0 -2px;box-shadow:0 8px 30px rgba(139,92,246,.55);color:#fff;text-decoration:none}
.btn-line{background:rgba(255,255,255,.05);color:var(--dim);
  border:1px solid rgba(255,255,255,.1);border-radius:10px;
  padding:12px 22px;font-weight:600;text-decoration:none;font-size:.9rem;
  transition:all .2s;display:inline-block}
.btn-line:hover{background:rgba(255,255,255,.1);color:var(--tx);text-decoration:none}

/* 루프 배너 — 오늘의 핵심 */
.loop{display:grid;grid-template-columns:repeat(4,1fr);gap:0;
  border:1px solid var(--rim);border-radius:16px;overflow:hidden;margin-bottom:28px}
.loop-step{background:var(--surface);padding:24px 20px;text-align:center;
  border-right:1px solid var(--faint);position:relative}
.loop-step:last-child{border-right:none}
.loop-step::after{content:"→";position:absolute;right:-12px;top:50%;translate:0 -50%;
  color:var(--pop);font-size:1rem;z-index:1}
.loop-step:last-child::after{display:none}
.loop-icon{font-size:1.6rem;margin-bottom:10px;display:block}
.loop-label{font-size:.78rem;font-weight:700;color:var(--tx);margin-bottom:4px}
.loop-desc{font-size:.72rem;color:var(--dim);line-height:1.5}
.loop-new{position:absolute;top:10px;right:10px;
  background:var(--go);color:#fff;font-size:.6rem;font-weight:800;
  padding:2px 6px;border-radius:99px;letter-spacing:.05em}

/* 통계 */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px}
.stat{background:var(--surface);border:1px solid var(--rim);border-radius:14px;
  padding:20px 16px;text-align:center;transition:border-color .2s,translate .2s}
.stat:hover{border-color:rgba(139,92,246,.4);translate:0 -2px}
.stat-n{font-size:1.9rem;font-weight:900;
  background:linear-gradient(135deg,#a78bfa,#67e8f9);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1}
.stat-l{font-size:.72rem;color:var(--dim);margin-top:5px}

/* 코드 예시 */
.win{background:var(--surface);border:1px solid var(--rim);
  border-radius:16px;overflow:hidden;margin-bottom:28px;
  animation:bob 8s ease-in-out infinite;
  box-shadow:0 24px 60px rgba(0,0,0,.5)}
.win-bar{background:var(--raised);padding:12px 18px;
  display:flex;align-items:center;gap:7px;border-bottom:1px solid var(--faint)}
.dd{width:10px;height:10px;border-radius:50%}
.dr{background:#ff5f57}.dy{background:#febc2e}.dg{background:#28c840}
.win-title{margin-left:8px;font-size:.72rem;color:var(--dim);font-family:monospace}
.win-tag{margin-left:auto;font-size:.65rem;font-weight:700;
  background:rgba(16,185,129,.15);color:#34d399;
  padding:2px 8px;border-radius:99px}
.code{padding:28px 32px;font-family:"SF Mono","Fira Code",monospace;
  font-size:.84rem;line-height:2;overflow-x:auto;color:var(--tx)}
.kw{color:#c084fc}.fn{color:#86efac}.str{color:#fca5a5}
.cm{color:#3d455a;font-style:italic}.sym{color:#93c5fd}.hi{color:#67e8f9}
.ok{color:#4ade80}

/* 피처 */
.feats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px}
.feat{background:var(--surface);border:1px solid var(--rim);
  border-radius:14px;padding:24px;position:relative;overflow:hidden;
  transition:border-color .2s,translate .2s}
.feat:hover{border-color:rgba(139,92,246,.4);translate:0 -2px}
.feat::before{content:"";position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--pop),var(--sea));opacity:0;transition:opacity .2s}
.feat:hover::before{opacity:1}
.feat-i{font-size:1.5rem;margin-bottom:12px;display:block}
.feat-t{font-size:.9rem;font-weight:700;color:var(--tx);margin-bottom:6px}
.feat-d{font-size:.8rem;color:var(--dim);line-height:1.65}
.tag{display:inline-block;margin-top:10px;font-family:monospace;font-size:.72rem;
  background:rgba(139,92,246,.12);border:1px solid rgba(139,92,246,.2);
  color:#c4b5fd;padding:2px 8px;border-radius:4px}

/* AI 배너 */
.ai{border:1px solid rgba(139,92,246,.25);border-radius:14px;
  background:linear-gradient(135deg,rgba(139,92,246,.08),rgba(6,182,212,.04));
  padding:32px 36px;margin-bottom:28px;
  display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.ai h3{font-size:1rem;font-weight:800;color:var(--tx);margin-bottom:6px}
.ai p{font-size:.84rem;color:var(--dim);line-height:1.65;max-width:500px}

/* 반응형 */
@media(max-width:768px){
  .loop,.stats,.feats{grid-template-columns:repeat(2,1fr)}
  .hero{padding:40px 28px}
  .ai{flex-direction:column}
}
@media(max-width:480px){
  .loop,.stats{grid-template-columns:1fr 1fr}
  .feats{grid-template-columns:1fr}
}
</style>
"""

