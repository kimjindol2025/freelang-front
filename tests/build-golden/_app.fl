_area=\"note_content_area__4e00\";\nvar note_view=\"note_view__c3b7\";\nvar note_meta=\"note_meta__7671\";\nvar form_toolbar=\"form_toolbar__a6d8\";\nvar color_row=\"color_row__b5e4\";\nvar note_empty=\"note_empty__b08c\";\nvar note_actions=\"note_actions__dfb1\";\nvar icon_btn=\"icon_btn__4d25\";\nvar del_btn=\"del_btn__8fac\";\nvar search_wrap=\"search_wrap__37a0\";\nvar search_icon=\"search_icon__f263\";\nvar pin_form=\"pin_form__b618\";\nvar textarea_input=\"textarea_input__4bb6\";\nvar pg_wrap=\"pg_wrap__92cf\";\nvar pg_title=\"pg_title__9a36\";\nvar pg_subtitle=\"pg_subtitle__2581\";\nvar pg_grid=\"pg_grid__35a8\";\nvar pg_panel=\"pg_panel__aaad\";\nvar pg_panel_head=\"pg_panel_head__2bce\";\nvar pg_editor=\"pg_editor__f737\";\nvar pg_result=\"pg_result__d0e8\";\nvar pg_result_error=\"pg_result_error__7eff\";\nvar pg_btn=\"pg_btn__538e\";\nvar pg_examples=\"pg_examples__8d1f\";\nvar pg_ex_btn=\"pg_ex_btn__ea5c\";\nvar pg_status=\"pg_status__b570\";\nvar card=\"card__86e7\";\nvar hero=\"hero__43b0\";\nvar badge=\"badge__a154\";\nvar resp_grid=\"resp_grid__7f07\";\nvar resp_card=\"resp_card__789b\";\nvar resp_hero=\"resp_hero__3912\";\nif(_fl.get_store(\"notes\")==null)_fl.dispatch(\"notes\",[]);\n_fl.mount_reactive(\"island-noteapp-0\", (() => { const query = _fl.atom(\"\"); const draft = _fl.atom(\"\"); const saving = _fl.atom(false);\n  return (update) => { const notes_raw = ((_fl.get_store(\"notes\")) || ([])); return (() => { const notes = _fl.filter_arr((n) => { return (((_fl.deref(query) === \"\")) || (str_includes(str_to_lower(_fl.get(n, \"content\")), str_to_lower(_fl.deref(query))))); }, notes_raw); return _fl.h(\"div\", {\"class\": ni_wrap}, _fl.h(\"h1\", {\"class\": ni_title}, \"노트\"), _fl.h(\"p\", {\"class\": ni_sub}, \"Island 기반 실시간 CRUD\"), _fl.h(\"div\", {\"class\": ni_form}, _fl.h(\"textarea\", {\"class\": ni_input, \"rows\": \"2\", \"placeholder\": \"새 노트... (Ctrl+Enter로 저장)\", \"on-input\": (e) => { return (_fl.reset(draft, ((e).target).value), update()); }, \"on-keydown\": (e) => { return ((((e).ctrlKey) && (((e).key === \"Enter\")))) ? ((!(str_blank_q(_fl.deref(draft)))) ? ((_fl.reset(saving, true), update())) : null) : null; }}), _fl.h(\"div\", {\"class\": ni_row}, _fl.h(\"input\", {\"class\": ni_search, \"type\": \"text\", \"placeholder\": \"🔍 검색...\", \"on-input\": (e) => { return (_fl.reset(query, ((e).target).value), update()); }}), _fl.h(\"span\", {\"class\": ni_count}, _fl_str((notes)?.length ?? 0, \" / \", (notes_raw)?.length ?? 0)), _fl.h(\"button\", {\"class\": ni_btn_add, \"on-click\": () => { return (!(str_blank_q(_fl.deref(draft)))) ? ((_fl.reset(saving, true), update())) : null; }}, (_fl.deref(saving)) ? (\"저장 중...\") : (\"추가\")))), _fl.h(\"div\", {\"class\": ni_grid, \"style\": \"grid-template-columns:repeat(auto-fill,minmax(240px,1fr))\"}, (((notes)?.length ?? 0 === 0)) ? (_fl.h(\"div\", {\"class\": ni_empty}, ((_fl.deref(query) === \"\")) ? (\"노트가 없습니다\") : (\"검색 결과 없음\"))) : (_fl.map_arr((note) => { return _fl.h(\"div\", {\"class\": (_fl.get(note, \"pinned\")) ? (_fl_str(ni_card, \" \", ni_card_pin)) : (ni_card)}, _fl.h(\"div\", {\"class\": ni_content}, _fl.get(note, \"content\")), _fl.h(\"div\", {\"class\": ni_meta}, _fl.h(\"span\", {}, str_slice(((_fl.get(note, \"created_at\")) || (\"\")), 0, 10)), _fl.h(\"div\", {\"style\": \"display:flex;gap:4px\"}, _fl.h(\"button\", {\"class\": ni_btn_pin, \"on-click\": () => { return _fl.fetch_post(_fl_str(\"/api/notes/\", _fl.get(note, \"id\"), \"/pin\"), {}, (res) => { return _fl.dispatch(\"notes\",_fl.map_arr((n) => { return ((_fl.get(n, \"id\") === _fl.get(note, \"id\"))) ? (_fl.assoc(n, \"pinned\", !(_fl.get(note, \"pinned\")))) : (n); }, _fl.get_store(\"notes\"))); }); }}, (_fl.get(note, \"pinned\")) ? (\"📌\") : (\"📍\")), _fl.h(\"button\", {\"class\": ni_btn_del, \"on-click\": () => { return _fl.fetch_post(_fl_str(\"/api/notes/\", _fl.get(note, \"id\"), \"/delete\"), {}, (_) => { return _fl.dispatch(\"notes\",_fl.filter_arr((n) => { return