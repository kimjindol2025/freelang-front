opacity: .85 } .u-btn-primary { background: #6366f1; color: #fff } .u-btn-success { background: #10b981; color: #fff } .u-btn-warning { background: #f59e0b; color: #fff } .u-btn-danger { background: #ef4444; color: #fff } .u-btn-info { background: #0891b2; color: #fff } .u-btn-ghost { background: transparent; border: 1px solid #e5e7eb; color: #374151 } .u-btn-sm { padding: 5px 12px; font-size: .78rem } .u-btn-lg { padding: 12px 24px; font-size: 1rem } .u-btn-full { width: 100% } .u-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 99px; font-size: .72rem; font-weight: 700 } .u-badge-primary { background: #ede9fe; color: #6366f1 } .u-badge-success { background: #dcfce7; color: #16a34a } .u-badge-warning { background: #fef3c7; color: #d97706 } .u-badge-danger { background: #fef2f2; color: #dc2626 } .u-badge-info { background: #e0f2fe; color: #0284c7 } .u-badge-neutral { background: #f3f4f6; color: #6b7280 } .u-input { width: 100%; padding: 9px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; font-family: inherit; transition: border-color .15s; box-sizing: border-box } .u-input:focus { outline: none; border-color: #6366f1 } .u-input:hover { border-color: #9ca3af } .u-label { display: block; font-size: .78rem; font-weight: 600; color: #6b7280; margin-bottom: 4px } .u-form-group { display: flex; flex-direction: column; gap: 4px } .u-divider { height: 1px; background: #f3f4f6; border: none; margin: 12px 0 } .u-progress { width: 100%; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden } .u-progress-bar { height: 100%; border-radius: 3px; background: #6366f1 } .u-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg,#6366f1,#8b5cf6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; flex-shrink: 0 } .u-avatar-sm { width: 28px; height: 28px; font-size: .72rem } .u-avatar-lg { width: 56px; height: 56px; font-size: 1.1rem } .u-empty-state { text-align: center; padding: 60px 24px; color: #9ca3af; background: #fff; border-radius: 16px } .u-empty-state .icon { font-size: 2.5rem; display: block; margin-bottom: 8px } .u-empty-state p { margin: 0 } .u-table { width: 100%; border-collapse: collapse } .u-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #9ca3af; border-bottom: 1px solid #f3f4f6 } .u-table td { padding: 11px 14px; font-size: .88rem; border-bottom: 1px solid #fafafa } .u-table tr:hover td { background: #fafafa } .u-hero-gradient { padding: 28px 24px; text-align: center; color: #fff } .u-hero-gradient h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 4px } .u-hero-gradient p { opacity: .8; margin: 0; font-size: .9rem } /* ─── 반응형 ────────────────────────────────── */ @media(max-width: 640px) { .u-sm-col { flex-direction: column } .u-sm-full { width: 100% } .u-sm-grid-1{ grid-template-columns: 1fr !important } .u-sm-hidden{ display: none !important } }
.apps-section{margin-bottom:28px}
.apps-section h2{font-size:1rem;font-weight:700;color:var(--tx);margin:0 0 14px;display:flex;align-items:center;gap:8px}
.apps-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}
.app-card{background:var(--surface);border:1px solid var(--rim);border-radius:14px;
