; tests/island.test.flx — Island 회귀 테스트
; 빌드 시 자동 실행: node fl-front-build.js → G. Island 테스트

; ── 06 카운터 ──────────────────────────────────────────────
(deftest "counter 초기 렌더 — 0 표시"
  {:file "pages/examples/06-counter.flx"
   :island "counter"
   :expect {:html-contains ">0<"}})

(deftest "counter + 버튼 클릭 → 1"
  {:file "pages/examples/06-counter.flx"
   :island "counter"
   :click "button:last-of-type"
   :expect {:html-contains "1"}})

; ── 07 토글 ─────────────────────────────────────────────────
(deftest "toggle 초기 — 펼치기 버튼 있음"
  {:file "pages/examples/07-toggle.flx"
   :island "toggle"
   :expect {:html-contains "펼치기"}})

