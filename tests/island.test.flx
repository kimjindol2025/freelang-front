; ── 22 온도 변환기 ───────────────────────────────────────────
(deftest "tempconvert 초기 25°C — 화씨 77"
  {:file "pages/examples/22-temp-convert.flx"
   :island "tempconvert"
   :expect {:html-contains "77"}})

(deftest "tempconvert 초기 25°C — 켈빈 298"
  {:file "pages/examples/22-temp-convert.flx"
   :island "tempconvert"
   :expect {:html-contains "298"}})

; ── 23 likes store ──────────────────────────────────────────
(deftest "likes store — 버튼 클릭 5→6"
  {:file "pages/examples/23-like-store.flx"
   :island "likebutton"
   :store {"likes" 5}
   :click "button"
   :expect {:store-key "likes" :store-val 6}})

(deftest "likes badge — store watch 반영"
  {:file "pages/examples/23-like-store.flx"
   :island "likebadge"
   :store {"likes" 7}
   :expect {:html-contains "7"}})

; ── 29 BMI ──────────────────────────────────────────────────
(deftest "bmi 초기 170cm/65kg — 22.5"
  {:file "pages/examples/29-bmi.flx"
