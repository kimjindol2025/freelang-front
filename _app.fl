      "padding:12px 28px;font-weight:600;text-decoration:none;font-size:1rem;border:1px solid rgba(255,255,255,.3)'>"
      "Island"
      "</a>"
      "</div>"
      "</div>"

      ; ── 수치 ─────────────────────────────────────────────────
      "<div class='" stat_row "' style='margin:32px 0'>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>0</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>npm 의존성</div>"
      "</div>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>&lt;1KB</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>Island 런타임</div>"
      "</div>"
      "<div class='" stat_item "'>"
      "<div style='font-size:2rem;font-weight:800;color:#6366f1'>SSR</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>서버 렌더링</div>"
