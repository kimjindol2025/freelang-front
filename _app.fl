; _app.fl — 자동 생성. 직접 수정 금지.
; 생성: 2026-05-29T11:56:41.671Z

; ── CSS 스타일 클래스 바인딩 ──
(define card "card__6486")
(define grid "grid__e95a")
(define hero "hero__1266")
(define badge "badge__bbad")

; ── pages/about.flx ──
(defn page_about [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>About — FreeLang Front</title>"
    "<style>body{font-family:sans-serif;max-width:800px;margin:40px auto;padding:0 20px}</style>"
    "</head><body>"
    "<h1>FreeLang-Front란?</h1>"
    "<p>FreeLang v11 fx 기반 풀스택 프론트엔드 언어</p>"
    "<ul><li>npm install 0개</li><li>SSR 기본</li><li>파일 기반 라우팅</li></ul>"
    "<a href='/'>← 홈</a>"
    "</body></html>")))

; ── pages/api/hello.flx ──
(defn page_api_hello [req]
  (server-json {:ok true :message "Hello from FL-Front API" :version "0.1"}))

; ── pages/counter.flx ──
(defn page_counter [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>Counter Island — FreeLang Front</title>"
    "<style>body{font-family:sans-serif;max-width:600px;margin:60px auto;text-align:center}"
    "button{font-size:2rem;padding:16px 32px;cursor:pointer;border:2px solid #6366f1;"
    "border-radius:8px;background:white;color:#6366f1}</style>"
    "</head><body>"
    "<h1>Island 카운터</h1>"
    "<p>버튼을 클릭하면 숫자가 증가합니다.</p>"
    "<div id='island-counter-0'></div>"
    "<script>\nconst _fl={\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else el.setAttribute(k,String(v));\n    }\n    ch.flat().forEach(c=>el.appendChild(typeof c==='string'||typeof c==='number'?document.createTextNode(String(c)):c));\n    return el;\n  },\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{while(el.firstChild)el.removeChild(el.firstChild);el.appendChild(renderFn(update));};\n    update();\n  }\n};\nconst _fl_str=(...xs)=>xs.map(String).join('');\n</script><script>\n_fl.mount(\"island-counter-0\", (update) => {\n    return (() => { const n = _fl.atom(0); return _fl.h(\"button\", {\"on-click\": () => { return (_fl.swap(n, v => v + 1), update()); }}, [_fl.deref(n)].map(String).join('')); })();\n  });\n</script>"
    "<p style='margin-top:32px'><a href='/'>← 홈</a></p>"
    "</body></html>")))

; ── pages/index.flx ──
(defn page_index [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>FreeLang Front</title>"
    "<style>body{font-family:sans-serif;max-width:800px;margin:40px auto;padding:0 20px}</style>"
    "</head><body>"
    "<h1>Hello FreeLang-Front</h1>"
    "<p>npm install 0개로 Next.js 대체</p>"
    "<nav><a href='/about'>About</a> · <a href='/api/hello'>API 테스트</a></nav>"
    "</body></html>")))

; ── pages/styled.flx ──
(defn page_styled [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>Styled — FreeLang Front</title>"
    "<link rel='stylesheet' href='/public/app.css'>"
    "<style>body{font-family:sans-serif;max-width:900px;margin:40px auto;padding:0 20px}</style>"
    "</head><body>"
    "<div class='hero__HASH'><h1>CSS DSL 데모</h1></div>"
    "<div class='grid__HASH' style='margin-top:24px'>"
    "  <div class='card__HASH'>카드 1</div>"
    "  <div class='card__HASH'>카드 2</div>"
    "  <div class='card__HASH'>카드 3</div>"
    "</div>"
    "<p style='margin-top:16px'><a href='/'>← 홈</a></p>"
    "</body></html>")))

; ── pages/users/[id].flx ──
(defn page_users_id [req]
  (let [params (get req "params")
        id     (get params "id")]
    (server-html (str
      "<!DOCTYPE html><html><head>"
      "<meta charset='utf-8'>"
      "<title>User " id " — FreeLang Front</title>"
      "<style>body{font-family:sans-serif;max-width:800px;margin:40px auto;padding:0 20px}</style>"
      "</head><body>"
      "<h1>User #" id "</h1>"
      "<p>req.params.id = '" id "'</p>"
      "<a href='/'>← 홈</a>"
      "</body></html>"))))

(server-get "/about" "page_about")
(server-get "/api/hello" "page_api_hello")
(server-get "/counter" "page_counter")
(server-get "/" "page_index")
(server-get "/styled" "page_styled")
(server-get "/users/:id" "page_users_id")

(println "FL-Front v0.1 — http://localhost:3000")
(server-start 3000)