      "<div style='display:flex;gap:12px;flex-wrap:wrap'>"
      "<a href='/dashboard' style='background:white;color:#6366f1;border-radius:8px;"
      "padding:12px 28px;font-weight:700;text-decoration:none;font-size:1rem'>"
      "데모 보기 →"
