; ── 레이아웃·헬퍼 함수 ──
; ── _charts.flx ──
; pages/_charts.flx — SVG 차트 DSL 헬퍼
; (chart-bar data w h) : [{:label "A" :value 40} ...] → SVG 문자열
; (chart-line data w h): [{:label "A" :value 40} ...] → SVG 문자열

; 막대 차트
(defn chart-bar [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        bar-w   (- (/ inner-w n) 6)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  bar-h (round (* inner-h (/ val max-v)))
                  x     (+ pad (* i (+ bar-w 6)))
                  y     (+ pad (- inner-h bar-h))]
              (str
                "<rect x='" x "' y='" y "' width='" bar-w "' height='" bar-h
                "' fill='#6366f1' rx='3' opacity='0.85'/>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (- y 4)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

; 선 차트
(defn chart-line [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        min-v   (reduce (fn [a b] (if (< a b) a b)) max-v values)
        range-v (if (= max-v min-v) 1 (- max-v min-v))
        step-x  (if (= n 1) inner-w (/ inner-w (- n 1)))
        ; 포인트 좌표 계산
        points  (map-indexed
                  (fn [i d]
                    (let [val (get d :value)
                          cx  (+ pad (* i step-x))
                          cy  (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
                      (str cx "," cy)))
                  data)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      ; 그라데이션 영역 (fill)
      "<defs><linearGradient id='grad' x1='0' y1='0' x2='0' y2='1'>"
      "<stop offset='0%' stop-color='#6366f1' stop-opacity='0.2'/>"
      "<stop offset='100%' stop-color='#6366f1' stop-opacity='0'/>"
      "</linearGradient></defs>"
      "<polyline points='"
      (reduce str "" (map (fn [p] (str p " ")) points))
      "' fill='none' stroke='#6366f1' stroke-width='2.5' stroke-linejoin='round'/>"
      ; 데이터 포인트 + 레이블
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  cx    (+ pad (* i step-x))
                  cy    (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
              (str
                "<circle cx='" cx "' cy='" cy "' r='4' fill='#6366f1'/>"
                "<text x='" cx "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" cx "' y='" (- cy 8)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

; ── _layout.flx ──
; pages/_layout.flx — 공통 레이아웃 헬퍼
; 라우트로 등록되지 않음 (빌드 스크립트가 _ 접두사 제외)
; 사용: (layout "페이지 제목" "body HTML 내용")


; nav link 현재 페이지 강조 여부 반환
(defn nav-link [href label current]
  (if (= href current)
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;background:rgba(255,255,255,.2)'>" label "</a>")
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;opacity:.8'>" label "</a>")))

; 공통 레이아웃 — title, content, 현재 path
(defn layout [title content req]
  (let [path (server-req-path req)]
    (str
      "<!DOCTYPE html><html lang='ko'><head>"
      "<meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>" title " — FreeLang Front</title>"
      "<style>"
      "*{box-sizing:border-box}"
      "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;margin:0;background:#f9fafb;color:#111}"
      ".lnav{background:#6366f1;padding:0 24px;display:flex;align-items:center;gap:4px}"
      ".lnav-brand{color:white;font-weight:700;font-size:1.1rem;margin-right:16px;text-decoration:none}"
      ".lwrap{max-width:960px;margin:0 auto;padding:32px 24px}"
      ".lfoot{text-align:center;padding:32px;color:#9ca3af;font-size:.8rem;border-top:1px solid #e5e7eb;margin-top:48px}"
      "</style>"
      "</head><body>"
      "<nav class='lnav'>"
      "<a href='/' class='lnav-brand'>FL Front</a>"
      (nav-link "/" "홈" path)
      (nav-link "/dashboard" "대시보드" path)
      (nav-link "/counter" "카운터" path)
      (nav-link "/contact" "문의" path)
      (nav-link "/styled" "스타일" path)
      "</nav>"
      "<div class='lwrap'>"
      content
      "</div>"
      "<footer class='lfoot'>FreeLang Front v0.1 · npm install 0개 · SSR · Island</footer>"
      "</body></html>")))

