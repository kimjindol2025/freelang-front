      "<div style='font-size:1.5rem;margin-bottom:8px'>📬</div>"
      "<div style='font-weight:600'>Contact</div>"
      "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>서버 폼 처리 · 검증 · Redirect</div>"
      "</a>"
      "</div>") req)))

; ── pages/styled.flx ──
; 기본 스타일

; 반응형 그리드 — 기본 3열, md(768px)에서 2열, sm(640px)에서 1열

; 반응형 카드 — 기본 24px 패딩, sm에서 14px

; 반응형 히어로 — 기본 48px 패딩, sm에서 24px

(defn page_styled [req]
  (server-html
    (layout "Styled" (str "<style>.card__6486 { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 12px rgba(0,0,0,.15); } .hero__1266 { background: #6366f1; color: white; padding: 48px; border-radius: 12px; } .badge__6fd2 { background: #f3f4f6; color: #374151; padding: 4px; border-radius: 4px; font-size: 12px; font-weight: 600; } .resp_grid__90c1 { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); } @media(max-width:768px){.resp_grid__90c1{grid-template-columns: repeat(2, 1fr);}} @media(max-width:640px){.resp_grid__90c1{grid-template-columns: repeat(1, 1fr);}} .resp_card__23ba { background: white; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.12); padding: 24px; } @media(max-width:640px){.resp_card__23ba{padding: 14px;}} .resp_hero__266c { background: #6366f1; color: white; border-radius: 12px; padding: 48px; } @media(max-width:640px){.resp_hero__266c{padding: 24px;}}</style>"
      "<h2 style='margin:0 0 8px'>CSS DSL 데모</h2>"
      "<p style='color:#6b7280;margin:0 0 24px'>scoped hash + 반응형 breakpoint — 화면 크기를 줄여보세요</p>"

      ; 반응형 히어로
      "<div class='" resp_hero "'>"
      "<h3 style='margin:0 0 8px'>반응형 히어로</h3>"
      "<p style='margin:0;opacity:.85'>sm(640px): 패딩 24px · md(768px) 이상: 48px</p>"
      "</div>"

      ; 반응형 그리드
      "<h3 style='margin:24px 0 12px;color:#374151'>반응형 그리드 (3 → 2 → 1열)</h3>"
      "<div class='" resp_grid "'>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>📊</div>"
      "<strong>SSR 렌더링</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>서버에서 완전한 HTML 생성</p>"
      "</div>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🎨</div>"
      "<strong>CSS DSL</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>:sm-p :md-cols breakpoint</p>"
      "</div>"
      "<div class='" resp_card "'>"
      "<div style='font-size:1.5rem;margin-bottom:8px'>🏝️</div>"
      "<strong>Island 아키텍처</strong>"
      "<p style='font-size:.85rem;color:#6b7280;margin:8px 0 0'>필요한 부분만 JS</p>"
      "</div>"
      "</div>"

      ; 배지 예제
      "<h3 style='margin:24px 0 12px;color:#374151'>CSS DSL 배지</h3>"
      "<div style='display:flex;gap:8px;flex-wrap:wrap'>"
      "<span class='" badge "'>npm 0개</span>"
      "<span class='" badge "'>SSR</span>"
      "<span class='" badge "'>Island</span>"
      "<span class='" badge "'>반응형</span>"
      "<span class='" badge "'>Critical CSS</span>"
      "<span class='" badge "'>서버 폼</span>"
      "</div>") req)))

; ── pages/todo.flx ──
(defn page_todo [req]
  (server-html
    (layout "To-do" (str
      "<h2 style='margin:0 0 8px'>To-do Island</h2>"
      "<p style='color:#6b7280;margin:0 0 24px'>atom 배열 상태 · 추가 / 완료 토글 / 삭제 — 순수 클라이언트 Island</p>"
      "<div id='island-todoapp-0'></div>"
      "<script>\nconst _fl={\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // 배열/맵 조작\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    ch.flat().forEach(c=>{\n      if(c==null)return;\n      if(c instanceof Node)el.appendChild(c);\n      else el.appendChild(document.createTextNode(String(c)));\n    });\n    return el;\n  },\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{while(el.firstChild)el.removeChild(el.firstChild);const r=renderFn(update);if(r)el.appendChild(r);};\n    update();\n  }\n};\nconst _fl_str=(...xs)=>xs.map(String).join('');\n</script><script>\n_fl.mount(\"island-todoapp-0\", (update) => {\n    return (() => { const items = _fl.atom([]); const inp_val = _fl.atom(\"\"); const next_id = _fl.atom(0); return _fl.h(\"div\", {\"style\": \"max-width:480px\"}, _fl.h(\"div\", {\"style\": \"display:flex;gap:8px;margin-bottom:16px\"}, _fl.h(\"input\", {\"type\": \"text\", \"value\": _fl.deref(inp_val), \"placeholder\": \"할 일을 입력하세요...\", \"style\": \"flex:1;padding:10px 14px;border:1px solid #d1d5db;border-radius:6px;font-size:1rem\", \"on-input\": (e) => { return (_fl.reset(inp_val, (((e)?.[\"target\"])?.[\"value\"] ?? null)), update()); }, \"on-keydown\": (e) => { return ((((e)?.[\"key\"] ?? null) === \"Enter\")) ? ((!((_fl.deref(inp_val) === \"\"))) ? ((() => { (_fl.swap(items, (arr) => { return _fl.push(arr, {\"id\": _fl.deref(next_id), \"text\": _fl.deref(inp_val), \"done\": false}); }), update()); (_fl.swap(next_id, v => v + 1), update()); (_fl.reset(inp_val, \"\"), update()) })()) : null) : null; }}), _fl.h(\"button\", {\"style\": \"background:#6366f1;color:white;border:none;border-radius:6px;padding:10px 20px;cursor:pointer;font-size:1rem;white-space:nowrap\", \"on-click\": () => { return (!((_fl.deref(inp_val) === \"\"))) ? ((() => { (_fl.swap(items, (arr) => { return _fl.push(arr, {\"id\": _fl.deref(next_id), \"text\": _fl.deref(inp_val), \"done\": false}); }), update()); (_fl.swap(next_id, v => v + 1), update()); (_fl.reset(inp_val, \"\"), update()) })()) : null; }}, \"추가\")), _fl.h(\"ul\", {\"style\": \"list-style:none;margin:0;padding:0\"}, _fl.map_arr((item) => { return (() => { const done = _fl.get(item, \"done\"); const id = _fl.get(item, \"id\"); const text = _fl.get(item, \"text\"); return _fl.h(\"li\", {\"style\": \"display:flex;align-items:center;gap:10px;padding:12px 14px;background:white;border-radius:8px;margin-bottom:8px;box-shadow:0 1px 3px rgba(0,0,0,.08)\"}, _fl.h(\"input\", {\"type\": \"checkbox\", \"style\": \"width:18px;height:18px;cursor:pointer;accent-color:#6366f1\", \"checked\": (done) ? (\"checked\") : (\"\"), \"on-click\": () => { return (_fl.swap(items, (arr) => { return _fl.map_arr((it) => { return ((_fl.get(it, \"id\") === id)) ? (_fl.assoc(it, \"done\", !(_fl.get(it, \"done\")))) : (it); }, arr); }), update()); }}), _fl.h(\"span\", {\"style\": (done) ? (\"flex:1;color:#9ca3af;text-decoration:line-through\") : (\"flex:1\")}, text), _fl.h(\"button\", {\"style\": \"background:none;border:none;color:#ef4444;cursor:pointer;font-size:1.3rem;line-height:1;padding:0 2px\", \"on-click\": () => { return (_fl.swap(items, (arr) => { return _fl.filter_arr((it) => { return (_fl.get(it, \"id\") !== id); }, arr); }), update()); }}, \"×\")); })(); }, _fl.deref(items))), _fl.h(\"p\", {\"style\": \"color:#9ca3af;font-size:.85rem;margin-top:12px\"}, [(_fl.deref(items))?.length ?? 0, \"개 항목\"].map(String).join(''))); })();\n  });\n</script>") req)))

; ── pages/users/[id].flx ──
(defn page_users_id [req]
  (let [params (get req "params")
        id     (get params "id")]
    (server-html (str
      "<!DOCTYPE html><html><head>"
      "<meta charset='utf-8'>"
      "<title>User " id " — FreeLang Front</title>"
      "<style>body{font-family:sans-serif;max-width:800px;margin:40px auto;padding:0 20px}</style>"
      "</head><body>"
      "<h1>User #" id "</h1>"
      "<p>req.params.id = '" id "'</p>"
      "<a href='/'>← 홈</a>"
      "</body></html>"))))

(server-get "/about" "page_about")
(server-get "/api/hello" "page_api_hello")
(server-get "/contact/thanks" "page_contact_thanks")
(server-get "/contact" "page_contact")
(server-post "/contact" "page_contact_post")
(server-get "/counter" "page_counter")
(server-get "/dashboard" "page_dashboard")
(server-get "/" "page_index")
(server-get "/styled" "page_styled")
(server-get "/todo" "page_todo")
(server-get "/users/:id" "page_users_id")

(println "FL-Front v0.1 — http://localhost:3000")
(server-start 3000)