      "</div>"

      ; ── 기능 카드 ──────────────────────────────────────────
      "<h2 style='font-size:1.5rem;font-weight:700;margin:8px 0 20px;color:#111'>핵심 기능</h2>"
      "<div class='" feat_grid "'>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>🗂️</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>파일 기반 라우팅</div>"
