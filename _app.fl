      "<a href='/styled' style='background:rgba(255,255,255,.15);color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none;font-size:1rem;border:1px solid rgba(255,255,255,.3)'>"
      "CSS DSL"
      "</a>"
