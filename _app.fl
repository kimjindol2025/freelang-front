; ── 레이아웃·헬퍼 함수 ──
; ── _layout.flx ──
; pages/_layout.flx — 공통 레이아웃 헬퍼
; 라우트로 등록되지 않음 (빌드 스크립트가 _ 접두사 제외)
; 사용: (layout "페이지 제목" "body HTML 내용")


; nav link 현재 페이지 강조 여부 반환
(defn nav-link [href label current]
  (if (= href current)
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;background:rgba(255,255,255,.2)'>" label "</a>")
    (str "<a href='" href "' style='color:white;text-decoration:none;"
         "padding:12px 16px;display:inline-block;opacity:.8'>" label "</a>")))

; 공통 레이아웃 — title, content, 현재 path
(defn layout [title content req]
  (let [path (server-req-path req)]
    (str
      "<!DOCTYPE html><html lang='ko'><head>"
      "<meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>" title " — FreeLang Front</title>"
      "<style>"
      "*{box-sizing:border-box}"
      "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;margin:0;background:#f9fafb;color:#111}"
      ".lnav{background:#6366f1;padding:0 24px;display:flex;align-items:center;gap:4px}"
      ".lnav-brand{color:white;font-weight:700;font-size:1.1rem;margin-right:16px;text-decoration:none}"
      ".lwrap{max-width:960px;margin:0 auto;padding:32px 24px}"
      ".lfoot{text-align:center;padding:32px;color:#9ca3af;font-size:.8rem;border-top:1px solid #e5e7eb;margin-top:48px}"
      "</style>"
      "</head><body>"
      "<nav class='lnav'>"
      "<a href='/' class='lnav-brand'>FL Front</a>"
      (nav-link "/" "홈" path)
      (nav-link "/dashboard" "대시보드" path)
      (nav-link "/counter" "카운터" path)
      (nav-link "/contact" "문의" path)
      (nav-link "/styled" "스타일" path)
      (nav-link "/todo" "To-do" path)
      "<a href='/logout' style='color:white;text-decoration:none;padding:12px 16px;display:inline-block;opacity:.8;margin-left:auto'>로그아웃</a>"
      "</nav>"
      "<div class='lwrap'>"
      content
      "</div>"
      "<footer class='lfoot'>FreeLang Front v0.1 · npm install 0개 · SSR · Island</footer>"
      "</body></html>")))

; ── _db.flx ──
; pages/_db.flx — SQLite DB 연결 헬퍼
; DB 설정 — data/app.db
(define DB {:type "sqlite" :path "data/app.db"})

; 마이그레이션 — 서버 시작 시 자동 실행
(defn db-migrate []
  (db-exec DB "CREATE TABLE IF NOT EXISTS sessions (
    id TEXT PRIMARY KEY,
    username TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS stats (
    id INTEGER PRIMARY KEY,
    users INTEGER DEFAULT 0,
    revenue INTEGER DEFAULT 0,
    orders INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now'))
  )")
  (db-exec DB "CREATE TABLE IF NOT EXISTS monthly_stats (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    label TEXT NOT NULL,
    value INTEGER NOT NULL,
    created_at TEXT DEFAULT (datetime('now'))
  )")
  ; 초기 데이터 없으면 삽입
  (let [existing (db-query DB "SELECT id FROM stats LIMIT 1" [])]
    (if (= (length existing) 0)
      (do
        (db-exec DB "INSERT INTO stats (id, users, revenue, orders) VALUES (1, 1247, 23450000, 892)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('1월', 1200)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('2월', 1800)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('3월', 2100)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('4월', 1700)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('5월', 2400)" [])
        (db-exec DB "INSERT INTO monthly_stats (label, value) VALUES ('6월', 2800)" []))
      nil)))

; DB에서 대시보드 통계 조회
(defn db-fetch-stats []
  (let [rows    (db-query DB "SELECT * FROM stats WHERE id = 1" [])
        monthly (db-query DB "SELECT label, value FROM monthly_stats ORDER BY id" [])
        weekly  [{:label "월" :value 320}
                 {:label "화" :value 410}
                 {:label "수" :value 290}
                 {:label "목" :value 500}
                 {:label "금" :value 460}
                 {:label "토" :value 230}
                 {:label "일" :value 180}]]
    (if (= (length rows) 0)
      {:users 0 :revenue 0 :orders 0 :monthly [] :weekly weekly}
      (let [row (first rows)]
        {:users   (get row "users")
         :revenue (get row "revenue")
         :orders  (get row "orders")
         :monthly monthly
         :weekly  weekly}))))

; 마이그레이션 즉시 실행
(db-migrate)

; ── _auth.flx ──
; pages/_auth.flx — 쿠키 세션 인증 헬퍼
; 데모 계정: admin / admin123

(define COOKIE_NAME "fl_session")
(define DEMO_USER "admin")
(define DEMO_PASS "admin123")

; 쿠키에서 세션 ID 읽기
(defn auth-session-id [req]
  (server-req-cookie req COOKIE_NAME))

; 세션 유효성 검사 → username 또는 nil
(defn auth-check [req]
  (let [sid (auth-session-id req)]
    (if sid
      (let [rows (db-query DB "SELECT username FROM sessions WHERE id = ?" [sid])]
        (if (> (length rows) 0)
          (get (first rows) "username")
          nil))
      nil)))

; 로그인 → 세션 생성 + 쿠키 문자열 반환 (실패 시 nil)
(defn auth-login [username password]
  (if (and (= username DEMO_USER) (= password DEMO_PASS))
    (let [sid (uuid)]
      (db-exec DB "INSERT INTO sessions (id, username) VALUES (?, ?)" [sid username])
      (server-set-cookie COOKIE_NAME sid {:max_age 86400 :secure false}))
    nil))

; 로그아웃 → 세션 삭제 + 만료 쿠키 문자열 반환
(defn auth-logout [req]
  (let [sid (auth-session-id req)]
    (if sid
      (db-exec DB "DELETE FROM sessions WHERE id = ?" [sid])
      nil)
    (server-set-cookie COOKIE_NAME "" {:max_age 0 :secure false})))

; 인증 필요 라우트 가드 — 미인증 시 /login redirect
(defn auth-required [req handler]
  (let [user (auth-check req)]
    (if user
      (handler user)
      (server-redirect "/login"))))

; ── _error.flx ──
; pages/_error.flx — 에러 페이지 헬퍼
; (page-404 req) → server-html 404 응답
; (page-500 msg req) → server-html 500 응답

(defn page-404 [req]
  (server-status 404
    (layout "404 — 페이지를 찾을 수 없음" (str
      "<div style='text-align:center;padding:48px 0'>"
      "<div style='font-size:5rem;margin-bottom:16px'>🔍</div>"
      "<h2 style='font-size:2rem;font-weight:800;color:#111;margin:0 0 12px'>404</h2>"
      "<p style='color:#6b7280;font-size:1.1rem;margin:0 0 32px'>페이지를 찾을 수 없습니다</p>"
      "<a href='/' style='background:#6366f1;color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none'>← 홈으로</a>"
      "</div>") req)))

(defn page-500 [msg req]
  (server-status 500
    (layout "500 — 서버 오류" (str
      "<div style='text-align:center;padding:48px 0'>"
      "<div style='font-size:5rem;margin-bottom:16px'>💥</div>"
      "<h2 style='font-size:2rem;font-weight:800;color:#111;margin:0 0 12px'>500</h2>"
      "<p style='color:#6b7280;font-size:1.1rem;margin:0 0 8px'>서버에서 오류가 발생했습니다</p>"
      "<p style='color:#9ca3af;font-size:.85rem;font-family:monospace;margin:0 0 32px'>" msg "</p>"
      "<a href='/' style='background:#6366f1;color:white;border-radius:8px;"
      "padding:12px 28px;font-weight:600;text-decoration:none'>← 홈으로</a>"
      "</div>") req)))

; 와일드카드 핸들러 — 등록되지 않은 모든 경로
(defn not-found-handler [req]
  (page-404 req))

; ── _charts.flx ──
; pages/_charts.flx — SVG 차트 DSL 헬퍼
; (chart-bar data w h) : [{:label "A" :value 40} ...] → SVG 문자열
; (chart-line data w h): [{:label "A" :value 40} ...] → SVG 문자열

; 막대 차트
(defn chart-bar [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        bar-w   (- (/ inner-w n) 6)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  bar-h (round (* inner-h (/ val max-v)))
                  x     (+ pad (* i (+ bar-w 6)))
                  y     (+ pad (- inner-h bar-h))]
              (str
                "<rect x='" x "' y='" y "' width='" bar-w "' height='" bar-h
                "' fill='#6366f1' rx='3' opacity='0.85'/>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" (+ x (/ bar-w 2)) "' y='" (- y 4)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

; 선 차트
(defn chart-line [data w h]
  (let [n       (length data)
        pad     40
        inner-w (- w (* pad 2))
        inner-h (- h (* pad 2))
        values  (map (fn [d] (get d :value)) data)
        max-v   (reduce (fn [a b] (if (> a b) a b)) 1 values)
        min-v   (reduce (fn [a b] (if (< a b) a b)) max-v values)
        range-v (if (= max-v min-v) 1 (- max-v min-v))
        step-x  (if (= n 1) inner-w (/ inner-w (- n 1)))
        ; 포인트 좌표 계산
        points  (map-indexed
                  (fn [i d]
                    (let [val (get d :value)
                          cx  (+ pad (* i step-x))
                          cy  (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
                      (str cx "," cy)))
                  data)]
    (str
      "<svg viewBox='0 0 " w " " h "' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:auto'>"
      "<line x1='" pad "' y1='" pad "' x2='" pad "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      "<line x1='" pad "' y1='" (+ pad inner-h) "' x2='" (+ pad inner-w) "' y2='" (+ pad inner-h) "' stroke='#e5e7eb' stroke-width='1'/>"
      ; 그라데이션 영역 (fill)
      "<defs><linearGradient id='grad' x1='0' y1='0' x2='0' y2='1'>"
      "<stop offset='0%' stop-color='#6366f1' stop-opacity='0.2'/>"
      "<stop offset='100%' stop-color='#6366f1' stop-opacity='0'/>"
      "</linearGradient></defs>"
      "<polyline points='"
      (reduce str "" (map (fn [p] (str p " ")) points))
      "' fill='none' stroke='#6366f1' stroke-width='2.5' stroke-linejoin='round'/>"
      ; 데이터 포인트 + 레이블
      (reduce str ""
        (map-indexed
          (fn [i d]
            (let [val   (get d :value)
                  label (get d :label)
                  cx    (+ pad (* i step-x))
                  cy    (+ pad (- inner-h (* inner-h (/ (- val min-v) range-v))))]
              (str
                "<circle cx='" cx "' cy='" cy "' r='4' fill='#6366f1'/>"
                "<text x='" cx "' y='" (+ (+ pad inner-h) 14)
                "' text-anchor='middle' font-size='11' fill='#6b7280'>" label "</text>"
                "<text x='" cx "' y='" (- cy 8)
                "' text-anchor='middle' font-size='10' fill='#374151'>" val "</text>")))
          data))
      "</svg>")))

