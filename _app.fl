      "<a href='/'>홈으로 돌아가기</a>"
      "</div>"
      "</div>"
      "</body></html>"))))

; ── pages/contact.flx ──
; GET /contact — 문의 폼 렌더
; POST /contact — 폼 처리 → /contact/thanks redirect (또는 에러 재렌더)


; POST 핸들러 — server-req-json이 {name email message} 객체 반환
; (form-field req "name") → "홍길동" 또는 ""
(defn form-field [req key]
  (let [parsed (server-req-json req)
        val    (get parsed key)]
    (if (= val nil) "" val)))

; GET 핸들러 — ?error=1 시 에러 메시지 표시
(defn page_contact [req]
  (let [err (server-req-query req "error")]
    (server-html (str
      "<!DOCTYPE html><html><head>"
      "<meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>문의하기 — FreeLang Front</title>"
      "<style>"
      "body{font-family:sans-serif;margin:0;background:#f9fafb}"
      ".wrap{max-width:560px;margin:0 auto;padding:48px 24px}"
      "label{display:block;font-size:.9rem;color:#374151;margin-bottom:4px}"
      "input,textarea{width:100%;box-sizing:border-box;border:1px solid #d1d5db;"
      "border-radius:6px;padding:10px 12px;font-size:1rem;margin-bottom:16px}"
      "input:focus,textarea:focus{outline:2px solid #6366f1;border-color:transparent}"
      "button{background:#6366f1;color:white;border:none;border-radius:6px;"
      "padding:12px 32px;font-size:1rem;cursor:pointer;width:100%}"
      "button:hover{background:#4f46e5}"
      ".err{background:#fef2f2;border:1px solid #fecaca;border-radius:6px;"
      "padding:12px 16px;color:#dc2626;margin-bottom:16px;font-size:.9rem}"
      ".nav{margin-bottom:24px}"
      ".nav a{color:#6366f1;text-decoration:none;font-size:.9rem}"
      "</style>"
      "</head><body>"
      "<div class='wrap'>"
      "<div class='nav'><a href='/'>← 홈으로</a></div>"
      "<div class='" form_box "'>"
      "<h2 style='margin:0 0 24px;color:#111'>문의하기</h2>"
      (if (= err "1")
        "<div class='err'>이름과 이메일을 모두 입력해 주세요.</div>"
        "")
      "<form method='POST' action='/contact'>"
      "<label>이름</label>"
      "<input type='text' name='name' placeholder='홍길동' required>"
      "<label>이메일</label>"
      "<input type='email' name='email' placeholder='hello@example.com' required>"
      "<label>메시지</label>"
      "<textarea name='message' rows='5' placeholder='문의 내용을 입력해 주세요...'></textarea>"
      "<button type='submit'>보내기</button>"
      "</form>"
      "</div>"
      "</div>"
      "</body></html>"))))

; POST 핸들러 — form-field 파싱 → 검증 → redirect
; server-redirect가 encodeURI로 한글 자동 인코딩하므로 raw 값 그대로 전달
(defn page_contact_post [req]
  (let [name  (form-field req "name")
        email (form-field req "email")]
    (if (= name "")
      (server-redirect "/contact?error=1")
      (if (= email "")
        (server-redirect "/contact?error=1")
        (server-redirect (str "/contact/thanks?name=" name))))))

; ── pages/counter.flx ──
(defn page_counter [req]
  (server-html (str
    "<!DOCTYPE html><html><head>"
    "<meta charset='utf-8'>"
    "<title>Counter Island — FreeLang Front</title>"
    "<style>body{font-family:sans-serif;max-width:600px;margin:60px auto;text-align:center}"
    "button{font-size:2rem;padding:16px 32px;cursor:pointer;border:2px solid #6366f1;"
    "border-radius:8px;background:white;color:#6366f1}</style>"
    "</head><body>"
    "<h1>Island 카운터</h1>"
    "<p>버튼을 클릭하면 숫자가 증가합니다.</p>"
    "<div id='island-counter-0'></div>"
    "<script>\nconst _fl={\n  atom:(v)=>({v}),\n  deref:(a)=>a.v,\n  swap:(a,f)=>{a.v=f(a.v);return a.v;},\n  reset:(a,v)=>{a.v=v;return v;},\n  // 배열/맵 조작\n  push:(arr,item)=>[...(arr||[]),item],\n  get:(obj,key)=>obj==null?null:obj[key]??null,\n  assoc:(obj,key,val)=>({...(obj||{}),[key]:val}),\n  dissoc:(obj,key)=>{const r={...(obj||{})};delete r[key];return r;},\n  map_arr:(fn,arr)=>(arr||[]).map(fn),\n  filter_arr:(fn,arr)=>(arr||[]).filter(fn),\n  reduce_arr:(fn,init,arr)=>(arr||[]).reduce(fn,init),\n  h:(tag,attrs,...ch)=>{\n    const el=document.createElement(tag);\n    for(const[k,v]of Object.entries(attrs||{})){\n      if(k==='checked'){if(v&&v!=='')el.checked=true;}\n      else if(k.startsWith('on-'))el.addEventListener(k.slice(3),v);\n      else if(v!==null&&v!==undefined&&v!=='')el.setAttribute(k,String(v));\n    }\n    ch.flat().forEach(c=>{\n      if(c==null)return;\n      if(c instanceof Node)el.appendChild(c);\n      else el.appendChild(document.createTextNode(String(c)));\n    });\n    return el;\n  },\n  mount:(id,renderFn)=>{\n    const el=document.getElementById(id);\n    if(!el)return;\n    const update=()=>{while(el.firstChild)el.removeChild(el.firstChild);const r=renderFn(update);if(r)el.appendChild(r);};\n    update();\n  }\n};\nconst _fl_str=(...xs)=>xs.map(String).join('');\n</script><script>\n_fl.mount(\"island-counter-0\", (update) => {\n    return (() => { const n = _fl.atom(0); return _fl.h(\"button\", {\"on-click\": () => { return (_fl.swap(n, v => v + 1), update()); }}, [_fl.deref(n)].map(String).join('')); })();\n  });\n</script>"
    "<p style='margin-top:32px'><a href='/'>← 홈</a></p>"
    "</body></html>")))

; ── pages/dashboard.flx ──
; server-fn — 서버 데이터 패치 (실제 앱: DB 쿼리)
(defn fetch-stats []
  {:users 1247 :revenue 23450000 :orders 892
   :monthly [{:label "1월" :value 1200}
             {:label "2월" :value 1800}
             {:label "3월" :value 2100}
             {:label "4월" :value 1700}
             {:label "5월" :value 2400}
             {:label "6월" :value 2800}]
   :weekly  [{:label "월" :value 320}
             {:label "화" :value 410}
             {:label "수" :value 290}
             {:label "목" :value 500}
             {:label "금" :value 460}
             {:label "토" :value 230}
             {:label "일" :value 180}]})


; 숫자 포맷 (백만 단위)
(defn fmt-num [n]
  (let [s   (str n)
        len (length s)]
    (if (> len 6)
      (str (str-slice s 0 (- len 6)) "백" (str-slice s (- len 6) (- len 4)) "만")
      s)))

(defn page_dashboard [req]
  (let [stats   (fetch-stats)
        users   (get stats :users)
        revenue (get stats :revenue)
        orders  (get stats :orders)
        monthly (get stats :monthly)
        weekly  (get stats :weekly)
        bar     (chart-bar monthly 480 200)
        line    (chart-line weekly 480 200)]
    (server-html
      (layout "Dashboard" (str "<style>.stat_card__5598 { background: white; padding: 24px; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.12); } .grid__e95a { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); } .chart_box__4b8f { background: white; padding: 24px; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.12); }</style>"
        "<h2 style='margin:0 0 4px'>📊 FreeLang Front Dashboard</h2>"
        "<p style='color:#6b7280;margin:0 0 24px'>npm install 0개 · SSR · CSS DSL · Island · SVG Chart</p>"

        ; 통계 카드 3개
        "<div class='" grid "' style='margin-bottom:24px'>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>" users "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 사용자</div>"
        "</div>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>₩" (fmt-num revenue) "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 매출</div>"
        "</div>"
        "<div class='" stat_card "'>"
        "<div style='font-size:2rem;font-weight:700'>" orders "</div>"
        "<div style='font-size:.85rem;color:#6b7280;margin-top:4px'>총 주문</div>"
        "</div>"
        "</div>"

        ; 차트 2개 — 나란히
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:16px'>"
        "<div class='" chart_box "'>"
        "<h3 style='margin:0 0 12px;font-size:.95rem;color:#374151'>📊 월별 매출 막대 차트</h3>"
        bar
        "</div>"
        "<div class='" chart_box "'>"
        "<h3 style='margin:0 0 12px;font-size:.95rem;color:#374151'>📈 주간 방문 선 차트</h3>"
        line
        "</div>"
        "</div>") req))))

