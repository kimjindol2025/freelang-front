      "<code style='background:#f3f4f6;padding:2px 6px;border-radius:4px;font-size:.8rem'>"
      "(chart-bar data w h) → &lt;svg&gt;</code>"
      "</div>"
      "</div>"

      "<div class='" feat_card "'>"
      "<div style='font-size:2rem;margin-bottom:12px'>⚡</div>"
      "<div style='font-weight:700;font-size:1rem;margin-bottom:8px'>Critical CSS 인라인</div>"
      "<div style='font-size:.875rem;color:#6b7280;line-height:1.6'>"
      "페이지별 사용 CSS만 &lt;head&gt;에 인라인.<br>"
      "불필요한 CSS 로드 없음 · 외부 stylesheet 제로."
      "</div>"
      "</div>"

      "</div>"

      ; ── 코드 예시 ──────────────────────────────────────────
      "<h2 style='font-size:1.5rem;font-weight:700;margin:40px 0 20px;color:#111'>이렇게 씁니다</h2>"
      "<div class='" code_block "'>"
      "<pre style='margin:0;color:#cdd6f4;font-family:monospace;font-size:.875rem;line-height:1.7;overflow-x:auto'>"
      "<span style='color:#cba6f7'>(style</span> <span style='color:#a6e3a1'>hero</span>"
      "  <span style='color:#89b4fa'>:bg</span> <span style='color:#f38ba8'>\"#6366f1\"</span>"
      "  <span style='color:#89b4fa'>:p</span> <span style='color:#f38ba8'>\"48px\"</span>"
      "  <span style='color:#89b4fa'>:sm-p</span> <span style='color:#f38ba8'>\"24px\"</span>"
      "  <span style='color:#89b4fa'>:radius</span> <span style='color:#f38ba8'>\"12px\"</span><span style='color:#cba6f7'>)</span>\n"
      "\n"
      "<span style='color:#cba6f7'>(island</span> <span style='color:#a6e3a1'>Counter</span> <span style='color:#cdd6f4'>[]</span>\n"
      "  <span style='color:#cba6f7'>(let</span> <span style='color:#cdd6f4'>[n (atom 0)]</span>\n"
      "    <span style='color:#cba6f7'>(h</span> <span style='color:#f38ba8'>\"button\"</span>\n"
      "      <span style='color:#cdd6f4'>{</span><span style='color:#f38ba8'>\"on-click\"</span> <span style='color:#cba6f7'>(fn</span> <span style='color:#cdd6f4'>[]</span> <span style='color:#cba6f7'>(swap!</span> n inc<span style='color:#cba6f7'>))</span><span style='color:#cdd6f4'>}</span>\n"
      "      <span style='color:#cba6f7'>(str</span> <span style='color:#cdd6f4'>@n</span><span style='color:#cba6f7'>))))</span>\n"
      "\n"
      "<span style='color:#cba6f7'>(defn</span> <span style='color:#a6e3a1'>render</span> <span style='color:#cdd6f4'>[req]</span>\n"
      "  <span style='color:#cba6f7'>(server-html</span>\n"
      "    <span style='color:#cba6f7'>(layout</span> <span style='color:#f38ba8'>\"홈\"</span> content req<span style='color:#cba6f7'>)))</span>"
      "</pre>"
      "</div>"

      ; ── CTA ──────────────────────────────────────────────
      "<div style='text-align:center;margin:48px 0 16px'>"
      "<p style='color:#6b7280;margin:0 0 20px'>지금 바로 실행해보세요</p>"
