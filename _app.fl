; CSS 스타일 정의

(defn page_index [req]
  (server-html
    (layout "FreeLang Front" (str "<style>.hero_wrap__1b9c { background: #6366f1; color: white; border-radius: 16px; padding: 64px; } @media(max-width:640px){.hero_wrap__1b9c{padding: 32px;}} .feat_grid__506d { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); } @media(max-width:768px){.feat_grid__506d{grid-template-columns: repeat(2, 1fr);}} @media(max-width:640px){.feat_grid__506d{grid-template-columns: repeat(1, 1fr);}} .feat_card__1c54 { background: white; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.12); padding: 28px; } @media(max-width:640px){.feat_card__1c54{padding: 20px;}} .code_block__3b3c { background: #1e1e2e; border-radius: 12px; padding: 24px; } .stat_row__ba9a { display: grid; gap: 16px; grid-template-columns: repeat(4, 1fr); } @media(max-width:768px){.stat_row__ba9a{grid-template-columns: repeat(2, 1fr);}} @media(max-width:640px){.stat_row__ba9a{grid-template-columns: repeat(2, 1fr);}} .stat_item__d43e { background: white; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.12); padding: 24px; }</style>"

      ; ── Hero ─────────────────────────────────────────────────
